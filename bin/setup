#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

# The development database's server, as config/database.yml (and a
# DATABASE_URL, which Rails merges over it) names it, asked with libpq's ping,
# which needs no database to exist yet. A server that answers but refuses the
# login is up: db:prepare then says why. Waits up to 30 seconds, for a
# container started a moment ago.
def wait_for_postgres
  require_relative "../config/application"
  require "active_record/database_configurations"
  config = ActiveRecord::DatabaseConfigurations.new(Rails.application.config.database_configuration)
    .configs_for(env_name: "development", name: "primary").configuration_hash
  params = { host: config[:host], port: config[:port], user: config[:username], password: config[:password],
             gssencmode: config[:gssencmode], dbname: "postgres", connect_timeout: 2 }.compact
  where = "#{config[:host] || "the local socket"}#{":#{config[:port]}" if config[:port]}"
  30.times do |second|
    return if PG::Connection.ping(params) != PG::PQPING_NO_RESPONSE

    puts "Postgres does not answer at #{where} yet. Start it with: docker compose up -d" if second.zero?
    sleep 1
  end
  abort "Postgres did not answer at #{where} within 30 seconds. Start it with `docker compose up -d` (docker-compose.yml) and run bin/setup again."
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Waiting for Postgres =="
  wait_for_postgres

  # A database it creates is also seeded (db/seeds.rb: the built-in groups,
  # and in development the accounts, the demo content and /showcase); an
  # existing one is migrated and left as it is: `bin/rails db:seed` adds
  # what the seed has that it lacks.
  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  # The public stylesheet (and, through the task's enhancement, the theme's):
  # every public page and the tests that draw one read it.
  puts "\n== Building the stylesheets =="
  system! "bin/rails tailwindcss:build"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
