#!/usr/bin/env bash
# usage: bin/changelog-guard BASE_REF
#
# A pull request that changes the theme contract's ledger, a plugin hook or a
# migration says so in CHANGELOG.md under "## Unreleased" (a line added or
# changed between that heading and the next "## " one). Compares HEAD with
# `git merge-base BASE_REF HEAD`; exits 1, naming the guarded files it saw,
# when one changed and the section did not.
#
# Every migration gets a changelog line (the releases ruling): a migration
# file the pull request ADDS must also be named, by its version (the
# timestamp its file name starts with), under "### Migrations" in
# "## Unreleased". `contentspiel upgrade` warns that going back is not safe
# past a release with that heading, so a migration left out of it would make
# going back look safe. "### Migrations needing action" is for the ones a
# person must also do something about, and is not asked for here.
#
# Environment changes are not guarded here: the pull request template's
# checkbox covers them.
set -euo pipefail

GUARDED=(test/support/contract_ledger.rb lib/content_spiel/plugins.rb db/migrate/)

base_ref=${1:?usage: bin/changelog-guard BASE_REF}
base=$(git merge-base "$base_ref" HEAD)

changed=$(git diff --name-only "$base" HEAD -- "${GUARDED[@]}")
[ -z "$changed" ] && exit 0

unreleased() {
  git show "$1:CHANGELOG.md" 2>/dev/null |
    awk '/^## /{ inside = ($0 == "## Unreleased"); next } inside'
}

# The lines under "### Migrations" (exactly that heading) of a section.
migrations() {
  awk '/^### /{ inside = ($0 == "### Migrations"); next } inside'
}

status=0

if [ "$(unreleased "$base")" = "$(unreleased HEAD)" ]; then
  echo "CHANGELOG.md's \"## Unreleased\" section did not change, but these guarded files did:" >&2
  while IFS= read -r file; do echo "  $file" >&2; done <<< "$changed"
  echo "Add a line under \"## Unreleased\" saying what changed." >&2
  status=1
fi

listed=$(unreleased HEAD | migrations)
missing=()
while IFS= read -r file; do
  [ -n "$file" ] || continue
  name=${file##*/}
  version=${name%%_*}
  grep -qF -- "$version" <<< "$listed" || missing+=("$file")
done < <(git diff --name-only --diff-filter=A "$base" HEAD -- db/migrate/)

if [ ${#missing[@]} -gt 0 ]; then
  echo "These new migrations are not named under \"### Migrations\" in CHANGELOG.md's \"## Unreleased\":" >&2
  printf '  %s\n' "${missing[@]}" >&2
  echo "Add a line for each, naming its version and saying what it does." >&2
  status=1
fi

exit "$status"
