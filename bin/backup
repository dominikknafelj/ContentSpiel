#!/usr/bin/env ruby
# The backup accessory's command (lib/content_spiel/backup.rb,
# docs/reference/backups.md): plain Ruby, no Rails boot.
require_relative "../lib/content_spiel/backup"

$stdout.sync = true
backup = ContentSpiel::Backup.new(env: ENV, out: $stdout, err: $stderr, root: File.expand_path("..", __dir__))
exit backup.call(ARGV)
