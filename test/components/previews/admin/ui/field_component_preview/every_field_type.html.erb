<%
  # Registered here, not in the preview's own Ruby method: `render`/
  # `render_with_template` just return a description of what to render, so
  # registering there and cleaning up in that method's own `ensure` would
  # unregister "test/preview_detail" before this template -- the thing that
  # actually renders the `group`/`groups` fields below -- ever ran.
  FieldGroups.register("test/preview_detail") { |g| g.field :note, :string }
%>
<% fields.each do |field| %>
  <%= render Admin::Ui::FieldComponent.new(field: field, form_name: "preview[fields]", value: nil, locale: "en") %>
<% end %>
<% Rails.application.reloader.prepare! %>
