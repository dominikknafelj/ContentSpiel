<%= tag.dialog id: DIALOG_ID,
      class: "admin-media-picker admin-dialog rounded-cs border border-line-strong bg-surface p-0 text-ink shadow-menu",
      "aria-labelledby": part_id("title"),
      data: {
        dialog_width: "picker",
        controller: "admin--media-picker admin--media-select",
        action: ACTIONS,
        "admin--media-picker-grid-url-value": grid_url,
        "admin--media-picker-upload-url-value": upload_url
      } do %>
  <%# Padding lives on the sections below, not the <dialog>: a click on the
      dialog's own padding is a click on the <dialog> element, which the
      body-level `admin--dialog#backdrop` reads as a backdrop click. %>
  <div class="flex min-h-0 flex-1 flex-col">
    <div class="flex items-center justify-between gap-4 border-b border-line px-6 py-4">
      <h2 id="<%= part_id("title") %>" class="text-h2 text-ink">Choose an image</h2>
      <div class="flex items-center gap-3">
        <%= render Admin::ButtonComponent.new(label: "Upload", variant: :secondary, type: "button", data: { action: "admin--media-picker#browse" }) %>
        <%= tag.button "×", type: "button", "aria-label": "Close", class: "rounded-cs px-2 text-2xl leading-none text-meta hover:text-ink focus:outline-2 focus:outline-accent",
              data: { action: "admin--media-picker#dismiss" } %>
      </div>
    </div>

    <%# No `name`: the files go to the upload endpoint by XHR, never with any
        form's own data. Visually hidden, not `hidden`: still a labelled field
        (the header's Upload button clicks it). %>
    <%= label_tag part_id("file"), "Image file", class: "sr-only" %>
    <%= tag.input type: "file", id: part_id("file"), accept: accept, multiple: true, class: "sr-only",
          data: { "admin--media-picker-target": "file", action: "change->admin--media-picker#upload" } %>
    <p class="sr-only" role="status" aria-live="polite" data-admin--media-picker-target="status"></p>

    <div class="min-h-0 flex-1 overflow-y-auto px-6 py-4">
      <%# Loaded by `admin--media-picker#open` every time the picker opens (so a
          library changed meanwhile -- an upload in another tab, a delete -- is
          never stale), then navigated in place by its own search form, segments
          and pagination links. %>
      <turbo-frame id="media-picker-grid" data-admin--media-picker-target="frame"></turbo-frame>
    </div>

    <div class="flex items-center justify-between gap-4 border-t border-line px-6 py-3">
      <%# What is chosen, said in words and announced as it changes. %>
      <p class="text-sm text-meta" role="status" aria-live="polite" data-admin--media-select-target="status">No image selected</p>
      <div class="flex items-center gap-2">
        <%= render Admin::ButtonComponent.new(label: "Cancel", variant: :ghost, type: "button", data: { action: "admin--media-picker#dismiss" }) %>
        <%= render Admin::ButtonComponent.new(label: "Use image", variant: :primary, type: "button", disabled: true,
              data: { "admin--media-select-target": "use", action: "admin--media-select#confirm" }) %>
      </div>
    </div>
  </div>
<% end %>
