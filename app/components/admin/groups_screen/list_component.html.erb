<div class="rounded-card bg-surface shadow-1">
  <%# A row that is one link has no sticky first cell: a sticky cell would be the
      containing block of the link's cover, which would then cover the name
      alone. The table scrolls sideways whole. %>
  <div class="admin-table-scroll--x rounded-card">
    <table class="admin-groups-list admin-card-table w-full border-collapse text-sm">
      <thead>
        <tr class="border-b border-line-strong text-left text-label text-meta">
          <th scope="col" class="py-2 pr-4"><%= t(".group") %></th>
          <th scope="col" class="py-2 pr-4"><%= t(".members_column") %></th>
          <th scope="col" class="py-2 pr-4"><%= t(".tokens_column") %></th>
          <th scope="col" class="py-2"><span class="sr-only"><%= t(".actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% groups.each do |group| %>
          <tr id="<%= helpers.dom_id(group) %>" class="border-b border-line last:border-b-0 hover:bg-paper">
            <th scope="row" class="py-2.5 pr-4 text-left font-normal">
              <span class="flex min-w-0 flex-col gap-0.5">
                <span class="flex flex-wrap items-center gap-2">
                  <%= link_to group.name, helpers.edit_admin_group_path(group, **url_options), data: { turbo_frame: "content" },
                        class: "admin-row-link font-medium text-ink" %>
                  <% if group.built_in? %><%= render Admin::Ui::BadgeComponent.new(label: t(".built_in")) %><% end %>
                </span>
                <% if group.description.present? %><span class="text-small text-dim"><%= group.description %></span><% end %>
              </span>
            </th>
            <td class="py-2.5 pr-4 text-small <%= count_class(members(group)) %>" data-column="members"><%= members(group) %><span class="sr-only"> <%= t(".members", count: members(group)) %></span></td>
            <td class="py-2.5 pr-4 text-small <%= count_class(tokens(group)) %>" data-column="tokens"><%= tokens(group) %><span class="sr-only"> <%= t(".tokens", count: tokens(group)) %></span></td>
            <td class="py-2.5 text-right"><span class="admin-row-verb" aria-hidden="true"><%= t(".edit") %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<p class="mt-3 text-small text-meta"><%= t(".footnote") %></p>
