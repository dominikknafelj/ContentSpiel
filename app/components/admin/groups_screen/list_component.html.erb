<div class="admin-groups-list overflow-hidden rounded-cs border border-line bg-surface">
  <div class="<%= COLUMNS %> border-b border-line-strong py-2 font-cs-mono text-label uppercase tracking-mono text-meta" aria-hidden="true">
    <span>Group</span><span>Members</span><span>Tokens</span><span></span>
  </div>
  <ul>
    <% groups.each do |group| %>
      <li id="<%= helpers.dom_id(group) %>" class="<%= COLUMNS %> relative border-b border-line py-3 last:border-b-0 hover:bg-paper">
        <span class="flex min-w-0 flex-col gap-0.5">
          <span class="flex items-center gap-2">
            <%= link_to group.name, helpers.edit_admin_group_path(group, **url_options), data: { turbo_frame: "content" },
                  class: "font-medium text-ink after:absolute after:inset-0 after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-[-2px] focus-visible:after:outline-accent" %>
            <% if group.built_in? %>
              <%= render Admin::Ui::BadgeComponent.new(label: "Built-in") %>
            <% end %>
          </span>
          <% if group.description.present? %><span class="text-sm text-dim"><%= group.description %></span><% end %>
        </span>
        <span class="font-cs-mono text-sm <%= count_class(members(group)) %>" data-column="members"><%= members(group) %><span class="sr-only"> <%= "member".pluralize(members(group)) %></span></span>
        <span class="font-cs-mono text-sm <%= count_class(tokens(group)) %>" data-column="tokens"><%= tokens(group) %><span class="sr-only"> <%= "token".pluralize(tokens(group)) %></span></span>
        <span class="text-meta" aria-hidden="true">›</span>
      </li>
    <% end %>
  </ul>
</div>
<p class="mt-3 text-xs text-meta">Built-in groups can be changed but not deleted. Deleting a custom group removes its permissions from its members and revokes its AI tokens.</p>
