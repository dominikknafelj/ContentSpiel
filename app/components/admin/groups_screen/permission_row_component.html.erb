<div class="admin-permission-row border-b border-line" data-permission="<%= permission.key %>" <%= "data-locked" if locked? %> id="permission-row-<%= slug %>">
  <div class="grid grid-cols-[1.25rem_minmax(7rem,12rem)_minmax(0,1fr)_auto] items-center gap-3 px-4 py-2.5">
    <%# The accessible name is the registry's full label ("Edit pages"): the short label is only what a row under a "Pages" band needs to say
        (`accessible_label` puts the short one in front where the full one doesn't contain it). %>
    <% if locked? %>
      <%# Ticked and disabled, in the disabled look, which reaches the label that follows it: it is not submitted, so the hidden inputs after the label carry the grant. %>
      <%= render Admin::Ui::CheckboxComponent.new(name: field_name("enabled"), value: "1", checked: true, disabled: true, id: checkbox_id,
            aria: { label: accessible_label, describedby: "#{checkbox_id}-locked" }) %>
    <% else %>
      <%= render Admin::Ui::CheckboxComponent.new(name: field_name("enabled"), value: "1", checked: ticked?, id: checkbox_id, aria: { label: accessible_label },
            data: { action: "change->admin--groups--permission-matrix#toggle" }) %>
    <% end %>
    <label for="<%= checkbox_id %>" class="flex min-w-0 <%= locked? ? "cursor-default" : "cursor-pointer" %> flex-col">
      <span class="<%= "text-ink" unless locked? %>"><%= short_label %></span>
      <code class="font-cs-mono text-small text-meta" title="<%= permission.key %>"><%= permission.key %></code>
      <% if locked? %><span id="<%= checkbox_id %>-locked" class="admin-locked-note text-small text-meta"><%= t(".locked") %></span><% end %>
    </label>
    <% if locked? %>
      <% carried_inputs.each do |name, value| %><%= hidden_field_tag name, value, id: nil %><% end %>
    <% end %>
    <div class="flex min-w-0 flex-wrap items-center gap-1.5" data-chips>
      <% chips.each do |chip| %><%= render_chip(chip) %><% end %>
    </div>
    <% if locked? %>
      <span></span>
    <% elsif view_only? %>
      <a href="#<%= editor_id %>" role="button" class="<%= Admin::Ui::ButtonComponent.classes(:tertiary, size: :small) %>" <%= "hidden" unless ticked? %>
         aria-expanded="<%= open? %>" aria-controls="<%= editor_id %>" data-open-label="<%= t(".hide_scope") %>" data-closed-label="<%= t(".view_scope") %>"
         data-action="click->admin--groups--permission-matrix#toggleEditor keydown.space->admin--groups--permission-matrix#toggleEditor"><%= open? ? t(".hide_scope") : t(".view_scope") %></a>
    <% else %>
      <button type="button" class="<%= Admin::Ui::ButtonComponent.classes(:tertiary, size: :small) %>" <%= "hidden" unless ticked? %>
        aria-expanded="<%= open? %>" aria-controls="<%= editor_id %>" data-open-label="<%= t(".done") %>" data-closed-label="<%= t(".edit_scope") %>"
        data-action="click->admin--groups--permission-matrix#toggleEditor"><%= open? ? t(".done") : t(".edit_scope") %></button>
    <% end %>
  </div>
  <% unless locked? %><%= render editor %><% end %>
</div>
