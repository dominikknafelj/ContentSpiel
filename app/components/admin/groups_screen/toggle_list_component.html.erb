<div class="admin-toggle-list">
  <% bands.each do |area, title, permissions| %>
    <section aria-labelledby="<%= band_id(area) %>">
      <h3 id="<%= band_id(area) %>" class="admin-area-heading border-b border-line bg-paper px-4 py-2 text-label text-meta"><%= title %></h3>
      <% permissions.each do |permission| %>
        <label for="<%= field_id(permission) %>" class="flex <%= locked?(permission) ? "cursor-default" : "cursor-pointer" %> items-center justify-between gap-3 border-b border-line px-4 py-2 last:border-b-0">
          <span class="flex min-w-0 flex-col">
            <span class="text-sm <%= locked?(permission) ? "text-meta" : "text-ink" %>"><%= permission.label %></span>
            <code class="font-cs-mono text-small text-meta" title="<%= permission.key %>"><%= permission.key %></code>
            <% if locked?(permission) %><span id="<%= field_id(permission) %>-locked" class="admin-locked-note text-small text-meta"><%= t(".locked") %></span><% end %>
          </span>
          <% if locked?(permission) %>
            <%# Disabled and not submitted; the hidden input carries the grant. %>
            <%= check_box_tag field_name(permission), "1", true, id: field_id(permission), class: "cs-toggle", role: "switch", disabled: true, aria: { describedby: "#{field_id(permission)}-locked" } %>
            <%= hidden_field_tag field_name(permission), "1", id: nil %>
          <% else %>
            <%= check_box_tag field_name(permission), "1", ticked?(permission), id: field_id(permission), class: "cs-toggle", role: "switch" %>
          <% end %>
        </label>
      <% end %>
    </section>
  <% end %>
</div>
