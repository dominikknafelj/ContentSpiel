<%= tag.div class: "admin-permission-matrix flex flex-col gap-6", data: { controller: "admin--groups--permission-matrix", messages: script_messages, **script_values } do %>
  <% unregistered_notes.each do |note| %>
    <%= render Admin::Ui::NoticeComponent.new(tone: :warn, role: nil, class: "admin-stale-grant") do %><%= note %><% end %>
  <% end %>

  <%= render Admin::Ui::SettingsCardComponent.new(heading_id: "group-content-permissions", heading: t(".content"), icon: :pages, family: :structure, intro: t(".content_intro")) do %>
    <% sections.each do |area, permissions| %>
      <div class="admin-area-heading border-b border-line bg-paper px-4 py-2 text-label text-meta"><%= area %></div>
      <% permissions.each do |permission| %>
        <%= render row_for(permission) %>
        <% notes = stale_notes(permission) %>
        <% if notes.any? %>
          <%# Indented like the scope editor: the tick column, the gap and the row's padding. %>
          <div class="flex flex-col gap-2 border-b border-line py-2 pr-4 pl-[calc(1.25rem+0.75rem+1rem)]">
            <% notes.each do |note| %>
              <%= render Admin::Ui::NoticeComponent.new(tone: :warn, size: :compact, role: nil, class: "admin-stale-grant") do %><%= note %><% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Admin::Ui::SettingsCardComponent.new(heading_id: "group-other-permissions", heading: t(".other"), icon: :settings, family: :neutral) do %>
    <%= render Admin::GroupsScreen::ToggleListComponent.new(grants: toggle_grants, form_name: form_name, locked: locked_toggle_keys) %>
  <% end %>

  <% if any_locked? %>
    <p class="admin-locked-hint text-small text-meta"><%= t(".locked_hint") %></p>
  <% end %>
<% end %>
