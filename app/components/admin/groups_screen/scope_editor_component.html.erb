<%# Rendered open: with scripts off every scope control is on the page. `admin--groups--permission-matrix` closes each editor
    that isn't `data-open` when it connects (and shows the row's "Edit scope"). Indented to the row's label column: the tick
    column, the gap and the row's padding. %>
<div id="<%= id %>" class="admin-scope-editor flex flex-col gap-3 border-t border-line bg-paper py-3.5 pr-4 pl-[calc(1.25rem+0.75rem+1rem)]" data-scope-editor
     data-open="<%= open? %>" data-action="change->admin--groups--permission-matrix#scopeChanged keydown.esc->admin--groups--permission-matrix#closeFromKey">
  <% if types_shown %>
    <fieldset class="flex flex-col gap-2">
      <legend class="mb-2 text-label text-meta"><%= t(".types") %></legend>
      <div class="flex flex-wrap gap-2">
        <% registered_types.each do |name| %>
          <% box_id = field_id("type", name.parameterize) %>
          <label for="<%= box_id %>" class="flex items-center gap-2 rounded-cs border border-field-line bg-surface px-2.5 py-1.5 text-sm text-ink">
            <%= render Admin::Ui::CheckboxComponent.new(name: field_name("content_types") + "[]", value: name, checked: chosen_types.include?(name), id: box_id,
                  data: { chip_label: content_type_label(name), chip_dot: dot_class(name) }) %>
            <% if dot_class(name) %><span aria-hidden="true" class="h-[7px] w-[7px] shrink-0 rounded-full <%= dot_class(name) %>"></span><% end %>
            <%= content_type_label(name) %>
          </label>
        <% end %>
        <% removed_types.each do |name| %>
          <span class="admin-removed-type flex items-center gap-2" data-removed-type="<%= name %>">
            <%= render Admin::Ui::BadgeComponent.new(label: removed_label(name), tone: :warn) %>
            <%# Carried until Remove: a form saved as rendered keeps it. Tracked, so Remove is a change the footer counts. %>
            <%= hidden_field_tag field_name("content_types") + "[]", name, id: nil, data: { save_bar_track: true } %>
            <button type="button" class="<%= Admin::Ui::ButtonComponent.classes(:tertiary, size: :small) %>" data-action="click->admin--groups--permission-matrix#removeType"><%= t(".remove") %></button>
          </span>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <% if own_shown %>
    <label for="<%= field_id("own") %>" class="flex items-center gap-2.5 text-sm text-ink">
      <%= check_box_tag field_name("own"), "1", scope["own"] == true, id: field_id("own"), class: "cs-toggle", role: "switch", data: { chip_own: true } %>
      <%= t(".own_only") %> <span class="text-meta"><%= t(".own_hint") %></span>
    </label>
  <% end %>

  <% if branch_shown %>
    <div class="flex flex-col gap-2">
      <span class="text-label text-meta"><%= t(".branches") %></span>
      <div class="admin-branch-picker max-w-[520px] rounded-card bg-surface shadow-1 p-1.5" data-controller="admin--groups--branch-picker">
        <%= branch_list(tree.roots) %>
        <% kept_page_ids.each do |page_id| %>
          <%# A stored root the viewer can't open: carried, with no title and no place in the tree. %>
          <%= hidden_field_tag field_name("page_ids") + "[]", page_id, id: nil, data: { admin__groups__branch_picker_target: "kept" } %>
          <p class="px-2 py-1 text-sm text-dim"><%= t(".kept") %></p>
        <% end %>
      </div>
      <% if kept_page_ids.any? %>
        <p class="admin-unreadable-branches text-sm text-warn-ink"><%= t(".unreadable_branches") %></p>
      <% end %>
    </div>
  <% end %>
</div>
