<li class="flex gap-4 py-4" data-alert-kind="<%= alert.kind %>">
  <div class="w-[110px] shrink-0">
    <%= render chip %>
  </div>
  <div class="min-w-0 flex-1">
    <p class="font-semibold text-ink">
      <% if error_sentence? %>
        <code class="font-cs-mono text-small font-normal"><%= error_class %></code><% if error_place %> <%= t(".in") %> <code class="font-cs-mono text-small font-normal"><%= error_place %></code><% end %>
      <% else %>
        <%= sentence %>
      <% end %>
    </p>
    <p class="text-small text-dim">
      <%= how_often %> · <%= last_seen %> · <span class="<%= mail_unavailable? ? "text-warn-ink" : "text-meta" %>"><%= mail_state %></span>
    </p>
    <% if security? && audit_href %>
      <p class="mt-2"><%= link_to t(".open_audit_log"), audit_href, class: LINK_CLASS %></p>
    <% end %>
  </div>
</li>
