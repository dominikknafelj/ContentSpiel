<% frame = capture do %>
  <%= tag.turbo_frame id: frame_id, class: "block", data: { "admin--presence--record-target": "frame" } do %>
    <% if people.any? %>
      <div role="group" aria-label="<%= group_label %>" class="flex items-center">
        <% circles.each_with_index do |person, index| %>
          <%= tag.span class: circle_class(index), tabindex: 0, role: "img", aria: { label: person.label }, data: { presence_user: person.user.id, presence_state: person.state } do %>
            <%= render Admin::Ui::AvatarComponent.new(initials: person.initials, size: avatar_size, tone: tone(person), ring: true) %><%= render Admin::Ui::TooltipComponent.new(text: person.label, align: hang) %>
          <% end %>
        <% end %>
        <% if more? %>
          <%= tag.span class: more_class do %>
            <%= render Admin::Ui::MenuComponent.new(label: more_label, list: true, align: hang, button_class: more_button_class) do |menu| %>
              <% people.each do |person| %>
                <% menu.with_item do %>
                  <%= tag.div class: "flex items-center gap-2 px-2 py-1", data: { presence_listed: person.user.id } do %>
                    <%= render Admin::Ui::AvatarComponent.new(initials: person.initials, size: :md, tone: tone(person)) %>
                    <span class="min-w-0">
                      <span class="block max-w-56 truncate text-sm text-ink" data-presence-name><%= person.name %></span>
                      <span class="block text-xs text-meta" data-presence-status><%= person.status %></span>
                    </span>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
<% if frame_only? %>
  <%= frame %>
<% else %>
  <%= tag.div class: wrapper_class, data: { controller: "admin--presence--record", live_part: "waiting",
        "admin--presence--record-kind-value": kind.name, "admin--presence--record-id-value": @record.id, "admin--presence--record-url-value": url } do %>
    <%= frame %>
  <% end %>
<% end %>
