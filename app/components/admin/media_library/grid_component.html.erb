<ul class="admin-media-grid <%= grid_class %>">
  <% assets.each do |asset| %>
    <%= render Admin::MediaLibrary::TileComponent.new(asset: asset, url: (show_path(asset) unless pick?), unused: !used_ids.include?(asset.id),
          selected: selected?(asset), pick: pick?, locale: locale,
          open_notes: note_counts.fetch(asset.id, 0), notes_unread: note_unread.include?(asset.id)) %>
  <% end %>
</ul>
<% if assets.empty? %>
  <div class="rounded-card bg-surface shadow-1" data-media-empty>
    <% if filtered? %>
      <%= render Admin::Ui::EmptyStateComponent.new(title: t(".empty.no_matches"), description: t(".empty.no_matches_description")) do |empty_state| %>
        <% empty_state.with_action do %>
          <%= link_to t(".empty.clear"), clear_filters_path, class: setup_secondary_link_class, data: clear_filters_data %>
        <% end %>
      <% end %>
    <% else %>
      <%= render Admin::Ui::EmptyStateComponent.new(title: t(".empty.title"), description: pick? ? t(".empty.picker_description") : t(".empty.description")) %>
    <% end %>
  </div>
<% end %>
