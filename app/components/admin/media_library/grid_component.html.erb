<ul class="admin-media-grid <%= grid_class %>">
  <% assets.each do |asset| %>
    <%= render Admin::MediaLibrary::TileComponent.new(asset: asset, url: (show_path(asset) unless pick?), unused: !used_ids.include?(asset.id),
          selected: selected?(asset), pick: pick?, locale: locale) %>
  <% end %>
</ul>
<% if assets.empty? %>
  <div class="rounded-cs border border-line bg-surface" data-media-empty>
    <% if filtered? %>
      <%= render Admin::EmptyStateComponent.new(title: "No matches", description: "No images match the current search or filter.") do |empty_state| %>
        <% empty_state.with_action do %>
          <%= link_to "Clear filters", clear_filters_path, class: setup_secondary_link_class, data: clear_filters_data %>
        <% end %>
      <% end %>
    <% else %>
      <%= render Admin::EmptyStateComponent.new(title: "No images", description: pick? ? "Use Upload above to add one." : "Upload one above.") %>
    <% end %>
  </div>
<% end %>
