<div class="admin-media-detail flex flex-col gap-6">
  <%= link_to "← Back to media", index_path, class: "text-sm text-meta hover:text-ink" %>

  <div class="grid gap-6 md:grid-cols-[16rem_1fr]">
    <div class="flex flex-col gap-2">
      <span class="block overflow-hidden rounded-cs border border-line bg-sunken">
        <%= image_tag preview_url, alt: "", class: "w-full" %>
      </span>
      <dl class="text-sm text-meta">
        <div class="flex justify-between"><dt>Type</dt><dd><%= asset.content_type %></dd></div>
        <div class="flex justify-between"><dt>Size</dt><dd><%= byte_size %></dd></div>
        <% if dimensions %>
          <div class="flex justify-between"><dt>Dimensions</dt><dd><%= dimensions %></dd></div>
        <% end %>
      </dl>
    </div>

    <div class="flex flex-col gap-4">
      <div class="flex items-center justify-between gap-3">
        <%= render Admin::LanguageTabsComponent.new(current: locale, missing: missing_locales, outdated: outdated_locales, url: language_url) %>
        <%= render Admin::SaveStatusComponent.new(id: status_id, state: :idle) %>
      </div>

      <%= form_with url: form_url, method: :patch, class: "flex flex-col gap-4", data: form_data do %>
        <%= tag.fieldset disabled: !editable?, class: "contents" do %>
          <%= render partial: "admin/shared/base_updated_at_field", locals: { id: base_updated_at_id, value: base_updated_at_value } %>

          <%= render Admin::Columns::PlainColumnComponent.new(
                name: "title", id: "media-title", html_name: "media_asset[title]",
                value: title_value, errors: title_errors
              ) %>

          <%= render Admin::Columns::PlainColumnComponent.new(
                name: "alt", id: "media-alt", html_name: "media_asset[alt]",
                value: alt_value, original: original(:alt), errors: alt_errors, locale: locale, **translation(:alt)
              ) %>

          <%= render Admin::Columns::PlainColumnComponent.new(
                name: "caption", id: "media-caption", html_name: "media_asset[caption]",
                value: caption_value, original: original(:caption), errors: caption_errors, locale: locale, multiline: true,
                **translation(:caption)
              ) %>
        <% end %>
      <% end %>

      <div>
        <h2 id="media-used-on" class="mb-2 scroll-mt-4 font-semibold text-ink">Used on</h2>
        <% if unresolved_usage? %>
          <p class="text-sm text-meta">Used somewhere that can’t be shown — the record of where may be out of date.</p>
        <% elsif usage_state == :trash_only %>
          <p class="text-sm text-meta">Used only by items in the trash.</p>
        <% elsif usage_entries.empty? %>
          <p class="text-sm text-meta">Not used anywhere yet.</p>
        <% else %>
          <ul class="flex flex-col gap-1 text-sm">
            <% usage_entries.each do |entry| %>
              <li>
                <% if entry[:path] %>
                  <%= link_to entry[:label], entry[:path], class: "text-ink hover:underline" %>
                <% else %>
                  <span class="text-ink"><%= entry[:label] %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <% if can_delete? %>
        <div>
          <% if move_to_trash_disabled? %>
            <%= render Admin::ButtonComponent.new(label: "Move to trash", variant: :danger_outline, type: "button", disabled: true, aria: { describedby: "media-trash-help" }) %>
            <%# `text-dim`, not `text-meta`: the low contrast was bug 7. %>
            <p id="media-trash-help" class="mt-1 text-sm text-dim"><%= in_use_reason %> <a href="#media-used-on" class="underline">See where it's used</a></p>
          <% else %>
            <%= render Admin::ButtonComponent.new(label: "Move to trash", variant: :danger_outline, type: "button",
                  data: dialog_trigger(delete_dialog_id)) %>
            <%= render Admin::ConfirmDialogComponent.new(destructive: true, id: delete_dialog_id, title: "Move this image to the trash?", body: "You can restore it from the trash.") do |dialog| %>
              <% dialog.with_confirm_action do %>
                <%= form_with url: destroy_path, method: :delete do %>
                  <%= render Admin::ButtonComponent.new(label: "Move to trash", variant: :danger, type: "submit") %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
