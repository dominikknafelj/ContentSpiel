<header class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2" data-media-place-heading>
  <div class="flex min-w-0 flex-col gap-1">
    <% if folder? %>
      <%= tag.nav aria: { label: t(".breadcrumb_label") }, class: "flex flex-wrap items-center gap-1.5 text-small text-meta" do %>
        <% ancestors.each do |label, each| %>
          <%= link_to label, place_href(each), class: "text-accent", data: link_data %><span aria-hidden="true">›</span>
        <% end %>
        <span aria-current="page"><%= name %></span>
      <% end %>
    <% end %>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h1 class="text-h1 text-ink"><%= name %></h1>
      <span id="<%= COUNT_ID %>" class="text-small text-meta"><%= count_text %></span>
      <%# SLOT: the folder actions' menu (a folder, for `media.manage`) follows the count. %>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <%# SLOT: Select stands here, before Upload images. %>
    <% if upload? %>
      <%= render Admin::Ui::ButtonComponent.new(label: t(".upload"), variant: :primary, type: "button", data: { action: "admin--media--upload#browse" }) %>
    <% end %>
  </div>
</header>
