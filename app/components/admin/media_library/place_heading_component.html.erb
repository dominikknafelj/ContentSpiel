<header class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2" data-media-place-heading>
  <div class="flex min-w-0 flex-col gap-1">
    <% if folder? %>
      <%= tag.nav aria: { label: t(".breadcrumb_label") }, class: "flex flex-wrap items-center gap-1.5 text-small text-meta" do %>
        <% ancestors.each do |label, each| %>
          <%= link_to label, place_href(each), class: "text-accent", data: link_data %><span aria-hidden="true">›</span>
        <% end %>
        <span aria-current="page"><%= name %></span>
      <% end %>
    <% end %>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h1 class="text-h1 text-ink"><%= name %></h1>
      <span id="<%= COUNT_ID %>" class="text-small text-meta"><%= count_text %></span>
      <% if menu? %>
        <%= render Admin::Ui::MenuComponent.new(label: "⋯", aria_label: t(".menu"), align: :left, close_on_select: true) do |menu| %>
          <% if new_inside? %>
            <% menu.with_item { tag.button(t(".new_inside"), type: "button", data: new_inside_data) } %>
          <% end %>
          <% menu.with_item { tag.button(t(".rename"), type: "button", data: rename_data) } %>
          <% menu.with_item { tag.button(move_label, type: "button", data: move_data) } %>
          <% menu.with_item { tag.div(role: "separator", class: "my-1 border-t border-line") } %>
          <% menu.with_item { tag.button(t(".delete"), type: "button", class: "text-danger-ink", data: delete_data) } %>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <% if select? %>
      <%= link_to t(".select"), select_url, class: Admin::Ui::ButtonComponent.classes(:secondary, size: :small), data: link_data %>
    <% end %>
    <% if upload? %>
      <%= render Admin::Ui::ButtonComponent.new(label: t(".upload"), variant: :primary, type: "button", data: { action: "admin--media--upload#browse" }) %>
    <% end %>
  </div>
</header>
