<%# The tree: the list a find narrows and names (`aria-controls`). It folds
    and unfolds the folders (`admin--tree--disclosure`); on the screen it
    writes their folds into `cs_media_open` on the admin path only and
    follows the place the content frame shows (`admin--media--folders`: the
    selected row's classes handed over as Stimulus classes), and
    `data-media-drag-tree` and the deepest level are the drop hooks
    `admin--media--drag` reads from outside (`tree_data`). %>
<% tree_list = capture do %>
  <%= tag.ul id: tree_id, class: ROW[:tree], data: tree_data do %>
    <li>
      <%= render Admin::Ui::TreeItemComponent.new(id: row_id(Media::Place::ALL), title: t(".all"), selected: selected?(Media::Place::ALL), data: row_data(Media::Place::ALL)) do |item| %>
        <% item.with_mark { glyph(:media) } %>
        <% item.with_title { link(t(".all"), Media::Place::ALL) } %>
        <% item.with_trailing { count_part(counts[:all], Media::Place::ALL) } %>
      <% end %>
    </li>
    <li>
      <%= render Admin::Ui::TreeItemComponent.new(id: row_id(Media::Place::NONE), title: t(".none"), selected: selected?(Media::Place::NONE), data: row_data(Media::Place::NONE)) do |item| %>
        <% item.with_mark { glyph(:folder_none) } %>
        <% item.with_title { link(t(".none"), Media::Place::NONE) } %>
        <% item.with_trailing { count_part(counts[:none], Media::Place::NONE) } %>
      <% end %>
    </li>
    <%# The rule between the two places of every library and its folders. %>
    <li class="my-1.5 border-t border-line" aria-hidden="true"></li>
    <% tree.roots.each do |node| %>
      <%= folder_node(node, 1) %>
    <% end %>
  <% end %>
<% end %>
<% if picker? %>
  <%# Two siblings, for the picker's grid of columns to place: the select
      above the toolbar below 640px, the list in its own 200px column from
      640px. A select in no form, so no `name`. Their wrapper draws no box. %>
  <%= tag.div id: PICKER_PART_ID, class: "contents", data: part_data do %>
  <div class="px-6 pt-4 sm:hidden">
    <%= label_tag "media-picker-place-select", t(".picker_select"), class: setup_label_class %>
    <%= tag.select select_options, id: "media-picker-place-select", class: "#{setup_select_class} mt-1",
          data: { action: "change->admin--media--picker#place" } %>
  </div>
  <%= tag.nav tree_list, "aria-label": t(".heading"),
        class: "hidden min-h-0 overflow-y-auto border-r border-line bg-surface px-2 py-3 sm:block" %>
  <% end %>
<% else %>
  <%# The part a folder or move answer replaces whole, carrying the place the
      screen goes to next (`go_to`, read once by `admin--media--folders`). %>
  <%= tag.div id: PART_ID, data: { media_go: go_to, **part_data } do %>
    <%= tree_list %>
    <% unless folders? %>
      <p class="px-1 text-small text-dim"><%= t(".empty") %></p>
    <% end %>
  <% end %>
<% end %>
