<% face = capture do %>
  <span class="relative block aspect-[4/3] w-full overflow-hidden bg-sunken">
    <%# The thumbnail is `relative`, so it paints over the absolute preview. %>
    <% if loading_preview_url %>
      <img src="<%= loading_preview_url %>" alt="" aria-hidden="true" class="absolute inset-0 size-full scale-110 object-cover blur-md">
    <% end %>
    <%= render Admin::Ui::LibraryImageComponent.new(asset: asset, min_width: 480, css_class: "relative h-full w-full object-cover") %>
    <%# Open notes: on the image, where the title's chips below never push it.
        Words for a screen reader, like the chips: the number alone says
        nothing. %>
    <%= render Admin::Ui::NoteMarkerComponent.new(count: open_notes, label: t(notes_unread? ? ".open_notes_unread" : ".open_notes", count: open_notes), unread: notes_unread?, on_image: true,
          data: { notes_chip: true }) %>
  </span>
  <span class="flex flex-col gap-1 px-2.5 py-2">
    <span class="truncate text-sm font-medium text-ink"><%= asset.title %></span>
    <span class="flex flex-wrap items-center gap-1.5">
      <% if dimensions %><span class="text-label text-meta"><%= dimensions %></span><% end %>
      <% if no_alt? %><%= render Admin::Ui::BadgeComponent.new(label: t(".no_alt"), tone: :warn) %><% end %>
      <% if unused? %><%= render Admin::Ui::BadgeComponent.new(label: t(".unused")) %><% end %>
    </span>
  </span>
<% end %>
<li id="<%= dom_id %>">
  <% if pick? %>
    <%= tag.button face, type: "button", class: PICK_CARD, aria: { pressed: "false" }, data: pick_data %>
  <% else %>
    <%= link_to face, url, class: CARD, aria: { current: (selected? ? "true" : nil) }, data: { turbo_frame: "content", turbo_action: "advance", action: "click->admin--media--panel#choose" } %>
  <% end %>
</li>
