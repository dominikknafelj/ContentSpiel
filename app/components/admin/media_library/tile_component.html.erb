<% face = capture do %>
  <span class="relative block aspect-[4/3] w-full overflow-hidden bg-sunken">
    <%= image_tag thumbnail_url, alt: "", loading: "lazy", class: "h-full w-full object-cover" %>
    <%# Open notes (notes handoff, "Media tile chip"): on the image, where the
        title's chips below never push it. Words for a screen reader, like
        the chips: the number alone says nothing. %>
    <% if open_notes.positive? %>
      <%= tag.span data: { notes_chip: true, has_notes: true, unread: (true if notes_unread?) }, role: "img",
            title: t(".open_notes", count: open_notes), aria: { label: t(".open_notes", count: open_notes) },
            class: "admin-notes-marker admin-notes-marker--readonly admin-notes-marker--on-image" do %>
        <%= helpers.render "admin/shared/icon", name: :message_square, size: "size-3" %><%= open_notes %>
      <% end %>
    <% end %>
  </span>
  <span class="flex flex-col gap-1 px-2.5 py-2">
    <span class="truncate text-sm font-medium text-ink"><%= asset.title %></span>
    <span class="flex flex-wrap items-center gap-1.5">
      <% if dimensions %><span class="font-cs-mono text-label text-meta"><%= dimensions %></span><% end %>
      <% if no_alt? %><span class="rounded-cs border border-warn px-1 font-cs-mono text-label text-warn-ink">NO ALT</span><% end %>
      <% if unused? %><span class="rounded-cs border border-line-strong px-1 font-cs-mono text-label text-meta">UNUSED</span><% end %>
    </span>
  </span>
<% end %>
<li id="<%= dom_id %>">
  <% if pick? %>
    <%= tag.button face, type: "button", class: PICK_CARD, aria: { pressed: "false" }, data: pick_data %>
  <% else %>
    <%= link_to face, url, class: card_class, aria: { current: (selected? ? "true" : nil) }, data: { turbo_frame: "content", turbo_action: "advance", action: "click->admin--media--panel#choose" } %>
  <% end %>
</li>
