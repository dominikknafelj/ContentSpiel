<%= form_with(**form_options) do %>
  <% if hidden_locale? %>
    <%= hidden_field_tag :locale, url_options[:locale], id: nil %>
  <% end %>
  <% if picker? %>
    <%= hidden_field_tag :picker, "1", id: nil %>
  <% end %>
  <% if selected_id %>
    <%= hidden_field_tag :selected, selected_id, id: nil %>
  <% end %>

  <div>
    <%= label_tag search_id, t(".search_label"), class: "sr-only" %>
    <%= search_field_tag :q, q.is_a?(String) ? q : nil, id: search_id, placeholder: t(".search_placeholder"), autocomplete: "off",
          class: "block w-72 max-w-full px-3 py-1.5 text-ink" %>
  </div>

  <%= render Admin::Ui::SegmentedComponent.new(mode: :radios, name: :filter, label: t(".show"), segments: segment_items) %>

  <noscript><%= render Admin::Ui::ButtonComponent.new(label: t(".filter"), variant: :secondary, type: "submit") %></noscript>
  <% if active? %>
    <%= link_to t(".clear"), clear_path, class: setup_secondary_link_class,
          data: (picker? ? { turbo_frame: "media-picker-grid" } : { turbo_frame: "content", turbo_action: "replace" }) %>
  <% end %>
<% end %>
