<%# One image's panel, the Image tab's content. `id="media-panel"` is what the
    Media screen's own layout and the tests look for, and the focus target
    (`admin--media--panel`); the title, the save status and the
    base-updated-at field keep stable ids because the autosave answer
    (`Admin::MediaController#update`) addresses them. %>
<section id="media-panel" class="admin-media-panel flex flex-col gap-4 focus:outline-none" aria-labelledby="media-panel-title" tabindex="-1" data-admin--media--panel-target="panel">
  <%# The title row: the name takes the room that is left and is cut on ONE
      line, the whole name its `title` (it is in full in the fields below);
      what features register at `media.panel.header` stands 8px after it and
      never gives way. The title's line is 28px (`leading-7`), the line the
      slot's parts are centred on. `pr-10` keeps the row clear of the rail's
      Close, which stands over its right end. The title's inside is
      `PanelComponent.title_content`, which the autosave's answer draws again. %>
  <div class="flex items-start gap-2 pr-10">
    <h2 id="media-panel-title" class="min-w-0 flex-1 truncate text-h2 leading-7 text-ink"><%= self.class.title_content(asset, self) %></h2>
    <%= render Admin::Ui::SlotComponent.new(name: "media.panel.header", record: asset, viewer: viewer, **slot_context) %>
  </div>

  <span class="block overflow-hidden rounded-tile bg-sunken">
    <%= render Admin::Ui::LibraryImageComponent.new(asset: asset, min_width: 960, css_class: "w-full h-auto", loading: "eager") %>
  </span>

  <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-label text-meta">
    <% if filename %>
      <dt><%= t(".facts.file") %></dt><dd class="min-w-0 break-all text-right text-ink"><%= filename %></dd>
    <% end %>
    <dt><%= t(".facts.type") %></dt><dd class="text-right text-ink"><%= file_facts %></dd>
    <dt><%= t(".facts.uploaded") %></dt>
    <dd class="text-right text-ink">
      <% if uploader? %>
        <%= t(".facts.uploaded_by_html", name: render(Admin::Ui::UserNameComponent.new(user: uploader, user_id: asset.created_by_id)), date: uploaded_on) %>
      <% else %>
        <%= uploaded_on %>
      <% end %>
    </dd>
  </dl>
  <%# The original file, for whoever may open the panel (`media.upload`):
      CS Studio's own route, a plain download (no Turbo visit), never an
      Active Storage URL, which refuses a library original to everyone. %>
  <div class="flex flex-col gap-1">
    <%= link_to t(".download_original"), original_path, download: "", data: { turbo: false }, class: "self-start #{Admin::Ui::ButtonComponent.classes(:tertiary, size: :small)}" %>
    <p class="text-sm text-meta"><%= t(".download_hint") %></p>
  </div>

  <div class="flex items-center justify-between gap-3">
    <%= render Admin::Ui::LanguageTabsComponent.new(current: locale, missing: missing_locales, outdated: outdated_locales, url: language_url) %>
    <% if editable? %>
      <%= render Admin::Ui::SaveStatusComponent.new(id: status_id, state: :idle) %>
    <% end %>
  </div>

  <% if editable? %>
    <%= form_with url: form_url, method: :patch, class: "admin-translation-form flex flex-col", data: form_data do %>
      <%= render partial: "admin/shared/base_updated_at_field", locals: { id: base_updated_at_id, value: base_updated_at_value } %>

      <%= render Admin::Columns::PlainColumnComponent.new(
            name: "title", id: "media-title", html_name: "media_asset[title]",
            value: title_value, errors: title_errors
          ) %>

      <%= tag.div class: ("admin-media-alt-warn" if alt_warn?) do %>
        <%= render Admin::Columns::PlainColumnComponent.new(
              name: "alt", id: "media-alt", html_name: "media_asset[alt]",
              value: alt_value, original: original(:alt), errors: alt_errors, locale: locale, placeholder: alt_placeholder, **translation(:alt)
            ) %>
      <% end %>

      <%= render Admin::Columns::PlainColumnComponent.new(
            name: "caption", id: "media-caption", html_name: "media_asset[caption]",
            value: caption_value, original: original(:caption), errors: caption_errors, locale: locale, multiline: true,
            **translation(:caption)
          ) %>
    <% end %>
  <% else %>
    <%# View only: the same facts as plain text, no inputs, no autosave, no Move to trash. %>
    <dl class="flex flex-col gap-3 text-sm">
      <% view_only_facts.each do |label, text| %>
        <div>
          <dt class="<%= setup_label_class %> mb-1"><%= label %></dt>
          <dd class="whitespace-pre-line text-ink"><%= text.presence || "—" %></dd>
        </div>
      <% end %>
    </dl>
    <p class="text-sm text-dim"><%= t(".view_only.sentence") %></p>
  <% end %>

  <div>
    <h3 id="media-used-on" class="mb-2 scroll-mt-4 text-h3 text-ink"><%= t(".used_on.heading") %></h3>
    <% if unresolved_usage? %>
      <p class="text-sm text-meta"><%= t(".used_on.unresolved") %></p>
    <% elsif usage_state == :trash_only %>
      <p class="text-sm text-meta"><%= trash_only_message %></p>
    <% elsif usage_entries.empty? %>
      <p class="text-sm text-meta"><%= t(".used_on.none") %></p>
    <% else %>
      <%# Each row is its record's kind as its chip (hidden from a screen
          reader: the words name the kind), then the place's words. %>
      <ul class="flex flex-col gap-1.5 text-sm">
        <% usage_entries.each do |entry| %>
          <li class="flex items-start gap-2" data-used-on="<%= entry[:kind] %>">
            <%= render Admin::Ui::RecordChipComponent.new(kind: entry[:kind]) %>
            <% if entry[:path] %>
              <%= link_to entry[:label], entry[:path], class: "min-w-0 text-ink hover:underline", data: { turbo_frame: "_top" } %>
            <% else %>
              <span class="min-w-0 text-ink"><%= entry[:label] %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <%# What features register at `media.panel.sections`: outside the panel's
      autosave form above, since what stands here brings forms of its own. %>
  <%= render Admin::Ui::SlotComponent.new(name: "media.panel.sections", record: asset, viewer: viewer, **slot_context) %>

  <%# The shared action zone with no heading: the panel is a narrow column,
      so the cost line stands first and the trigger under it. While a kept
      place uses the image the trigger is disabled and the line says where;
      otherwise it says how long the trash keeps it. The confirm dialog is
      drawn after the zone, as every zone's dialogs are. %>
  <% if can_delete? %>
    <% help = move_to_trash_disabled? ? safe_join([ in_use_reason, " ", link_to(t(".trash.see_where"), "#media-used-on", class: "underline") ]) : retention_help %>
    <%= render Admin::Ui::ActionZoneComponent.new(label: t(".trash.confirm"), body: help, body_id: "media-trash-help", data: { zone: "trash" }) do |zone| %>
      <% zone.with_trigger do %>
        <% if move_to_trash_disabled? %>
          <%= render Admin::Ui::ButtonComponent.new(label: t(".trash.button"), variant: :danger_text, type: "button", disabled: true, aria: { describedby: "media-trash-help" }) %>
        <% else %>
          <%= render Admin::Ui::ButtonComponent.new(label: t(".trash.button"), variant: :danger_text, type: "button",
                data: dialog_trigger(delete_dialog_id), aria: { describedby: "media-trash-help" }) %>
        <% end %>
      <% end %>
    <% end %>
    <% unless move_to_trash_disabled? %>
      <%= render Admin::Ui::ConfirmDialogComponent.new(destructive: true, id: delete_dialog_id, title: t(".trash.title"), body: t(".trash.body")) do |dialog| %>
        <% dialog.with_confirm_action do %>
          <%# `_top`: a whole-page visit, so the sidebar's Trash badge
              updates and the Undo toast isn't relayed out of the frame. %>
          <%= form_with url: destroy_path, method: :delete, data: { turbo_frame: "_top" } do %>
            <%= render Admin::Ui::ButtonComponent.new(label: t(".trash.confirm"), variant: :danger, type: "submit") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</section>
