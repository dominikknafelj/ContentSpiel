<div class="admin-flash mb-4 flex flex-wrap items-center gap-3">
  <% if notice.present? %>
    <p role="status" class="text-ok-ink"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p role="alert" class="text-danger-ink"><%= alert %></p>
  <% end %>
  <% if action %>
    <%= button_to action[:label], action[:url], method: action_method, form: { class: "inline", data: { turbo_frame: "_top" } },
          class: setup_secondary_link_class %>
  <% end %>
</div>
