<%= tag.li id: dom_id, class: row_class, data: row_data do %>
  <span id="<%= state_id %>" class="col-start-1 row-start-1 sm:pt-px" data-part="state"><%= render state_chip %></span>
  <div class="col-span-2 row-start-2 min-w-0 sm:col-span-1 sm:col-start-2 sm:row-start-1">
    <%= link_to text, editor_path, id: text_id, class: "admin-row-link block #{text_class} no-underline", data: { part: "text", turbo_frame: "_top" },
          aria: { labelledby: labelled_by, describedby: verb_id } %>
    <%= tag.p "", class: "mt-0.5 text-small text-dim data-[tone=danger]:text-danger-ink", hidden: true, data: { part: "reason" } %>
  </div>
  <% if language_column? %>
    <span id="<%= language_id %>" class="col-span-2 row-start-3 text-small text-meta sm:col-span-1 sm:col-start-3 sm:row-start-1 sm:pt-0.5" data-part="language"><%= language_name %></span>
  <% end %>
  <span id="<%= verb_id %>" class="admin-row-verb col-start-2 row-start-1 text-right sm:row-start-1 sm:pt-0.5 <%= verb_column %>" aria-hidden="true"><%= t(".open") %></span>
  <%= tag.template row.source, data: { part: "source" } %>
<% end %>
