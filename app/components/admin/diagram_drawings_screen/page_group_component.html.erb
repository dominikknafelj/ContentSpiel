<%= tag.section class: "border-t border-line-strong first:border-t-0", aria: { labelledby: heading_id }, data: { page_id: page.id } do %>
  <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1 px-4 pt-3 pb-2" data-part="head">
    <h2 id="<%= heading_id %>" class="text-h3 font-semibold text-ink" data-part="title"><%= title %></h2>
    <% if path.present? %>
      <span class="text-xs text-meta" data-part="path"><%= path %></span>
    <% end %>
    <%= render Admin::Ui::ListStateComponent.new(record: page) %>
  </div>
  <ul>
    <% rows.each do |row| %>
      <%= render row_component(row) %>
    <% end %>
  </ul>
<% end %>
