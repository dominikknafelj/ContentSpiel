<%= tag.section class: "overflow-hidden rounded-card bg-surface shadow-1", hidden: true, aria: { labelledby: heading_id }, data: target("publish") do %>
  <div class="bg-rail px-4 py-3">
    <h2 id="<%= heading_id %>" class="text-base font-semibold text-ink"><%= words(:title) %></h2>
    <p class="mt-0.5 text-small text-dim"><%= words(:line) %></p>
  </div>
  <%= tag.ul data: target("publishList") %>
  <%= tag.template data: target("publishRow") do %>
    <li class="flex flex-wrap items-center justify-between gap-3 border-t border-line px-4 py-2.5">
      <span class="min-w-0"><span class="text-h3 font-semibold text-ink" data-part="title"></span> <span class="text-xs text-meta" data-part="path"></span> <span data-part="status"></span></span>
      <%= link_to review, "#", class: review_class, data: { part: "review", turbo_frame: "_top" } %>
    </li>
  <% end %>
  <%= chip_templates %>
<% end %>
