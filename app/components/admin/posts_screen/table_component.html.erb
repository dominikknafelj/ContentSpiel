<%# The table is a LIST whose rows are marked where someone else is working
    (`admin--presence--list`, which reads the markers again when presence
    changes and touches nothing else). `data-live-part`: the list holds a
    cable subscription, and says here whether it has been answered
    (`live/state`). %>
<%= tag.div class: "overflow-x-auto rounded-cs border border-line bg-surface",
      data: { controller: "admin--presence--list", live_part: "waiting", "admin--presence--list-kind-value": "post", "admin--presence--list-chunk-value": Presence::HERE_IDS,
              "admin--presence--list-url-value": helpers.admin_presence_here_path(kind: "post") } do %>
  <table class="admin-posts-table w-full min-w-[880px] border-collapse text-sm">
    <thead>
      <tr class="border-b border-line-strong text-left font-cs-mono text-label uppercase tracking-mono text-meta">
        <% if selectable? %>
          <th scope="col" class="w-10 py-2 pl-3.5 pr-2">
            <%= render Admin::Ui::CheckboxComponent.new(name: "select_all", id: "posts-select-all", aria: { label: "Select all posts on this page" },
                  data: { "admin--posts--bulk-select-target": "all", action: "change->admin--posts--bulk-select#toggleAll" }) %>
          </th>
        <% end %>
        <th scope="col" class="py-2 pr-4<%= " pl-3.5" unless selectable? %>">Title</th>
        <th scope="col" class="py-2 pr-4">Type</th>
        <th scope="col" class="py-2 pr-4">Status</th>
        <th scope="col" class="py-2 pr-4">Translations</th>
        <%# A 56px column whose header is the icon alone (notes handoff,
            "Posts-list count cell"): its name is there for a screen reader,
            and the title says what the numbers under it count. %>
        <th scope="col" class="w-14 py-2 pr-4" title="<%= t(".open_notes_title") %>">
          <%= helpers.render "admin/shared/icon", name: :message_square, size: "size-3" %><span class="sr-only"><%= t(".notes") %></span>
        </th>
        <%# The list is always newest-changed first: say so to a screen reader
            (`aria-sort`) and keep the arrow, which would be read out as "down
            arrow", out of the name. %>
        <th scope="col" aria-sort="descending" class="py-2 pr-4">Updated <span aria-hidden="true">↓</span></th>
        <th scope="col" class="w-11 py-2 pr-3"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% posts.each do |post| %>
        <tr id="<%= helpers.dom_id(post) %>" class="border-b border-line align-middle hover:bg-paper data-[selected]:bg-accent-tint">
          <% if selectable? %>
          <td class="py-2.5 pl-3.5 pr-2">
            <%= render Admin::Ui::CheckboxComponent.new(name: "select[]", value: post.id, id: "select-post-#{post.id}", aria: { label: "Select #{title_of(post)}" },
                  data: { "admin--posts--bulk-select-target": "row", action: "change->admin--posts--bulk-select#sync" }) %>
          </td>
          <% end %>
          <th scope="row" class="w-2/5 max-w-0 py-2.5 pr-4 text-left font-normal<%= " pl-3.5" unless selectable? %>">
            <%= link_to editor_path(post), class: "group/title flex min-w-0 flex-col gap-0.5 text-ink no-underline" do %>
              <%# The title's line is a row (presence handoff 27): the title, cut
                  with an ellipsis before anything after it is, then what
                  features register at `posts.row.title`, 6px after it and
                  INSIDE the link -- so nothing registered there may be
                  interactive. The hover underline is the title's and the
                  path's own, each asked of the link (`group/title`): on the
                  link itself it was drawn through everything in it, a
                  marker's count included, and a child of a flex row cannot
                  refuse its parent's underline. %>
              <span class="flex min-w-0 items-center gap-1.5">
                <span class="min-w-0 truncate font-medium group-hover/title:underline"><%= title_of(post) %></span>
                <%= render Admin::Ui::SlotComponent.new(name: "posts.row.title", record: post, viewer: Current.actor, loaded: title_loaded, locale: locale, url_options: url_options) %>
              </span>
              <span class="truncate font-cs-mono text-label text-meta group-hover/title:underline"><%= path_of(post) || "Not listed" %></span>
            <% end %>
          </th>
          <td class="py-2.5 pr-4 text-dim"><%= render Admin::Ui::ContentTypeDotComponent.new(content_type: post.content_type) %></td>
          <td class="py-2.5 pr-4">
            <span class="inline-flex flex-wrap items-center gap-1">
              <%= render Admin::Ui::StatusChipComponent.new(status: post.status, at: post.published_at, hide_live: true) %>
              <%= render Admin::Ui::UnpublishedChipComponent.new if post.unpublished_changes? %>
            </span>
          </td>
          <%# One chip per *target* language (translation helpers spec §4): the
              original is what the others are measured against, so it has no
              state of its own here. %>
          <td class="py-2.5 pr-4">
            <span class="inline-flex flex-wrap gap-1">
              <% translation_states.fetch(post).each do |code, state| %>
                <%= link_to editor_path(post, locale: code), class: "no-underline" do %>
                  <%= render Admin::Ui::TranslationChipComponent.new(state: state, locale: code) %>
                <% end %>
              <% end %>
            </span>
          </td>
          <td class="py-2.5 pr-4">
            <%= render Admin::Ui::SlotComponent.new(name: "posts.row.markers", record: post, viewer: Current.actor, loaded: loaded, locale: locale, url_options: url_options) %>
          </td>
          <td class="py-2.5 pr-4 text-meta"><%= render Admin::Ui::TimeAgoComponent.new(time: post.updated_at) %></td>
          <td class="py-2.5 pr-3 text-right">
            <%= render Admin::Ui::MenuComponent.new(label: "⋯", aria_label: "Actions for #{title_of(post)}", close_on_select: true) do |menu| %>
              <% menu.with_item { link_to "Open", editor_path(post) } %>
              <% if site_path(post) %>
                <% menu.with_item { link_to "View on site", site_path(post), target: "_blank", rel: "noopener" } %>
              <% end %>
              <% if can?("posts.delete", post) %>
                <%# Selects just this row and opens the bulk trash confirmation
                    (`admin--posts--bulk-select#only`): one path for trashing, with
                    its confirmation, its filters and its Undo. %>
                <% menu.with_item do %>
                  <%= tag.button "Move to trash…", type: "button", class: "text-danger-ink",
                        data: { action: "admin--posts--bulk-select#only admin--ui--dialog#open", "admin--posts--bulk-select-id-param": post.id,
                                "admin--posts--bulk-select-dialog-id-param": Admin::PostsScreen::BulkBarComponent::TRASH_DIALOG_ID,
                                "admin--ui--dialog-id-param": Admin::PostsScreen::BulkBarComponent::TRASH_DIALOG_ID } %>
                <% end %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= footer %>
<% end %>
