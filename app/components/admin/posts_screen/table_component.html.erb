<div class="overflow-x-auto rounded-cs border border-line bg-surface">
  <table class="admin-posts-table w-full min-w-[820px] border-collapse text-sm">
    <thead>
      <tr class="border-b border-line-strong text-left font-cs-mono text-label uppercase tracking-mono text-meta">
        <th class="w-10 py-2 pl-3.5 pr-2">
          <%= render Admin::CheckboxComponent.new(name: "select_all", id: "posts-select-all", aria: { label: "Select all posts on this page" },
                data: { "admin--bulk-select-target": "all", action: "change->admin--bulk-select#toggleAll" }) %>
        </th>
        <th class="py-2 pr-4">Title</th>
        <th class="py-2 pr-4">Type</th>
        <th class="py-2 pr-4">Status</th>
        <th class="py-2 pr-4">Translations</th>
        <th class="py-2 pr-4">Updated ↓</th>
        <th class="w-11 py-2 pr-3"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% posts.each do |post| %>
        <tr id="<%= helpers.dom_id(post) %>" class="border-b border-line align-middle hover:bg-paper data-[selected]:bg-accent-tint">
          <td class="py-2.5 pl-3.5 pr-2">
            <%= render Admin::CheckboxComponent.new(name: "select[]", value: post.id, id: "select-post-#{post.id}", aria: { label: "Select #{title_of(post)}" },
                  data: { "admin--bulk-select-target": "row", action: "change->admin--bulk-select#sync" }) %>
          </td>
          <td class="w-2/5 max-w-0 py-2.5 pr-4">
            <%= link_to editor_path(post), class: "flex min-w-0 flex-col gap-0.5 text-ink no-underline hover:underline" do %>
              <span class="truncate font-medium"><%= title_of(post) %></span>
              <span class="truncate font-cs-mono text-[11px] text-meta"><%= path_of(post) || "Not listed" %></span>
            <% end %>
          </td>
          <td class="py-2.5 pr-4 text-dim"><%= render Admin::ContentTypeDotComponent.new(content_type: post.content_type) %></td>
          <td class="py-2.5 pr-4"><%= render Admin::StatusChipComponent.new(status: post.status, at: post.published_at, hide_live: true) %></td>
          <%# One chip per *target* language (translation helpers spec §4): the
              original is what the others are measured against, so it has no
              state of its own here. %>
          <td class="py-2.5 pr-4">
            <span class="inline-flex flex-wrap gap-1">
              <% translation_states.fetch(post).each do |code, state| %>
                <%= link_to editor_path(post, locale: code), class: "no-underline" do %>
                  <%= render Admin::TranslationChipComponent.new(state: state, locale: code) %>
                <% end %>
              <% end %>
            </span>
          </td>
          <td class="py-2.5 pr-4 text-meta"><%= render Admin::TimeAgoComponent.new(time: post.updated_at) %></td>
          <td class="py-2.5 pr-3 text-right">
            <%= render Admin::MenuComponent.new(label: "⋯", aria_label: "Actions for #{title_of(post)}", close_on_select: true) do |menu| %>
              <% menu.with_item { link_to "Open", editor_path(post) } %>
              <% if site_path(post) %>
                <% menu.with_item { link_to "View on site", site_path(post), target: "_blank", rel: "noopener" } %>
              <% end %>
              <% if can?("posts.delete", post) %>
                <% menu.with_item do %>
                  <%= helpers.button_to "Move to trash", helpers.admin_post_path(post, **url_options), method: :delete,
                        form: { data: { turbo_frame: "_top" } }, class: "text-danger-ink" %>
                <% end %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= footer %>
</div>
