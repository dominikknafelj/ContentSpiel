<div hidden aria-live="polite" aria-atomic="true" data-admin--bulk-select-target="bar"
     class="mb-3 flex flex-wrap items-center justify-between gap-3 rounded-cs bg-accent-tint px-3 py-2 text-sm text-ink">
  <span><b class="font-semibold" data-admin--bulk-select-target="count">0</b> selected</span>
  <span class="flex flex-wrap items-center gap-2">
    <% if may_publish? %>
      <%= form_with url: helpers.admin_posts_bulk_path, method: :post, class: "contents", data: { turbo_frame: "_top" } do %>
        <%= hidden_field_tag :bulk_action, "publish", id: nil %>
        <% list_fields.each do |name, value| %>
          <%= hidden_field_tag name, value, id: nil %>
        <% end %>
        <span class="contents" data-admin--bulk-select-target="ids"></span>
        <%= render Admin::ButtonComponent.new(label: "Publish", variant: :secondary, type: "submit", size: :small) %>
      <% end %>
    <% end %>
    <% if may_trash? %>
      <%= render Admin::ButtonComponent.new(label: "Move to trash", variant: :danger_text, type: "button", size: :small, data: dialog_trigger(trash_dialog_id)) %>
    <% end %>
    <%= render Admin::ButtonComponent.new(label: "Clear", variant: :ghost, type: "button", size: :small, data: { action: "admin--bulk-select#clear" }) %>
  </span>
</div>

<% if may_trash? %>
  <%= render Admin::ConfirmDialogComponent.new(id: trash_dialog_id, title: "Move the selected posts to the trash?", destructive: true,
        body: "They disappear from the site and from every list. You can undo this right afterwards or restore them from the trash.") do |dialog| %>
    <% dialog.with_details do %>
      This moves <strong data-admin--bulk-select-target="confirmCount">0 posts</strong> to the trash.
    <% end %>
    <% dialog.with_confirm_action do %>
      <%= form_with url: helpers.admin_posts_bulk_path, method: :post, data: { turbo_frame: "_top" } do %>
        <%= hidden_field_tag :bulk_action, "trash", id: nil %>
        <% list_fields.each do |name, value| %>
          <%= hidden_field_tag name, value, id: nil %>
        <% end %>
        <span class="contents" data-admin--bulk-select-target="ids"></span>
        <%= render Admin::ButtonComponent.new(label: "Move to trash", variant: :danger, type: "submit") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
