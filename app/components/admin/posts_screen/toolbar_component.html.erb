<%= form_with(**form_options) do %>
  <div class="<%= bar_class %>">
    <% if hidden_locale? %>
      <%= hidden_field_tag :locale, locale, id: nil %>
    <% end %>

    <div>
      <%= label_tag :q, t(".search"), class: "sr-only" %>
      <%= text_field_tag :q, filters[:q], placeholder: t(".search"), autocomplete: "off", class: "block w-56 px-3 py-1.5 text-ink" %>
    </div>

    <%= render Admin::Ui::SegmentedComponent.new(mode: :radios, name: :scope, label: t(".show"), segments: scope_segments) %>

    <noscript><%= render Admin::Ui::ButtonComponent.new(label: t(".filter"), variant: :secondary, type: "submit") %></noscript>
    <% if active? %>
      <%= link_to t(".clear"), path, class: setup_secondary_link_class, data: { turbo_frame: "content", turbo_action: "replace" } %>
    <% end %>
  </div>

  <fieldset class="admin-list-rail__rail admin-filter-panel">
    <legend class="text-label text-meta"><%= t(".filters") %></legend>

    <div>
      <%= label_tag :type, t(".type"), class: "text-label text-meta" %>
      <%= select_tag :type, options_for_select(type_options, filters[:type]), include_blank: t(".all"), class: setup_select_class %>
    </div>

    <div>
      <%= label_tag :tag, t(".tag"), class: "text-label text-meta" %>
      <%= select_tag :tag, options_for_select(tag_options, filters[:tag]), include_blank: t(".any"), class: setup_select_class %>
    </div>

    <div>
      <%= label_tag :translation, t(".translation"), class: "text-label text-meta" %>
      <%= select_tag :translation, options_for_select(translation_options, filters[:translation]), include_blank: t(".any"), class: setup_select_class %>
    </div>
  </fieldset>
<% end %>
