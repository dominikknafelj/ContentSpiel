<header class="admin-record-header mb-6 flex flex-col gap-3 rounded-cs border border-line bg-surface p-4">
  <% if notice.present? %>
    <p role="status" class="text-sm text-ok-ink"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p role="alert" class="text-sm text-danger-ink"><%= alert %></p>
  <% end %>

  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h1 class="truncate text-h1 text-ink"><%= Locales.read(page, :title, locale: locale) %></h1>

      <% if public_path.present? %>
        <div class="mt-1 flex items-center gap-2 text-sm text-meta">
          <span class="truncate"><%= public_path %></span>
          <button type="button" data-controller="admin--clipboard" data-admin--clipboard-url-value="<%= public_url %>"
            data-action="click->admin--clipboard#copy" class="shrink-0 rounded-cs border border-line-strong px-2 py-0.5 hover:bg-sunken">Copy</button>
          <% if live? %>
            <%= link_to "View on site", public_url, target: "_blank", rel: "noopener", class: "shrink-0 underline hover:text-ink" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="flex shrink-0 items-center gap-3">
      <% unless editable? %>
        <%= render "admin/shared/view_only_badge" %>
      <% end %>
      <%= render Admin::LanguageTabsComponent.new(current: locale, missing: missing_locales, outdated: outdated_locales, url: language_url) %>
      <span data-status="<%= status %>">
        <%= render Admin::StatusChipComponent.new(status: status, at: scheduled_at) %>
      </span>
    </div>
  </div>

  <% if live? %>
    <p role="status" class="text-sm text-warn-ink">Live — changes appear on the site as you edit</p>
  <% end %>

  <%= render Admin::SaveStatusComponent.new(id: save_status_id, state: :idle) %>

  <%# Translate empty fields / Use all (translation helpers spec §6.4):
      only in a non-default language, for a viewer who may edit the page,
      with AI set up and `ai.translate`. It asks for the page's own fields
      and its blocks' alike -- whatever has a Translate button below. %>
  <%= render Admin::TranslationScreen::TranslateAllComponent.new(locale: locale, editable: editable?) %>

  <div class="flex flex-wrap items-center gap-2">
    <%= link_to "Preview", preview_path, target: "_blank", rel: "noopener", class: setup_secondary_link_class %>

    <%# The Activity link (design spec §5 "Audit log module", Task 9):
        opens the audit log filtered to this page -- visible only with
        `audit.view` (access-control design spec §5 "Everywhere"), the
        same permission `Admin::AuditEventsController` itself requires,
        so this link is never shown to someone who'd only get the 403
        page for following it. %>
    <% if can?("audit.view") %>
      <%= link_to "Activity", helpers.admin_audit_events_path(subject_type: "Page", subject_id: page.id, **url_options), class: setup_secondary_link_class %>
    <% end %>

    <%# `form: { data: { turbo_frame: "_top" } }` / `data: { turbo_frame:
        "_top" }` on every action below (final-fixes round, finding 1):
        each one redirects (`Admin::PagesController#redirect_after`/
        `#destroy`), and every one of these forms/buttons submits from
        inside the layout's own `<turbo-frame id="content">` -- left to its
        own default frame targeting, that redirect's response would only
        ever replace *this* frame, leaving the tree column (outside it,
        cs-studio spec §4.2's "re-rendered after structural changes") still
        showing whatever status dot/child-count it had before a publish,
        unpublish, schedule or delete. Navigating `_top` instead makes each
        of these an ordinary full-page visit, which re-renders the tree
        (via `content_for :tree`) for free, the same way loading the editor
        fresh already does. %>
    <% if can_publish? %>
      <%= button_to "Publish now", helpers.publish_admin_page_path(page, **url_options), method: :post,
            class: setup_primary_button_class, form: { data: { turbo_frame: "_top" } } %>
    <% end %>

    <% if can_unpublish? %>
      <%= button_to "Unpublish", helpers.unpublish_admin_page_path(page, **url_options), method: :post,
            class: setup_secondary_link_class, form: { data: { turbo_frame: "_top" } } %>
    <% end %>

    <% if may_publish? %>
      <details class="admin-record-header__schedule">
        <summary class="cursor-pointer <%= setup_secondary_link_class %>">Schedule…</summary>
        <%= form_with url: helpers.schedule_admin_page_path(page, **url_options), method: :post, class: "mt-2 flex items-center gap-2",
              data: { turbo_frame: "_top" } do %>
          <%= tag.input type: "datetime-local", name: "published_at", value: scheduled_at_input_value, class: setup_input_class %>
          <%= render Admin::ButtonComponent.new(label: "Schedule", variant: :secondary, type: "submit") %>
        <% end %>
      </details>
    <% end %>

    <%# No Move to trash at all without `pages.delete`; with it, disabled
        (with the reason) only for the homepage -- a page with subpages
        moves its whole branch along (trash spec §4.1). %>
    <% if may_delete? && can_delete? %>
      <%= render Admin::ButtonComponent.new(label: "Move to trash", variant: :danger, type: "button",
            onclick: "document.getElementById('#{delete_dialog_id}').showModal()") %>

      <%= render Admin::ConfirmDialogComponent.new(id: delete_dialog_id, title: "Move this page to the trash?", body: delete_dialog_body) do |dialog| %>
        <% dialog.with_confirm_action do %>
          <%= form_with url: helpers.admin_page_path(page, **url_options), method: :delete, data: { turbo_frame: "_top" } do %>
            <%= render Admin::ButtonComponent.new(label: "Move to trash", variant: :danger, type: "submit") %>
          <% end %>
        <% end %>
      <% end %>
    <% elsif may_delete? %>
      <%= render Admin::ButtonComponent.new(label: "Move to trash", variant: :danger, type: "button", disabled: true, title: delete_disabled_reason) %>
    <% end %>
  </div>
</header>
