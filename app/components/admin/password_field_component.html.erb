<div class="admin-password-field" data-controller="password-field" data-password-field-minimum-value="<%= User::MINIMUM_PASSWORD_LENGTH %>">
  <% if label_aside? %>
    <div class="flex items-baseline justify-between">
      <label for="<%= id %>" class="<%= setup_label_class %>"><%= label %></label>
      <%= label_aside %>
    </div>
  <% else %>
    <label for="<%= id %>" class="<%= setup_label_class %>"><%= label %></label>
  <% end %>

  <div class="relative">
    <%= tag.input(**input_attrs) %>
    <button type="button" aria-controls="<%= id %>" data-password-field-target="toggle" data-action="password-field#toggle"
            class="absolute inset-y-0 right-0 cursor-pointer px-3 text-xs font-medium text-accent hover:text-accent-hover">Show</button>
  </div>

  <% if meter %>
    <div class="mt-2 flex gap-1" aria-hidden="true">
      <% 4.times do %>
        <span data-password-field-target="bar" class="h-1 flex-1 rounded-cs bg-line-strong"></span>
      <% end %>
    </div>
    <p id="<%= hint_id %>" data-password-field-target="hint" aria-live="polite" class="mt-1 text-sm text-meta">Use at least <%= User::MINIMUM_PASSWORD_LENGTH %> characters.</p>
  <% end %>

  <% if errors.any? %>
    <div id="<%= errors_id %>" class="mt-1 text-sm text-danger-ink">
      <% errors.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>
</div>
