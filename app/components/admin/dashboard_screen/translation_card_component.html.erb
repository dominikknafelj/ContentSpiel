<%= render Admin::DashboardScreen::CardComponent.new(title: "Needs translation", id: "dashboard-needs-translation", empty: "Nothing to translate.", link: link, limit: nil) do |card| %>
  <% entries.each do |entry| %>
    <% card.with_row do %>
      <div class="flex min-w-0 flex-1 flex-col gap-1.5" data-locale="<%= entry.locale %>">
        <div class="flex items-baseline justify-between gap-3">
          <% if link %>
            <%= link_to entry.name, helpers.admin_translations_path(language: entry.locale), class: "font-semibold text-ink hover:underline", data: { turbo_frame: "_top" } %>
          <% else %>
            <span class="font-semibold text-ink"><%= entry.name %></span>
          <% end %>
          <span class="text-sm <%= entry.outdated.positive? ? "text-warn-ink" : "text-meta" %>"><%= counts(entry) %></span>
        </div>
        <div class="h-1 overflow-hidden rounded-full bg-line" role="progressbar" aria-label="<%= entry.name %> translated"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= percent(entry) %>">
          <div class="h-full rounded-full bg-ok <%= width_class(entry) %>"></div>
        </div>
        <% if entry.item %>
          <p class="truncate text-sm text-meta">Outdated: <%= link_to item_title(entry), item_path(entry), class: "text-ink hover:underline", data: { turbo_frame: "_top" } %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
