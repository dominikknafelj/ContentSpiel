<div class="mb-6 flex flex-col gap-3 rounded-cs border border-line bg-surface p-4">
  <% if errors.any? %>
    <p class="text-danger-ink" role="alert"><%= errors.to_sentence %></p>
  <% end %>
  <div class="flex flex-wrap items-end gap-3">
    <% if content_types.any? %>
      <%= form_with url: helpers.admin_dashboard_draft_path(**url_options), method: :post, class: "flex flex-1 flex-wrap items-end gap-3" do %>
        <div class="min-w-48 flex-1">
          <%= label_tag "dashboard_draft_title", "Title", class: setup_label_class %>
          <%= text_field_tag :title, title, id: "dashboard_draft_title", placeholder: "A new idea…", class: setup_input_class %>
        </div>
        <div>
          <%= label_tag "dashboard_draft_content_type", "Content type", class: setup_label_class %>
          <%= select_tag :content_type, options_for_select(content_types.map { |type| [ type.label, type.name ] }, content_type),
                id: "dashboard_draft_content_type", class: setup_select_class %>
        </div>
        <%= render Admin::ButtonComponent.new(label: "Create draft", variant: :primary, type: "submit") %>
      <% end %>
    <% end %>
    <% if new_page? || upload_image? %>
      <div class="flex flex-wrap items-center gap-3">
        <% if new_page? %>
          <%= link_to "New page", helpers.new_admin_page_path(**url_options), class: setup_secondary_link_class, data: { turbo_frame: "_top" } %>
        <% end %>
        <% if upload_image? %>
          <%= link_to "Upload image", helpers.admin_media_path(**url_options), class: setup_secondary_link_class, data: { turbo_frame: "_top" } %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
