<%= render Admin::Ui::ScheduledDateComponent.new(at: record.published_at) %>
<div class="min-w-0 flex-1">
  <%= link_to title, path, class: "block truncate font-semibold text-ink hover:underline", data: { turbo_frame: "_top" } %>
  <div class="flex flex-wrap items-center gap-x-2 text-sm text-meta">
    <time datetime="<%= record.published_at.iso8601 %>" title="<%= exact_time %>"><%= going_live_phrase %></time>
    <% if mine? %><span><%= t(".by_you") %></span><% end %>
  </div>
</div>
