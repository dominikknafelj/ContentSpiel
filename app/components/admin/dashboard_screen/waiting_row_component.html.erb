<%# A grid of `minmax(0, 1fr) auto`, to the edges of the panel's row (the
    negative margins), `hover:bg-paper`. Only the title and the review are
    links; the rest is spans the title's `::after` lies over. %>
<%= tag.div class: "admin-waiting-row -mx-4 -my-2.5 min-w-0 flex-1 px-4 py-[11px] hover:bg-paper", data: { waiting_row: kind } do %>
  <span class="flex min-w-0 flex-col gap-0.5">
    <%= link_to path, id: link_id, class: "admin-waiting-row__link truncate text-sm font-medium text-ink no-underline",
          aria: one_link_aria(link_id:, reason_ids:, verb: !review?), data: { turbo_frame: "_top" } do %><%= title %><% end %>
    <span class="flex min-w-0 items-center gap-1.5 text-xs text-meta">
      <span class="size-1.5 shrink-0 <%= marker_class %>" aria-hidden="true" data-type-marker="<%= post? ? "round" : "square" %>"></span>
      <span class="truncate"><%= type_name %><% if author? %> · <%= render Admin::NotesScreen::PersonNameComponent.new(user: thread.last_author, user_id: thread.last_author_id) %><% end %> · <%= render Admin::Ui::TimeAgoComponent.new(time: row.at) %></span>
    </span>
  </span>
  <span class="flex shrink-0 items-center gap-2">
    <% if thread? %>
      <%# `role="img"` and a label, like the page tree's: a bare "2" says
          nothing. Hidden, since the link's name reads it (`OneLink`). %>
      <%= tag.span id: count_id, role: "img", title: t(".open", count: thread.count), aria: { label: t(".open", count: thread.count), hidden: true },
            class: "admin-notes-marker admin-notes-marker--readonly", data: { has_notes: true } do %>
        <%= helpers.render "admin/shared/icon", name: :message_square, size: "size-3" %><%= thread.count %>
      <% end %>
    <% end %>
    <% if unpublished? %>
      <%= tag.span id: unpublished_id, class: "inline-flex", aria: { hidden: true } do %><%= render Admin::Ui::UnpublishedChipComponent.new %><% end %>
    <% end %>
    <% if review? %>
      <%= link_to t(".review"), review_path, class: "#{Admin::Ui::ButtonComponent.classes(:secondary, size: :small)} relative z-(--cs-z-raised)", data: { turbo_frame: "_top" } %>
    <% else %>
      <%= row_verb(verb) %>
    <% end %>
  </span>
<% end %>
