<%= render Admin::DashboardScreen::PanelComponent.new(kind: :information, title: title, line: t(".line"), id: "dashboard-needs-translation",
      empty: t(".empty"), link: link, limit: nil) do |panel| %>
  <% entries.each do |entry| %>
    <% panel.with_row do %>
      <div class="flex min-w-0 flex-1 flex-col gap-1.5" data-locale="<%= entry.locale %>">
        <div class="flex items-baseline justify-between gap-3">
          <% if link %>
            <%= link_to entry.name, helpers.admin_translations_path(language: entry.locale), class: "font-semibold text-ink hover:underline", data: { turbo_frame: "_top" } %>
          <% else %>
            <span class="font-semibold text-ink"><%= entry.name %></span>
          <% end %>
          <span class="text-sm <%= entry.outdated.positive? ? "text-warn-ink" : "text-meta" %>"><%= counts(entry) %></span>
        </div>
        <div class="h-1 overflow-hidden rounded-full bg-line" role="progressbar" aria-label="<%= t(".translated", language: entry.name) %>"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= percent(entry) %>">
          <div class="h-full rounded-full bg-ok <%= width_class(entry) %>"></div>
        </div>
        <% if entry.item %>
          <p class="truncate text-sm text-meta"><%= t(".outdated_item_html", link: link_to(item_title(entry), item_path(entry), class: "text-ink hover:underline", data: { turbo_frame: "_top" })) %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
