<div class="admin-column mb-4" data-field-name="<%= name %>">
  <label class="<%= setup_label_class %> mb-1" for="<%= id %>">Slug</label>

  <%= render Admin::Ui::PrefixInputComponent.new(name: html_name, id: id, value: value, prefix: prefix, errors: errors, **html) %>

  <% if help %>
    <p class="mt-1 text-xs text-meta"><%= help %></p>
  <% end %>

  <%= helpers.render "admin/shared/field_errors", id: errors_id, messages: errors %>
</div>
