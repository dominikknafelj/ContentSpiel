<div class="admin-column mb-4" data-field-name="<%= name %>">
  <p id="<%= label_id %>" class="<%= setup_label_class %> mb-1"><%= name.to_s.humanize %></p>

  <div class="<%= show_original? ? "grid gap-3 md:grid-cols-2" : "" %>">
    <%# `admin--rich-text` (tiptap spec §4.1) -- see the class comment for
        every `data-*` value below. `relative` anchors the controller's own
        popovers (link, internal link, image, YouTube) to this editor. %>
    <%= tag.div class: "admin-rich-text relative min-w-0",
          data: {
            controller: "admin--rich-text",
            action: "focusout->admin--rich-text#containFocus",
            "admin--rich-text-upload-url-value": upload_url,
            "admin--rich-text-link-targets-url-value": link_targets_url,
            "admin--rich-text-locale-value": editor_locale,
            "admin--rich-text-asset-urls-value": asset_urls_json,
            "admin--rich-text-link-titles-value": link_titles_json
          } do %>
      <%# The document JSON under `html_name` (e.g. `post[body]`) -- see the
          class comment. `html_name`, not `name`: a caller nesting this
          under a form object needs the param to arrive as
          `params[:post][:body]`, and `name` alone is only the label/
          `data-field-name`'s concern. %>
      <%= tag.input type: "hidden", name: html_name, id: "#{id}-json", value: json_value, data: { "admin--rich-text-target": "input" } %>

      <div role="toolbar" aria-label="<%= name.to_s.humanize %> formatting" aria-controls="<%= editor_id %>"
           class="flex flex-wrap gap-1 rounded-t-cs border border-b-0 border-line-strong bg-sunken p-1"
           data-action="mousedown->admin--rich-text#keepFocus">
        <% TOOLBAR.each do |action, label, text, toggle| %>
          <%= tag.button text, type: "button", title: label, "aria-label": label, "aria-pressed": (toggle ? "false" : nil),
                "aria-haspopup": (%w[link internalLink youtube].include?(action) ? "dialog" : nil),
                class: "admin-rich-text-button min-w-8 cursor-pointer rounded-cs px-2 py-1 font-cs-mono text-sm text-ink hover:bg-surface aria-pressed:bg-accent-tint aria-pressed:text-accent data-active:bg-accent-tint data-active:text-accent",
                data: { action: "admin--rich-text##{action}", "admin--rich-text-command": action } %>
        <% end %>
      </div>

      <%# No `name`: the chosen file goes to the upload endpoint by `fetch`,
          never with the autosave form's own `FormData`. %>
      <%= tag.input type: "file", accept: ACCEPT, class: "hidden", tabindex: -1, "aria-label": "Upload image",
            data: { "admin--rich-text-target": "file", action: "change->admin--rich-text#upload" } %>

      <%# The ProseMirror element Tiptap mounts inside this is the actual
          textbox; the controller gives *it* `aria-labelledby` from
          `data-labelledby`. %>
      <%= tag.div id: editor_id,
            class: "admin-rich-text-editor rounded-b-cs border border-line-strong bg-surface text-ink",
            data: { "admin--rich-text-target": "editor", labelledby: label_id } %>

      <p class="mt-1 text-sm text-danger-ink" role="alert" data-admin--rich-text-target="message"></p>
    <% end %>

    <% if show_original? %>
      <div class="rounded-cs border border-line bg-sunken px-3 py-2">
        <p class="<%= setup_label_class %> mb-1"><%= default_locale_name %></p>
        <div data-original-for="<%= name %>" class="admin-rich-text-content text-ink"><%= original_html %></div>
        <span data-translate-slot="<%= name %>"></span>
      </div>
    <% end %>
  </div>

  <div id="<%= errors_id %>" class="mt-1 text-sm text-danger-ink">
    <% errors.each do |message| %>
      <p><%= message %></p>
    <% end %>
  </div>
</div>
