<% translate = show_original? ? translate_button : nil %>
<%# The suggestion box is shared by Translate (an empty field) and Suggest update (an outdated one, in
    its reference card): one id, `SuggestionComponent.dom_id(input_id)`, so either lands under the input. %>
<% box_button = translate || (show_original? ? suggest_update_button : nil) %>
<div class="admin-column mb-4" data-field-name="<%= name %>">
  <%# One side of the translation pair (or the whole field): label, the editor and, under it,
      the Translate button and the suggestion box. The error slot stays a direct child of
      `.admin-column`, below the pair. %>
  <% field_side = capture do %>
    <p id="<%= label_id %>" class="<%= setup_label_class %> mb-1"><%= name.to_s.humanize %></p>
    <%# `admin--rich-text--editor` (tiptap spec §4.1) -- see the class comment for
        every `data-*` value below. `relative` anchors the controller's own
        Link popover (the image, YouTube and page dialogs live once in the layout) to this editor. %>
    <%= tag.div class: "admin-rich-text relative min-w-0",
          data: {
            controller: "admin--rich-text--editor",
            action: "focusout->admin--rich-text--editor#containFocus media-picker:picked->admin--rich-text--editor#picked translate:use->admin--rich-text--editor#applySuggestion rich-text-dialog:closed->admin--rich-text--editor#dialogClosed",
            "admin--rich-text--editor-link-targets-url-value": link_targets_url,
            "admin--rich-text--editor-locale-value": editor_locale,
            "admin--rich-text--editor-assets-value": assets_json,
            "admin--rich-text--editor-link-titles-value": link_titles_json
          } do %>
      <%# The document JSON under `html_name` (e.g. `post[body]`) -- see the
          class comment. `html_name`, not `name`: a caller nesting this
          under a form object needs the param to arrive as
          `params[:post][:body]`, and `name` alone is only the label/
          `data-field-name`'s concern. %>
      <%= tag.input type: "hidden", name: html_name, id: "#{id}-json", value: json_value, data: { "admin--rich-text--editor-target": "input" } %>

      <%# One row whenever it fits (design pass round 1, bug 5): grouped tools
          with separators, and an Insert menu for everything that inserts. No
          `overflow-x-auto` -- an overflow container would clip the menu's
          absolutely positioned panel -- so a column too narrow for the whole row
          (a translation field beside its original, in the page editor under the
          tree column) wraps whole groups onto a second row (`flex-wrap`, and
          groups are `shrink-0`) instead of spilling over its neighbour.
          Children stretch (`items-stretch`) so every one shares the
          row's top edge; the separators are full-height boxes whose rule is clipped to their
          content box (`bg-clip-content` + `py-1`), shorter than the row without a margin that
          would shift their top. Choosing a menu item closes the menu (`admin--ui--menu#close`) before the
          command runs; the command then moves focus (editor or popover). %>
      <% if editable? %>
      <div role="toolbar" aria-label="<%= name.to_s.humanize %> formatting" aria-controls="<%= editor_id %>"
           class="flex flex-wrap items-stretch gap-0.5 rounded-t-cs border border-b-0 border-line-strong bg-sunken p-1"
           data-action="mousedown->admin--rich-text--editor#keepFocus">
        <% toolbar_groups.each do |group| %>
          <div role="group" class="flex shrink-0 items-center gap-0.5">
            <% group.each do |action, label, text, toggle| %>
              <%= tool_button(action, label, text, toggle, extra_class: "min-w-7") %>
            <% end %>
          </div>
          <span role="separator" aria-orientation="vertical" class="mx-0.5 w-px shrink-0 bg-line bg-clip-content py-1"></span>
        <% end %>
        <%= render Admin::Ui::MenuComponent.new(label: "Insert ▾", align: :right,
              button_class: "inline-flex cursor-pointer whitespace-nowrap items-center gap-1 rounded-cs px-2 py-1 font-cs-mono text-sm text-ink hover:bg-surface") do |menu| %>
          <% insert_menu.each do |action, label, text, toggle| %>
            <% menu.with_item do %>
              <%= tool_button(action, label, text, toggle, extra_action: "click->admin--ui--menu#close") %>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <% end %>

      <%# The ProseMirror element Tiptap mounts inside this is the actual
          textbox; the controller gives *it* `aria-labelledby` from
          `data-labelledby`. %>
      <%= tag.div id: editor_id,
            class: "admin-rich-text-editor #{editable? ? "rounded-b-cs" : "rounded-cs"} border border-line-strong bg-surface text-ink",
            data: { "admin--rich-text--editor-target": "editor", labelledby: label_id } %>

      <p class="mt-1 text-sm text-danger-ink" role="alert" data-admin--rich-text--editor-target="message"></p>
    <% end %>
    <div data-translate-slot="<%= name %>"><% if translate %><%= render translate %><% end %></div>
    <%= render "admin/shared/translation_box", button: box_button %>
  <% end %>

  <% if show_original? %>
    <div class="admin-translation-pair">
      <div class="min-w-0"><%= field_side %></div>
      <%= render reference_card %>
    </div>
  <% else %>
    <%= field_side %>
  <% end %>

  <%= helpers.render "admin/shared/field_errors", id: errors_id, messages: errors %>
</div>
