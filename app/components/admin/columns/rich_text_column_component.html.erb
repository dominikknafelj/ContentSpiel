<div class="admin-column mb-4" data-field-name="<%= name %>">
  <label class="<%= setup_label_class %> mb-1" for="<%= markdown_id %>"><%= name.to_s.humanize %></label>

  <%# The document JSON under `html_name` (e.g. `post[body]`) -- see the
      class comment. `html_name`, not `name`: a caller nesting this under a
      form object needs the param to arrive as `params[:post][:body]`, and
      `name` alone is only the label/`data-field-name`'s concern. %>
  <%= tag.input type: "hidden", name: html_name, id: "#{id}-json", value: json_value %>

  <div class="<%= show_original? ? "grid gap-3 md:grid-cols-2" : "" %>">
    <div>
      <%= tag.textarea markdown_value, name: markdown_html_name, id: markdown_id, rows: 12,
            class: "#{setup_input_class} font-cs-mono text-sm", spellcheck: "true" %>
      <p class="mt-1 text-sm text-meta">
        Markdown. Embeds go on their own line: <code>::youtube{id="…"}</code>, <code>::image{asset="42" alt="…" caption="…"}</code>.
        Link to this site with <code>[text](cs:page/ID)</code> or <code>[text](cs:post/ID)</code>.
      </p>
    </div>

    <% if show_original? %>
      <div class="rounded-cs border border-line bg-sunken px-3 py-2">
        <p class="<%= setup_label_class %> mb-1"><%= default_locale_name %></p>
        <div data-original-for="<%= name %>" class="cs-prose text-ink"><%= original_html %></div>
        <span data-translate-slot="<%= name %>"></span>
      </div>
    <% end %>
  </div>

  <div id="<%= errors_id %>" class="mt-1 text-sm text-danger-ink">
    <% errors.each do |message| %>
      <p><%= message %></p>
    <% end %>
  </div>

  <%= render partial: "admin/shared/field_warnings", locals: { id: warnings_id, messages: [] } %>
</div>
