<div class="admin-column mb-4" data-field-name="<%= name %>">
  <label class="<%= setup_label_class %> mb-1" for="<%= id %>"><%= name.to_s.humanize %></label>

  <div class="<%= show_original? ? "grid gap-3 md:grid-cols-2" : "" %>">
    <div>
      <% if multiline %>
        <%= tag.textarea value, **html.merge(name: html_name, id: id, class: setup_input_class, rows: 3) %>
      <% else %>
        <%= tag.input(**html.merge(type: "text", name: html_name, id: id, value: value, class: setup_input_class)) %>
      <% end %>
    </div>

    <% if show_original? %>
      <div class="rounded-cs border border-line bg-sunken px-3 py-2">
        <p class="<%= setup_label_class %> mb-1"><%= default_locale_name %></p>
        <p data-original-for="<%= name %>" class="text-ink"><%= original %></p>
        <span data-translate-slot="<%= name %>"></span>
        <% if (note = outdated_note) %><%= render note %><% end %>
      </div>
    <% end %>
  </div>

  <div id="<%= errors_id %>" class="mt-1 text-sm text-danger-ink">
    <% errors.each do |message| %>
      <p><%= message %></p>
    <% end %>
  </div>
</div>
