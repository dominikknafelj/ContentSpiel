<div class="admin-column mb-4" data-field-name="<%= name %>">
  <label class="<%= setup_label_class %> mb-1" for="<%= id %>"><%= name.to_s.humanize %></label>

  <div class="<%= show_original? ? "grid gap-3 md:grid-cols-2" : "" %>">
    <div>
      <% if multiline %>
        <%= tag.textarea value, **html.merge(name: html_name, id: id, class: input_class, rows: 3, **invalid_attrs) %>
      <% else %>
        <%= tag.input(**html.merge(type: "text", name: html_name, id: id, value: value, class: input_class, **invalid_attrs)) %>
      <% end %>
    </div>

    <% if show_original? %>
      <div class="rounded-cs border border-line bg-sunken px-3 py-2">
        <p class="<%= setup_label_class %> mb-1"><%= default_locale_name %></p>
        <p data-original-for="<%= name %>" class="text-ink"><%= original %></p>
        <div data-translate-slot="<%= name %>"><% if (button = translate_button) %><%= render button %><% end %></div>
        <% if (note = outdated_note) %><%= render note %><% end %>
      </div>
    <% end %>
  </div>

  <%= helpers.render "admin/shared/field_errors", id: errors_id, messages: errors %>
</div>
