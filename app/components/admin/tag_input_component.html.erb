<div class="admin-column mb-4" data-field-name="tag_names"
     data-controller="admin--tag-input" data-admin--tag-input-names-value="<%= tag_names.to_json %>">
  <label class="<%= setup_label_class %> mb-1" for="<%= id %>">Tags</label>

  <%= tag.input type: "text", name: name, id: id, value: value, list: datalist_id, class: setup_input_class,
        placeholder: "comma, separated, tags",
        data: { "admin--tag-input-target": "input", action: "input->admin--tag-input#update" } %>

  <datalist id="<%= datalist_id %>" data-admin--tag-input-target="datalist"></datalist>

  <p class="mt-1 text-sm text-meta">Comma-separated. New tags are created when you save.</p>

  <%= helpers.render "admin/shared/field_errors", id: errors_id, messages: errors %>
</div>
