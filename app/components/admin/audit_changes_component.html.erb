<% if field_changes.empty? %>
  <p class="text-sm text-meta">No field changes recorded.</p>
<% else %>
  <table class="w-full border-collapse text-sm">
    <thead>
      <tr class="border-b border-line-strong text-left font-cs-mono text-label uppercase tracking-mono text-meta">
        <th class="py-2 pr-4">Field</th>
        <th class="py-2 pr-4">Old</th>
        <th class="py-2">New</th>
      </tr>
    </thead>
    <tbody>
      <% field_changes.each do |field, value| %>
        <tr class="border-b border-line align-top">
          <td class="py-2 pr-4 font-medium text-ink"><%= field %></td>
          <% if body_change?(value) %>
            <td class="py-2 text-meta" colspan="2">Changed</td>
          <% else %>
            <td class="py-2 pr-4 whitespace-pre-wrap break-words"><%= display(old_value(value)) %></td>
            <td class="py-2 whitespace-pre-wrap break-words"><%= display(new_value(value)) %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
