<%# The whole row is ONE link: the avatar, the sentence with where it is and the
    first words under it, then the end column, in a grid of `26px 1fr auto`,
    `hover:bg-paper`. The end column is three right-aligned lines: the time,
    "New" on an unread row only, and the verb. The verb is its widest line, so
    an unread row's lines keep the room of a read row's: in a 327px
    panel (390px window) they would otherwise be left about 100px and cut
    "Dana mentioned you". The verb stays the link's last child, so `a:hover >
    .admin-row-verb` still finds it. The negative margins take the link to the
    edges of the row that holds it -- the dashboard panel's and the full
    list's `<li>` alike (`px-4` on the list, `py-2.5` on the item) -- so the
    hover fills the row. Everything inside is a span: a link holds no block of
    its own. No `turbo_prefetch: false` as on a thread's row: this link is the
    EDITOR, whose GET reads nothing; the thread is fetched, and marked read,
    only by the drawer once the page is open. The focus ring is the browser's
    own, drawn inside the row (`-outline-offset-2`): nothing in a read row is
    accent at rest -- the verb is dim until the row is pointed at or focused
    -- and accent in a row means unread and for the viewer. %>
<%= link_to path, class: "-mx-4 -my-2.5 grid min-w-0 flex-1 grid-cols-[26px_1fr_auto] items-start gap-x-2.5 px-4 py-[11px] no-underline hover:bg-paper focus-visible:-outline-offset-2",
      data: { delivery: row.id, unread: (true if row.unread), turbo_frame: "_top" } do %>
  <% if somebody? %>
    <%= render Admin::Ui::ActorAvatarComponent.new(user: row.by, size: :md) %>
  <% else %>
    <span class="flex size-[26px] items-center justify-center rounded-full bg-sunken text-meta" aria-hidden="true"><%= helpers.render "admin/shared/icon", name: :message_square, size: "size-3.5" %></span>
  <% end %>
  <span class="row-span-3 flex min-w-0 flex-col gap-0.5">
    <span class="truncate text-sm <%= row.unread ? "text-ink" : "text-dim" %>" data-inbox-sentence><%= sentence %></span>
    <span class="flex min-w-0 items-center gap-1.5" data-inbox-where>
      <%= where_chip %>
      <span class="truncate text-[13px] text-dim"><%= where %></span>
    </span>
    <span class="truncate text-[13px] text-meta" data-inbox-excerpt><%= row.excerpt %></span>
  </span>
  <span class="col-start-3 justify-self-end text-count text-meta"><%= render Admin::Ui::TimeAgoComponent.new(time: row.at) %></span>
  <% if row.unread %>
    <span data-inbox-new class="col-start-3 inline-flex items-center gap-1 justify-self-end rounded-pill bg-accent-tint px-2 text-count font-semibold text-accent"><span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span><%= t(".new") %></span>
  <% end %>
  <span class="admin-row-verb col-start-3 justify-self-end"><%= t(".verb") %></span>
<% end %>
