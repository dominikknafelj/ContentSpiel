<%# `group/note`: the add-reaction chip shows on hover or focus of its message.
    `admin--notes--reactions` places and closes the emoji set, and opens it for
    the menu's "React". %>
<%= tag.div id: dom_id, class: "group/note flex flex-col gap-2 border-t border-line px-4 py-3.5",
      data: { note_message: message.id, controller: "admin--notes--reactions #{"admin--notes--unsaved" if own?}".strip, action: "click@window->admin--notes--reactions#outside",
              "admin--notes--unsaved-key-value": (key if own?), "admin--notes--unsaved-user-value": (viewer.id if own?) } do %>
  <div class="flex items-start gap-2">
    <p class="flex min-w-0 flex-1 flex-wrap items-center gap-x-2 gap-y-1">
      <%= render Admin::NotesScreen::AvatarComponent.new(user: author, user_id: message.author_id, viewer: viewer, size: :message) %>
      <strong class="text-[13px] font-semibold text-ink"><%= render Admin::NotesScreen::PersonNameComponent.new(user: author, user_id: message.author_id) %></strong>
      <span class="font-cs-mono text-label text-meta"><%= render Admin::Ui::TimeAgoComponent.new(time: message.created_at) %></span>
      <% if message.edited_at %><span class="text-[12px] text-meta">· <%= t(".edited") %></span><% end %>
      <%# "Unsaved edit" (the handoff's decisions 27 and 29): shown by the
          script while this tab holds a draft of an edit of this message that
          was left (`admin--notes--unsaved`) -- here in the meta line only,
          also while the edit form is open with the draft put back: the
          space above the field is for errors. %>
      <% if own? %><span hidden class="text-[12px] text-meta" data-note-unsaved data-admin--notes--unsaved-target="note">· <%= t(".unsaved") %></span><% end %>
      <%= content %>
    </p>
    <%# The way to the emoji set of a message nobody reacted to (decision 26). %>
    <%= render Admin::NotesScreen::ReactionsComponent.new(message: message, listing: listing, viewer: viewer, view: view, state: reactions_state, place: :meta) %>
    <% if deletable? || reactable? %>
      <%= render Admin::Ui::MenuComponent.new(label: "⋯", aria_label: t(".actions"), close_on_select: true) do |menu| %>
        <% if reactable? %>
          <% menu.with_item do %><%= tag.button t(".react"), type: "button", class: "cursor-pointer text-sm text-ink", data: { note_react: message.id, action: "admin--notes--reactions#open" } %><% end %>
        <% end %>
        <% if own? %>
          <% menu.with_item do %><%= link_to t(".edit"), thread_path(edit: message.id), class: "text-sm text-ink no-underline", data: { note_edit: message.id, **frame_link } %><% end %>
        <% end %>
        <% if deletable? %>
          <% menu.with_item do %><%= link_to t(".delete"), thread_path(delete: message.id), class: "text-sm text-danger-ink no-underline", data: { note_delete: message.id, **frame_link } %><% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <% if editing? %>
    <% text, names = editable %>
    <%# `files: false`: an edit changes the text; the files stay as they were written. %>
    <%= render Admin::NotesScreen::ComposerComponent.new(url: message_path, method: :patch, key: key, label: t(".edit_label"), submit: t(".save"),
          mentions_url: mentions_path, body: text, names: names, errors: edit_failure&.dig(:errors), edit: true, files: false, saved: (saved_text if edit_failure)) %>
    <%# Cancel gives the edit up: its draft goes with it. %>
    <p><%= link_to t(".cancel"), thread_path, class: cancel_class, data: { note_cancel: true, action: "admin--notes--unsaved#forget", **frame_link } %></p>
  <% else %>
    <%= render Admin::NotesScreen::BodyComponent.new(body: message.body, users: listing.users, viewer_id: viewer&.id) %>
  <% end %>
  <%# The message's files, under its text (and under the edit form while the
      text is being edited: they are not part of an edit). A direct child of
      the message, by this name: a live refresh keeps the very element
      (`admin--notes--live`), so a picture is not fetched again. %>
  <%= render Admin::NotesScreen::FilesComponent.new(message: message, listing: listing) %>
  <%# Below the text (handoff "Reaction chip"), for a message that has
      reactions; under the edit form while the message is being edited, and
      then disabled (the handoff's decision 23). Its forms are siblings of
      everything here, inside no other form. %>
  <%= render Admin::NotesScreen::ReactionsComponent.new(message: message, listing: listing, viewer: viewer, view: view, state: reactions_state) %>
  <% if bare_failure %>
    <ul role="alert" class="text-[12px] text-danger-ink"><% bare_failure[:errors].each do |error| %><li><%= error %></li><% end %></ul>
  <% end %>
  <% if confirming_delete? %>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] text-ink" data-note-delete-question>
      <span><%= t(".delete_question") %></span>
      <%= button_to t(".delete_confirm"), message_path, method: :delete,
            class: "#{Admin::Ui::ButtonComponent::SMALL_CLASS} #{Admin::Ui::ButtonComponent::VARIANT_CLASSES.fetch(:danger_text)}", form: { data: { turbo_frame: "notes" } } %>
      <%= link_to t(".cancel"), thread_path, class: cancel_class, data: { note_cancel: true, **frame_link } %>
    </div>
  <% end %>
<% end %>
