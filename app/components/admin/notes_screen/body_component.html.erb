<p class="whitespace-pre-wrap break-words text-pretty text-sm leading-[1.55] text-ink"><% parts.each do |part| %><% if part.kind == :mention %><span data-note-mention class="font-medium text-accent">@<%= render Admin::UserNameComponent.new(user: users[part.value], user_id: part.value) %></span><% elsif part.kind == :link %><%= link_to part.value, part.value, target: "_blank", rel: "noopener noreferrer", class: "text-accent underline hover:text-accent-hover" %><% else %><%= part.value %><% end %><% end %></p>
