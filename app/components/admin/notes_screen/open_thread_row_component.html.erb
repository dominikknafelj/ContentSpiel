<%# The whole row is ONE link (handoff "Open threads row"), grid `1fr auto`,
    `hover:bg-paper`; the negative margins take it to the edges of the card's
    row, as the inbox row's do. Left: the record's title over "type · last
    author · time", the type led by its 6px marker. Right: the neutral pill. %>
<%= link_to path, class: "-mx-4 -my-2.5 grid min-w-0 flex-1 grid-cols-[minmax(0,1fr)_auto] items-center gap-3 px-4 py-[11px] no-underline hover:bg-paper focus-visible:-outline-offset-2",
      data: { turbo_frame: "_top", open_thread_row: row.kind } do %>
  <span class="flex min-w-0 flex-col gap-0.5">
    <span class="truncate text-sm font-medium text-ink"><%= row.title || t(".untitled") %></span>
    <span class="flex min-w-0 items-center gap-1.5 text-xs text-meta">
      <%# Round in the type's category colour for a post, square in meta for a page and an image: a shape as well as a colour, and the word beside it. %>
      <span class="size-1.5 shrink-0 <%= marker_class %>" aria-hidden="true" data-type-marker="<%= post? ? "round" : "square" %>"></span>
      <span class="truncate"><%= type_name %><% if author? %> · <%= render Admin::NotesScreen::PersonNameComponent.new(user: row.last_author, user_id: row.last_author_id) %><% end %> · <%= render Admin::TimeAgoComponent.new(time: row.at) %></span>
    </span>
  </span>
  <%# `role="img"` and a label, like the page tree's: a bare "2" says nothing. %>
  <%= tag.span data: { has_notes: true }, role: "img", title: t(".open", count: row.count), aria: { label: t(".open", count: row.count) },
        class: "admin-notes-marker admin-notes-marker--readonly" do %>
    <%= helpers.render "admin/shared/icon", name: :message_square, size: "size-3" %><%= row.count %>
  <% end %>
<% end %>
