<%= link_to path, class: "-mx-2 flex min-w-0 items-center gap-2.5 rounded-tile px-2 py-1.5 no-underline transition-colors duration-120 ease-(--cs-ease) hover:bg-paper hover:[--admin-avatar-ground:var(--cs-paper)] motion-reduce:transition-none focus-visible:outline-offset-2", data: { turbo_frame: "_top", turbo_prefetch: false } do %>
  <%= record_chip(row.kind) %>
  <span class="flex min-w-0 flex-1 flex-col">
    <span class="truncate text-sm text-ink"><%= row.title || t(".untitled") %></span>
    <span class="truncate text-small text-meta"><%= line %><span class="sr-only">, <%= writers %></span></span>
  </span>
  <span class="flex flex-none items-center">
    <% row.authors.each_with_index do |author, index| %>
      <span class="flex flex-none <%= "-ml-1.5" if index.positive? %>"><%= render Admin::NotesScreen::AvatarComponent.new(user: author, user_id: author&.id, viewer: viewer, size: :message, ring: :ground) %></span>
    <% end %>
    <% if more? %>
      <span class="-ml-1.5 flex flex-none"><%= render Admin::Ui::AvatarComponent.new(initials: more_label, size: :sm, tone: :more, ring: :ground) %></span>
    <% end %>
  </span>
<% end %>
