<%# `admin-sidebar` (content-spiel.tailwind.css) is the sticky, viewport-high
    part; its grid cell (`.admin-shell__sidebar`) stretches the full page
    height and carries the same chrome background, so the column is not cut
    off at the viewport on a long page. %>
<nav aria-label="Modules" class="admin-sidebar flex w-60 flex-col border-r border-line bg-chrome">
  <div class="flex flex-col gap-3 p-3">
    <div class="flex flex-col gap-0.5 px-1">
      <span class="admin-wordmark font-cs text-xs font-bold uppercase tracking-wide text-ink">CONTENT·SPIEL</span>
      <span class="admin-site-name truncate text-[13px] text-dim"><%= site_name %></span>
    </div>
    <%= tag.button type: "button", data: { action: "admin--command-palette#open" },
          class: "flex w-full cursor-pointer items-center justify-between rounded-cs border border-line-strong px-2 py-1.5 text-left text-sm text-meta" do %>
      <span>Jump to…</span><span class="font-cs-mono text-label">⌘K</span>
    <% end %>
  </div>

  <div class="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto px-3 py-2">
    <% sections.each do |heading, entries| %>
      <section>
        <h2 class="px-2 pb-1 font-cs-mono text-label uppercase tracking-mono text-meta"><%= heading %></h2>
        <ul class="flex flex-col gap-0.5">
          <% entries.each do |entry| %>
            <li>
              <%= link_to module_path(entry), class: link_classes(entry), aria: { current: (current?(entry) ? "page" : nil) } do %>
                <%= helpers.render "admin/shared/icon", name: entry[:icon] %><span><%= entry[:label] %></span>
                <% if (badge = badge_for(entry)) %><span data-badge class="ml-auto font-cs-mono text-label text-meta"><%= badge %></span><% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>

  <div class="flex flex-col gap-3 border-t border-line p-3">
    <%= render Admin::ThemeSwitchComponent.new %>
    <%# The account block: who is signed in (`AccountIdentityComponent`, its
        own element so "Save name" can replace it by stream), then your own
        password (open to every user, access-control design spec §5) and
        sign out. %>
    <div class="admin-account flex min-w-0 flex-col gap-0.5">
      <%= render Admin::Shell::AccountIdentityComponent.new(user: user) %>
      <div class="mt-1 flex items-center gap-3 text-xs">
        <%= link_to "Change password", admin_account_password_path(**link_options), class: "text-dim underline-offset-2 hover:text-ink hover:underline" %>
        <%= button_to "Sign out", admin_sign_out_path, method: :delete, class: "cursor-pointer text-dim underline-offset-2 hover:text-ink hover:underline" %>
      </div>
    </div>
  </div>
</nav>
