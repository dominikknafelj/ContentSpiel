<%# `admin-sidebar` (content-spiel.tailwind.css) is the sticky, viewport-high
    part; its grid cell (`.admin-shell__sidebar`) stretches the full page
    height and carries the same chrome background, so the column is not cut
    off at the viewport on a long page. %>
<nav aria-label="Modules" class="admin-sidebar flex w-60 flex-col border-r border-line bg-chrome">
  <div class="flex flex-col gap-3 p-3">
    <div class="flex flex-col gap-0.5 px-1">
      <span class="admin-wordmark font-cs text-xs font-bold uppercase tracking-wide text-ink">CONTENT·SPIEL</span>
      <span class="admin-site-name truncate text-[13px] text-dim"><%= site_name %></span>
    </div>
    <%= tag.button type: "button", data: { action: "admin--command-palette#open" },
          class: "flex w-full cursor-pointer items-center justify-between rounded-cs border border-line-strong px-2 py-1.5 text-left text-sm text-meta" do %>
      <span>Jump to…</span><span class="font-cs-mono text-label">⌘K</span>
    <% end %>
  </div>

  <div class="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto px-3 py-2">
    <% sections.each do |heading, entries| %>
      <section>
        <h2 class="px-2 pb-1 font-cs-mono text-label uppercase tracking-mono text-meta"><%= heading %></h2>
        <ul class="flex flex-col gap-0.5">
          <% entries.each do |entry| %>
            <li>
              <%# System status runs its checks on every GET (a storage probe
                  writes and deletes a blob): never fetched just because the
                  pointer crossed the link. %>
              <%= link_to module_path(entry), class: link_classes(entry), aria: { current: (current?(entry) ? "page" : nil) },
                    data: { turbo_prefetch: (false if entry[:path] == :admin_system_status_path) } do %>
                <%= helpers.render "admin/shared/icon", name: entry[:icon] %><span><%= entry[:label] %></span>
                <% if badge?(entry) %>
                  <%= tag.span (badge_count(entry) if badge_count(entry).positive?), id: BADGE_IDS.fetch(entry[:path]), hidden: !badge_count(entry).positive?,
                        class: badge_class(entry), data: { badge: (true if badge_count(entry).positive?) } %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>

  <div class="flex flex-col gap-3 border-t border-line p-3">
    <%= render Admin::ThemeSwitchComponent.new %>
    <%# The account block: who is signed in (`AccountIdentityComponent`, its
        own element so the account screen's "Save" can replace it by stream, and a
        link to that screen), then "Your account" -- the same screen: the
        name, the notes settings and your own password (open to every user,
        access-control design spec §5; the notes handoff's decision 25) --
        and sign out. %>
    <div class="admin-account flex min-w-0 flex-col gap-0.5">
      <%= render Admin::Shell::AccountIdentityComponent.new(user: user, url_options: link_options) %>
      <div class="mt-1 flex items-center gap-3 text-xs">
        <%= link_to t("admin.accounts.title"), admin_account_password_path(**link_options), class: "text-dim underline-offset-2 hover:text-ink hover:underline" %>
        <%# A real navigation, not a Turbo submission (`data-turbo="false"`):
            signing out must end the DOCUMENT. Turbo would swap the body and
            keep every module's state -- the upload queue's failed tiles with
            their file names, focus notes -- for whoever signs in next on this
            tab. With unsaved work the browser's own "Leave site?" asks (the
            footer's and the write queue's `beforeunload` guards). %>
        <%= button_to "Sign out", admin_sign_out_path, method: :delete, form: { data: { turbo: false } }, class: "cursor-pointer text-dim underline-offset-2 hover:text-ink hover:underline" %>
      </div>
    </div>
  </div>
</nav>
