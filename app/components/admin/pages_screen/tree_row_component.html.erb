<%= render Admin::Ui::TreeItemComponent.new(id: dom_id, title: title, parent: parent?, folded: false, controls: children_list_id,
      selected: selected?, context_only: context_only?, root: root?, node_id: page.id, path: (public_path unless context_only?), data: row_data) do |item| %>
  <% if context_only? %>
    <%# Shown only as the path to a readable page below it: not a link, no
        status or actions; its tooltip says why. %>
    <% item.with_title do %><span title="<%= t(".context_only") %>"><%= title %></span><% end %>
  <% else %>
    <%# The homepage can't be moved (Pages::Move) -- no handle, nothing to
        grab; nor can a page the actor may not move, nor the top of a branch
        under a page they can't read. Every other row's handle is the only
        part of it that starts a drag (admin--pages--tree's `handle:` option),
        so the title link stays a plain, clickable link.

        A real button, so the keyboard reaches it: Space picks the row up,
        the arrows move it, Space drops it (`admin--pages--tree#key`). It
        stands in the step's gutter (the block's `__handle` rule): every
        movable row has that gutter, since only the homepage is not in a
        children list, and it has no handle. It rests transparent and keeps
        its room (the block's rule), so it stays in the Tab order and under
        the pointer: a press where it is starts the drag. It shows while the
        focus is in its row, which covers a row picked up with Space after a
        click on its handle, so what holds the row is in sight. %>
    <% if movable? %>
      <% item.with_handle do %>
        <button type="button" class="<%= ROW[:handle] %>"
                aria-label="<%= t(".move", title: title) %>" aria-describedby="tree-drag-help"
                data-action="keydown->admin--pages--tree#key focusout->admin--pages--tree#blur">⠿</button>
      <% end %>
    <% end %>

    <%# `data-tree-focus`: the control a find moves the focus to. %>
    <% item.with_title do %>
      <%= link_to title, path, id: link_id, data: { turbo_frame: "content", tree_focus: true },
            aria: (selected? ? { current: "page" } : {}) %>
    <% end %>

    <%# Draft, Scheduled or Live with changes, one small named mark; nothing,
        and no box for it, on a plain live page. %>
    <% if state_mark.render? %>
      <% item.with_state { render state_mark } %>
    <% end %>

    <%# Outdated and missing translated fields, summed over the target
        languages: plain text in a warn / meta ink, nothing at zero.
        `role="img"` + `aria-label` so a screen reader hears what the tooltip
        says; the glyph itself is decoration. Clipped at rest
        (`marker_class`), never `hidden` or `aria-hidden`. %>
    <% if translation_total(:outdated).positive? %>
      <% item.with_trailing do %>
        <%= tag.span "↻#{translation_total(:outdated)}", data: { translation_marker: "outdated" }, role: "img",
              title: translation_tooltip(:outdated), aria: { label: translation_label(:outdated) },
              class: [ "text-count text-warn-ink", marker_class ] %>
      <% end %>
    <% end %>
    <% if translation_total(:missing).positive? %>
      <% item.with_trailing do %>
        <%= tag.span "○#{translation_total(:missing)}", data: { translation_marker: "missing" }, role: "img",
              title: translation_tooltip(:missing), aria: { label: translation_label(:missing) },
              class: [ "text-count text-meta", marker_class ] %>
      <% end %>
    <% end %>

    <%# What features register at `tree.row.markers`, after the translation
        markers: each is told this row's page and its slice of what was
        loaded for the rows being drawn. %>
    <% item.with_trailing do %>
      <%= render Admin::Ui::SlotComponent.new(name: "tree.row.markers", record: page, viewer: Current.actor, loaded: loaded, locale: locale, url_options: url_options) %>
    <% end %>

    <%# `role="img"` and a label, like the translation markers: a bare "3"
        says nothing. Clipped at rest, never removed, so "3 subpages" is still
        heard; the block shows it with the row's other reveals. %>
    <% if parent? %>
      <% item.with_trailing do %>
        <%= tag.span child_count, data: { child_count: true }, role: "img", aria: { label: child_count_label },
              title: child_count_label, class: "#{ROW[:count]} #{ROW[:reveal]}" %>
      <% end %>
    <% end %>

    <%# The row's "+": the shared row draws it; this row names it and hands
        it the New page dialog's trigger, presetting Inside. %>
    <% if can_add_child? %>
      <% item.with_add(label: t(".add_child", title: title), href: new_child_path,
           data: dialog_trigger("new-page-dialog").merge("new-page-parent-id-param": page.id, turbo_frame: "content")) %>
    <% end %>
  <% end %>
<% end %>
