<div class="flex flex-col gap-2 rounded-cs border bg-surface px-4 py-3.5 <%= current? ? "border-accent" : "border-line" %>" data-locale="<%= locale %>">
  <div class="flex items-baseline justify-between gap-3">
    <% if url %>
      <%= link_to name, url, class: "font-semibold text-ink hover:underline #{"underline decoration-accent decoration-2 underline-offset-4" if current?}", aria: { label: link_label, current: (current? ? "true" : nil) }, data: { turbo_frame: "content", turbo_action: "replace" } %>
    <% else %>
      <span class="font-semibold text-ink"><%= name %></span>
    <% end %>
    <span class="font-cs-mono text-[11px] uppercase text-meta"><%= percent %>% done</span>
  </div>
  <div class="h-1 overflow-hidden rounded-full bg-line" role="progressbar" aria-label="<%= name %> translated"
       aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= percent %>">
    <div class="h-full rounded-full bg-ok <%= width_class %>"></div>
  </div>
  <span class="text-sm <%= outdated? ? "text-warn-ink" : "text-dim" %>"><%= counts %></span>
</div>
