<div class="rounded-cs border border-line bg-surface">
  <% if items.empty? %>
    <%= render Admin::EmptyStateComponent.new(title: "Everything is translated.") %>
  <% else %>
    <div class="overflow-x-auto" data-translation-matrix-scroll>
      <table class="w-full min-w-[40rem] border-collapse text-left">
        <thead>
          <tr class="border-b border-line-strong font-cs-mono text-[10px] uppercase tracking-mono text-meta">
            <th scope="col" class="sticky left-0 min-w-60 bg-surface px-4 py-2 font-normal">Item</th>
            <th scope="col" class="px-3 py-2 font-normal">Type</th>
            <% locales.each do |locale| %>
              <th scope="col" class="px-3 py-2 font-normal" data-locale="<%= locale %>"><%= language_name(locale) %></th>
            <% end %>
            <th scope="col" class="px-4 py-2 font-normal"><span class="sr-only">Action</span></th>
          </tr>
        </thead>
        <tbody>
          <% items.each do |item| %>
            <% focus = editor_path(item, focus_locale(item)) %>
            <tr id="<%= row_id(item) %>" class="border-b border-line last:border-b-0 hover:bg-paper">
              <th scope="row" class="sticky left-0 min-w-60 max-w-80 bg-surface px-4 py-2 text-left font-medium">
                <%= link_to title(item), focus, class: "block truncate text-ink hover:underline", data: { turbo_frame: "_top" } %>
              </th>
              <td class="px-3 py-2 text-sm text-dim"><%= type_label(item) %></td>
              <% locales.each do |locale| %>
                <td class="px-3 py-2">
                  <%= link_to editor_path(item, locale), aria: { label: cell_label(item, locale) }, class: "inline-flex", data: { turbo_frame: "_top" } do %>
                    <%= render Admin::TranslationChipComponent.new(state: item.states.fetch(locale), locale: locale) %>
                  <% end %>
                </td>
              <% end %>
              <td class="px-4 py-2 text-right text-sm whitespace-nowrap">
                <%# 50 of these share a visible phrase: the name starts with it (so the visible text is in the
                    name) and goes on with the item's, for a screen reader's link list. %>
                <%= link_to cta(item), focus, class: "text-accent hover:text-accent-hover", aria: { label: "#{cta(item).delete_suffix(" →")}: #{title(item)}" }, data: { turbo_frame: "_top" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
