<%# The whole card is the `admin--saving--pending-lock` scope: every
    `control` below is an instant action. It is also the order's field for
    the save bar: the order has no label of its own, so its changed mark is
    the dot after the card's heading (`data-save-bar-mark="heading"`), and
    each row's fallback is a field of its own inside it, keyed by its
    language (`data-save-bar-key`) so a move changes the order alone. %>
<%= render Admin::Ui::SettingsCardComponent.new(**Admin::SettingsScreen::SectionCard.options(SettingsSections.find("languages"), self), id: "settings-languages-card", intro: t(".intro"),
      data: { controller: "admin--saving--pending-lock admin--settings--sortable-rows",
              field_name: "language_order", save_bar_name: t(".names.language_order"), save_bar_mark: "heading", save_bar_changed: values.saved_change("language_order") }) do |card| %>
  <% card.with_heading_mark do %>
    <span class="admin-save-bar-heading-mark"><span class="sr-only"><%= t("admin.components.ui.save_bar.order_changed") %></span></span>
  <% end %>
  <% card.with_head_note do %>
    <p id="language-drag-help" class="sr-only"><%= t(".drag_help") %></p>
    <p class="mt-1 text-sm text-meta" data-admin--saving--pending-lock-target="hint" hidden></p>
  <% end %>

  <%# The order as ONE tracked value: see `admin--settings--sortable-rows`. %>
  <%= hidden_field_tag "site_setting[language_order]", order_value, id: "settings-language-order",
        data: { "save-bar-track": true, "admin--settings--sortable-rows-target": "order" } %>
  <p class="sr-only" aria-live="assertive" data-admin--settings--sortable-rows-target="announcer"></p>

  <ul class="m-0 list-none p-0" data-admin--settings--sortable-rows-target="list">
    <% rows.each do |row| %>
      <% code = row[:code] %>
      <li id="language-<%= code %>" class="admin-language-row flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-line bg-surface px-4 py-3"
          data-admin--settings--sortable-rows-target="row" data-code="<%= code %>" data-label="<%= name(code) %>">
        <button type="button" class="shrink-0 cursor-grab select-none rounded-cs px-0.5 text-meta hover:text-ink focus-visible:outline-2 focus-visible:outline-accent"
                aria-label="<%= t(".move", language: name(code)) %>" aria-describedby="language-drag-help"
                data-admin--settings--sortable-rows-target="handle"
                data-action="keydown->admin--settings--sortable-rows#key focusout->admin--settings--sortable-rows#blur">⠿</button>
        <%# Row inputs, in row order: the code first, then the fallback (the
            default's select is disabled and so not posted). %>
        <%= hidden_field_tag "site_setting[languages][][code]", code, id: nil %>

        <div class="min-w-[9rem] flex-1">
          <span class="font-semibold text-ink"><%= name(code) %></span>
          <span class="ml-1.5 text-small text-meta"><%= path(code) %></span>
        </div>

        <%# The default: a tag on the row that is it, a button on every other
            (an instant action behind its dialog, not a field). They share a
            column width so the rows line up. %>
        <div class="flex w-28 justify-start">
          <% if default?(code) %>
            <%= render Admin::Ui::BadgeComponent.new(label: t(".default"), data: { default_tag: true }) %>
          <% else %>
            <%= render Admin::Ui::ButtonComponent.new(label: t(".make_default"), variant: :secondary, size: :small, aria: { label: t(".make_default_label", language: name(code)) },
                  data: dialog_trigger(self.class.default_dialog_id(code)).merge("admin--saving--pending-lock-target": "control")) %>
          <% end %>
        </div>

        <%= tag.div class: "inline-flex items-center gap-2 text-sm text-ink",
              data: { field_name: "languages.#{code}.fallback", save_bar_name: fallback_name(code), save_bar_changed: values.saved_change("languages.#{code}.fallback") } do %>
          <label for="language-<%= code %>-fallback"><%= t(".falls_back_to") %><span class="sr-only"> <%= t(".falls_back_for", language: name(code)) %></span></label>
          <%= select_tag "site_setting[languages][][fallback]", options_for_select(fallback_options(code), (default?(code) ? "" : row[:fallback])),
                id: "language-#{code}-fallback", disabled: default?(code), class: "#{setup_select_class} !mt-0 !w-auto",
                data: { save_bar_key: "languages.#{code}.fallback" } %>
        <% end %>

        <%# The default can't be turned off. Its row keeps the button's place
            with the button itself, unseen and inert, in the same variant,
            rather than a guessed width: a spacer that is a few pixels off
            shifts the default's tag and select out of line with the rows below. %>
        <% if default?(code) %>
          <span class="invisible" aria-hidden="true" data-turn-off-spacer>
            <%= render Admin::Ui::ButtonComponent.new(label: t(".turn_off"), variant: :danger_text, size: :small, disabled: true, tabindex: -1) %>
          </span>
        <% else %>
          <%= render Admin::Ui::ButtonComponent.new(label: t(".turn_off"), variant: :danger_text, size: :small, aria: { label: t(".turn_off_label", language: name(code)) },
                data: dialog_trigger(self.class.off_dialog_id(code)).merge("admin--saving--pending-lock-target": "control")) %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <%# With every offered language already on there is nothing to add: a
      sentence, not an empty select beside a button that can only fail. %>
  <% if addable_options.any? %>
    <div class="flex flex-wrap items-center gap-3 p-4">
      <label for="language-add-code" class="text-sm text-ink"><%= t(".add_label") %></label>
      <%= select_tag "code", options_for_select(addable_options), id: "language-add-code", form: ADD_FORM,
            class: "#{setup_select_class} !mt-0 !w-auto", data: { "admin--saving--pending-lock-target": "control" } %>
      <%= render Admin::Ui::ButtonComponent.new(label: t(".add"), variant: :secondary, type: "submit", form: ADD_FORM,
            data: { "admin--saving--pending-lock-target": "control" }) %>
    </div>
  <% else %>
    <p class="p-4 text-sm text-meta"><%= t(".all_on") %></p>
  <% end %>
<% end %>
