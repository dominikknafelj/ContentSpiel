<%= render Admin::Ui::SettingsCardComponent.new(**Admin::SettingsScreen::SectionCard.options(SettingsSections.find("forms"), self), id: "settings-forms-card") do %>
  <div class="admin-column p-4" data-field-name="form_keep_days" <%= tag.attributes(data: { save_bar_changed: values.saved_change("form_keep_days") }) %>>
    <div class="flex flex-wrap items-center gap-2 text-ink">
      <label for="<%= field_id %>"><%= t(".keep_label") %></label>
      <%= number_field_tag "site_setting[form_keep_days]", values.form_keep_days, id: field_id, min: range.min, max: range.max, step: 1,
            class: "#{setup_input_class} !mt-0 !w-20", aria: { describedby: "#{field_id}-help #{errors_id}" } %>
      <span><%= t(".days") %></span>
    </div>
    <p id="<%= field_id %>-help" class="mt-1.5 text-sm text-meta"><%= t(".help") %></p>
    <%= helpers.render "admin/shared/field_errors", id: errors_id, messages: errors %>
  </div>
<% end %>
