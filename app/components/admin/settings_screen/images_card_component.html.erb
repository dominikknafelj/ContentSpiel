<%= render Admin::Ui::SettingsCardComponent.new(**Admin::SettingsScreen::SectionCard.options(SettingsSections.find("images"), self), id: "settings-images-card", intro: t(".intro"),
      data: { controller: "admin--saving--pending-lock" }) do %>

  <div class="flex flex-col gap-4 p-4">
    <div class="admin-column" data-field-name="image_format" <%= tag.attributes(data: { save_bar_changed: values.saved_change("image_format") }) %>>
      <%= render Admin::Ui::SegmentedComponent.new(mode: :radios, name: "site_setting[image_format]", label: t(".format"), legend: :visible,
            id: input_id(:image_format), describedby: "#{input_id(:image_format)}-help", segments: format_segments) %>
      <p id="<%= input_id(:image_format) %>-help" class="mt-1.5 text-sm text-meta"><%= t(".format_help") %></p>
      <% if avif_available? %>
        <p class="mt-1 text-sm text-meta" data-images-avif-note><%= t(".avif_note") %></p>
      <% else %>
        <p class="mt-1 text-sm text-meta" data-images-avif-unavailable><%= t(".avif_unavailable") %></p>
      <% end %>
      <%= helpers.render "admin/shared/field_errors", id: "#{input_id(:image_format)}-errors", messages: field_errors(:image_format) %>
    </div>

    <div class="grid gap-3.5 sm:grid-cols-2">
      <% %i[image_quality_webp image_quality_avif].each do |name| %>
        <div class="admin-column" data-field-name="<%= name %>" <%= tag.attributes(data: { save_bar_changed: values.saved_change(name) }) %>>
          <%= label_tag input_id(name), t(".#{name}"), class: setup_label_class %>
          <%= number_field_tag "site_setting[#{name}]", value(name), id: input_id(name), min: quality_range.min, max: quality_range.max, step: 1,
                class: setup_input_class, aria: { describedby: "#{input_id(name)}-errors" } %>
          <%= helpers.render "admin/shared/field_errors", id: "#{input_id(name)}-errors", messages: field_errors(name) %>
        </div>
      <% end %>
    </div>

    <div class="admin-column" data-field-name="image_widths" <%= tag.attributes(data: { save_bar_changed: values.saved_change("image_widths") }) %>>
      <%= label_tag input_id(:image_widths), t(".widths"), class: setup_label_class %>
      <%= text_field_tag "site_setting[image_widths]", value(:image_widths), id: input_id(:image_widths), inputmode: "numeric", autocomplete: "off", spellcheck: false,
            placeholder: t(".widths_placeholder"), class: setup_input_class, aria: { describedby: "#{input_id(:image_widths)}-help #{input_id(:image_widths)}-errors" } %>
      <p id="<%= input_id(:image_widths) %>-help" class="mt-1.5 text-sm text-meta">
        <%= t(".widths_help", count_min: width_count.min, count_max: width_count.max, min: width_range.min, max: width_range.max) %>
      </p>
      <%= helpers.render "admin/shared/field_errors", id: "#{input_id(:image_widths)}-errors", messages: field_errors(:image_widths) %>
    </div>

    <div class="admin-column" data-field-name="image_max_upload_mb" <%= tag.attributes(data: { save_bar_changed: values.saved_change("image_max_upload_mb") }) %>>
      <div class="flex flex-wrap items-center gap-2 text-ink">
        <label for="<%= input_id(:image_max_upload_mb) %>"><%= t(".max_upload") %></label>
        <%= number_field_tag "site_setting[image_max_upload_mb]", value(:image_max_upload_mb), id: input_id(:image_max_upload_mb),
              min: upload_range.min, max: upload_range.max, step: 1, class: "#{setup_input_class} !mt-0 !w-18",
              aria: { describedby: "#{input_id(:image_max_upload_mb)}-errors" } %>
        <span><%= t(".mb") %></span>
      </div>
      <%= helpers.render "admin/shared/field_errors", id: "#{input_id(:image_max_upload_mb)}-errors", messages: field_errors(:image_max_upload_mb) %>
    </div>

    <div id="settings-images-progress" class="flex flex-col gap-2 border-t border-line pt-4">
      <% if total.zero? %>
        <p class="text-sm text-ink" data-images-progress><%= t(".no_images") %></p>
      <% elsif other_settings.positive? %>
        <p class="text-sm text-ink" data-images-progress><%= t(".progress", count: other_settings) %></p>
      <% end %>
      <% if failed.positive? %>
        <p class="text-sm text-danger-ink" data-images-failed>
          <% if status_link? %>
            <%= link_to t(".failed", count: failed), status_path, class: "underline hover:no-underline" %>
          <% else %>
            <%= t(".failed", count: failed) %>
          <% end %>
        </p>
      <% end %>
      <p class="text-sm text-meta"><%= t(".regenerate_help") %></p>
      <div>
        <%# Outside the form's Save: a button of its own that opens the dialog (rendered after the form, which holds the POST). %>
        <%= render Admin::Ui::ButtonComponent.new(label: t(".regenerate"), variant: :secondary, data: dialog_trigger(DIALOG).merge("admin--saving--pending-lock-target": "control")) %>
      </div>
      <p class="text-sm text-meta" data-admin--saving--pending-lock-target="hint" hidden></p>
    </div>
  </div>
<% end %>
