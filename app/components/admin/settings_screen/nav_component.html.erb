<nav aria-label="<%= t(".label") %>" class="admin-settings-nav flex flex-col gap-0.5" data-controller="admin--settings--nav" data-action="turbo:before-cache@document->admin--settings--nav#reset">
  <% sections.each do |section| %>
    <%= tag.a href: "##{section.id}", class: "flex items-center gap-2 rounded-cs px-2 py-1.5 text-sm text-dim hover:bg-sunken hover:text-ink", data: { "admin--settings--nav-target": "link" } do %><%= render Admin::Ui::IconChipComponent.new(icon: section.icon, family: section.family, size: :small) %><%= word(section) %><% end %>
  <% end %>
</nav>
