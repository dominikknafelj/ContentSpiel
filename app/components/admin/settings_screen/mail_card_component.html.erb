<%= render Admin::SettingsScreen::CardComponent.new(section: SettingsSections.find("mail"), id: "settings-mail-card", intro: t(".intro"),
      data: { controller: "admin--settings--mail mail-port admin--saving--pending-lock", messages: messages_data("components.settings_screen.mail_login.hold") }) do |card| %>
  <% card.with_head_end do %>
    <%= render Admin::SettingsScreen::MailStateComponent.new(mail_settings: mail_settings) %>
  <% end %>

  <div class="flex flex-col gap-4 p-4">
    <% if all_from_host? %>
      <p class="text-sm text-ink"><%= t(".all_from_host") %></p>
    <% end %>

    <%= render fields do |mail_fields| %>
      <% mail_fields.with_login do %>
        <%= render Admin::SettingsScreen::MailLoginComponent.new(site_setting: site_setting, mail_settings: mail_settings) %>
      <% end %>
    <% end %>
  </div>

  <%= render Admin::SettingsScreen::MailTestResultComponent.new(address: address) %>
<% end %>
