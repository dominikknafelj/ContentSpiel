<%= form_with url: admin_settings_languages_path, method: :post, id: add_form, html: { class: "hidden" } do end %>

<% others.each do |code| %>
  <%= render Admin::Ui::ConfirmDialogComponent.new(id: default_dialog_id(code), title: t(".default_dialog.title", language: name(code)),
        body: t(".default_dialog.body", language: name(code), default_language: name(default_code), default_code: default_code)) do |dialog| %>
    <% dialog.with_details do %>
      <p class="rounded-cs border border-warn bg-warn-tint px-3 py-2 text-sm text-ink"><%= t(".default_dialog.details", language: name(code), items: items_phrase) %></p>
    <% end %>
    <% dialog.with_confirm_action do %>
      <%= form_with url: admin_settings_default_language_path(code), method: :patch do %>
        <%= render Admin::Ui::ButtonComponent.new(label: t(".default_dialog.confirm"), variant: :primary, type: "submit") %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Admin::Ui::ConfirmDialogComponent.new(id: off_dialog_id(code), title: t(".off_dialog.title", language: name(code)),
        body: t(".off_dialog.body", language: name(code), code: code)) do |dialog| %>
    <% dialog.with_confirm_action do %>
      <%= form_with url: admin_settings_language_path(code), method: :delete do %>
        <%= render Admin::Ui::ButtonComponent.new(label: t(".off_dialog.confirm", language: name(code)), variant: :primary, type: "submit") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
