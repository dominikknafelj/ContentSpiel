<%= render Admin::SettingsScreen::CardComponent.new(section: SettingsSections.find("site"), id: "settings-site-card",
      data: { controller: "admin--settings--tabs", action: "click@document->admin--settings--tabs#reveal", "admin--settings--tabs-current-value": locale }) do |card| %>
  <% if codes.size > 1 %>
    <% card.with_head_end do %>
      <%= render Admin::Ui::LanguageTabsComponent.new(current: locale, missing: switcher_locales[:missing], outdated: switcher_locales[:outdated],
            mode: :buttons, button_data: method(:tabs_data), panel_id: method(:panel_id)) %>
    <% end %>
  <% end %>
  <%# Where Save (or a refused one) comes back to; `admin--settings--tabs` keeps it on the visible tab. %>
  <%= hidden_field_tag :locale, locale, id: "settings-locale", data: { "admin--settings--tabs-target": "locale" } %>

  <%# `.admin-translation-form` is the container the reference card's
      two-column pair keys its breakpoint on. %>
  <div class="admin-translation-form flex flex-col gap-5 p-4">
    <% codes.each do |code| %>
      <%= tag.div id: panel_id(code), role: ("tabpanel" if codes.size > 1), hidden: !current?(code), class: "flex flex-col gap-4",
            aria: ({ labelledby: "language-tab-#{code}" } if codes.size > 1),
            data: { language_panel: code, "admin--settings--tabs-target": "panel" } do %>
        <%# Suggest translations for N empty fields -- this language's. %>
        <%= render Admin::TranslationScreen::TranslateAllComponent.new(record: site_setting, locale: code, editable: true) %>

        <%= render Admin::Columns::PlainColumnComponent.new(
              name: "title", label: t(".title_label"), id: field_id(code, "title"), html_name: html_name(code, "title"),
              value: values.text(code, :title), original: original(code, :title), locale: code,
              errors: (default?(code) ? errors_for(:title) : []), **translation(code, :title),
              field_name: "title.#{code}", field_changed: values.saved_change("title.#{code}"), data: { save_bar_name: field_name_words(code, :title) }
            ) %>
        <%= render Admin::Columns::PlainColumnComponent.new(
              name: "tagline", label: t(".tagline_label"), id: field_id(code, "tagline"), html_name: html_name(code, "tagline"),
              value: values.text(code, :tagline), original: original(code, :tagline), locale: code,
              errors: (default?(code) ? errors_for(:tagline) : []), **translation(code, :tagline),
              field_name: "tagline.#{code}", field_changed: values.saved_change("tagline.#{code}"), data: { save_bar_name: field_name_words(code, :tagline) }
            ) %>
      <% end %>
    <% end %>

    <%# Logo: the stored one, if any, the shared drop zone, and an
        explicit remove box -- a blank file input never detaches it. %>
    <%= tag.div class: "admin-column", data: { field_name: "logo", save_bar_name: t(".names.logo"), save_bar_changed: values.saved_change("logo") } do %>
      <p class="<%= setup_label_class %> mb-1" id="settings-logo-label"><%= t(".logo") %></p>
      <div class="flex flex-wrap items-start gap-3.5">
        <% logo = values.logo %>
        <% if logo.attached? %>
          <%= image_tag logo, alt: t(".current_logo"), class: "size-11 shrink-0 rounded-cs border border-line bg-sunken object-contain" %>
        <% end %>
        <div class="min-w-0 flex-1">
          <%= render Admin::Ui::FileDropComponent.new(name: "site_setting[logo]", id: "settings-logo", accept: "image/*", label: t(".logo_file"),
                hint: t(".logo_hint")) %>
          <% if logo.attached? %>
            <label class="mt-2 inline-flex items-center gap-2 text-sm text-meta">
              <%= render Admin::Ui::CheckboxComponent.new(name: "site_setting[remove_logo]", value: "1", id: "settings-remove_logo", checked: values.remove_logo?) %>
              <%= t(".remove_logo") %>
            </label>
          <% end %>
        </div>
      </div>
      <%= helpers.render "admin/shared/field_errors", id: "settings-logo-errors", messages: errors_for(:logo) %>
    <% end %>

    <%= tag.div class: "admin-column max-w-sm", data: { field_name: "time_zone", save_bar_changed: values.saved_change("time_zone") } do %>
      <%= label_tag "settings-time_zone", t(".time_zone"), class: setup_label_class %>
      <%= select_tag "site_setting[time_zone]", options_for_select(time_zone_options, values.time_zone), id: "settings-time_zone",
            class: setup_select_class, aria: { describedby: "settings-time_zone-help" } %>
      <p id="settings-time_zone-help" class="mt-1 text-xs text-meta"><%= t(".time_zone_help") %></p>
      <%= helpers.render "admin/shared/field_errors", id: "settings-time_zone-errors", messages: errors_for(:time_zone) %>
    <% end %>

    <%# A list, so its changed mark is the dot after the legend, never an edge
        on its rows' fields (`data-save-bar-mark="dot"`). %>
    <%= tag.fieldset class: "admin-column", id: "settings-social-links",
          data: { field_name: "social_links", save_bar_name: t(".names.social_links"), save_bar_mark: "dot", save_bar_changed: values.saved_change("social_links"),
                  controller: "admin--settings--repeat-rows", "admin--settings--repeat-rows-next-value": values.social_rows.size } do %>
      <legend class="<%= setup_label_class %> mb-1"><%= t(".social_links") %></legend>
      <%# The form says it carries the links, so no rows means none; a client
          that posts nothing leaves them. %>
      <%= hidden_field_tag "site_setting[social_links_present]", "1", id: nil %>
      <div class="flex flex-col gap-2" data-admin--settings--repeat-rows-target="list">
        <% values.social_rows.each_with_index do |(name, url), index| %>
          <%= render "admin/settings/social_link_row", index: index, name: name, url: url %>
        <% end %>
      </div>
      <template id="settings-social-link-template" data-admin--settings--repeat-rows-target="template">
        <%= render "admin/settings/social_link_row", index: TEMPLATE_INDEX, name: "", url: "" %>
      </template>
      <button type="button" class="mt-2 cursor-pointer text-sm text-accent hover:text-accent-hover" data-action="admin--settings--repeat-rows#add"><%= t(".add_link") %></button>
      <%= helpers.render "admin/shared/field_errors", id: "settings-social_links-errors", messages: errors_for(:social_links) %>
    <% end %>
  </div>
<% end %>
