<div class="admin-mermaid-field">
  <div class="admin-mermaid-field__pair">
    <div class="min-w-0">
      <%= tag.textarea shown, name: source_name, id: input_id, class: input_class, rows: rows, wrap: "off",
            spellcheck: "false", autocapitalize: "off", autocomplete: "off", required: field.required?,
            aria: { describedby: described_by }, data: input_data %>
      <%= tag.p counter_text, id: counter_id, hidden: !counter_shown?, class: counter_class, data: target("counter") %>
      <% if starting? %>
        <%= tag.p starting_text, id: starting_id, class: "mt-1 text-sm text-meta" %>
      <% end %>
    </div>
    <%# The script builds the renderer frame in the preview's slot; on a translation tab it stands under the pair (`#below_pair`). %>
    <%= preview unless paired? %>
  </div>
  <%# Read by the script for the theme's colours; nobody sees or hears it. %>
  <%= tag.span class: "content-block--diagram", hidden: true, aria: { hidden: true }, data: target("colourProbe") %>
</div>
