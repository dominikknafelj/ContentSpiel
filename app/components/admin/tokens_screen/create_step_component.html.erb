<section class="rounded-card bg-surface shadow-1 p-4" data-controller="admin--tokens--group-hint">
  <h2 class="text-h2 text-ink"><%= t(".title") %></h2>

  <% if raw_token %>
    <%# The one-time reveal: only the response of the POST that created the
        token ever renders this, and the token stands once, as the copy
        box's text, a `secret` target blanked at `pagehide`. %>
    <%= render Admin::Ui::NoticeComponent.new(tone: :warn, class: "mt-3") do %>
      <p class="font-semibold"><%= t(".reveal") %></p>
      <%= render Admin::Ui::CopyValueComponent.new(id: "api-token-value", value: raw_token, copy_label: t(".copy_token"), layout: :block,
            source_data: { "admin--tokens--reveal-target": "secret" }, class: "mt-2") %>
    <% end %>
  <% end %>

  <%= form_with url: form_url, method: :post, data: { turbo: false }, class: "mt-3 flex max-w-[560px] flex-col gap-4" do %>
    <div class="admin-field">
      <%= label_tag "token-name", t(".name"), class: setup_label_class %>
      <%= text_field_tag "name", name, id: "token-name", required: true, maxlength: ApiToken::MAX_NAME_LENGTH,
            placeholder: t(".name_placeholder"), autocomplete: "off", class: setup_input_class,
            aria: { invalid: name_errors.any? ? "true" : nil, describedby: name_described_by } %>
      <%= render "admin/shared/field_errors", id: NAME_ERROR_ID, messages: name_errors %>
    </div>

    <%# The token's group bounds what an assistant using it may do, within the
        user's own rights: only groups the user may assign are offered. %>
    <div class="admin-field">
      <%= label_tag "group_id", t(".group"), class: setup_label_class %>
      <select name="group_id" id="group_id" required class="<%= setup_select_class %>"
        data-admin--tokens--group-hint-target="select" data-action="change->admin--tokens--group-hint#show"
        <%= tag.attributes(aria: { invalid: ("true" if group_errors.any?), describedby: group_described_by }) %>>
        <% groups.each do |group| %>
          <option value="<%= group.id %>" data-description="<%= group.description %>" <%= "selected" if group == selected_group %>><%= group.name %></option>
        <% end %>
      </select>
      <p id="<%= GROUP_DESCRIPTION_ID %>" data-admin--tokens--group-hint-target="text" class="mt-1 text-small text-meta"><%= selected_description %></p>
      <%= render "admin/shared/field_errors", id: GROUP_ERROR_ID, messages: group_errors %>
    </div>

    <div>
      <%= render Admin::Ui::ButtonComponent.new(label: t(".create"), variant: :primary, type: "submit") %>
    </div>
  <% end %>
</section>
