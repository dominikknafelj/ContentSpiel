<section class="rounded-card bg-surface shadow-1 p-4">
  <h2 class="text-h2 text-ink"><%= t(".title") %></h2>
  <p class="mt-1 text-small text-dim"><%= secret? ? t(".with_token") : t(".intro") %></p>

  <div class="mt-3">
    <p class="<%= setup_label_class %>"><%= t(".mcp_url") %></p>
    <%= render Admin::Ui::CopyValueComponent.new(id: "mcp-url", value: mcp_url, copy_label: t(".copy_mcp_url"), class: "mt-1") %>
  </div>

  <div class="mt-4">
    <p class="<%= setup_label_class %>"><%= t(".configuration") %></p>
    <%= render Admin::Ui::CopyValueComponent.new(id: config_id, value: config, copy_label: t(".copy_configuration"), layout: :block,
          source_data: config_data, class: "mt-1") %>
  </div>
</section>
