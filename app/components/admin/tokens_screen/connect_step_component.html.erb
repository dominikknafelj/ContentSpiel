<section class="rounded-card bg-surface shadow-1 p-4">
  <h2 class="text-h2 text-ink">2 · Add it to your assistant</h2>
  <p class="mt-1 text-meta">Point your assistant at this URL and send the token as a bearer token<%= " (this configuration already holds the token above)" if secret? %>.</p>

  <div class="mt-3">
    <p class="<%= setup_label_class %>">MCP URL</p>
    <%= render Admin::Ui::CopyValueComponent.new(id: "mcp-url", value: mcp_url, copy_label: "Copy the MCP URL", class: "mt-1") %>
  </div>

  <div class="mt-4">
    <p class="<%= setup_label_class %>">Client configuration</p>
    <%= render Admin::Ui::CopyValueComponent.new(id: config_id, value: config, copy_label: "Copy the client configuration", layout: :block,
          source_data: config_data, class: "mt-1") %>
  </div>
</section>
