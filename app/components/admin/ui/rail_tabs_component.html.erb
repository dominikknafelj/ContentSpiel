<% if single? %>
  <% tab = tabs.first %>
  <%= tag.h2 id: tab_id(tab), class: "admin-rail__tabs admin-rail__heading text-sm font-medium text-ink" do %><%= render Admin::Ui::RailTabComponent.new(rail_id: @rail_id, tab: tab, contents: true) %><% end %>
<% else %>
  <div class="admin-rail__tabs" role="tablist" aria-label="<%= label %>">
    <% tabs.each do |tab| %>
      <%= render Admin::Ui::RailTabComponent.new(rail_id: @rail_id, tab: tab, current: current?(tab)) %>
    <% end %>
  </div>
<% end %>
