<div class="admin-file-drop rounded-card border border-dashed border-field-line px-4 py-6 text-center data-[dragging]:border-accent data-[dragging]:bg-accent-tint"
     data-controller="file-drop"
     data-action="dragover->file-drop#dragOver dragleave->file-drop#dragLeave drop->file-drop#drop change->file-drop#changed">
  <%= tag.input(**input_attrs) %>
  <p class="text-ink">Drop an image here or</p>
  <%# A label drawn as the secondary button: the file input it names is the
      focusable control (`peer`), so the label rings when the input is focused. %>
  <label for="<%= id %>" class="mt-2 <%= Admin::Ui::ButtonComponent.classes(:secondary) %> peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">Choose file</label>
  <% if hint %>
    <p id="<%= hint_id %>" class="mt-2 text-sm text-meta"><%= hint %></p>
  <% end %>
  <p class="mt-2 min-h-5 text-sm text-ink" data-file-drop-target="name" aria-live="polite"></p>
</div>
