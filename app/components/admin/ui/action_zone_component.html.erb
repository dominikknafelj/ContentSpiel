<%= tag.section(**section_attributes) do %>
  <% if heading || words? %>
    <div class="flex min-w-0 flex-col gap-0.5">
      <% if heading %><h2 id="<%= heading_id %>" class="text-h3 text-ink"><%= heading %></h2><% end %>
      <% if body.present? %><%= tag.p body, id: body_id, class: "text-small text-dim" %><% end %>
      <% if reason.present? %><p class="text-small text-dim" data-action-zone-reason><%= reason %></p><% end %>
      <% if pending_lock %><p class="text-small text-meta" data-admin--saving--pending-lock-target="hint" hidden></p><% end %>
    </div>
  <% end %>
  <%= trigger %>
<% end %>
