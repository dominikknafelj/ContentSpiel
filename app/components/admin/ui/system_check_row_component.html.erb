<li class="admin-system-check flex gap-4 py-4" data-status="<%= result.status %>">
  <div class="w-[110px] shrink-0">
    <%= render state_chip %>
  </div>
  <div class="min-w-0 flex-1">
    <p class="font-semibold text-ink"><%= result.label %></p>
    <p class="text-dim"><%= result.message %></p>
    <% if result.command.present? %>
      <%= render copy_value %>
    <% end %>
    <% if mail_settings_link? %>
      <p class="mt-2"><%= link_to t(".open_mail_settings"), @mail_settings_href, class: LINK_CLASS %></p>
    <% end %>
    <% if image_settings_link? %>
      <p class="mt-2"><%= link_to t(".open_image_settings"), @image_settings_href, class: LINK_CLASS %></p>
    <% end %>
    <% if forms_link? %>
      <p class="mt-2"><%= link_to t(".open_forms"), @forms_href, class: LINK_CLASS %></p>
    <% end %>
    <% if result.docs.present? %>
      <p class="mt-2"><%= link_to t(".learn_more"), result.docs, class: LINK_CLASS %></p>
    <% end %>
  </div>
</li>
