<li class="admin-system-check flex gap-4 py-4" data-status="<%= result.status %>">
  <div class="w-[110px] shrink-0">
    <span class="<%= chip_class %>">
      <span aria-hidden="true" class="size-2 rounded-full <%= dot_class %>"></span><%= status_word %>
    </span>
  </div>
  <div class="min-w-0 flex-1">
    <p class="font-semibold text-ink"><%= result.label %></p>
    <p class="text-dim"><%= result.message %></p>
    <% if result.command.present? %>
      <%# The controller sits on the box so a failed copy can select the text
          itself and the status line can speak politely; without JavaScript
          (or in the wizard) the command is plain selectable text. %>
      <div class="mt-2 flex items-start gap-2 rounded-cs border border-line bg-sunken p-2"
           <% if copyable? %>data-controller="admin--clipboard" data-admin--clipboard-text-value="<%= result.command %>"<% end %>>
        <code class="min-w-0 flex-1 break-words font-cs-mono text-[13px] text-ink" <% if copyable? %>data-admin--clipboard-target="source"<% end %>><%= result.command %></code>
        <% if copyable? %>
          <button type="button" data-admin--clipboard-target="button" data-action="click->admin--clipboard#copy" aria-label="Copy command for <%= result.label %>"
                  class="shrink-0 cursor-pointer rounded-cs border border-line-strong bg-surface px-2 py-0.5 text-sm text-ink hover:bg-sunken">Copy</button>
          <span data-admin--clipboard-target="status" role="status" aria-live="polite" class="sr-only"></span>
        <% end %>
      </div>
    <% end %>
    <% if result.docs.present? %>
      <p class="mt-2"><%= link_to "Learn more →", result.docs, class: "text-accent hover:text-accent-hover hover:underline" %></p>
    <% end %>
  </div>
</li>
