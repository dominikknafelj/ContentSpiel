<%# One mark per state, shared by a tab and an overflow entry. Colour is never
    the only cue: the shape differs (hollow ring vs solid dot) and an
    `sr-only` sentence is what a screen reader announces. Neither uses red --
    translation states are never errors. The `title` keeps the hover text the
    old switcher had. %>
<% marks = ->(code) do %>
  <%# The `sr-only` sentence lives INSIDE the mark (no `aria-hidden` on it),
      so when "Still correct — mark up to date" streams the marker away by id the
      announcement goes with the dot. %>
  <% if missing?(code) %>
    <%= tag.span class: "size-[7px] shrink-0 rounded-full border-[1.5px] border-field-line", title: t(".missing_title"), data: { language_state: "missing" } do %>
      <span class="sr-only"><%= t(".missing", language: native_name(code)) %></span>
    <% end %>
  <% end %>
  <% if outdated?(code) %>
    <%= tag.span id: outdated_marker_id(code), class: "size-[7px] shrink-0 rounded-full bg-warn", title: t(".outdated_title"), data: { language_state: "outdated" } do %>
      <span class="sr-only"><%= t(".outdated", language: native_name(code)) %></span>
    <% end %>
  <% end %>
<% end %>
<nav aria-label="<%= t(".nav_label") %>" class="admin-language-tabs border-b border-line">
  <ul <%= "role=tablist" if buttons? %> class="flex items-end gap-5 font-cs text-sm">
    <% tabs.each do |code| %>
      <%# The underline and its padding sit on the <li>, not on the label: with
          the padding on the label the 7px dot centred on label-plus-padding
          and rode low (round 1 departure). Now the flex row is just the
          label and its dot, centred on each other. %>
      <%# Buttons mode keys the underline and weight on `aria-selected`, which
          `admin--settings--tabs` flips, so no script ever edits a class. %>
      <li <%= "role=presentation" if buttons? %> class="inline-flex items-center gap-1.5 border-b-2 pb-2 <%= buttons? ? "border-transparent has-[[aria-selected=true]]:border-ink" : (current?(code) ? "border-ink" : "border-transparent") %>">
        <% if buttons? %>
          <%= tag.button native_name(code), type: "button", role: "tab", id: "language-tab-#{code}",
                class: "cursor-pointer text-meta hover:text-ink aria-selected:font-medium aria-selected:text-ink",
                aria: { selected: current?(code).to_s, controls: panel_id_for(code) }.compact,
                data: button_data_for(code) %>
        <% elsif current?(code) %>
          <span class="font-medium text-ink" aria-current="true"><%= native_name(code) %></span>
        <% else %>
          <%# `data-turbo-frame="_top"` (final-fixes round, finding 1): this
              component lives inside the layout's own `<turbo-frame
              id="content">`, so left to its own default frame target a click
              here would only ever replace *that* frame -- the page tree
              outside it (spec §4.2) never re-renders with the new locale's
              own titles (`Admin::PagesScreen::TreeNodeComponent#title` reads `locale`), so
              switching language while looking at the tree left every node's
              title showing whichever language was selected before the
              switch. A full top-level visit re-renders the tree along with
              the content it was already reloading. %>
          <%= link_to native_name(code), href(code), class: "text-meta hover:text-ink", data: { turbo_frame: "_top" } %>
        <% end %>
        <% marks.call(code) %>
      </li>
    <% end %>
    <% if overflow.any? %>
      <li class="relative pb-2">
        <%# The shared popover menu (not a native <details>): arrow keys,
            Escape and outside click come with it. The `marks` lambda is
            still called as a silent scriptlet, never an output tag, so each
            language's marker id renders exactly once. %>
        <%= render Admin::Ui::MenuComponent.new(label: t(".more", count: overflow.size), button_class: "cursor-pointer text-meta hover:text-ink") do |menu| %>
          <% overflow.each do |code| %>
            <% menu.with_item do %>
              <span class="flex items-center gap-1.5">
                <%= link_to native_name(code), href(code), class: "text-meta hover:text-ink", data: { turbo_frame: "_top" } %>
                <% marks.call(code) %>
              </span>
            <% end %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
