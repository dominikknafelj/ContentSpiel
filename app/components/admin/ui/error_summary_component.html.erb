<div class="admin-error-summary mb-4 rounded-cs border border-danger bg-danger-tint px-4 py-3 text-danger-ink" role="alert" tabindex="-1" autofocus>
  <p class="font-semibold"><%= heading %></p>
  <ul class="mt-1 list-disc space-y-0.5 pl-5">
    <% entries.each do |field, sentence| %>
      <li>
        <% if (target = field_ids[field]) %>
          <a href="#<%= target %>" class="underline hover:no-underline"><%= sentence %></a>
        <% else %>
          <%= sentence %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
