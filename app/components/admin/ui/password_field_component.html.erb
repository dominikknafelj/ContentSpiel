<div class="<%= root_class %>" data-controller="password-field" data-password-field-minimum-value="<%= User::MINIMUM_PASSWORD_LENGTH %>" data-messages="<%= script_messages %>">
  <% if label_aside? %>
    <div class="flex flex-wrap items-baseline justify-between gap-x-3">
      <label for="<%= id %>" class="<%= setup_label_class %>"><%= label %></label>
      <%= label_aside %>
    </div>
  <% else %>
    <label for="<%= id %>" class="<%= setup_label_class %>"><%= label %></label>
  <% end %>

  <div class="relative">
    <%= tag.input(**input_attrs) %>
    <button type="button" aria-controls="<%= id %>" data-password-field-target="toggle" data-action="password-field#toggle"
            class="absolute inset-y-0 right-0 cursor-pointer px-3 text-xs font-medium text-accent hover:text-accent-hover"><%= t(".show") %></button>
  </div>

  <% if meter %>
    <div class="mt-2 flex gap-1" aria-hidden="true">
      <% 4.times do %>
        <span data-password-field-target="bar" class="h-1 flex-1 rounded-cs bg-line-strong"></span>
      <% end %>
    </div>
    <p id="<%= hint_id %>" data-password-field-target="hint" aria-live="polite" class="mt-1 text-sm text-meta"><%= t(".minimum", count: User::MINIMUM_PASSWORD_LENGTH) %></p>
  <% end %>

  <% if invalid? %>
    <%= helpers.render "admin/shared/field_errors", id: errors_id, messages: errors %>
  <% end %>
</div>
