<%= render Admin::Ui::DialogComponent.new(id: kind.id, title: words(:title), width: :form, hang: true) do |dialog| %>
  <div data-controller="admin--editor--new-record" data-admin--editor--new-record-kind-value="<%= kind.name %>" data-admin--editor--new-record-url-value="<%= form_url %>"
       data-messages="<%= messages_data(*Admin::Ui::NewRecordDialogComponent::MESSAGES) %>"
       data-action="admin--ui--dialog:opening@document->admin--editor--new-record#opened input->admin--editor--new-record#update change->admin--editor--new-record#update turbo:submit-start->admin--editor--new-record#submitting turbo:submit-end->admin--editor--new-record#submitted turbo:frame-missing->admin--editor--new-record#failed turbo:before-fetch-response->admin--editor--new-record#checkResponse turbo:fetch-request-error->admin--editor--new-record#failed">
    <p data-admin--editor--new-record-target="loading" class="py-6 text-center text-dim"><%= t(".loading") %></p>
    <%# The two failure messages are written into their `role="alert"` elements when
        they happen (`admin--editor--new-record`): an alert whose text was already in the page and was
        only un-hidden is not announced. %>
    <div data-admin--editor--new-record-target="failure" data-message="<%= t(".load_failed") %>" class="py-6 text-center" hidden>
      <p role="alert" class="text-danger-ink"></p>
      <div class="mt-3"><%= render Admin::Ui::ButtonComponent.new(label: t(".retry"), variant: :secondary, type: "button", data: { action: "admin--editor--new-record#retry" }) %></div>
    </div>
    <%# A SUBMIT that never reached the server (network error): the typed form stays, Create is enabled again. %>
    <p data-admin--editor--new-record-target="submitFailure" data-message="<%= t(".submit_failed") %>" role="alert" class="mb-3 text-danger-ink empty:hidden"></p>
    <turbo-frame id="<%= kind.frame_id %>"></turbo-frame>
  </div>
  <% dialog.with_footer do %>
    <%= tag.form method: "dialog" do %>
      <%= render Admin::Ui::ButtonComponent.new(label: t(".cancel"), variant: :tertiary, type: "submit") %>
    <% end %>
    <%# Disabled until the form has loaded (`admin--editor--new-record`). %>
    <%= render Admin::Ui::ButtonComponent.new(label: words(:create), variant: :primary, type: "submit", form: kind.form_id, disabled: true) %>
  <% end %>
<% end %>
