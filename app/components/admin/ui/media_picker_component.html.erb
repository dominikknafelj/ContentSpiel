<%= tag.dialog id: DIALOG_ID,
      class: "admin-media-picker admin-dialog rounded-card bg-popover p-0 text-ink shadow-3",
      "aria-labelledby": part_id("title"),
      data: {
        dialog_width: "picker",
        controller: "admin--media--picker admin--media--select admin--media--live",
        "admin--media--live-url-value": live_url,
        "admin--media--live-picker-value": true,
        action: ACTIONS,
        "admin--media--picker-grid-url-value": grid_url,
        "admin--media--picker-upload-url-value": upload_url,
        "admin--media--picker-tile-class-value": Admin::MediaLibrary::TileComponent::CARD,
        "admin--media--picker-button-class-value": Admin::Ui::ButtonComponent.classes(:secondary, size: :small),
        messages: messages_data(*Admin::MediaLibrary::TileComponent::UPLOAD_MESSAGES, *Admin::Ui::MediaPickerComponent::FOOTER_MESSAGES, *Admin::Ui::MediaPickerComponent::PLACE_MESSAGES,
                                *Admin::Ui::MediaPickerComponent::MULTIPLE_MESSAGES)
      } do %>
  <%# Padding lives on the sections below, not the <dialog>: a click on the
      dialog's own padding is a click on the <dialog> element, which the
      body-level `admin--ui--dialog#backdrop` reads as a backdrop click. %>
  <div class="flex min-h-0 flex-1 flex-col">
    <div class="flex items-center justify-between gap-4 border-b border-line px-6 py-4">
      <h2 id="<%= part_id("title") %>" class="text-h2 text-ink" data-admin--media--picker-target="title"><%= t(".title") %></h2>
      <div class="flex min-w-0 items-center gap-3">
        <%# Where Upload's files go: the place the frame shows, rewritten by
            `admin--media--picker` after each load of it. %>
        <p id="<%= part_id("upload-into") %>" class="min-w-0 truncate text-small text-meta" data-admin--media--picker-target="uploadInto"><%= t(".upload_nowhere") %></p>
        <%= render Admin::Ui::ButtonComponent.new(label: t(".upload"), variant: :secondary, type: "button", "aria-describedby": part_id("upload-into"), data: { action: "admin--media--picker#browse" }) %>
        <%= tag.button "×", type: "button", "aria-label": t(".close"), class: "rounded-cs px-2 text-2xl leading-none text-meta hover:text-ink focus:outline-2 focus:outline-accent",
              data: { action: "admin--media--picker#dismiss" } %>
      </div>
    </div>

    <%# No `name`: the files go to the upload endpoint by XHR, never with any
        form's own data. Visually hidden, not `hidden`: still a labelled field
        (the header's Upload button clicks it). %>
    <%= label_tag part_id("file"), t(".file"), class: "sr-only" %>
    <%= tag.input type: "file", id: part_id("file"), accept: accept, multiple: true, class: "sr-only",
          data: { "admin--media--picker-target": "file", action: "change->admin--media--picker#upload" } %>
    <p class="sr-only" role="status" aria-live="polite" data-admin--media--picker-target="status"></p>

    <%# A multiple opening's two marks on a tile's thumbnail, cloned by
        `admin--media--select` (the card StudioGallery, D4): a chosen tile's
        place in the order, a picture of the name the script gives the tile;
        and "In the gallery", the description of a tile already in it. %>
    <template data-admin--media--select-target="orderMark">
      <span class="admin-media-pick-order" aria-hidden="true" data-media-pick-order></span>
    </template>
    <template data-admin--media--select-target="inGalleryMark">
      <span class="admin-media-pick-in-gallery" aria-hidden="true" data-media-pick-in-gallery><%= render "admin/shared/icon", name: :check, size: "size-2.5" %><%= t(".in_gallery") %></span>
    </template>

    <%# Loaded by `admin--media--picker#open` every time the picker opens (so a
        library changed meanwhile -- an upload in another tab, a delete -- is
        never stale), at the place it showed last, then navigated in place by
        its places, its own search form, segments and pagination links. The
        frame is the body's grid (`admin/media/picker` draws its parts): from
        640px the 200px list of places beside the grid's column, each
        scrolling on its own; below, the select, then the grid's column. The
        frame's own classes stay on this tag: Turbo copies a response frame's
        children, never its attributes. %>
    <turbo-frame id="media-picker-grid" data-admin--media--picker-target="frame"
                 class="grid min-h-0 flex-1 grid-cols-1 grid-rows-[auto_minmax(0,1fr)] sm:grid-cols-[200px_minmax(0,1fr)] sm:grid-rows-[minmax(0,1fr)]"></turbo-frame>

    <div class="flex items-center justify-between gap-4 border-t border-line px-6 py-3">
      <%# What is chosen, said in words and announced as it changes. %>
      <p class="text-sm text-meta" role="status" aria-live="polite" data-admin--media--select-target="status"><%= t(".none") %></p>
      <div class="flex items-center gap-2">
        <%= render Admin::Ui::ButtonComponent.new(label: t(".cancel"), variant: :tertiary, type: "button", data: { action: "admin--media--picker#dismiss" }) %>
        <%= render Admin::Ui::ButtonComponent.new(label: t(".use"), variant: :primary, type: "button", disabled: true,
              data: { "admin--media--select-target": "use", action: "admin--media--select#confirm" }) %>
      </div>
    </div>
  </div>
<% end %>
