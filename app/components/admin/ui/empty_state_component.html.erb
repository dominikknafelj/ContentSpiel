<%# One dim line where the first row would be, then the action: the brand
    book's empty state, and the dashboard card's (`DashboardScreen::CardComponent`). %>
<div class="admin-empty-state px-4 py-2.5">
  <p class="text-sm text-dim"><span data-empty-state-title><%= title %></span><% if description.present? %> <%= description %><% end %></p>
  <% if action? %>
    <div class="mt-2 flex justify-start"><%= action %></div>
  <% end %>
</div>
