<%= tag.div class: "relative inline-block", data: { controller: "admin--menu", action: "click@window->admin--menu#closeOutside keydown->admin--menu#keydown" } do %>
  <%= tag.button label, type: "button", aria: { haspopup: "menu", expanded: "false", label: aria_label }, class: button_classes,
        data: { "admin--menu-target": "button", action: "admin--menu#toggle" } %>
  <%= tag.div role: "menu", hidden: true, class: panel_classes, data: { "admin--menu-target": "panel", **panel_data } do %>
    <% items.each do |item| %>
      <div role="none"><%= item %></div>
    <% end %>
  <% end %>
<% end %>
