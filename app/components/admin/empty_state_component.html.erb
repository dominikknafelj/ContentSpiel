<div class="admin-empty-state flex flex-col items-center gap-2 rounded-cs border border-dashed border-line-strong px-6 py-10 text-center">
  <h3 class="font-cs-mono text-label uppercase tracking-mono text-meta"><%= title %></h3>
  <% if description.present? %>
    <p class="text-ink"><%= description %></p>
  <% end %>
  <% if action? %>
    <div class="mt-2"><%= action %></div>
  <% end %>
</div>
