<%# `data-admin--tree-move-url-value` is read once by the Stimulus controller
    on connect -- every drop PATCHes that one URL regardless of which node in
    the tree moved (spec §4.2), the same "one fixed URL, the moved page's id
    travels in the body" shape the Avo tree tool this follows already uses. %>
<turbo-frame id="tree" data-controller="admin--tree" data-admin--tree-move-url-value="<%= helpers.admin_tree_path(**url_options) %>">
  <%# A flash-style status for the last move, replaced on its own by
      Admin::TreeController#update -- kept empty (not `sr-only`'d away
      entirely) on an ordinary page load, since there is nothing to report
      yet. %>
  <p id="tree-status" role="status" aria-live="polite" class="min-h-[1.25rem] px-1 text-sm"></p>

  <% if root %>
    <ul class="admin-tree flex flex-col gap-0.5">
      <%= render Admin::TreeNodeComponent.new(page: root, children_by_parent: children_by_parent, selected: selected, locale: locale, url_options: url_options, root: true) %>
    </ul>
  <% else %>
    <%= render Admin::EmptyStateComponent.new(title: "No pages yet") %>
  <% end %>
</turbo-frame>
