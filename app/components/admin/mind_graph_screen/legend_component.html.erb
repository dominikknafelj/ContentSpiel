<%# The legend is the filter: two groups of native checkboxes, everything
    on, drawn as three labelled groups (Claude Design's O5): "Show" over the
    toggles of both kinds, "Key" over the marks that are no controls, then
    "Status" over the five looks. The marks and the looks hold no stop, so
    the Tab order is the toggles alone.
    A toggle's count is the script's: the page holds no graph data. Until it
    is written the toggle's name is its label; then the script gives the
    input one name with the count in it ("Pages, 200"), which the
    controller's `reset` takes back. The count itself is hidden from a
    screen reader, which would otherwise hear it twice.

    STATUS IS NOT A FILTER (the third design answers): the five looks are a
    key on the row, each a swatch and its name in the chip's words (H6).

    A NEW VISIT STARTS FROM THE DEFAULTS (pages spec, decision 8), in every
    browser: `autocomplete="off"` keeps Firefox from putting a toggle's state
    back on a reload. (Back is another matter: the snapshot's checkboxes are
    the person's, and the script reads them.)

    Every swatch is an empty canvas (`SwatchComponent`) that
    `admin--mind-graph--swatches` has the graph's own renderer draw. %>
<div data-mind-graph-legend data-controller="admin--mind-graph--swatches" class="admin-mind-graph-legend flex min-w-0 flex-wrap items-center gap-x-6 gap-y-2 text-sm text-dim">
  <% toggle_groups = [ [ :nodes, node_toggles, t(".show") ], [ :lines, line_toggles, t(".lines") ] ].reject { |_, kinds, _| kinds.empty? } %>
  <% if toggle_groups.any? %>
    <div data-legend-section="show" class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1.5">
      <span aria-hidden="true" class="text-label text-meta"><%= t(".show") %></span>
      <% toggle_groups.each do |group, kinds, name| %>
        <fieldset data-legend-group="<%= group %>" class="m-0 flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1.5 border-0 p-0">
          <legend class="sr-only"><%= name %></legend>
          <% kinds.each do |kind| %>
            <% label = t(group == :nodes ? ".nodes.#{kind}" : ".edges.#{kind}") %>
            <label data-legend-toggle="<%= kind %>" class="inline-flex cursor-pointer items-center gap-1.5">
              <%= render Admin::Ui::CheckboxComponent.new(name: "mind_graph_#{group}", value: kind, checked: true, id: "mind-graph-#{group}-#{kind}", autocomplete: "off",
                    data: { action: "change->admin--mind-graph--graph#filter", name: label }) %>
              <%= render Admin::MindGraphScreen::SwatchComponent.new(swatch_name(group, kind)) %>
              <span><%= label %></span>
              <span data-legend-count aria-hidden="true" class="text-count text-meta"></span>
            </label>
          <% end %>
        </fieldset>
      <% end %>
    </div>
  <% end %>
  <div data-legend-section="key" class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1.5">
    <span id="mind-graph-legend-key" class="text-label text-meta"><%= t(".key") %></span>
    <ul data-legend-keys class="m-0 flex list-none flex-wrap items-center gap-x-5 gap-y-1.5 p-0" aria-labelledby="mind-graph-legend-key">
      <% type_names.each do |name| %>
        <li data-legend-type="<%= name %>"><%= render Admin::Ui::ContentTypeDotComponent.new(content_type: name) %></li>
      <% end %>
      <% if retired? %>
        <li class="inline-flex items-center gap-1.5" data-legend="retired">
          <%= render Admin::MindGraphScreen::SwatchComponent.new(:retired) %>
          <%= t(".retired") %>
        </li>
      <% end %>
      <li class="inline-flex items-center gap-1.5" data-legend="pinned">
        <%= render Admin::MindGraphScreen::SwatchComponent.new(:pinned) %>
        <%= t(".pinned") %>
      </li>
      <%# A post or a page with open notes: the count badge the
          canvas draws on the mark's top-left corner, opposite the pin. %>
      <li class="inline-flex items-center gap-1.5" data-legend="notes">
        <%= render Admin::MindGraphScreen::SwatchComponent.new(:notes) %>
        <%= t(".notes") %>
      </li>
    </ul>
  </div>
  <div data-legend-section="status" class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1.5">
    <span id="mind-graph-legend-states" class="text-label text-meta"><%= t(".states_label") %></span>
    <ul data-legend-states class="m-0 flex list-none flex-wrap items-center gap-x-5 gap-y-1.5 p-0" aria-labelledby="mind-graph-legend-states">
      <% STATES.each do |state| %>
        <li class="inline-flex items-center gap-1.5" data-legend-state="<%= state %>">
          <%= render Admin::MindGraphScreen::SwatchComponent.new("state-#{state.to_s.dasherize}") %>
          <%= t(".states.#{state}") %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
