<div class="rounded-cs border border-line bg-surface">
<% if items.empty? %>
  <%= render Admin::EmptyStateComponent.new(title: empty_title, description: empty_description) %>
<% else %>
  <table class="admin-trash-table admin-card-table w-full border-collapse text-sm">
    <thead>
      <tr class="border-b border-line-strong text-left font-cs-mono text-label uppercase tracking-mono text-meta">
        <th class="py-2 pr-4">Item</th>
        <th class="py-2 pr-4">Type</th>
        <th class="py-2 pr-4">Trashed</th>
        <th class="py-2 pr-4">Deletes</th>
        <th class="py-2"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% items.each do |item| %>
        <%= render row_for(item) %>
      <% end %>
    </tbody>
  </table>
<% end %>
  <%= footer %>
</div>
