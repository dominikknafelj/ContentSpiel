<tr id="<%= row_id %>" class="border-b border-line align-top">
  <td class="py-2 pr-4">
    <div class="flex items-center gap-3">
      <% if image? %>
        <span class="block size-12 shrink-0 overflow-hidden rounded-cs bg-sunken">
          <%= image_tag item.thumbnail_url, alt: "", loading: "lazy", class: "h-full w-full object-cover" %>
        </span>
      <% end %>
      <span class="font-semibold text-ink"><%= title %></span>
    </div>
    <% if subpages.any? %>
      <details class="mt-1 text-meta">
        <summary class="cursor-pointer">+<%= helpers.pluralize(subpages.size, "subpage") %></summary>
        <ul class="mt-1 list-disc pl-5">
          <% subpages.each do |subpage| %>
            <li><%= subpage.title.presence || "Untitled" %></li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </td>
  <td class="py-2 pr-4 text-meta"><%= type_label %></td>
  <td class="py-2 pr-4">
    <div><%= trashed_by_label %></div>
    <div class="text-meta">
      <time datetime="<%= item.trashed_at.iso8601 %>" title="<%= item.trashed_at.strftime("%b %-d, %Y %H:%M") %>"><%= helpers.time_ago_in_words(item.trashed_at) %> ago</time>
    </div>
    <% if (text = countdown) %>
      <div class="text-meta"><%= text %></div>
    <% end %>
  </td>
  <td class="py-2">
    <div class="flex flex-wrap items-start justify-end gap-2">
      <% if needs_parent? %>
        <%= form_with url: restore_path, method: :post, class: "flex flex-wrap items-center gap-2", data: { turbo_frame: "_top" } do %>
          <%= label_tag parent_select_id, "Restore under", class: "text-meta" %>
          <%= select_tag :parent_id, options_for_select(parent_choices || []), id: parent_select_id, class: setup_input_class,
                disabled: parent_choices.blank? %>
          <%= render Admin::ButtonComponent.new(label: "Restore", variant: :secondary, type: "submit", disabled: parent_choices.blank?) %>
        <% end %>
      <% else %>
        <%= form_with url: restore_path, method: :post, data: { turbo_frame: "_top" } do %>
          <%= render Admin::ButtonComponent.new(label: "Restore", variant: :secondary, type: "submit") %>
        <% end %>
      <% end %>

      <% if in_use? %>
        <%= render Admin::ButtonComponent.new(label: "Delete permanently", variant: :danger, type: "button", disabled: true,
              title: "Still used by an item in the trash") %>
      <% else %>
        <%= render Admin::ButtonComponent.new(label: "Delete permanently", variant: :danger, type: "button",
              onclick: "document.getElementById('#{purge_dialog_id}').showModal()") %>
        <%= render Admin::ConfirmDialogComponent.new(id: purge_dialog_id, title: "Delete permanently?", body: purge_dialog_body) do |dialog| %>
          <% dialog.with_confirm_action do %>
            <%= form_with url: purge_path, method: :delete, data: { turbo_frame: "_top" } do %>
              <%= render Admin::ButtonComponent.new(label: "Delete permanently", variant: :danger, type: "submit") %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
