<div class="admin-users-list overflow-hidden rounded-cs border border-line bg-surface">
  <div class="<%= COLUMNS %> border-b border-line-strong py-2 font-cs-mono text-label uppercase tracking-mono text-meta" aria-hidden="true">
    <span>User</span><span>Groups</span><span>Last sign-in</span><span></span>
  </div>
  <ul>
    <% users.each do |user| %>
      <li id="<%= helpers.dom_id(user) %>" class="<%= COLUMNS %> relative border-b border-line py-2.5 last:border-b-0 hover:bg-paper">
        <span class="flex min-w-0 items-center gap-2.5">
          <span class="grid size-[26px] flex-none place-items-center rounded-full bg-sunken text-xs font-semibold text-dim" aria-hidden="true"><%= initial(user) %></span>
          <span class="flex min-w-0 flex-col gap-px">
            <span class="flex flex-wrap items-center gap-2">
              <%= link_to helpers.edit_admin_user_path(user, **url_options), data: { turbo_frame: "content" },
                    class: "font-medium text-ink after:absolute after:inset-0 after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-[-2px] focus-visible:after:outline-accent" do %><%= render Admin::UserNameComponent.new(user: user) %><% end %>
              <% if you?(user) %><span class="text-sm text-meta">(you)</span><% end %>
              <% if user.owner? %><span class="rounded-cs border border-line-strong px-1.5 font-cs-mono text-label uppercase tracking-mono text-meta">Owner</span><% end %>
            </span>
            <% if user.name.present? %><span class="truncate text-sm text-meta"><%= user.email_address %></span><% end %>
          </span>
        </span>
        <span class="flex flex-wrap gap-1" data-column="groups">
          <% names = group_names(user) %>
          <% if names.empty? %>
            <span class="text-sm text-meta">No groups</span>
          <% else %>
            <% names.each do |name| %><span class="rounded-full bg-sunken px-2 py-0.5 text-xs text-ink"><%= name %></span><% end %>
          <% end %>
        </span>
        <span class="font-cs-mono text-xs text-meta" data-column="last-sign-in">
          <% if last_sign_ins[user.id] %><%= render Admin::TimeAgoComponent.new(time: last_sign_ins[user.id]) %><% else %>Never<% end %>
        </span>
        <span class="text-meta" aria-hidden="true">›</span>
      </li>
    <% end %>
  </ul>
</div>
<p class="mt-3 text-xs text-meta">Delete a user from their edit page. Their pages, posts and media stay; their posts are left without an author.</p>
