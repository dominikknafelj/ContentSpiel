<%= render Admin::Ui::ActionZoneComponent.new(heading_id: "delete-user-title", heading: t(".heading"), body: t(".body"),
      reason: (t(".reason", name: name) if last_owner), pending_lock: true, class: "mt-6", data: { zone: "delete" }) do |zone| %>
  <% zone.with_trigger do %>
    <%= render Admin::Ui::ButtonComponent.new(label: t(".trigger"), variant: :danger_text, size: :small, disabled: last_owner || nil,
          data: dialog_trigger(dialog_id).merge("admin--saving--pending-lock-target": "control")) %>
  <% end %>
<% end %>

<%# After the user's form, never inside it (forms don't nest). %>
<% unless last_owner %>
  <%= render Admin::Ui::ConfirmDialogComponent.new(destructive: true, id: dialog_id, title: t(".dialog_title", name: name), body: dialog_body) do |dialog| %>
    <% dialog.with_confirm_action do %>
      <%= form_with url: helpers.admin_user_path(user, **url_options), method: :delete, data: { turbo_frame: "_top" } do %>
        <%= render Admin::Ui::ButtonComponent.new(label: t(".confirm"), variant: :danger, type: "submit") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
