<%= render Admin::Ui::ActionZoneComponent.new(heading_id: "owner-zone-title", heading: t(".heading"), body: t(".body"),
      reason: reason, pending_lock: true, class: "mt-6", data: { zone: "owner" }) do |zone| %>
  <% zone.with_trigger do %>
    <%= render Admin::Ui::ButtonComponent.new(label: trigger_label, variant: :secondary, size: :small, disabled: last_owner? || nil,
          data: dialog_trigger(dialog_id).merge("admin--saving--pending-lock-target": "control")) %>
  <% end %>
<% end %>

<%# After the user's form, never inside it (forms don't nest). Not destructive: the confirm is the primary button. %>
<% unless last_owner? %>
  <%= render Admin::Ui::ConfirmDialogComponent.new(id: dialog_id, title: dialog_title, body: dialog_body) do |dialog| %>
    <% dialog.with_confirm_action do %>
      <%= form_with url: url, method: :patch, data: { turbo_frame: "_top" } do %>
        <%= hidden_field_tag "owner", requested_value, id: nil %>
        <%= render Admin::Ui::ButtonComponent.new(label: confirm_label, variant: :primary, type: "submit") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
