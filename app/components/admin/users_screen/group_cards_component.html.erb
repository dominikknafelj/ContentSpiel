<% tiles = capture do %>
  <%= hidden_field_tag "user[group_ids][]", "", id: nil %>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-2.5">
    <% groups.each do |group| %>
      <label for="<%= input_id(group) %>" class="<%= tile_class(group) %>" data-group-card="<%= group.id %>" <%= "data-locked" if locked?(group) %>>
        <%# A disabled box sends nothing, so a ticked locked one keeps its membership through a hidden input. %>
        <% if locked?(group) && checked?(group) %><%= hidden_field_tag "user[group_ids][]", group.id, id: nil %><% end %>
        <span class="flex min-w-0 flex-col gap-0.5">
          <span class="text-sm font-medium"><%= group.name %></span>
          <% if group.description.present? %><span class="<%= class_names("text-small leading-snug", "text-dim": !locked?(group)) %>"><%= group.description %></span><% end %>
          <% if locked?(group) %><span class="text-small"><%= t(".locked") %></span><% end %>
        </span>
        <%= render Admin::Ui::CheckboxComponent.new(name: "user[group_ids][]", value: group.id, checked: checked?(group), id: input_id(group), disabled: locked?(group), class: "col-start-2 row-start-1 mt-0.5") %>
      </label>
    <% end %>
  </div>
<% end %>
<% if frame %>
  <%= render Admin::Ui::SettingsCardComponent.new(heading_id: HEADING_ID, heading: t(".title"), icon: :groups, family: :people, class: "admin-user-groups") do |card| %>
    <% card.with_head_end { manage_link } if manage_groups %>
    <div class="p-4"><%= tiles %></div>
  <% end %>
<% else %>
  <div class="admin-user-groups" role="group" aria-labelledby="<%= HEADING_ID %>">
    <div class="mb-2.5 flex items-baseline justify-between gap-3">
      <h2 id="<%= HEADING_ID %>" class="text-h2 text-ink"><%= t(".title") %></h2>
      <%= manage_link if manage_groups %>
    </div>
    <%= tiles %>
  </div>
<% end %>
