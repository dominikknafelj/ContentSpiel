<%= render Admin::Ui::DialogComponent.new(id: DIALOG_ID, title: t(".title"), width: :form, open_on_load: refused?) do |dialog| %>
  <%= render Admin::Ui::NoticeComponent.new(tone: :danger, size: :compact, class: "mb-4") do %><%= safe_join(general_errors.map { |message| tag.p(message) }) %><% end %>

  <%= form_with url: create_path, method: :post, id: FORM_ID, class: "flex flex-col gap-4", data: { turbo_frame: "_top" }, html: { novalidate: true } do %>
    <div class="admin-field">
      <%= label_tag "invite_email_address", t(".email"), class: setup_label_class %>
      <%= email_field_tag "user[email_address]", invite.email_address, id: "invite_email_address", required: true, autofocus: true,
            autocomplete: "off", placeholder: t(".email_placeholder"),
            aria: { invalid: (email_errors.any? ? "true" : nil), describedby: ("invite_email_address-errors" if email_errors.any?) }.compact,
            class: setup_input_class %>
      <%= render "admin/shared/field_errors", id: "invite_email_address-errors", messages: email_messages %>
    </div>
    <div class="admin-field">
      <%= label_tag "invite_name", t(".name"), class: setup_label_class %>
      <%= text_field_tag "user[name]", invite.name, id: "invite_name", maxlength: 120, autocomplete: "off",
            aria: { invalid: (name_errors.any? ? "true" : nil), describedby: [ "invite_name_help", ("invite_name-errors" if name_errors.any?) ].compact.join(" ") }.compact,
            class: setup_input_class %>
      <p id="invite_name_help" class="mt-1 text-small text-meta"><%= t(".name_help") %></p>
      <%= render "admin/shared/field_errors", id: "invite_name-errors", messages: name_errors %>
    </div>
    <%= render Admin::UsersScreen::GroupCardsComponent.new(groups: groups, selected_ids: group_ids, assignable_ids: assignable_ids, frame: false) %>
  <% end %>

  <% if resend_invitation %>
    <%= form_with url: resend_path, method: :post, id: RESEND_FORM_ID, data: { turbo_frame: "_top" } do %><% end %>
  <% end %>

  <% dialog.with_footer do %>
    <%= tag.form method: "dialog" do %>
      <%= render Admin::Ui::ButtonComponent.new(label: t(".cancel"), variant: :tertiary, type: "submit") %>
    <% end %>
    <%= render Admin::Ui::ButtonComponent.new(label: t(".submit"), variant: :primary, type: "submit", form: FORM_ID) %>
  <% end %>
<% end %>
