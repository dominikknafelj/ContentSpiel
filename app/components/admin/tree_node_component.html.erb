<li data-page-id="<%= page.id %>" data-parent-id="<%= page.parent_id %>" class="admin-tree-node"<%= " data-context-only" if context_only? %>>
  <% if context_only? %>
    <%# Shown only as the path to a readable page below it (access-control
        design spec §3.3): greyed out, not a link, no status or actions. %>
    <div class="flex items-center gap-1.5 rounded-cs px-1.5 py-1">
      <span class="flex-1 truncate text-meta" title="You can’t open this page"><%= title %></span>
    </div>
  <% else %>
    <div class="group/node flex items-center gap-1.5 rounded-cs px-1.5 py-1 hover:bg-sunken">
      <%# The homepage can't be moved (Pages::Move) -- no handle, nothing to
          grab; nor can a page the actor may not move. Every other node's
          handle is the only part of the row that starts a drag (admin--tree's
          `handle:` option), so the title link below stays a plain, clickable
          link. %>
      <% if movable? %>
        <%# A real button, so the keyboard reaches it: Space picks the row up,
            the arrows move it, Space drops it (`admin--tree#key`). The mouse
            drag still starts from it (SortableJS `handle:`). %>
        <button type="button" class="admin-tree-node__handle shrink-0 cursor-grab select-none rounded-cs px-0.5 text-meta hover:text-ink focus-visible:outline-2 focus-visible:outline-accent"
                aria-label="Move <%= title %>" aria-describedby="tree-drag-help"
                data-action="keydown->admin--tree#key focusout->admin--tree#blur">⠿</button>
      <% end %>

      <%# `title:` is the full name for a row the narrow column truncates. %>
      <%= link_to title, path, title: title, data: { turbo_frame: "content" },
            aria: (selected? ? { current: "page" } : {}),
            class: "flex-1 truncate #{selected? ? "font-semibold text-ink" : "text-ink"}" %>

      <%# The chip carries `data-status` itself and renders nothing for Live. %>
      <%= render Admin::StatusChipComponent.new(status: status, at: page.published_at, hide_live: true) %>

      <%# Outdated and missing translated fields (handoff §10 B24), summed over
          the target languages: plain text in a warn / meta ink, nothing at
          zero. `role="img"` + `aria-label` so a screen reader hears what the
          tooltip says; the glyph itself is decoration. %>
      <% if translation_total(:outdated).positive? %>
        <%= tag.span "↻#{translation_total(:outdated)}", data: { translation_marker: "outdated" }, role: "img",
              title: translation_tooltip(:outdated), aria: { label: translation_label(:outdated) },
              class: "shrink-0 font-cs-mono text-label text-warn-ink" %>
      <% end %>
      <% if translation_total(:missing).positive? %>
        <%= tag.span "○#{translation_total(:missing)}", data: { translation_marker: "missing" }, role: "img",
              title: translation_tooltip(:missing), aria: { label: translation_label(:missing) },
              class: "shrink-0 font-cs-mono text-label text-meta" %>
      <% end %>

      <% if child_count.positive? %>
        <span data-child-count class="shrink-0 font-cs-mono text-label text-meta"><%= child_count %></span>
      <% end %>

      <% if can_add_child? %>
        <%= link_to "+", new_child_path, data: dialog_trigger("new-page-dialog").merge("new-page-parent-id-param": page.id, turbo_frame: "content"),
              class: "shrink-0 rounded-cs px-1 text-meta opacity-0 hover:bg-surface hover:text-ink focus-visible:opacity-100 group-hover/node:opacity-100",
              aria: { label: "Add a page under #{title}" } %>
      <% end %>
    </div>
  <% end %>

  <%# Always rendered, even with no children -- every node's children list is
      a real SortableJS drop target (`data-admin--tree-target="list"`), so a
      currently-childless page can still receive a dropped page. Except under
      a context-only page (see the component's comment). %>
  <ul <%= tag.attributes("data-admin--tree-target": ("list" if drop_target?)) %> data-parent-id="<%= page.id %>" class="ml-4 flex flex-col gap-0.5 border-l border-line pl-2">
    <% children.each do |child| %>
      <%= render Admin::TreeNodeComponent.new(page: child, children_by_parent: children_by_parent, context_only_ids: context_only_ids, translation_counts: translation_counts, selected: selected, locale: locale, url_options: url_options) %>
    <% end %>
  </ul>
</li>
