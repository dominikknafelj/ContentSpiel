<div id="<%= lanes_id %>" class="admin-section-lanes" data-admin--editor--section-target="lanes" data-columns="<%= lanes.size %>" style="--lanes: <%= lanes.size %>">
  <% lanes.each do |column, blocks| %>
    <div class="admin-section-lane flex min-w-0 flex-col gap-1">
      <p class="admin-section-lane__label font-cs-mono text-label text-meta" aria-hidden="true"><%= column_label(column) %></p>
      <%# Nothing but tiles in here: see the component. %>
      <%= tag.div id: lane_id(column), role: "list", aria: { label: column_label(column) },
            data: { "admin--editor--blocks-target": "lane", section_id: section.id, column: column, no_drop: closed? ? "" : nil } do %>
        <% blocks.each do |block| %>
          <%= render tile(block) %>
        <% end %>
      <% end %>
      <%# The lane's "+": after the lane, in its wrapper, never in the lane. Not for a lane
          that takes nothing (see the component). %>
      <% if picker? %>
        <%= render picker(column) %>
      <% end %>
    </div>
  <% end %>
</div>
