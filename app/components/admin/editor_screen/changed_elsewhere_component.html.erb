<%# The compact warn notice, an alert: announced at once, since the editor's
    typing was just not saved. Warn, never red: nothing is wrong with what
    they typed. %>
<%= render Admin::Ui::NoticeComponent.new(tone: :warn, size: :compact, id: "changed-elsewhere", class: "flex flex-wrap items-center gap-x-3 gap-y-1") do %>
  <p class="min-w-0 flex-1">
    <% if (found = change).nil? %>
      <%= t(".message") %>
    <% elsif found.own %>
      <%= t(".own_html", time: render(Admin::Ui::TimeAgoComponent.new(time: found.event.last_occurred_at))) %>
    <% else %>
      <%= t(".by_html", name: render(Admin::Ui::UserNameComponent.new(user: found.event.user, user_id: found.event.user_id)),
            time: render(Admin::Ui::TimeAgoComponent.new(time: found.event.last_occurred_at))) %>
    <% end %>
  </p>
  <%= link_to t(".reload"), reload_url, class: "shrink-0 font-semibold underline hover:text-ink", data: { turbo_frame: "_top" } %>
<% end %>
