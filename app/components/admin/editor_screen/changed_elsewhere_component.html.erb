<%# The compact warn notice, an alert: announced at once, since the editor's
    typing was just not saved. Warn, never red: nothing is wrong with what
    they typed. %>
<%= render Admin::Ui::NoticeComponent.new(tone: :warn, size: :compact, id: "changed-elsewhere", class: "flex flex-wrap items-center gap-x-3 gap-y-1") do %>
  <p class="min-w-0 flex-1">
    <% if (found = change) %>
      <% event = found.event %>
      <% if found.own %>
        Changed in another tab or window <%= render Admin::Ui::TimeAgoComponent.new(time: event.last_occurred_at) %>.
      <% else %>
        Changed by <%= render Admin::Ui::UserNameComponent.new(user: event.user, user_id: event.user_id) %> <%= render Admin::Ui::TimeAgoComponent.new(time: event.last_occurred_at) %>.
      <% end %>
    <% else %>
      Changed elsewhere.
    <% end %>
    Your text is still here so you can copy it; reloading shows the latest version.
  </p>
  <%= link_to "Reload", reload_url, class: "shrink-0 font-semibold underline hover:text-ink", data: { turbo_frame: "_top" } %>
<% end %>
