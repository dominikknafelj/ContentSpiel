<%= render Admin::Ui::DialogComponent.new(id: dialog_id, title: "Schedule publishing", width: :form_narrow, open_on_load: error.present?) do |dialog| %>
  <%= form_with url: url, method: :post, id: form_id, data: { turbo_frame: "_top", controller: "admin--queue-hold", action: "submit->admin--queue-hold#submit" }, html: { novalidate: true } do %>
    <label for="<%= input_id %>" class="<%= setup_label_class %>">Date and time</label>
    <%= tag.input type: "datetime-local", id: input_id, name: "published_at", value: input_value, min: min_value,
          class: setup_input_class, aria: { invalid: (error ? "true" : nil), describedby: [ (error_id if error), zone_id ].compact.join(" ") } %>
    <p id="<%= zone_id %>" class="mt-2 text-[13px] text-dim"><%= zone_line %></p>
    <% if error %>
      <p id="<%= error_id %>" role="alert" class="mt-2 text-[13px] text-danger-ink"><%= error %></p>
    <% end %>
  <% end %>
  <% dialog.with_footer do %>
    <% if scheduled? %>
      <%# Its own form, NOT a submit button of the schedule form: the default
          button of a form (what Enter in the date field presses) is the first
          submit whose owner it is, and this one sits first in the footer --
          Enter would have removed the schedule instead of saving the new
          time. "Schedule" is the schedule form's only submit. %>
      <%= form_with url: url, method: :post, class: "mr-auto", data: { turbo_frame: "_top", controller: "admin--queue-hold", action: "submit->admin--queue-hold#submit" } do %>
        <%= hidden_field_tag :remove, "1", id: nil %>
        <%= render Admin::Ui::ButtonComponent.new(label: "Remove schedule", variant: :ghost, type: "submit") %>
      <% end %>
    <% end %>
    <%= tag.form method: "dialog" do %>
      <%= render Admin::Ui::ButtonComponent.new(label: "Cancel", variant: :ghost, type: "submit") %>
    <% end %>
    <%= render Admin::Ui::ButtonComponent.new(label: "Schedule", variant: :primary, type: "submit", form: form_id) %>
  <% end %>
<% end %>
