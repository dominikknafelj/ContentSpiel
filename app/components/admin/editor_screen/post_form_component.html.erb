<%# The header (breadcrumb, title, publish state, actions, language tabs) is
    `Admin::EditorScreen::HeaderComponent`, shared with the page editor. Its
    dialogs are siblings of it, so they sit outside this form. %>
<% unless form_only? %>
<%= render Admin::EditorScreen::HeaderComponent.new(record: post, locale: locale, url_options: url_options, slot_context: @slot_context, hold_strip: (hold_strip if held?)) do |header| %>
  <% header.with_suggest do %>
    <%# Suggest translations for N empty fields / Use all (translation helpers spec §6.4). %>
    <%= render Admin::TranslationScreen::TranslateAllComponent.new(record: post, locale: locale, editable: editable? && !read_only_hold?) %>
  <% end %>
<% end %>
<% end %>

<%# `data-controller="admin--saving--autosave"` sits on this form directly, same as
    `Admin::EditorScreen::PageSettingsFormComponent`'s own (see that component's own
    comment for why the save-status line, up in the header above rather
    than nested inside this form, needs no Stimulus target here to reach
    it) -- and only on an editable post (`form_data`). The `<fieldset>`
    (`contents`, so it doesn't affect the form's layout) disables every
    field at once for a view-only one. %>
<%# The fetched answer (`form_only`) carries the notice area too, so that the strip comes and
    goes with the hold: `admin--editing--live` merges it around an alert already there. On one
    line, so that `:empty` holds without a strip. %>
<% if form_only? %><div id="editor-notice"><%= render hold_strip if held? %></div><% end %>

<%= form_with url: form_url, method: :patch, id: "post-form", class: "admin-translation-form #{Admin::EditorScreen::FormColumn.classes(locale)} flex flex-col gap-4 rounded-cs border border-line bg-surface p-4", data: form_data.merge(editing_unit: "", editing_subject: "record", editing_version: editing_version, **held_marks) do %>
<%= tag.fieldset disabled: !editable?, class: [ "contents", ("admin-view-only" unless editable?), ("admin-held" if read_only_hold?) ] do %>
<%= fields do %>

  <%= render partial: "admin/shared/base_updated_at_field", locals: { id: base_updated_at_id, value: base_updated_at_value } %>

  <%# Wraps title + slug only, for `admin--editor--slug-preview` -- same pairing
      `Admin::EditorScreen::PageSettingsFormComponent` already uses. %>
  <div data-controller="admin--editor--slug-preview" data-action="input->admin--editor--slug-preview#update">
    <%= render Admin::Columns::PlainColumnComponent.new(
          name: "title", id: field_id("title"), html_name: field_html_name("title"),
          value: value(:title), original: original(:title), locale: locale, errors: field_errors("title"), **translation(:title),
          data: { "admin--editor--slug-preview-target": "title" }
        ) %>

    <%= render Admin::Columns::SlugColumnComponent.new(
          name: "slug", id: field_id("slug"), html_name: field_html_name("slug"),
          value: value(:slug), base_url: slug_base_url, original: original(:slug), locale: locale, errors: field_errors("slug"),
          data: { "admin--editor--slug-preview-target": "slug" }, help: "The last part of the post’s address. Changing it leaves a redirect from the old address."
        ) %>
  </div>

  <%= render Admin::Columns::PlainColumnComponent.new(
        name: "excerpt", id: field_id("excerpt"), html_name: field_html_name("excerpt"),
        value: value(:excerpt), original: original(:excerpt), locale: locale, multiline: true, errors: field_errors("excerpt"),
        **translation(:excerpt)
      ) %>

  <%# The content type's own typed fields (spec §5.2): a `group` field
      renders as a nested fieldset, `groups` as an add/remove/reorder list
      (`Admin::Fields::GroupField`/`GroupsField`) -- every one of them, plus
      every scalar field, dispatched through the one `Admin::Ui::FieldComponent`
      `Admin::EditorScreen::BlockCardComponent`'s own schema fields already go through.
      `id_prefix: ID_PREFIX` (the bare "post") is passed explicitly rather
      than left to default from `form_name` ("post[fields]" ->
      "post_fields") -- see `Admin::PostsController#post_error_fields`'s own
      comment for why every id here has to agree with that bare prefix. %>
  <% if fields_group? %>
    <%# Titled with the type's label ("RESUME ENTRY FIELDS", design pass round 2, handoff §9 B23) so the
        type's own fields read as one group between Excerpt and Body rather than more loose columns. %>
    <section class="admin-fields-group flex flex-col gap-1 rounded-cs border border-line p-3" data-editor-fields-group aria-labelledby="<%= field_id("fields-group-title") %>">
      <h2 id="<%= field_id("fields-group-title") %>" class="font-cs-mono text-label uppercase tracking-mono text-meta" data-fields-group-title><%= fields_group_title %></h2>
    <% schema_fields.each do |field| %>
      <%= render Admin::Ui::FieldComponent.new(
            field: field, form_name: "post[fields]",
            value: field_value(field), original: field_original(field), locale: locale,
            errors: field_errors_for(field), id_prefix: ID_PREFIX, **translation(field.name)
          ) %>
    <% end %>

    <%# On a translation tab the fields that are the same in every language are not inputs but
        one collapsed, read-only list (`schema_fields` above already left them out), so this
        tab's autosave can never send -- and never change -- a shared value. %>
    <%= render Admin::EditorScreen::SharedFieldsComponent.new(fields: shared_fields, primary_url: primary_url) %>

    </section>
  <% end %>

  <%= render Admin::Columns::RichTextColumnComponent.new(
        name: "body", id: field_id("body"), html_name: field_html_name("body"),
        value: value(:body), original: original(:body), locale: locale, errors: field_errors("body"),
        editable: editable? && !read_only_hold?, **translation(:body)
      ) %>

  <%# Tags are shared by every language (they are not translated), and a new name is created on save. %>
  <%= render Admin::Ui::ChipInputComponent.new(
        name: "#{field_html_name("tag_names")}[]", id: field_id("tag_names"), label: "Tags", chips: tag_chips,
        search_url: helpers.admin_tag_suggestions_path, create: true, lowercase: true, max_length: Tag::MAX_NAME_LENGTH, noun: "tag", placeholder: "Add a tag…",
        errors: field_errors("tag_names"), help: "Press Enter or a comma to add. New tags are created when you save."
      ) %>

  <%= render Admin::EditorScreen::RelatedPostsComponent.new(
        post: post, locale: locale, url_options: url_options, errors: field_errors("related_post_ids")
      ) %>
<% end %>
<% end %>
<% end %>
