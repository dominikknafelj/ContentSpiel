<%= tag.div id: "editing", class: "admin-editor-area", data: region_data do %><%= content %>
<%# What the live script puts in the header's notice area when the record is
    gone (`admin--editing--live#gone`): the "Changed elsewhere" bar's compact
    warn notice, a warning and not an error. It keeps the notice's alert: the
    notice area is no live region, so nothing else would announce it. %>
<template data-admin--editing--live-target="missing">
  <%= render Admin::Ui::NoticeComponent.new(tone: :warn, size: :compact, class: "flex flex-wrap items-center gap-x-3 gap-y-1", data: { editing_missing: "" }) do %>
    <p class="min-w-0 flex-1"><%= t(@record.is_a?(::Page) ? ".missing" : ".missing_post") %></p>
    <%= link_to t(@record.is_a?(::Page) ? ".back" : ".back_post"), (@record.is_a?(::Page) ? helpers.admin_pages_path(**@url_options) : helpers.admin_posts_path(**@url_options)), class: "shrink-0 font-semibold underline hover:text-ink", data: { turbo_frame: "_top" } %>
  <% end %>
</template>
<%# The notice of a deleted block whose own answer could not name who deleted it (a read that
    says 404, or none): the plain sentence, for the id 0 the script puts the block's id in. %>
<% if @record.is_a?(::Page) %>
  <%# The head's words after this tab took a block over, which `editing/marks.js` puts where an
      "Updated by" mark would stand. %>
  <template data-admin--editing--hold-target="takenOver"><%= render Admin::EditorScreen::UpdatedMarkComponent.new(taken_over: true) %></template>
  <template data-admin--editing--hold-target="deleted"><%= render Admin::EditorScreen::HoldStripComponent.new(subject: ::ContentBlock.new(id: 0), hold: nil, viewer: nil, kind: :deleted, actor: nil) %></template>
<% end %><% end %>
