<%= form_with url: url, method: :post, id: form_id, data: { turbo_frame: "_top" } do %>
  <%= render Admin::Ui::ErrorSummaryComponent.new(errors: error_summary, field_ids: field_ids) %>

  <div class="mb-4">
    <label for="<%= TITLE_ID %>" class="<%= setup_label_class %>"><%= t(".title") %></label>
    <%= text_field_tag "post[title]", title, id: TITLE_ID, autofocus: true, autocomplete: "off", class: setup_input_class,
          data: { admin__editor__new_record_target: "title" }, aria: { invalid: (title_invalid? ? "true" : nil) } %>
  </div>

  <% if single_type? %>
    <%= hidden_field_tag "post[content_type]", selected_choice.name, id: TYPE_ID, data: { admin__editor__new_record_target: "type", path: selected_choice.path } %>
  <% else %>
    <div class="mb-4">
      <label for="<%= TYPE_ID %>" class="<%= setup_label_class %>"><%= t(".type") %></label>
      <select name="post[content_type]" id="<%= TYPE_ID %>" class="mt-1 <%= setup_select_class %>" data-admin--editor--new-record-target="type"
              <%= tag.attributes(aria: { invalid: ("true" if type_invalid?) }) %>>
        <% choices.each do |choice| %>
          <%= tag.option choice.label, value: choice.name, selected: selected?(choice), data: { path: choice.path } %>
        <% end %>
      </select>
    </div>
  <% end %>

  <p data-admin--editor--new-record-target="url" class="text-small text-dim"><%= initial_url %></p>
  <p class="mt-1 text-small text-meta"><%= note %></p>
<% end %>
