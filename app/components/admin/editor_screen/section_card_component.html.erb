<%# A frame, not a card: its border, radius and transparent ground are the stylesheet's
    (`.admin-section-card`), and so is its state edge, read from `data-card-edge` (see the
    component). %>
<%= tag.div id: dom_id, class: "admin-block-card admin-section-card", data: wrapper_data do %>
  <% if unavailable? %>
    <%# A section whose type is gone (see the component): the unavailable block card's
        header and a sentence, over the blocks it still holds, and a section's own two
        removals under their own names -- the one that keeps the blocks first. The header
        wraps: on a narrow card the two buttons go under the type's name. %>
    <div class="flex flex-wrap items-center gap-2 p-3">
      <span class="min-w-48 flex-1 truncate text-sm font-semibold text-danger-ink"><%= t(".unavailable", type: section.block_type) %></span>
      <% if editable? %>
        <%= form_with url: destroy_path, method: :delete, data: settled_screen_data do %>
          <%= hidden_field_tag :keep_blocks, 1, id: nil %>
          <%= render Admin::Ui::ButtonComponent.new(label: t(".remove_keep"), variant: :secondary, size: :small, type: "submit") %>
        <% end %>
        <%= render Admin::Ui::ButtonComponent.new(label: t(".delete"), variant: :danger_text, size: :small, data: dialog_trigger(delete_dialog_id)) %>
      <% end %>
    </div>
    <p class="px-3 pb-3 text-xs text-meta"><%= t(".unavailable_hint") %></p>
  <% else %>
  <%# The head, tinted in the structure colour: the handle, the type's chip, the name that
      collapses the card, the settings as words, the count and the "⋯" menu. It wraps: on a
      narrow card the words go under the name. Collapsed, the head is the whole card:
      "Section 3 columns ▾ … 5 blocks". %>
  <%# It has an id, as every ancestor of a unit up to the block list does: `editing/merge`
      reconciles the card in place around the settings form below when that form holds
      unsaved changes, and finds the head again by it. %>
  <div id="<%= header_id %>" class="admin-section-card__head flex flex-wrap items-center gap-2">
    <% if editable? %>
      <%# The block card's own handle, class and actions: `admin--editor--blocks` drags and
          moves a section's card as it does any card of the list. %>
      <button type="button" class="admin-block-card__handle shrink-0 cursor-grab select-none rounded-cs px-0.5 text-meta hover:text-ink focus-visible:outline-2 focus-visible:outline-accent"
              aria-label="<%= t(".move") %>" aria-describedby="block-drag-help"
              data-action="keydown->admin--editor--blocks#key focusout->admin--editor--blocks#blur">⠿</button>
    <% end %>
    <%= render Admin::EditorScreen::BlockIconComponent.new(definition: section.definition, place: :section) %>

    <%# The name collapses the card, as a block card's does. %>
    <button type="button" class="shrink-0 truncate text-left text-sm font-semibold text-ink"
            aria-expanded="true" aria-controls="<%= body_id %>" data-action="click->admin--editor--blocks#toggle">
      <%= t(".name") %>
    </button>
    <%= render self.class.words(section: section, editable: editable?) %>
    <%= render self.class.summary(section: section, count: blocks.size) %>

    <% if editable? %>
      <%= render Admin::Ui::MenuComponent.new(label: "⋯", aria_label: t(".actions"), close_on_select: true) do |menu| %>
        <% menu.with_item { take_over_item } if read_only_hold? %>
        <% menu.with_item do %>
          <%= tag.button t(".move_up"), type: "button", disabled: first?, class: menu_item_class,
                data: { move: "up", action: "click->admin--editor--blocks#moveUp" } %>
        <% end %>
        <% menu.with_item do %>
          <%= tag.button t(".move_down"), type: "button", disabled: last?, class: menu_item_class,
                data: { move: "down", action: "click->admin--editor--blocks#moveDown" } %>
        <% end %>
        <% menu.with_item do %>
          <%= button_to t(".duplicate"), duplicate_path, method: :post, class: menu_item_class %>
        <% end %>
        <% menu.with_item do %>
          <%= tag.div role: "separator", class: "my-1 h-px bg-line" %>
        <% end %>
        <% menu.with_item do %>
          <%= button_to t(".remove_keep"), destroy_path, method: :delete, params: { keep_blocks: 1 }, class: menu_item_class, form: { data: settled_screen_data } %>
        <% end %>
        <% menu.with_item do %>
          <%= tag.button t(".delete"), type: "button", class: "#{menu_item_class} text-danger-ink", data: dialog_trigger(delete_dialog_id) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <%# Between the head and the settings, as a block card's is under its head: always there,
      empty unless the section's own settings are held, and in sight while the region is
      closed. %>
  <div id="<%= hold_slot_id %>" data-editing-strip-slot><%= render hold_strip if held? %></div>
  <span class="sr-only" aria-live="polite" data-editing-announcer></span>

  <%# The one element that holds the section's settings form (see the component): hidden
      until a word of the head opens it, never replaced by an answer. Close is outside the
      form, so a reader's disabled fieldset does not disable it. %>
  <%= tag.div id: settings_id, hidden: true, class: "admin-section-card__settings mx-3 mb-3 rounded-card bg-rail p-3",
        data: { "admin--editor--section-target": "settings" } do %>
    <%# The section's own settings (see the component): an autosave form like a block
        card's, with the same ids. No form may be nested in it. %>
    <%= form_with url: form_url, method: :patch, id: form_id, class: "flex flex-wrap items-center gap-2", data: form_data.merge(editing_unit: "", editing_subject: ::Editing.key(section), editing_version: editing_version, **held_marks) do %>
      <%= tag.fieldset disabled: !editable?, data: { controller: "admin--editor--template-fields" }, class: [ "contents", ("admin-view-only" unless editable?), ("admin-held" if read_only_hold?) ] do %>
      <%= fields do %>
        <%= render partial: "admin/shared/base_updated_at_field", locals: { id: base_updated_at_id, value: base_updated_at_value } %>
        <%# What the layout menu writes into. Beside the menu, not in it: the menu is
            replaced after a save, and this input is the form's own. %>
        <%= hidden_field_tag "block[settings][layout]", layout_menu.current, id: field_id("layout") %>
        <%= render layout_menu %>
        <%= select_tag "block[settings][background]", options_for_select(background_options, setting("background")),
              id: field_id("background"), class: select_class, "aria-label": t(".background") %>
        <%= select_tag "block[settings][width]", options_for_select(width_options, setting("width")),
              id: field_id("width"), class: select_class, "aria-label": t(".width") %>
        <% if style? %>
          <%= select_tag "block[settings][style]", options_for_select(style_options, setting("style")),
                id: field_id("style"), class: select_class, "aria-label": t(".style"), "aria-describedby": field_id("style-note"),
                data: { "admin--editor--template-fields-target": "select", action: "change->admin--editor--template-fields#update" } %>
        <% end %>
        <%# The address of a link that jumps here. Its help line is the field's description
            for a screen reader and its tooltip; the row has no room for it in sight. %>
        <%= text_field_tag "block[settings][anchor]", setting("anchor"), id: field_id("anchor"), autocomplete: "off", spellcheck: false,
              placeholder: t(".anchor"), title: t(".anchor_help"), "aria-label": t(".anchor"), "aria-describedby": field_id("anchor-help"),
              class: "admin-well w-32 px-2.5 py-1 text-sm text-ink placeholder:text-meta" %>
        <span id="<%= field_id("anchor-help") %>" class="sr-only"><%= t(".anchor_help") %></span>
        <%= render Admin::Ui::SaveStatusComponent.new(id: status_id, state: :idle, live: page.published_at.present?) %>
        <%# Issue 146: a style may set its own layout, background or width, and the CMS cannot
            know whether this one does, so a style other than the default gets one help
            line. Always drawn and shown or hidden by the chosen style, as the page
            settings' template fields are (`admin--editor--template-fields`); it writes
            nothing but `hidden`, so a held form keeps it. %>
        <% if style? %>
          <p id="<%= field_id("style-note") %>" class="basis-full text-xs text-meta" <%= "hidden" if style_note_hidden? %>
             data-admin--editor--template-fields-target="group" data-template-field="style-note"><%= t(".style_note") %></p>
        <% end %>
        <%# One slot per setting, as every field of a block has: `update` replaces all five
            with each answer. Together they take a line of their own, and no room at all
            while none holds a message (`.admin-section-errors`). %>
        <div class="admin-section-errors basis-full">
          <% %w[layout background width style anchor].each do |name| %>
            <%= helpers.render "admin/shared/field_errors", id: error_id(name), messages: [] %>
          <% end %>
        </div>
      <% end %>
      <% end %>
    <% end %>

    <div class="mt-2 flex justify-end">
      <%= render Admin::Ui::ButtonComponent.new(label: t(".close_settings"), variant: :tertiary, size: :small, data: { action: "admin--editor--section#closeSettings" }) %>
    </div>
  <% end %>
  <% end %>

  <div id="<%= body_id %>" data-block-body class="flex flex-col gap-3 px-3 pt-3 pb-3">
    <%= render lanes %>

    <%# Every block's form, hidden, one shown at a time (see the component). No gap
        between hidden panels: `hidden` takes them out of the flex layout. %>
    <div id="<%= panels_id %>" class="flex flex-col">
      <% blocks.each do |block| %>
        <%= render panel(block) %>
      <% end %>
    </div>
  </div>

  <%# "Delete section and its blocks…": after the body, outside the settings form. Its
      count is kept current by every add and delete inside the section. %>
  <% if editable? %>
    <%= render Admin::Ui::ConfirmDialogComponent.new(destructive: true, id: delete_dialog_id, title: t(".delete_title"), body: t(".delete_body")) do |dialog| %>
      <% dialog.with_details do %>
        <%= render self.class.delete_count(section: section, count: blocks.size) %>
        <%# The open notes on the section's blocks, deleted with them (notes spec D12), in
            a sentence of their own (the handoff's decision 7): filled by `admin--notes--drawer`
            from the markers of the tiles inside this card. The section itself takes no
            notes (decision 10): this card has no marker and no "Add note" in its menu,
            and "Remove section, keep blocks" above stays one press with nothing to say. %>
        <%= tag.p(**Admin::EditorScreen::DeleteBlockDialogComponent.notes_warning_attributes(dom_id, spacing: "mt-2", kind: :section)) %>
      <% end %>
      <% dialog.with_confirm_action do %>
        <%= form_with url: destroy_path, method: :delete do %>
          <%= render Admin::Ui::ButtonComponent.new(label: t(".delete_confirm"), variant: :danger, type: "submit") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
