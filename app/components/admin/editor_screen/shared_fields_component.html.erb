<details class="admin-shared-fields mb-4 rounded-cs border border-line bg-paper p-3" data-shared-fields>
  <summary class="<%= setup_label_class %> cursor-pointer">Shared fields (<%= count %>)</summary>

  <p class="mt-2 text-sm text-meta">Shared by all languages. Edit them on the <%= primary_name %> tab.</p>

  <dl class="mt-2 flex flex-col gap-2">
    <% fields.each do |label, value| %>
      <div>
        <dt class="<%= setup_label_class %>"><%= label %></dt>
        <dd class="text-ink"><%= value.presence || "—" %></dd>
      </div>
    <% end %>
  </dl>
</details>
