<details class="admin-shared-fields mb-4 rounded-cs border border-line bg-paper p-3" data-shared-fields>
  <summary class="<%= setup_label_class %> cursor-pointer">Shared fields (<%= count %>)</summary>

  <p class="mt-2 text-sm text-meta">Shared by all languages. Edit them on the <%= primary_name %> tab.</p>

  <dl class="mt-2 flex flex-col gap-2">
    <% fields.each do |label, value| %>
      <div>
        <dt class="<%= setup_label_class %>"><%= label %></dt>
        <dd class="text-ink">
          <% if value.is_a?(Admin::EditorScreen::SharedFieldsComponent::Code) %>
            <p class="mb-1 text-xs text-meta" data-code-note><%= code_note %></p>
            <%# The line break after the opening tag is the one a browser drops: see the component. %>
            <pre tabindex="0" class="max-h-[12lh] overflow-auto rounded-cs border border-line bg-sunken p-2 font-cs-mono text-sm text-ink [tab-size:2]">
<%= value.text %></pre>
          <% else %>
            <%= value.presence || "—" %>
          <% end %>
        </dd>
      </div>
    <% end %>
  </dl>
</details>
