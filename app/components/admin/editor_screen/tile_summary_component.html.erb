<% if pictured? %>
  <%# The picture's layout: the type's picture (markup the type wrote, hidden from a screen reader), then the line with its
      hints over the preview's heading, and the preview's text only without a picture. Every word is ERB-escaped. %>
  <span id="<%= dom_id %>" class="admin-block-tile__summary flex min-w-0 items-start gap-2.5">
    <% if picture %>
      <span class="admin-block-tile__picture flex h-18 w-28 shrink-0 items-center justify-center overflow-hidden rounded-cs border border-line bg-surface p-1.5" aria-hidden="true"><%= picture %></span>
    <% end %>
    <span class="flex min-w-0 flex-col gap-0.5">
      <span class="flex min-h-[1lh] min-w-0 items-center gap-1.5 text-sm text-dim">
        <% if attention? %>
          <span id="<%= attention_id %>" class="shrink-0 font-semibold text-warn-ink" role="img" aria-label="<%= t(".attention") %>">!</span>
        <% end %>
        <span id="<%= name_id %>" class="truncate"><% parts.each do |text, look| %><%= look ? tag.span(text, class: look) : text %><% end %></span>
      </span>
      <% if picture_heading.present? || picture_text.present? %>
        <%# The two stand against each other: white space between them would be read with the description. %>
        <span id="<%= text_id %>" class="flex min-w-0 flex-col gap-0.5"><% if picture_heading.present? %><span class="admin-block-tile__text truncate text-sm text-dim"><%= picture_heading %></span><% end %><% if picture_text.present? %><span class="<%= preview_text_class %>"><%= picture_text %></span><% end %></span>
      <% end %>
    </span>
  </span>
<% elsif preview %>
  <%# The preview: the heading (with the mark and the thumbnail before it) over the text. Every word is ERB-escaped. %>
  <span id="<%= dom_id %>" class="admin-block-tile__summary flex min-w-0 flex-col gap-0.5">
    <% if preview.heading.present? || attention? || thumbnail_asset %>
      <span class="admin-block-tile__heading flex min-w-0 items-center gap-1.5">
        <% if attention? %>
          <span id="<%= attention_id %>" class="shrink-0 font-semibold text-warn-ink" role="img" aria-label="<%= t(".attention") %>">!</span>
        <% end %>
        <% if thumbnail_asset %>
          <%= render Admin::Ui::LibraryImageComponent.new(asset: thumbnail_asset, min_width: 480, css_class: "size-6 shrink-0 rounded-cs border border-line object-cover") %>
        <% end %>
        <% if preview.heading.present? %>
          <%# `text-base`: the nearest size token to the drawing's 17px. %>
          <span id="<%= name_id %>" class="admin-block-tile__title block truncate text-base font-semibold text-ink"><%= preview.heading %></span>
        <% end %>
      </span>
    <% end %>
    <% if preview.text.present? %>
      <span id="<%= text_id %>" class="<%= preview_text_class %>"><%= preview.text %></span>
    <% end %>
    <% if invalid %>
      <span id="<%= status_id %>" class="text-sm text-dim"><%= needs_fixing %></span>
    <% end %>
  </span>
<% else %>
  <%# `min-h-[1lh]`: a tile with no line keeps the height of one, so the tiles of a lane line up. %>
  <span id="<%= dom_id %>" class="admin-block-tile__summary flex min-h-[1lh] min-w-0 items-center gap-1.5 text-sm text-dim">
    <% if attention? %>
      <%# Never colour alone: the mark is a glyph with a name, and the line beside it says what is wrong. %>
      <span id="<%= attention_id %>" class="shrink-0 font-semibold text-warn-ink" role="img" aria-label="<%= t(".attention") %>">!</span>
    <% end %>
    <% if thumbnail_asset %>
      <%= render Admin::Ui::LibraryImageComponent.new(asset: thumbnail_asset, min_width: 480, css_class: "size-6 shrink-0 rounded-cs border border-line object-cover") %>
    <% end %>
    <%# The parts stand directly against each other: white space between them would be drawn. %>
    <span id="<%= name_id %>" class="truncate"><% parts.each do |text, look| %><%= look ? tag.span(text, class: look) : text %><% end %></span>
  </span>
<% end %>
