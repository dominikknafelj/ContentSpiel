<%= form_with url: url, method: :post, id: form_id, data: { turbo_frame: "_top" } do %>
  <%= render Admin::Ui::ErrorSummaryComponent.new(errors: error_summary, field_ids: field_ids) %>

  <div class="mb-4">
    <label for="<%= TITLE_ID %>" class="<%= setup_label_class %>">Title</label>
    <%= text_field_tag "page[title]", title_value, id: TITLE_ID, autofocus: true, autocomplete: "off", class: setup_input_class,
          data: { admin__editor__new_record_target: "title" }, aria: { invalid: (title_invalid? ? "true" : nil) } %>
  </div>

  <div class="mb-4 grid <%= choices.any? && template_field? ? "grid-cols-2" : "grid-cols-1" %> gap-3">
    <% if choices.any? %>
      <div class="min-w-0">
        <label for="<%= INSIDE_ID %>" class="<%= setup_label_class %>">Inside</label>
        <select name="page[parent_id]" id="<%= INSIDE_ID %>" class="mt-1 <%= setup_select_class %>" data-admin--editor--new-record-target="inside"
                <%= tag.attributes(aria: { invalid: ("true" if inside_invalid?) }) %>>
          <% choices.each do |choice| %>
            <%= tag.option choice.label, value: choice.id, selected: (choice.id == selected_choice.id), data: { path: choice.path, title: choice.title } %>
          <% end %>
        </select>
      </div>
    <% end %>
    <% if template_field? %>
    <div class="min-w-0">
      <label for="<%= TEMPLATE_ID %>" class="<%= setup_label_class %>"><%= t(".template") %></label>
      <%= select_tag "page[template]", options_for_select(template_options, template), id: TEMPLATE_ID, class: "mt-1 #{setup_select_class}" %>
    </div>
    <% end %>
  </div>

  <p data-admin--editor--new-record-target="url" class="text-small text-dim"><%= initial_url %></p>
  <p data-admin--editor--new-record-target="note" class="mt-1 text-[13px] text-meta"><%= initial_note %></p>
<% end %>
