<%= render Admin::Ui::ChipInputComponent.new(
      name: html_name, id: search_id, label: "Related posts", chips: chips, search_url: search_url,
      placeholder: "Search posts to link…", exclude: [ post.id ], errors: errors, hidden_note: hidden_note,
      help: t(".help")
    ) do %>
  <% if (from = related_from).any? %>
    <p class="mt-2 text-sm text-meta">
      Also related from: <%= safe_join(from.map { |other| link_to(title_for(other), editor_path(other), class: "underline hover:text-ink") }, ", ") %>
      (edit on that post)
    </p>
  <% end %>
<% end %>
