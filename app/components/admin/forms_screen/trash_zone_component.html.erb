<% if zone? %>
  <%= render Admin::Ui::ActionZoneComponent.new(heading_id: "form-trash-zone-title", heading: t(".title"), body: t(".body"), class: "mt-2", data: { zone: "trash" }) do |zone| %>
    <% zone.with_trigger do %>
      <%= render Admin::Ui::ButtonComponent.new(label: t(".button"), variant: :danger_text, size: :small, type: "button", data: dialog_trigger(dialog_id)) %>
    <% end %>
  <% end %>
<% end %>

<%= render Admin::Ui::ConfirmDialogComponent.new(destructive: true, id: dialog_id, title: t(".dialog_title", name: name), body: body) do |dialog| %>
  <% dialog.with_confirm_action do %>
    <%= form_with url: destroy_path, method: :delete, data: { turbo_frame: "_top" } do %>
      <%= render Admin::Ui::ButtonComponent.new(label: t(".confirm"), variant: :danger, type: "submit") %>
    <% end %>
  <% end %>
<% end %>
