<% fields = capture do %>
  <% if refused? %>
    <%= render Admin::Ui::NoticeComponent.new(tone: :danger, size: :compact, class: "mb-4") do %>
      <% errors.each do |error| %><p><%= error %></p><% end %>
    <% end %>
  <% end %>
  <%= form_with url: create_path, method: :post, id: FORM_ID, class: "flex flex-col gap-4", data: { turbo_frame: "_top" }, html: { novalidate: true } do %>
    <% if page? %><%= hidden_field_tag :from, "page", id: nil %><% end %>
    <div>
      <%= label_tag "new_form_name", t(".name"), class: setup_label_class %>
      <%= text_field_tag "form[name]", name, id: "new_form_name", required: true, maxlength: Forms::Form::NAME_MAX, autofocus: true, autocomplete: "off",
            aria: { describedby: "new_form_name_help" }, class: setup_input_class %>
      <p id="new_form_name_help" class="mt-1 text-sm text-meta"><%= t(".name_help") %></p>
    </div>
    <%= render Admin::Ui::SegmentedComponent.new(mode: :radios, name: "form[start]", label: t(".start"), legend: :visible,
          segments: STARTS.map { |value| { label: t(".#{value}"), value:, id: start_id(value), current: start == value } }) %>
    <div>
      <%= label_tag "new_form_recipients", t(".mail_to"), class: setup_label_class %>
      <%= text_area_tag "form[recipients]", recipients, id: "new_form_recipients", rows: 2, autocomplete: "off",
            aria: { describedby: "new_form_recipients_help" }, class: setup_input_class %>
      <p id="new_form_recipients_help" class="mt-1 text-sm text-meta"><%= t(".mail_to_help") %></p>
    </div>
  <% end %>
<% end %>

<% if page? %>
  <div class="max-w-md">
    <h1 class="mb-4 text-h1 text-ink"><%= t(".title") %></h1>
    <%= fields %>
    <div class="mt-4 flex gap-2">
      <%= render Admin::Ui::ButtonComponent.new(label: t(".create"), variant: :primary, type: "submit", form: FORM_ID) %>
      <%= link_to t(".cancel"), cancel_path, data: { turbo_frame: "content" }, class: setup_tertiary_link_class %>
    </div>
  </div>
<% else %>
  <%= render Admin::Ui::DialogComponent.new(id: DIALOG_ID, title: t(".title"), width: :form_narrow, open_on_load: refused?) do |dialog| %>
    <%= fields %>
    <% dialog.with_footer do %>
      <%= tag.form method: "dialog" do %>
        <%= render Admin::Ui::ButtonComponent.new(label: t(".cancel"), variant: :tertiary, type: "submit") %>
      <% end %>
      <%= render Admin::Ui::ButtonComponent.new(label: t(".create"), variant: :primary, type: "submit", form: FORM_ID) %>
    <% end %>
  <% end %>
<% end %>
