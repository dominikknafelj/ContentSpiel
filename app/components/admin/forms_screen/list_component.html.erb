<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <div class="flex flex-col gap-1">
    <h1 class="text-h1 text-ink"><%= t(".title") %></h1>
    <p class="text-meta"><%= t(".intro") %></p>
  </div>
  <% if manage? %>
    <%# A link that opens the dialog; without JavaScript it is the New form page (`new.html.erb`), the posts list's "+ New post". %>
    <%= link_to t(".new_form"), new_form_path, data: dialog_trigger(Admin::FormsScreen::NewFormDialogComponent::DIALOG_ID).merge(turbo_frame: "content"), class: setup_primary_button_class %>
  <% end %>
</div>

<% if mail_warning? || !keys %>
  <div class="mb-4 flex flex-col gap-2">
    <% if mail_warning? %>
      <div class="<%= WARN_CLASS %>" data-forms-warning="mail">
        <p><%= t(".mail_not_ready") %></p>
        <% if settings_link? %>
          <p class="mt-1"><%= link_to t(".open_mail_settings"), mail_settings_path, class: "font-medium underline hover:no-underline", data: { turbo_frame: "_top" } %></p>
        <% end %>
      </div>
    <% end %>
    <% unless keys %>
      <div class="<%= WARN_CLASS %>" data-forms-warning="keys"><p><%= t(".no_keys") %></p></div>
    <% end %>
  </div>
<% end %>

<div class="rounded-card bg-surface shadow-1">
  <% if forms.empty? %>
    <%= render Admin::Ui::EmptyStateComponent.new(title: t(".empty.title"), description: t(".empty.description")) do |empty| %>
      <% if manage? %>
        <% empty.with_action do %>
          <%= link_to t(".new_form"), new_form_path, data: dialog_trigger(Admin::FormsScreen::NewFormDialogComponent::DIALOG_ID).merge(turbo_frame: "content"), class: setup_secondary_link_class %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%# Rounded as the card is, so the sticky Name column's ground keeps the card's corners. %>
    <div class="admin-table-scroll--x rounded-card">
      <table class="admin-forms-table admin-card-table w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-line-strong text-left text-label text-meta">
            <th class="py-2 pr-4"><%= t(".columns.name") %></th>
            <th class="py-2 pr-4"><%= t(".columns.fields") %></th>
            <th class="py-2 pr-4"><%= t(".columns.submissions") %></th>
            <th class="py-2 pr-4"><%= t(".columns.keeping") %></th>
            <th class="py-2 pr-4"><%= t(".columns.placed_on") %></th>
            <th class="py-2 pr-4"><%= t(".columns.updated") %></th>
            <th class="py-2"><span class="sr-only"><%= t(".columns.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% forms.each do |form| %>
            <tr id="<%= helpers.dom_id(form) %>" class="border-b border-line align-middle last:border-b-0">
              <td class="py-2.5 pr-4">
                <% if manage? %>
                  <%= link_to form.name, form_path(form), class: LINK_CLASS, data: { turbo_frame: "content" } %>
                <% elsif submissions? %>
                  <%= link_to form.name, submissions_path(form), class: LINK_CLASS, data: { turbo_frame: "content" } %>
                <% else %>
                  <span class="font-medium text-ink"><%= form.name %></span>
                <% end %>
              </td>
              <td class="py-2.5 pr-4 text-dim"><%= fields_count(form) %></td>
              <td class="py-2.5 pr-4">
                <% if submissions? %>
                  <span class="inline-flex flex-wrap items-center gap-2">
                    <%= link_to submissions_count(form), submissions_path(form), class: LINK_CLASS, aria: { label: t(".submissions_of", count: submissions_count(form), name: form.name) }, data: { turbo_frame: "content" } %>
                    <% if undelivered_count(form).positive? %>
                      <%= render Admin::Ui::StateChipComponent.new(tone: :warn, label: t(".not_delivered", count: undelivered_count(form))) %>
                    <% end %>
                  </span>
                <% else %>
                  <span class="text-meta">—</span>
                <% end %>
              </td>
              <td class="py-2.5 pr-4 text-dim"><%= keeping(form) %></td>
              <td class="py-2.5 pr-4 text-meta"><%= placed(form) %></td>
              <td class="py-2.5 pr-4 text-meta"><%= render Admin::Ui::TimeAgoComponent.new(time: form.updated_at) %></td>
              <td class="py-2.5 text-right">
                <% if manage? %>
                  <%= render Admin::Ui::MenuComponent.new(label: "⋯", aria_label: t(".actions_for", name: form.name), close_on_select: true) do |menu| %>
                    <% menu.with_item { link_to t(".open"), form_path(form), data: { turbo_frame: "content" } } %>
                    <% if submissions? %>
                      <% menu.with_item { link_to t(".submissions"), submissions_path(form), data: { turbo_frame: "content" } } %>
                    <% end %>
                    <% menu.with_item { content_tag(:div, "", class: "my-1 border-t border-line", role: "separator") } %>
                    <% menu.with_item { content_tag(:button, t(".move_to_trash"), type: "button", class: "text-danger-ink", data: dialog_trigger(trash_dialog_id(form))) } %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
<%= render Admin::Ui::PaginationComponent.new(pagination: pagination, url: page_url) %>

<%# The trash dialogs, after the table (outside every form), one per row a viewer may trash. %>
<% if manage? %>
  <% forms.each do |form| %>
    <%= render Admin::FormsScreen::TrashZoneComponent.new(form: form, placements: placements(form), zone: false, url_options: url_options) %>
  <% end %>
<% end %>
