<%= render Admin::Ui::SettingsCardComponent.new(heading_id: HEADING_ID, heading: t(".title"), icon: :life_buoy, family: :neutral,
      intro: t(".intro"), id: ID, class: "scroll-mt-6") do %>
  <div class="flex flex-col gap-3 px-4 py-3">
    <% if (words = warning) %>
      <%= render Admin::Ui::NoticeComponent.new(tone: :warn, size: :compact) do %><%= words %><% end %>
    <% end %>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-small text-dim" data-recovery-status><%= status %></p>
      <% if passkey? && made? %>
        <%= render Admin::Ui::ButtonComponent.new(label: t(".regenerate"), variant: :secondary, size: :small, type: "button", data: dialog_trigger(DIALOG_ID)) %>
      <% elsif passkey? %>
        <%= form_with url: generate_path, method: :post, data: { confirm_identity: "" } do %>
          <%= render Admin::Ui::ButtonComponent.new(label: t(".generate"), variant: :secondary, size: :small, type: "submit") %>
        <% end %>
      <% end %>
    </div>
  </div>
  <% if made? && passkey? %>
    <%= render Admin::Ui::ConfirmDialogComponent.new(id: DIALOG_ID, title: t(".regenerate_title"), body: t(".regenerate_body", count: unused)) do |dialog| %>
      <% dialog.with_confirm_action do %>
        <%= form_with url: generate_path, method: :post, data: { confirm_identity: "" } do %>
          <%= render Admin::Ui::ButtonComponent.new(label: t(".regenerate_confirm"), type: "submit") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
