<div class="mb-4 flex flex-col gap-2">
  <span class="text-label text-meta"><%= link_to t(".breadcrumb"), back_path, class: "text-meta hover:underline" %> /</span>
  <h1 class="text-h1 text-ink"><%= render Admin::AuditScreen::SentenceComponent.new(sentence: sentence) %></h1>
</div>

<%# Each cell draws its line on its right and at its foot, and the grid stands
    one pixel past the card's right and bottom edges, which clip it: the lines
    divide the cells inside the card and never draw its outer edge, at any
    number of columns. A gap over a line ground would fill a short last row's
    empty tracks with the line's colour. %>
<div class="mb-4 overflow-hidden rounded-card bg-surface shadow-1">
  <dl class="-mr-px -mb-px grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))]" data-audit-facts>
    <% cells.each do |key, value, mono| %>
      <div class="flex min-w-0 flex-col gap-1 border-b border-r border-line px-4 py-3">
        <dt class="text-label text-meta"><%= t(".cells.#{key}") %></dt>
        <%# The Security chip is words in the sans; only the value is mono. %>
        <dd class="m-0 flex flex-wrap items-center gap-2 break-words text-sm text-ink">
          <% if key == :action && sentence.security %><%= render Admin::Ui::StateChipComponent.new(tone: :warn, label: t(".security")) %><% end %>
          <span class="min-w-0 <%= "font-cs-mono" if mono %>"><%= value %></span>
        </dd>
      </div>
    <% end %>
    <div class="flex min-w-0 flex-col gap-1 border-b border-r border-line px-4 py-3">
      <dt class="text-label text-meta"><%= t(".cells.channel") %></dt>
      <dd class="m-0"><%= render(Admin::Ui::ChannelChipComponent.new(channel: event.channel)).presence || "—" %></dd>
    </div>
  </dl>
</div>
