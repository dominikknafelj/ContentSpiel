<%= form_with(**form_options) do %>
  <% if hidden_locale? %>
    <%= hidden_field_tag :locale, @locale, id: nil %>
  <% end %>

  <div>
    <%= label_tag :user_id, t(".user"), class: "sr-only" %>
    <%= select_tag :user_id, options_for_select(user_options, filter.user_id), include_blank: t(".anyone"), class: setup_select_class %>
  </div>

  <div>
    <%# Named `event_action`, not `action`: `params[:action]` is Rails' own routing parameter. %>
    <%= label_tag :event_action, t(".action"), class: "sr-only" %>
    <%= select_tag :event_action, grouped_options_for_select(action_groups, filter.event_action), include_blank: t(".any_action"), class: setup_select_class %>
  </div>

  <% if filter.subject? %>
    <%= hidden_field_tag :subject_type, filter.subject_type, id: nil %>
    <%= hidden_field_tag :subject_id, filter.subject_id, id: nil %>
    <span class="<%= chip_class %>" data-subject-chip>
      <span class="min-w-0 truncate"><%= t(".subject", type: subject_type_word, id: filter.subject_id) %></span>
      <%= link_to subject_clear_path, aria: { label: t(".remove_subject", type: subject_type_word) }, class: remove_class, data: { turbo_frame: "content", turbo_action: "replace" } do %><span aria-hidden="true">×</span><% end %>
    </span>
  <% else %>
    <div>
      <%= label_tag :subject_type, t(".type"), class: "sr-only" %>
      <%= select_tag :subject_type, options_for_select(type_options, filter.subject_type), include_blank: t(".any_content"), class: setup_select_class %>
    </div>
  <% end %>

  <div>
    <%= label_tag :channel, t(".channel"), class: "sr-only" %>
    <%= select_tag :channel, options_for_select(channel_options, filter.channel), include_blank: t(".all_channels"), class: setup_select_class %>
  </div>

  <div>
    <%= label_tag :range, t(".date"), class: "sr-only" %>
    <%= select_tag :range, options_for_select(date_options, filter.range), include_blank: t(".any_time"), class: setup_select_class %>
  </div>

  <% if filter.custom? %>
    <div>
      <%= label_tag :from, t(".from"), class: "sr-only" %>
      <%= date_field_tag :from, filter.from&.iso8601, class: DATE_CLASS %>
    </div>
    <div>
      <%= label_tag :to, t(".to"), class: "sr-only" %>
      <%= date_field_tag :to, filter.to&.iso8601, class: DATE_CLASS %>
    </div>
  <% end %>

  <noscript><%= render Admin::Ui::ButtonComponent.new(label: t(".filter"), variant: :secondary, type: "submit") %></noscript>
  <% if filter.active? %>
    <%= link_to t(".clear"), path, class: setup_secondary_link_class, data: { turbo_frame: "content", turbo_action: "replace" } %>
  <% end %>
<% end %>
