<li id="<%= dom_id %>" class="relative flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-line px-4 py-2.5 last:border-b-0 hover:bg-paper">
  <%# The link covers the whole row but shows only the time: its name says what
      it opens (and still begins with the words shown), and the row's sentence
      describes it, so a list of links is not a list of bare times. %>
  <%= link_to time_text, event_path, aria: { label: "#{time_text}, details of this change", describedby: "#{dom_id}-sentence" }, class: "w-28 shrink-0 font-cs-mono text-xs text-meta after:absolute after:inset-0 hover:underline focus-visible:outline-2 focus-visible:outline-accent" %>
  <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-sunken text-xs font-semibold text-ink" aria-hidden="true"><%= initial %></span>
  <p id="<%= dom_id %>-sentence" class="min-w-0 flex-1 basis-60 text-sm text-dim"><%= render Admin::AuditScreen::SentenceComponent.new(sentence: sentence) %></p>
  <%= render Admin::ChannelChipComponent.new(channel: event.channel) %>
  <span class="font-cs-mono text-[11px] <%= key_class %>"><%= event.action %></span>
</li>
