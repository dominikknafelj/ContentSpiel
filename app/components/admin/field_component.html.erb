<div class="admin-field mb-4" data-field-name="<%= field.name %>">
  <label class="<%= setup_label_class %> mb-1" for="<%= input_id %>"><%= label_text %></label>

  <div class="<%= show_original? ? "grid gap-3 md:grid-cols-2" : "" %>">
    <div><%= render input_component %></div>

    <% if show_original? %>
      <div class="rounded-cs border border-line bg-sunken px-3 py-2">
        <p class="<%= setup_label_class %> mb-1"><%= default_locale_name %></p>
        <p data-original-for="<%= field.name %>" class="text-ink"><%= original %></p>
        <span data-translate-slot="<%= field.name %>"></span>
        <% if (note = outdated_note) %><%= render note %><% end %>
      </div>
    <% end %>
  </div>

  <% if show_untranslated_hint? %>
    <p class="mt-1 text-sm text-meta">Same in all languages</p>
  <% end %>

  <div id="<%= errors_id %>" class="mt-1 text-sm text-danger-ink">
    <% errors.each do |message| %>
      <p><%= message %></p>
    <% end %>
  </div>
</div>
