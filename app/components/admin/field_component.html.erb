<% translate = show_original? ? translate_button : nil %>
<div class="admin-field mb-4" data-field-name="<%= field.name %>">
  <%# One side of the translation pair (or the whole field): label, input, the Translate button
      and the suggestion box. The error slot stays a direct child of `.admin-field`. %>
  <% field_side = capture do %>
    <label class="<%= setup_label_class %> mb-1" for="<%= input_id %>"><%= label_text %></label>
    <%= render input_component %>
    <div data-translate-slot="<%= field.name %>"><% if translate %><%= render translate %><% end %></div>
    <%= render "admin/shared/translation_box", button: translate %>
  <% end %>

  <% if show_original? %>
    <div class="admin-translation-pair">
      <div class="min-w-0"><%= field_side %></div>
      <%= render reference_card %>
    </div>
  <% else %>
    <%= field_side %>
  <% end %>

  <% if show_untranslated_hint? %>
    <p class="mt-1 text-sm text-meta">Same in all languages</p>
  <% end %>

  <%= helpers.render "admin/shared/field_errors", id: errors_id, messages: errors %>
</div>
