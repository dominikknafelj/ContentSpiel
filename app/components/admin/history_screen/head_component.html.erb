<div class="admin-list-rail__head flex-col items-stretch">
  <nav aria-label="<%= t(".breadcrumb") %>" class="min-w-0 truncate text-small text-meta">
    <% (crumbs + [ [ title, editor_url ] ]).each do |label, url| %>
      <% if url %>
        <%= link_to label, url, class: "hover:text-ink hover:underline" %>
      <% else %>
        <span><%= label %></span>
      <% end %>
      <span aria-hidden="true" class="px-0.5">/</span>
    <% end %>
    <span aria-current="page"><%= t(".title") %></span>
  </nav>
  <div class="flex flex-wrap items-center gap-2.5">
    <h1 class="min-w-0 truncate text-h1 text-ink"><%= title %></h1>
    <%= render Admin::Ui::StatusChipComponent.new(status: state.status, at: record.published_at) %>
    <% if state.changes? %>
      <%= render Admin::Ui::UnpublishedChipComponent.new %>
    <% end %>
    <%= link_to editor_url, class: "ml-auto #{Admin::Ui::ButtonComponent.classes(:secondary, size: :small)}" do %>
      <%= helpers.render "admin/shared/icon", name: :arrow_left, size: "size-4" %>
      <%= t(".back") %>
    <% end %>
  </div>
</div>
