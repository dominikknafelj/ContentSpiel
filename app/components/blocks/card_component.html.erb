<div class="content-block content-block--card">
  <%# One link per card: the title's, else the text's, and only with neither the image's, whose alt then names it. %>
  <% if image %>
    <% picture = render(Media::PictureComponent.new(**image, css_class: "content-block--card__image")) %>
    <% if link && !title && !text %><%= tag.a picture, href: link, class: "content-block--card__image-link" %><% else %><%= picture %><% end %>
  <% end %>
  <% if icon %>
    <span class="content-block--card__icon" aria-hidden="true"><%= icon %></span>
  <% end %>
  <% if title %>
    <h3 class="content-block--card__title"><% if link %><%= tag.a title, href: link %><% else %><%= title %><% end %></h3>
  <% end %>
  <% if text %>
    <p class="content-block--card__text"><% if link && !title %><%= tag.a text, href: link %><% else %><%= text %><% end %></p>
  <% end %>
</div>
