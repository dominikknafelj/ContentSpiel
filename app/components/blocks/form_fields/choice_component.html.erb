<% if radios? %>
  <%= tag.fieldset class: "form-field form-field--choice", **group_attributes do %>
    <%= tag.legend label_content, class: "form-field__label" %>
    <%= help_html %>
    <% field.labelled_choices.each do |choice| %>
      <div class="form-field__row">
        <%= tag.input **radio_attributes(choice) %>
        <%= tag.label field.choice_label(choice), for: radio_id(choice) %>
      </div>
    <% end %>
    <%= error_html %>
  <% end %>
<% else %>
  <div class="form-field form-field--choice">
    <%= label_html %>
    <%= help_html %>
    <%= tag.select **select_attributes do %>
      <%= tag.option field.word(:choose), value: "" %>
      <% field.labelled_choices.each do |choice| %>
        <%= tag.option field.choice_label(choice), value: choice.key, selected: chosen?(choice) %>
      <% end %>
    <% end %>
    <%= error_html %>
  </div>
<% end %>
