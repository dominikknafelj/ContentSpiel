<%# The copy script's markup is what a theme's own template has to write to keep the button
    working: the identifier, its `button`, `source` and `status` targets, its action and its
    three values (`label` is the button's word at rest, which the script writes back and never
    reads from the page). A head that holds nothing but the button is `hidden` and is the
    `strip` target, which the script shows with the button; a head with a file name or a
    language is neither. %>
<figure class="content-block content-block--code" data-controller="code-copy" data-code-copy-label-value="<%= string(:copy) %>" data-code-copy-copied-value="<%= string(:copied) %>" data-code-copy-failed-value="<%= string(:failed) %>">
  <%= tag.div class: "code-head", **head_attributes do %>
    <% if filename.present? %>
      <span class="code-file" id="<%= file_id %>"><%= filename %></span>
    <% end %>
    <% if language_label %>
      <span class="code-language"><%= language_label %></span>
    <% end %>
    <%= tag.button string(:copy), type: "button", hidden: true, aria: { label: string(:copy_code), describedby: (file_id if filename.present?) },
          data: { code_copy_target: "button", action: "code-copy#copy" } %>
    <span class="code-status" role="status" data-code-copy-target="status"></span>
  <% end %>
  <pre tabindex="0" data-code-copy-target="source"><code><% lines.each_with_index do |line, index| %><%= "\n" if index.positive? %><% line.each do |role, text| %><% if role %><%= tag.span(text, class: "syn-#{role}") %><% else %><%= text %><% end %><% end %><% end %></code></pre>
  <% if caption.present? %>
    <figcaption><%= caption %></figcaption>
  <% end %>
</figure>
