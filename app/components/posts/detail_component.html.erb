<article class="content-block content-block--post-list-detail">
  <p class="font-cs-mono text-label uppercase tracking-mono text-meta"><%= post_date(post) %></p>
  <h1 class="mt-3 text-h1 font-semibold leading-tight tracking-tight"><%= translated(post, :title) %></h1>
  <% excerpt = translated(post, :excerpt) %>
  <% if excerpt.present? %><p class="mt-4 text-lg text-dim"><%= excerpt %></p><% end %>
  <div class="cs-prose mt-8"><%= rich_text(post) %></div>
  <% if post.tags.any? %>
    <%# One line of text, not a list: "Tagged rails, ruby" is a sentence, and a ul would be read as "list, 2 items".
        The label is mono like the date; the names are the small sans, as stored (no transform), plain text, no links. %>
    <p class="post-tags mt-10"><span class="font-cs-mono text-label uppercase tracking-mono text-meta"><%= site_string(:tagged) %></span> <span class="font-cs text-small text-meta"><%= post.tags.map(&:name).join(", ") %></span></p>
  <% end %>
</article>
