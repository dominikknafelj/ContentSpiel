<ul>
  <% posts.each do |post| %>
    <li class="grid grid-cols-[7rem_1fr_auto] gap-4 border-b border-line py-4">
      <span class="font-cs-mono text-label uppercase tracking-mono text-meta"><%= resume_period(post) %></span>
      <div>
        <%= link_to translated(post, :title), post_url_path(post, listed_on: page), class: "font-semibold text-ink hover:text-accent" %>
        <% if post.fields.company.present? %><p class="mt-1 text-sm text-dim"><%= post.fields.company %></p><% end %>
      </div>
      <span class="font-cs-mono text-label uppercase tracking-mono text-meta"><%= ContentTypes::ResumeEntry::ROLE_TYPES[post.fields.role_type] %></span>
    </li>
  <% end %>
</ul>
