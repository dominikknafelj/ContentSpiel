<% content_for :title, t(".heading") %>
<h1 class="text-h1 font-semibold"><%= t(".heading") %> <span class="text-label text-meta"><%= t("setup.layout.optional") %></span></h1>
<p class="mt-2 text-dim"><%= t(".intro") %></p>

<%
  mail = MailSettings.current(@site_setting)
  typed = @mail_values || {}
  # The step's own defaults: the usual port of the default security, and the
  # site's title as the sender's name.
  defaults = { mail_port: Admin::Ui::MailFieldsComponent::PORTS.fetch(MailSettings::DEFAULT_SECURITY),
               mail_sender_name: @site_setting.title(locale: @site_setting.default_locale) }
  # What a field shows: what was typed (after a refused save or a test), else what is stored, else the step's default.
  shown = ->(name) { typed.key?(name) ? typed[name].to_s : (@site_setting.public_send(name).presence || defaults[name]).to_s }
  # The summary's links: each field's input, the login's halves too; a field the host sets has none.
  error_ids = (Admin::Ui::MailFieldsComponent::SETTING.to_a + [ %i[mail_username username], %i[mail_password password] ])
    .reject { |_name, field| mail.from_host?(field) }.to_h { |name, _field| [ name.to_s, "setup-#{name}" ] }
%>

<%= form_with url: setup_step_path("mail"), method: :patch, scope: :site_setting, class: "mt-6 max-w-[520px] space-y-4",
      data: { controller: "mail-port" } do %>
  <%= render Admin::Ui::ErrorSummaryComponent.new(errors: @site_setting.errors, field_ids: error_ids) %>
  <%# Enter in a field submits the form's FIRST submit button. The row below
      puts Send test mail first, so this hidden Continue stands before every
      field: Enter means Continue and never sends a mail. %>
  <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true"><%= t(".continue") %></button>

  <%= render Admin::Ui::MailFieldsComponent.new(mail_settings: mail, value: shown, name_prefix: "site_setting", id_prefix: "setup-",
        errors: @site_setting.errors) do |fields| %>
    <% fields.with_login do %>
      <%# The login has no Save of its own here: it is saved with Continue and
          never shown back (a blank half leaves a stored one as it is). A half
          the host sets is the mask, its value never read. %>
      <div class="grid gap-3.5 sm:grid-cols-2">
        <div class="admin-column">
          <% if mail.from_host?(:username) %>
            <%= render Admin::Ui::MailHostValueComponent.new(field: :username, label: t(".username"), mail_settings: mail) %>
          <% else %>
            <%= label_tag "setup-mail_username", t(".username"), class: setup_label_class %>
            <%= text_field_tag "site_setting[mail_username]", nil, id: "setup-mail_username", autocomplete: "off", spellcheck: false, class: setup_input_class %>
          <% end %>
        </div>
        <div class="admin-column">
          <% if mail.from_host?(:password) %>
            <%= render Admin::Ui::MailHostValueComponent.new(field: :password, label: t(".password"), mail_settings: mail) %>
          <% else %>
            <%= label_tag "setup-mail_password", t(".password"), class: setup_label_class %>
            <%= password_field_tag "site_setting[mail_password]", nil, id: "setup-mail_password", autocomplete: "new-password", class: setup_input_class %>
          <% end %>
        </div>
      </div>
      <% if @site_setting.mail_login_set? %>
        <p class="text-sm text-meta"><%= t(".login_saved") %></p>
      <% end %>
    <% end %>
  <% end %>

  <div id="setup-mail-test">
    <div id="setup-mail-actions" class="flex flex-wrap items-center gap-3">
      <div class="mr-auto flex flex-wrap items-center gap-3">
        <%= button_tag t(".send_test"), type: "submit", name: "send_test", value: "1", class: setup_secondary_link_class,
              data: { turbo_submits_with: t(".sending") } %>
        <span class="text-small text-meta"><%= t(".sends_to", address: Current.user&.email_address.to_s) %></span>
      </div>
      <%= render "setup/back" %>
      <%= link_to t(".skip"), setup_step_path("languages"), class: setup_tertiary_link_class %>
      <%= button_tag t(".continue"), type: "submit", class: setup_primary_button_class %>
    </div>
    <%= render Admin::Ui::MailTestOutcomeComponent.new(address: Current.user&.email_address, **(@mail_result || {})) %>
  </div>
<% end %>
