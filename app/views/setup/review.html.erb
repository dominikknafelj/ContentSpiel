<% content_for :title, step_label("review") %>
<h1 class="text-h1 font-semibold"><%= t(".heading") %></h1>
<p class="mt-2 text-dim"><%= t(".intro") %></p>

<dl class="mt-6 divide-y divide-line border-y border-line">
  <%# Skipped means no server: in development and test the stand-in delivery makes a site without one "complete", which is not a set-up mail. %>
<%
  mail = MailSettings.current(@site_setting)
  mail_row = [ t(".mail"), mail.value(:server).present? && mail.complete? ? t("admin.mail.states.#{mail.state}.word") : t(".mail_not_set_up"), "mail" ]
%>
<% rows = [
       [ t(".site_title"), @site_setting.title(locale: @site_setting.default_locale), "site" ],
       [ t(".tagline"), @site_setting.tagline(locale: @site_setting.default_locale).presence || t(".blank"), "site" ],
       [ t(".social_links"), @site_setting.social_links.keys.to_sentence.presence || t(".none"), "site" ], # i18n-ok: to_sentence joins with the locale's support.array words
       mail_row,
       [ t(".default_language"), language_name(@site_setting.default_locale), "languages" ],
       [ t(".home_page"), t(".home_page_always"), nil ],
       [ t(".mcp_token"), @mcp_token_name.present? ? t(".mcp_token_created", name: @mcp_token_name) : t(".skipped"), "mcp_token" ],
       [ t(".starter_content"), @starter_added ? t(".starter_added") : t(".starter_skipped"), "starter_content" ]
     ] %>
  <% rows.each do |label, value, step| %>
    <div class="flex items-baseline gap-4 py-3">
      <dt class="w-40 shrink-0 text-label text-meta"><%= label %></dt>
      <dd class="flex-1"><%= value %></dd>
      <% if step %>
        <dd><%= link_to t(".edit"), setup_step_path(step), class: "text-accent underline hover:no-underline" %></dd>
      <% end %>
    </div>
  <% end %>
</dl>

<div class="mt-6 flex items-center justify-end gap-3">
  <%= render "setup/back" %>
  <%= button_to t(".finish"), setup_step_path("review"), method: :patch, class: setup_primary_button_class %>
</div>
