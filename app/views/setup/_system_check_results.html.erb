<%# The check rows, shared by the setup wizard's step and CS Studio's System
    status: warnings first, then OK, each group in the checks' own order.
    `list_class` is the list's frame, the caller's: the wizard's ruled list
    under its step's heading by default, and System status's rows divided
    inside its card.
    `copyable` is false in the wizard, which loads no admin JavaScript, so a
    Copy button there would do nothing (`Admin::Ui::SystemCheckRowComponent`).
    The rows' sentences are `Setup::SystemCheck`'s and stay English. %>
<% copyable = local_assigns.fetch(:copyable, false) %>
<% list_class = local_assigns.fetch(:list_class, "mt-6 divide-y divide-line border-y border-line") %>
<% mail_settings_href = local_assigns[:mail_settings_href] %>
<% image_settings_href = local_assigns[:image_settings_href] %>
<% forms_href = local_assigns[:forms_href] %>
<ul class="<%= list_class %>">
  <% results.sort_by.with_index { |result, index| [ result.ok? ? 1 : 0, index ] }.each_with_index do |result, index| %>
    <%= render Admin::Ui::SystemCheckRowComponent.new(result: result, index: index, copyable: copyable, mail_settings_href: mail_settings_href,
      image_settings_href: image_settings_href, forms_href: forms_href) %>
  <% end %>
</ul>
