<% content_for :title, step_label("starter_content") %>
<h1 class="text-h1 font-semibold"><%= t(".heading") %> <span class="text-label text-meta"><%= t("setup.layout.optional") %></span></h1>
<p class="mt-2 text-dim"><%= t(".intro_html", path: tag.code("/", class: "font-cs-mono")) %></p>
<ul class="mt-4 list-disc space-y-1 pl-5 text-dim">
  <li><%= t(".pages_html", blog: tag.strong(t(".blog"), class: "text-ink"), resume: tag.strong(t(".resume"), class: "text-ink"), now: tag.strong(t(".now"), class: "text-ink")) %></li>
  <li><%= t(".posts") %></li>
</ul>

<div class="mt-6 flex items-center justify-end gap-3">
  <%= render "setup/back" %>
  <%= link_to t(".skip"), setup_step_path("review"), class: setup_tertiary_link_class %>
  <%= button_to t(".add"), setup_step_path("starter_content"), method: :patch, class: setup_primary_button_class %>
</div>
