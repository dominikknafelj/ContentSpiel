<%# An inline notice, not a toast: toasts are CS Studio only (they need the
    admin JS entry, which the wizard doesn't load). The regular size, the
    wizard's 14px; its role is the tone's (a refusal an alert, a success a
    status). The words are the controller's, from `setup.flash.*`. %>
<% if flash[:alert] %>
  <%= render Admin::Ui::NoticeComponent.new(tone: :danger, class: "mb-4").with_content(flash[:alert]) %>
<% end %>
<% if flash[:notice] %>
  <%= render Admin::Ui::NoticeComponent.new(tone: :ok, class: "mb-4").with_content(flash[:notice]) %>
<% end %>
