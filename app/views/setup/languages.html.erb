<% content_for :title, step_label("languages") %>
<h1 class="text-h1 font-semibold"><%= t(".heading") %></h1>
<p class="mt-2 text-dim">
  <%= t(".intro_html", plain: tag.code("/about", class: "font-cs-mono"), prefixed: tag.code("/de/about", class: "font-cs-mono")) %>
</p>

<%= form_with model: @site_setting, url: setup_step_path("languages"), method: :patch, class: "mt-6 space-y-4" do |form| %>
  <%= render Admin::Ui::ErrorSummaryComponent.new(errors: @site_setting.errors) %>

  <div>
    <%= form.label :default_locale, t(".default"), class: setup_label_class %>
    <%= form.select :default_locale, language_options, {}, class: setup_select_class %>
  </div>

  <div>
    <%= form.label :extra_locales, t(".additional"), class: setup_label_class %>
    <%= form.select :extra_locales, language_options,
      { selected: Locales.enabled - [ Locales.default ] }, multiple: true, class: setup_select_class %>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= render "setup/back" %>
    <%= render Admin::Ui::ButtonComponent.new(label: t(".continue"), type: "submit") %>
  </div>
<% end %>
