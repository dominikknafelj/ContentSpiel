<% content_for :title, "Connect an AI agent" %>
<h1 class="text-h1 font-semibold">Connect an AI agent <span class="font-cs-mono text-label uppercase tracking-mono text-meta">optional</span></h1>
<p class="mt-2 text-dim">
  AI agents (for example Claude) can manage your posts through this site's MCP server at
  <code class="font-cs-mono">/mcp</code>. They need a token to connect. This first token gets the
  Admin group; narrow it to a different group any time from CS Studio's "AI assistant" page, or
  create additional tokens there later.
</p>

<%# Turbo Drive refuses non-redirect 2xx form responses ("Form responses must
    redirect to another location"); update_mcp_token renders (not redirects)
    by design, since the raw token must never pass through session/flash.
    Turned off so the click actually submits -- a full page load also keeps
    the raw token out of Turbo's page cache. %>
<%= form_with url: setup_step_path("mcp_token"), method: :patch, data: { turbo: false }, class: "mt-6 max-w-[420px]" do %>
  <%= label_tag "token-name", "Token name", class: setup_label_class %>
  <%= text_field_tag "token_name", @token_name.to_s, id: "token-name", required: true, maxlength: ApiToken::MAX_NAME_LENGTH,
        placeholder: "claude-desktop", autocomplete: "off", class: setup_input_class,
        aria: { describedby: "token-name-hint", invalid: @token_error ? "true" : nil } %>
  <p id="token-name-hint" class="mt-1 text-sm text-meta">Helps you recognise which assistant is using it. The token acts as you; revoke it any time in Studio › AI assistant.</p>
  <% if @token_error %>
    <p id="token-name-error" role="alert" class="mt-1 text-sm text-danger-ink"><%= @token_error %></p>
  <% end %>

  <div class="mt-6 flex items-center gap-3">
    <%= button_tag "Generate token", type: "submit", class: setup_primary_button_class %>
    <%= link_to "Skip", setup_step_path("starter_content"), class: setup_ghost_link_class %>
    <%= render "setup/back" %>
  </div>
<% end %>
