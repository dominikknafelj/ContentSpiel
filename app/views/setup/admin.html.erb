<% content_for :title, "Admin account" %>
<h1 class="text-h1 font-semibold">Create the admin account</h1>
<p class="mt-2 text-dim">You'll use this account to sign in to the admin.</p>

<%= form_with model: @user, url: setup_step_path("admin"), method: :patch, class: "mt-6 space-y-4" do |form| %>
  <%= render Admin::Ui::ErrorSummaryComponent.new(errors: @user.errors) %>
  <div>
    <%= form.label :email_address, "Email address", class: setup_label_class %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: setup_input_class %>
  </div>
  <div>
    <%= render Admin::Ui::PasswordFieldComponent.new(name: "user[password]", id: "user_password", label: "Password", meter: true) %>
  </div>
  <div>
    <%= render Admin::Ui::PasswordFieldComponent.new(name: "user[password_confirmation]", id: "user_password_confirmation", label: "Confirm password") %>
  </div>
  <div class="flex items-center gap-4">
    <%= render Admin::Ui::ButtonComponent.new(label: "Continue", type: "submit", data: { password_submit: true }) %>
    <%= render "setup/back" %>
  </div>
<% end %>
