<% content_for :title, step_label("admin") %>
<h1 class="text-h1 font-semibold"><%= t(".heading") %></h1>
<p class="mt-2 text-dim"><%= t(".intro") %></p>

<%= form_with model: @user, url: setup_step_path("admin"), method: :patch, class: "mt-6 space-y-4" do |form| %>
  <%= render Admin::Ui::ErrorSummaryComponent.new(errors: @user.errors) %>
  <div>
    <%= form.label :email_address, t(".email"), class: setup_label_class %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: setup_input_class %>
  </div>
  <div>
    <%= render Admin::Ui::PasswordFieldComponent.new(name: "user[password]", id: "user_password", label: t(".password"), meter: true) %>
  </div>
  <div>
    <%= render Admin::Ui::PasswordFieldComponent.new(name: "user[password_confirmation]", id: "user_password_confirmation", label: t(".password_confirmation")) %>
  </div>
  <div class="flex items-center justify-end gap-3">
    <%= render "setup/back" %>
    <%= render Admin::Ui::ButtonComponent.new(label: t(".continue"), type: "submit", data: { password_submit: true }) %>
  </div>
<% end %>
