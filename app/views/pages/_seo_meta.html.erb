<%# The head tags describing this response: the document title, the meta
    description and the Open Graph card (page-tree design spec section 7).

    Rendered from the body template rather than written into the layout because
    this is where the `Page` -- and, at a post permalink, the `Post` -- it has
    to describe is in scope. The layout picks both halves up through
    `content_for(:title)` and its `yield :head`. %>
<% title = seo_title(page, post: post) %>
<% description = seo_description(page, post: post) %>

<% content_for :title, document_title(page, post: post) %>

<% content_for :head do %>
  <%= tag.meta(name: "description", content: description) if description %>
  <%= tag.meta property: "og:title", content: title %>
  <%= tag.meta(property: "og:description", content: description) if description %>
  <%# A post permalink is one piece of writing; every other response is a page
      of the site. %>
  <%= tag.meta property: "og:type", content: post ? "article" : "website" %>
  <%# The address of what is being shared: the record's own, in the language
      shown (for a page in a non-default locale its localized path), on the
      site's configured address and without the query string -- so the same
      address as the layout's `canonical` link. Never the request's URL: its
      host is whatever the client sent (`PublicController#public_urls`). In a
      preview `public_urls` builds the /preview address on the request's own
      origin. The fallback is for a record that has no address: a post in
      the preview that only a page's working rows list yet. %>
  <%= tag.meta property: "og:url", content: public_urls.url_for(post || page) || request.original_url %>
  <%= tag.meta property: "og:locale", content: I18n.locale %>
<% end %>
