<%= render "pages/seo_meta", page: @page, post: @post %>
<%# The page's own heading and, for a landing page, its hero fields -- skipped
    at a post's own detail view, since content_blocks/_post_list_detail
    already renders that post's title as the response's one <h1>. %>
<% if @post.nil? %>
  <h1><%= @page.title %></h1>
  <% if @page.landing? %>
    <% if @page.subtitle.present? %>
      <p class="subtitle"><%= @page.subtitle %></p>
    <% end %>
    <%= image_tag @page.hero_image if @page.hero_image.attached? %>
  <% end %>
<% end %>
<%# A page's body is its blocks in `position` order (the association is ordered),
    each rendered by the partial named after its own block_type.

    The one exception is a post detail request (`/en/blog/my-post`): the block
    the controller matched the post under renders that single post in place of
    its listing, while the page's other blocks -- its intro text, its image --
    still render around it. Compared against `@post_list_block` -- the block the
    controller resolved the post under -- rather than `block.post_list?`, so
    that a page carrying more than one listing swaps out only that block. %>
<% @page.content_blocks.each do |block| %>
  <% if @post && block == @post_list_block %>
    <%= render "content_blocks/post_list_detail", post: @post %>
  <% else %>
    <%= render "content_blocks/#{block.block_type}", block: block, page: @page %>
  <% end %>
<% end %>
<%# The tree is otherwise reachable only by typing an exact URL -- this is what
    makes clicking from a page down into its children possible at all.
    Published only, matching every other public listing on this site. %>
<% if @page.children.published.any? %>
  <nav class="page-children">
    <ul>
      <% @page.children.published.each do |child| %>
        <li><%= link_to child.title, page_url_path(child) %></li>
      <% end %>
    </ul>
  </nav>
<% end %>
