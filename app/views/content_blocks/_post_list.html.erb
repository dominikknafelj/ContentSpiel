<%# The block's `settings` are the listing's query criteria, applied by
    `ContentBlock#listed_posts`: `Post.published` is what keeps drafts (never
    published) and scheduled posts (a future date) out of the listing while
    leaving them visible in the admin, and a blank `content_type` means every
    content type. The single-post detail view resolves through the same
    method, so a page lists and serves permalinks for exactly the same
    posts. %>
<% settings = block.settings_object %>
<% posts = block.listed_posts.order(published_at: :desc).includes(:tags) %>
<% posts = posts.limit(settings.limit) if settings.limit.present? %>
<section class="content-block content-block--post-list my-12 border-t border-line pt-6">
  <% case settings.content_type %>
  <% when "now_update" %>
    <%= render "content_blocks/post_list/now", posts: posts, page: page %>
  <% when "resume_entry" %>
    <%= render "content_blocks/post_list/resume", posts: posts, page: page %>
  <% else %>
    <%= render "content_blocks/post_list/blog", posts: posts, page: page %>
  <% end %>
</section>
