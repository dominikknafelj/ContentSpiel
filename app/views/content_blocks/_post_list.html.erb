<div class="content-block content-block--post-list">
  <%# The block's `settings` are the listing's query criteria, applied by
      `ContentBlock#listed_posts`: `Post.published` is what keeps drafts (never
      published) and scheduled posts (a future date) out of the listing while
      leaving them visible in the admin, and a blank `content_type` means every
      content type. The single-post detail view resolves through the same
      method, so a page lists and serves permalinks for exactly the same
      posts. %>
  <% posts = block.listed_posts.order(published_at: :desc) %>
  <% posts = posts.limit(block.settings["limit"]) if block.settings["limit"].present? %>
  <ul>
    <% posts.each do |post| %>
      <li><%= link_to post.title, post_url_path(page, post) %></li>
    <% end %>
  </ul>
</div>
