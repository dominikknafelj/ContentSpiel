<div class="content-block content-block--post-list">
  <%# The block's `settings` are the listing's query criteria. `published_at` in
      the past is what makes a post public: NULL (never published) and a future
      date (scheduled) both fail the comparison, so drafts stay out of the
      listing while remaining visible in the admin. %>
  <% posts = Post.where(content_type: block.settings["content_type"]) %>
  <% posts = posts.where(published_at: ..Time.current).order(published_at: :desc) %>
  <% posts = posts.limit(block.settings["limit"]) if block.settings["limit"].present? %>
  <ul>
    <% posts.each do |post| %>
      <li><%= post.title %></li>
    <% end %>
  </ul>
</div>
