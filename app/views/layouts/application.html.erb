<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "ContentSpiel" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ContentSpiel">
    <meta name="mobile-web-app-capable" content="yes">
    <%# No csrf_meta_tags (spec §6.4): PublicController serves the same
        cookie-less response to every visitor, and Rails only reads/writes
        the session -- which would set a cookie on an otherwise anonymous,
        publicly cacheable page -- to mint the token these tags embed. %>
    <%= csp_meta_tag %>
    <%= render "shared/theme_head" %>

    <%= yield :head %>

    <%# hreflang alternates (spec §6.5): every enabled language's URL for the
        page or post currently shown, plus x-default pointing search engines
        at the site's own default language rather than making them guess. %>
    <% if (alternate_record = @post || @page) %>
      <% public_urls.alternates(alternate_record).each do |code, url| %>
        <link rel="alternate" hreflang="<%= code %>" href="<%= url %>">
      <% end %>
      <% if (default_url = public_urls.url_for(alternate_record, Locales.default)) %>
        <link rel="alternate" hreflang="x-default" href="<%= default_url %>">
      <% end %>
    <% end %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# The public theme only (spec §9) -- never the product stylesheet. %>
    <%= stylesheet_link_tag "theme-default", "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-paper font-cs text-ink scheme-light dark:scheme-dark">
    <div class="mx-auto max-w-3xl px-4">
      <%= render "layouts/public/header" %>
      <%= yield :preview_banner %>
      <main class="py-12"><%= yield %></main>
      <%= render "layouts/public/footer" %>
    </div>
  </body>
</html>
