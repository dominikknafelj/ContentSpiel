<!DOCTYPE html>
<html lang="<%= admin_locale %>">
  <head>
    <title><%= content_for(:title) || "CS Studio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/theme_head" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "admin" %>
    <%# Per-screen head tags -- today only the API token reveal's
        `turbo-cache-control` (admin/api_tokens/create). %>
    <%= yield :head %>
  </head>

  <%# CS Studio's shell (cs-studio spec §4.2): a grid of up to three columns --
      modules, an optional page tree, and the main content frame.
      `data-admin-locale` carries the editing language onto <body> (rather
      than one data attribute per component) so any Stimulus controller can
      read it via `closest` without a server round trip. The grid quietly
      collapses to two columns on any screen with no tree column of its own
      (every one but Pages -- `content_for :tree` is never set outside it).

      The modules column itself collapses to icons below `md` (spec §4.2):
      the grid's own first track narrows from a fixed 16rem to `auto`, and
      `nav_link_classes` below centers each row's icon once its text label
      (kept in the DOM as `sr-only`, so the link's accessible name is
      unchanged -- just not painted) has nowhere to go. %>
  <body data-controller="admin--dialog" data-action="mousedown->admin--dialog#remember click->admin--dialog#backdrop" data-admin-locale="<%= admin_locale %>" class="min-h-screen bg-paper font-cs text-ink scheme-light dark:scheme-dark">
    <% nav_link_classes = "flex items-center justify-center gap-3 rounded-cs px-2 py-1.5 hover:bg-sunken md:justify-start" %>
    <div class="grid min-h-screen grid-cols-[auto_1fr] md:grid-cols-[16rem_1fr]<%= " lg:grid-cols-[16rem_18rem_1fr]" if content_for?(:tree) %>">
      <nav aria-label="Modules" class="flex flex-col gap-6 border-r border-line bg-surface p-4">
        <ul class="flex flex-col gap-2">
          <%# `Admin::BaseController::MODULES`, narrowed to what this user can
              open (`admin_modules`, access-control design spec §5: sidebar
              modules are shown only when `can?`) -- a module they lack is
              simply absent, not greyed out; opening its URL anyway gets the
              403 page. `admin_url_options` on every one (final-fixes round,
              finding 5): without it, following a modules link while
              editing a non-default language silently dropped back to
              `Locales.default` -- these are the one navigation in the
              shell that doesn't already run through a component
              (`Admin::TreeNodeComponent#path`,
              `Admin::LanguageTabsComponent`, ...) that threads it
              through for its own links. %>
          <% admin_modules.each do |entry| %>
            <li>
              <%= link_to public_send(entry[:path], **admin_url_options), class: nav_link_classes do %>
                <%= render "admin/shared/icon", name: entry[:icon] %><span class="sr-only md:not-sr-only"><%= entry[:label] %></span>
              <% end %>
            </li>
          <% end %>
        </ul>

        <div class="mt-auto flex flex-col gap-2">
          <%= render Admin::ThemeSwitchComponent.new %>
          <%# The account menu: your own password (open to every user,
              access-control design spec §5), then sign out. %>
          <%= link_to admin_account_password_path(**admin_url_options), class: nav_link_classes do %>
            <%= render "admin/shared/icon", name: :key %><span class="sr-only md:not-sr-only">Change password</span>
          <% end %>
          <%= button_to admin_sign_out_path, method: :delete, class: nav_link_classes do %>
            <%= render "admin/shared/icon", name: :external %><span class="sr-only md:not-sr-only">Sign out</span>
          <% end %>
        </div>
      </nav>

      <% if content_for?(:tree) %>
        <aside id="tree-column" class="border-r border-line bg-surface p-4">
          <%= yield :tree %>
        </aside>
      <% end %>

      <main class="p-6">
        <turbo-frame id="content" data-turbo-action="advance">
          <%# A frame request's response keeps only this frame, so the flash
              it carries is rendered here (as bare toasts that `admin--toast`
              moves into `#toasts`) instead of in the region below, where it
              would be consumed and dropped. %>
          <%= render Admin::ToastRegionComponent.new(flash: flash, relay: true) if turbo_frame_request? %>
          <%= yield %>
        </turbo-frame>
      </main>
    </div>

    <%# The one toast region (handoff §10): outside `#content` so a frame
        navigation never wipes it, and a Turbo Stream's `toast_stream` has a
        fixed target. Empty on a frame request -- see the relay above. %>
    <%= render Admin::ToastRegionComponent.new(flash: turbo_frame_request? ? {} : flash) %>

    <%# The one Leave dialog (design pass spec §4): `admin--save-bar` opens it
        when a Turbo visit would drop unsaved changes, and wires its Leave
        button (`data-leave-confirm`) per open, as a listener rather than an
        inline handler. Here, outside `#content` and every form, like every
        dialog. Stay is the Cancel button. %>
    <%= render Admin::ConfirmDialogComponent.new(id: "leave-dialog", title: "Leave without saving?", body: "Your changes on this screen will be lost.", cancel_label: "Stay") do |dialog| %>
      <% dialog.with_confirm_action do %>
        <%= render Admin::ButtonComponent.new(label: "Leave", variant: :primary, type: "button", data: { leave_confirm: true }) %>
      <% end %>
    <% end %>

    <%# The one media picker (media library Task 8) -- here, outside the
        `#content` frame and every form, so there's exactly one per page
        however many image fields and editors open it, and its own inputs
        never feed an autosave. Renders nothing without `media.upload`
        (`Media::PickerComponent`'s own comment). %>
    <%= render Media::PickerComponent.new(url_options: admin_url_options) %>

    <%# The one form every "Mark as up to date" button submits
        (`Admin::TranslationScreen::OutdatedNoteComponent`): empty, here
        outside `#content` and every autosave form for the same reason as
        the picker -- forms can't nest, so each button names this one as
        its owner (`form=`) and its own record in `formaction`. It carries
        only the CSRF token. %>
    <%= form_with url: admin_translation_confirmation_path, method: :post,
          id: Admin::TranslationScreen::OutdatedNoteComponent::FORM_ID, class: "hidden" do %>
    <% end %>
  </body>
</html>
