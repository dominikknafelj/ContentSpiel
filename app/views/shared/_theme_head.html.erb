<%# Runs before the stylesheet paints anything: an explicit choice stored by
    theme_controller.js wins, otherwise the OS preference. Anything other than
    "light" or "dark" (missing, "auto", junk) means Auto. localStorage can
    throw (private windows, blocked site data), so reading it is guarded and
    the page still renders -- in the OS theme -- without it. data-theme-choice
    is what the user picked, data-theme what it resolves to. %>
<%= javascript_tag nonce: true do %>
  (function () {
    var stored = null;
    try { stored = localStorage.getItem("cs-theme"); } catch (e) {}
    var choice = stored === "light" || stored === "dark" ? stored : "auto";
    var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
    var root = document.documentElement;
    root.dataset.themeChoice = choice;
    root.dataset.theme = choice === "auto" ? (prefersDark ? "dark" : "light") : choice;
  })();
<% end %>
