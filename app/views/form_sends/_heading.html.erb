<%# locals: (key:) %>
<%# the heading of a plain page of a send (the sign-in heading's look without its admin words): the site's name
    above, then the page's words, `public.forms.pages.<key>`, which are
    also the document's title. %>
<% title = word("pages.#{key}") %>
<% content_for :title, title %>
<div class="flex flex-col gap-1.5">
  <% if site_title %>
    <p class="text-sm text-dim"><%= site_title %></p>
  <% end %>
  <h1 class="text-[28px] font-semibold"><%= title %></h1>
</div>
