<%# The Trash screen: what the viewer could restore or delete for good, newest
    first, in tabs that carry their counts, 50 per page
    (`Admin::TrashController`). The heading row is "Trash" with "Empty trash…"
    at its end, the actions wrapping under the heading below 640px; under it the
    retention line, with its Change link for a `settings.manage` holder. The
    list and every row's actions are `Admin::TrashScreen::ListComponent`'s. %>
<div class="mb-4">
  <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h1 class="text-h1 text-ink"><%= t(".title") %></h1>
    <% if @everything %>
      <%= render Admin::TrashScreen::EmptyTrashComponent.new(**@everything, url_options: admin_url_options) %>
    <% end %>
  </div>
  <p class="mt-1 text-small text-meta">
    <%= @retention_days.zero? ? t(".retention.never") : t(".retention.days", count: @retention_days) %>
    <% if can?("settings.manage") %>
      <%# A whole-page visit, not a navigation of the `content` frame: a frame
          navigation drops the `#publishing` fragment, so the link would land
          at the top of Settings instead of on the retention field. %>
      <%= link_to t(".change"), admin_settings_path(**admin_url_options, anchor: "publishing"), data: { turbo_frame: "_top" },
            class: Admin::Ui::ButtonComponent.classes(:tertiary, size: :small) %>
    <% end %>
  </p>
</div>

<div class="mb-4 flex">
  <%= render Admin::TrashScreen::TabsComponent.new(counts: (can?("forms.manage") ? @counts : @counts.except("form")), current: @tab,
        url: ->(tab) { admin_trash_path(**{ type: tab }.compact, **admin_url_options) }) %>
</div>

<% page_url = ->(page) { admin_trash_path(list_params(:type).merge("page" => page)) } %>
<% if @pagination.out_of_range? %>
  <%= render "admin/shared/out_of_range_page", url: page_url.call(1) %>
<% else %>
  <%= render Admin::TrashScreen::ListComponent.new(items: @items, retention_days: @retention_days, tab: @tab, hidden_items: @hidden_items, url_options: admin_url_options) do |list| %>
    <% list.with_footer { render Admin::Ui::PaginationComponent.new(pagination: @pagination, url: page_url) } %>
  <% end %>
<% end %>
