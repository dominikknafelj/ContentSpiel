<%# The Trash screen (trash spec §7, handoff §4.9): what the viewer could restore
    or delete for good, newest first, in tabs that carry their counts, 50 per
    page (`Admin::TrashController`). The header holds the retention line (its
    Change link for a `settings.manage` holder) and "Empty trash…"; the list
    and every row's actions are `Admin::TrashScreen::ListComponent`'s. %>
<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="mb-2 text-h1 text-ink">Trash</h1>
    <p class="text-meta">
      <% if @retention_days.zero? %>
        Items stay in the trash until someone deletes them for good.
      <% else %>
        Items are deleted for good after <%= pluralize(@retention_days, "day") %>.
      <% end %>
      <% if can?("settings.manage") %>
        <%# A whole-page visit, not a navigation of the `content` frame: a frame
            navigation drops the `#publishing` fragment, so the link would land
            at the top of Settings instead of on the retention field. %>
        <%= link_to "Change", admin_settings_path(**admin_url_options, anchor: "publishing"), data: { turbo_frame: "_top" },
              class: "text-accent hover:text-accent-hover hover:underline" %>
      <% end %>
    </p>
  </div>
  <% if @everything %>
    <%= render Admin::TrashScreen::EmptyTrashComponent.new(**@everything, url_options: admin_url_options) %>
  <% end %>
</div>

<div class="mb-4 flex">
  <%= render Admin::TrashScreen::TabsComponent.new(counts: @counts, current: @tab,
        url: ->(tab) { admin_trash_path(**{ type: tab }.compact, **admin_url_options) }) %>
</div>

<% page_url = ->(page) { admin_trash_path(list_params(:type).merge("page" => page)) } %>
<% if @pagination.out_of_range? %>
  <%= render "admin/shared/out_of_range_page", url: page_url.call(1) %>
<% else %>
  <%= render Admin::TrashScreen::ListComponent.new(items: @items, retention_days: @retention_days, tab: @tab, url_options: admin_url_options) do |list| %>
    <% list.with_footer { render Admin::PaginationComponent.new(pagination: @pagination, url: page_url) } %>
  <% end %>
<% end %>
