<%# The New page dialog's form, answering the shell's turbo-frame (see
    `Admin::Ui::NewRecordDialogComponent`): rendered without the layout,
    so it costs the form and nothing else. `#new` built `@form`, preset from
    `parent_id` and `title`. %>
<turbo-frame id="<%= Admin::Ui::NewRecordDialogComponent::KINDS.fetch(:page).frame_id %>">
  <%= render @form %>
</turbo-frame>
