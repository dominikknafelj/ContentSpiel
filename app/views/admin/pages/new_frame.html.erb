<%# The New page dialog's form, answering the shell's turbo-frame (see
    `Admin::EditorScreen::NewPageDialogComponent`): rendered without the layout,
    so it costs the form and nothing else. `parent_id` and `title` preset it. %>
<turbo-frame id="<%= Admin::EditorScreen::NewPageDialogComponent::FRAME_ID %>">
  <%= render Admin::EditorScreen::NewPageFormComponent.new(url_options: admin_url_options, locale: admin_locale,
        parent_id: @page.parent_id, title: params[:title]) %>
</turbo-frame>
