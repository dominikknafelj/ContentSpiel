<%# The no-JS fallback of the New page dialog (design pass round 2, Task 15):
    the dialog's own form, as a page. `:standalone_new_record` keeps the layout
    from rendering the dialog as well (the same form ids twice). A refused
    create answers with this page again (422), errors in the form's summary
    and the typed values kept. `data-turbo-frame="_top"` on the form makes the
    redirect to the new page's editor a full visit, so the tree shows it. %>
<% content_for :standalone_new_record, "page" %>
<% content_for :tree do %>
  <%= render Admin::TreeComponent.new(root: root_page, selected: @page, locale: admin_locale, url_options: admin_url_options) %>
<% end %>

<%# `@form` is built (and gated on) by `#new`; a refused create re-renders from what was typed. %>
<% form = @form || Admin::EditorScreen::NewPageFormComponent.new(url_options: admin_url_options, locale: admin_locale,
      parent_id: @page.parent_id, title: new_page_params[:title], page_type: new_page_params[:page_type], errors: @page.errors) %>
<div class="mx-auto max-w-md">
  <h1 class="mb-4 text-base font-semibold">New page</h1>

  <%= render form %>

  <div class="mt-4 flex gap-2">
    <%= render Admin::ButtonComponent.new(label: "Create page", variant: :primary, type: "submit", form: form.form_id) %>
    <%= link_to "Cancel", admin_pages_path(**admin_url_options), data: { turbo_frame: "content" }, class: setup_secondary_link_class %>
  </div>
</div>
