<% content_for :tree do %>
  <%= render Admin::TreeComponent.new(root: root_page, selected: @page, locale: admin_locale, url_options: admin_url_options) %>
<% end %>

<%= render Admin::EditorScreen::HeaderComponent.new(record: @page, locale: admin_locale, url_options: admin_url_options) do |header| %>
  <% header.with_suggest do %>
    <%# Translate empty fields / Use all (translation helpers spec §6.4): only
        in a non-default language, for a viewer who may edit the page, with AI
        set up and `ai.translate`. It asks for the page's own fields and its
        blocks' alike -- whatever has a Translate button below. %>
    <%= render Admin::TranslationScreen::TranslateAllComponent.new(record: @page, locale: admin_locale, editable: can_edit?(@page)) %>
  <% end %>
<% end %>

<%= render Admin::PageSettingsFormComponent.new(page: @page, locale: admin_locale, url_options: admin_url_options) %>

<%# The one slot a block action with nothing left to replace on the page
    (a stale PATCH/DELETE against an already-deleted block, spec §5.1's 410;
    a failed `create` from the picker) reports into --
    `Admin::ContentBlocksController#render_gone`/`#picker_error_stream`. %>
<div id="content-blocks-alert"></div>

<section class="admin-content-blocks mt-6" data-controller="admin--blocks"
     data-admin--blocks-reorder-url-value="<%= reorder_admin_page_content_blocks_path(@page, **admin_url_options) %>">
  <div class="mb-3 flex items-center justify-between">
    <h2 class="text-h2 text-ink">Blocks</h2>
    <%= render Admin::SaveStatusComponent.new(id: "content-blocks-status", state: :idle) %>
  </div>

  <%# Whether the blocks can be changed at all (access-control design spec
      §5: blocks follow their page's permissions) -- asked once here for
      every card, and for "+ Add block". %>
  <% blocks_editable = can_edit?(@page) %>
  <%# The keyboard path for a block drag (handoff §9 A9): the instruction every
      handle points at, and the live region `admin--blocks` announces in. %>
  <p id="block-drag-help" class="sr-only">Press Space to pick up, arrow keys to move, Space to drop, Escape to cancel.</p>
  <p data-admin--blocks-target="announcer" aria-live="assertive" class="sr-only"></p>
  <div id="content-blocks-list" data-admin--blocks-target="list" class="flex flex-col gap-3">
    <% blocks = @page.content_blocks.to_a %>
    <% blocks.each_with_index do |block, index| %>
      <%= render Admin::BlockCardComponent.new(page: @page, block: block, locale: admin_locale, url_options: admin_url_options, last: index == blocks.size - 1, editable: blocks_editable) %>
    <% end %>
  </div>

  <% if blocks_editable %>
    <%= render Admin::BlockPickerComponent.new(page: @page, locale: admin_locale, url_options: admin_url_options) %>
  <% end %>
</section>
