<%# Never restored from Turbo's page cache (final fix wave 1, ledger m1): a
    snapshot of an editor holds its forms as they stood when it was left --
    typed text whose save was only sent as the page was torn down (Back
    drains nothing), next to the base from before that save. Restored, the
    form took that text for what the server holds and sent the next edit on
    the old base: refused as "Changed elsewhere" against one's own save. With
    this, Back/Forward to an editor fetches it afresh. (A frame navigation's
    answer carries the tag too, and the promoted visit merges it into the
    head, so it also holds for an editor opened from the tree.)

    And no link is prefetched from an editor (follow-up N1): Turbo fetches a
    link on hover and reuses that answer for the click. From an editor the
    click first waits for the save queue (`saving/queue.js`), so a
    prefetched answer for the same record -- its other language tab, its own
    row in the tree -- shows it as it was BEFORE those saves, with the old
    base: the saved text missing and the next edit refused. %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
  <meta name="turbo-prefetch" content="false">
<% end %>

<% content_for :tree do %>
  <%= render Admin::PagesScreen::TreeComponent.new(root: root_page, selected: @page, locale: admin_locale, url_options: admin_url_options) %>
<% end %>

<%# The page's open notes (notes spec §4.3): two queries for the drawer's
    counts, every marker's and which of them hold something unread for the
    viewer. Here in the view, because every way this screen is rendered needs
    them. The header's Notes button is a slot component (`Admin::Slots`) and
    is handed the same counts rather than reading them again. %>
<% note_counts = Notes::Counts.for_container(@page, user: Current.user) %>

<%= render Admin::EditorScreen::HeaderComponent.new(record: @page, locale: admin_locale, url_options: admin_url_options, slot_context: { counts: note_counts }) do |header| %>
  <% header.with_suggest do %>
    <%# Suggest translations for N empty fields / Use all (translation helpers spec §6.4): only
        in a non-default language, for a viewer who may edit the page, with AI
        set up and `ai.translate`. It asks for the page's own fields and its
        blocks' alike -- whatever has a Translate button below. %>
    <%= render Admin::TranslationScreen::TranslateAllComponent.new(record: @page, locale: admin_locale, editable: can_edit?(@page)) %>
  <% end %>
<% end %>

<%# The element the live editing scripts stand on (`Admin::EditorScreen::LiveRegionComponent`):
    the settings and the blocks, not the header or the notes drawer. %>
<%= render Admin::EditorScreen::LiveRegionComponent.new(record: @page, locale: admin_locale, url_options: admin_url_options) do %>
<%= render Admin::EditorScreen::PageSettingsFormComponent.new(page: @page, locale: admin_locale, url_options: admin_url_options) %>

<%# The one slot a block action with nothing left to replace on the page
    (a stale PATCH/DELETE against an already-deleted block, spec §5.1's 410;
    a failed `create` from the picker) reports into --
    `Admin::ContentBlocksController#render_gone`/`#picker_error_stream`. %>
<div id="content-blocks-alert"></div>

<%# `data-messages`: the two sentences `admin--editor--blocks` says itself (a block not
    moved because its form holds an unsaved edit; a refused move whose list was
    not redrawn over unsaved text), the two choices it writes into the Move
    dialog and what it announces after a move made from a menu. Here and not on
    <body>: only this screen's script asks for them. %>
<section class="admin-content-blocks mt-6" data-controller="admin--editor--blocks"
     data-admin--editor--blocks-reorder-url-value="<%= reorder_admin_page_content_blocks_path(@page, **admin_url_options) %>"
     data-messages="<%= messages_data("components.editor_screen.section_card.unsaved_move", "components.editor_screen.section_card.reload_later",
                                      "components.editor_screen.move_dialog.column", "components.editor_screen.move_dialog.section_column",
                                      "components.editor_screen.block_moves.up", "components.editor_screen.block_moves.down",
                                      "components.editor_screen.block_moves.column", "components.editor_screen.block_moves.into",
                                      "components.editor_screen.block_moves.out", "components.editor_screen.block_moves.back") %>">
  <div class="mb-3 flex items-center justify-between">
    <h2 class="text-h2 text-ink">Blocks</h2>
    <%= render Admin::Ui::SaveStatusComponent.new(id: "content-blocks-status", state: :idle) %>
  </div>

  <%# Whether the blocks can be changed at all (access-control design spec
      §5: blocks follow their page's permissions) -- asked once here for
      every card, and for "+ Add block". %>
  <% blocks_editable = can_edit?(@page) %>
  <%# The keyboard path for a block drag (handoff §9 A9): the instruction every
      handle points at, and the live region `admin--editor--blocks` announces in. %>
  <p id="block-drag-help" class="sr-only">Press Space to pick up, arrow keys to move, Space to drop, Escape to cancel.</p>
  <p data-admin--editor--blocks-target="announcer" aria-live="assertive" class="sr-only"></p>
  <div id="content-blocks-list" data-admin--editor--blocks-target="list" class="flex flex-col gap-3">
    <%# The page's own list is its top-level blocks (sections spec §3.1); a
        block in a section's column is not a card of this list but a tile of
        its section's card, which draws it and its form (spec §4.1-§4.3) -- or,
        on a translation tab, a card in its section's group (spec §4.5):
        `SectionCardComponent.for` picks. A section is whatever holds blocks
        (`draws?`), so one whose type is gone still shows them (spec §6). The
        outline is built once, from the blocks the controller preloaded, and
        handed to every section. `Admin::ContentBlocksController#card_for`
        draws the same card for a stream. %>
    <% outline = BlockOutline.new(@page.content_blocks) %>
    <% blocks = outline.top_level %>
    <% blocks.each_with_index do |block, index| %>
      <% if Admin::EditorScreen::SectionCardComponent.draws?(block, outline: outline) %>
        <%= render Admin::EditorScreen::SectionCardComponent.for(page: @page, section: block, outline: outline, locale: admin_locale, url_options: admin_url_options, first: index.zero?, last: index == blocks.size - 1, editable: blocks_editable) %>
      <% else %>
        <%= render Admin::EditorScreen::BlockCardComponent.new(page: @page, block: block, locale: admin_locale, url_options: admin_url_options, first: index.zero?, last: index == blocks.size - 1, editable: blocks_editable) %>
      <% end %>
    <% end %>
  </div>

  <% if blocks_editable %>
    <%= render Admin::EditorScreen::BlockPickerComponent.new(page: @page, locale: admin_locale, url_options: admin_url_options) %>
    <%# "Move to column…" and "Move into section…" (sections spec §4.4): one dialog for the
        page, inside this section because `admin--editor--blocks` fills and reads it. %>
    <%= render Admin::EditorScreen::MoveDialogComponent.new %>
  <% end %>
</section>
<% end %>

<%# The notes drawer (notes spec §4.1): once per screen, after everything
    else and outside every form. `?notes=open` (a link from the inbox, the
    posts list) opens it on load, at `?thread=` when there is one. %>
<%= render Admin::NotesScreen::DrawerComponent.new(container: @page, counts: note_counts,
      title: Locales.read(@page, :title, locale: admin_locale).presence || t("admin.components.notes_screen.drawer.untitled"),
      open: params[:notes] == "open", thread: params[:thread], url_options: admin_url_options) %>
