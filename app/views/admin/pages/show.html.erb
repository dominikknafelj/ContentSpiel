<%# Never restored from Turbo's page cache: a
    snapshot of an editor holds its forms as they stood when it was left --
    typed text whose save was only sent as the page was torn down (Back
    drains nothing), next to the base from before that save. Restored, the
    form would take that text for what the server holds and send the next
    edit on the old base: refused as "Changed elsewhere" against one's own
    save. With this, Back/Forward to an editor fetches it afresh. (A frame navigation's
    answer carries the tag too, and the promoted visit merges it into the
    head, so it also holds for an editor opened from the tree.)

    And no link is prefetched from an editor: Turbo fetches a
    link on hover and reuses that answer for the click. From an editor the
    click first waits for the save queue (`saving/queue.js`), so a
    prefetched answer for the same record -- its other language tab, its own
    row in the tree -- shows it as it was BEFORE those saves, with the old
    base: the saved text missing and the next edit refused. %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
  <meta name="turbo-prefetch" content="false">
<% end %>

<%= render "admin/pages/tree", selected: @page %>

<%# The page this editor opens, named for the page tree, which stands outside
    `#content` and marks this page's row selected (`admin--pages--tree`, "The
    selected row"). %>
<div hidden data-tree-open-page="<%= @page.id %>"></div>

<%# What every slot of this screen is handed beside the record (`Admin::Slots`): `reads`
    is one Hash the screen's slot components share, so that a feature drawn in two of
    them (the header's actions and the rail's tabs) reads what both draw once. %>
<% slot_context = { reads: {} } %>

<%# One read of the page's reservations for the whole screen (`Editing::Holds`): the header's
    bulk translate, every card, tile and form below ask this object, so the editor costs the
    same statements for 3 blocks as for 30. %>
<% holds = Editing::Holds.on(@page, viewer: Current.user, tab: Current.editing_tab) %>

<%= render Admin::EditorScreen::HeaderComponent.new(record: @page, locale: admin_locale, url_options: admin_url_options, slot_context: slot_context) do |header| %>
  <% header.with_suggest do %>
    <%# Suggest translations for N empty fields / Use all (translation helpers spec §6.4): only
        in a non-default language, for a viewer who may edit the page, with AI
        set up and `ai.translate`. It asks for the page's own fields and its
        blocks' alike -- whatever has a Translate button below. %>
    <%= render Admin::TranslationScreen::TranslateAllComponent.new(record: @page, locale: admin_locale, editable: can_edit?(@page), holds: holds) %>
  <% end %>
<% end %>

<%# The element the live editing scripts stand on (`Admin::EditorScreen::LiveRegionComponent`):
    the rail and the blocks, not the header. %>
<%= render Admin::EditorScreen::LiveRegionComponent.new(record: @page, locale: admin_locale, url_options: admin_url_options) do %>
<%# The rail (`Admin::Ui::RailTabsComponent`, `RailPanelComponent`, `admin--ui--rail`): the
    settings first in the document, then the blocks, at every width; where the editor area
    has the room the grid places the settings in a rail right of the blocks, with a Page
    and a Section tab, and below it they stand above the blocks as one column, on a
    translation tab as on the default one (there a section's settings are read only:
    `SectionGroupComponent`). The page's settings are rendered once, in the Page panel. A section's settings region is moved
    into the Section panel when its words are pressed and back under its head when it
    closes (`admin--editor--section-choice`, which says what moves it and when). The
    address's `section` (the translation tab's "Edit in <language>") names a section
    chosen on load, on the default tab only (`@chosen_section_id`). %>
<% rail_id = "editor-grid" %>
<%# What the rail's slot is handed: the record and viewer, and what this screen has read (`Admin::Slots`). %>
<% rail_slot = Admin::Ui::RailSlotComponent.new(slot: "editor.rail.tabs", rail_id: rail_id, record: @page, viewer: Current.actor, reserved: %w[page section], locale: admin_locale, url_options: admin_url_options,
                                                query: request.query_parameters, **slot_context) %>
<%= tag.div id: rail_id, class: "admin-rail-grid",
      data: { controller: "admin--ui--rail admin--editor--section-choice", "admin--editor--section-choice-chosen-value": @chosen_section_id,
              action: "admin--ui--rail:reveal->admin--ui--rail#reveal admin--ui--rail:conceal->admin--ui--rail#conceal " \
                      "admin--editor--section:open-settings->admin--editor--section-choice#take " \
                      "admin--editor--section-settings:closed->admin--editor--section-choice#closed " \
                      "admin--ui--rail:docked->admin--editor--section-choice#undocked " \
                      "turbo:before-cache@document->admin--editor--section-choice#cache " \
                      "turbo:before-stream-render@document->admin--editor--section-choice#streamed " \
                      "admin--editing--live:merged@document->admin--editor--section-choice#merged" } do %>
<%= render Admin::Ui::RailTabsComponent.new(rail_id: rail_id, current: rail_slot.current_key || "page", tabs: [
      Admin::Ui::RailTabsComponent::Tab.new(key: "page", label: t("admin.components.editor_screen.rail.tabs.page")),
      Admin::Ui::RailTabsComponent::Tab.new(key: "section", label: t("admin.components.editor_screen.rail.tabs.section"))
    ], slot_tabs: rail_slot.tabs) %>
<%= render Admin::Ui::RailPanelComponent.new(rail_id: rail_id, key: "page", current: rail_slot.current_key.nil?) do %>
  <%= render Admin::EditorScreen::PageSettingsFormComponent.new(page: @page, locale: admin_locale, url_options: admin_url_options, holds: holds) %>
<% end %>
<%= render Admin::Ui::RailPanelComponent.new(rail_id: rail_id, key: "section", docked_only: true) do %>
  <%# The chosen section's settings region stands here; nothing is drawn in it. %>
  <div data-admin--editor--section-choice-target="slot"
       data-action="focusin->admin--editor--section-choice#keepFocus focusout->admin--editor--section-choice#keepBlur"></div>
  <div class="admin-section-choice__empty" data-admin--editor--section-choice-target="empty">
    <p class="text-sm font-medium text-ink"><%= t("admin.components.editor_screen.section_choice.empty") %></p>
    <p class="mt-1 text-sm text-meta"><%= t(admin_locale.to_s == Locales.default.to_s ? "admin.components.editor_screen.section_choice.help" : "admin.components.editor_screen.section_choice.help_translation") %></p>
  </div>
<% end %>
<%= render rail_slot %>

<%# `data-messages`: the two sentences `admin--editor--blocks` says itself (a block not
    moved because its form holds an unsaved edit; a refused move whose list was
    not redrawn over unsaved text), the two choices it writes into the Move
    dialog and what it announces after a move, from a menu or the handle's
    keyboard path. Here and not on <body>: only this screen's script asks
    for them. %>
<section class="admin-content-blocks admin-rail__main <%= Admin::EditorScreen::FormColumn.classes(admin_locale) %> mt-6" data-controller="admin--editor--blocks"
     data-admin--editor--blocks-reorder-url-value="<%= reorder_admin_page_content_blocks_path(@page, **admin_url_options) %>"
     data-messages="<%= messages_data("components.editor_screen.section_card.unsaved_move", "components.editor_screen.section_card.reload_later",
                                      "components.editor_screen.move_dialog.column", "components.editor_screen.move_dialog.section_column",
                                      "components.editor_screen.block_moves.up", "components.editor_screen.block_moves.down",
                                      "components.editor_screen.block_moves.column", "components.editor_screen.block_moves.into",
                                      "components.editor_screen.block_moves.out", "components.editor_screen.block_moves.back",
                                      "components.editor_screen.block_moves.picked_up", "components.editor_screen.block_moves.dropped",
                                      "components.editor_screen.block_moves.cancelled", "components.editor_screen.block_moves.position",
                                      "components.editor_screen.block_moves.untitled") %>">
  <%# The one slot a block action with nothing left to replace on the page
      (a stale PATCH/DELETE against an already-deleted block, spec §5.1's 410;
      a failed `create` from the picker) reports into --
      `Admin::Answers::BlockGone`/`BlockDrawing#picker_error_stream`. Inside the
      blocks column, so the rail's grid places it with the blocks. %>
  <div id="content-blocks-alert"></div>

  <div class="mb-3 flex items-center justify-between">
    <h2 class="text-h2 text-ink">Blocks</h2>
    <%= render Admin::Ui::SaveStatusComponent.new(id: "content-blocks-status", state: :idle) %>
  </div>

  <%# Whether the blocks can be changed at all (access-control design spec
      §5: blocks follow their page's permissions) -- asked once here for
      every card, and for "+ Add block". %>
  <% blocks_editable = can_edit?(@page) %>
  <%# The keyboard path for a block drag (handoff §9 A9): the instruction every
      handle points at, and the live region `admin--editor--blocks` announces in. %>
  <p id="block-drag-help" class="sr-only">Press Space to pick up, arrow keys to move, Space to drop, Escape to cancel.</p>
  <p data-admin--editor--blocks-target="announcer" aria-live="assertive" class="sr-only"></p>
  <div id="content-blocks-list" data-admin--editor--blocks-target="list" class="flex flex-col gap-5.5">
    <%# The page's own list is its top-level blocks (sections spec §3.1); a
        block in a section's column is not a card of this list but a tile of
        its section's card, which draws it and its form (spec §4.1-§4.3) -- or,
        on a translation tab, a card in its section's group (spec §4.5):
        `SectionCardComponent.for` picks. A section is whatever holds blocks
        (`draws?`), so one whose type is gone still shows them (spec §6). The
        outline is built once, from the blocks the controller preloaded, and
        handed to every section. `Admin::Answers::BlockDrawing#card_for`
        draws the same card for a stream. %>
    <% outline = BlockOutline.new(@page.content_blocks) %>
    <% blocks = outline.top_level %>
    <% blocks.each_with_index do |block, index| %>
      <% if Admin::EditorScreen::SectionCardComponent.draws?(block, outline: outline) %>
        <%= render Admin::EditorScreen::SectionCardComponent.for(page: @page, section: block, outline: outline, locale: admin_locale, url_options: admin_url_options, first: index.zero?, last: index == blocks.size - 1, editable: blocks_editable, holds: holds) %>
      <% else %>
        <%= render Admin::EditorScreen::BlockCardComponent.new(page: @page, block: block, locale: admin_locale, url_options: admin_url_options, first: index.zero?, last: index == blocks.size - 1, editable: blocks_editable, holds: holds) %>
      <% end %>
    <% end %>
  </div>

  <% if blocks_editable %>
    <%= render Admin::EditorScreen::BlockPickerComponent.new(page: @page, locale: admin_locale, url_options: admin_url_options) %>
    <%# "Move to column…" and "Move into section…" (sections spec §4.4): one dialog for the
        page, inside this section because `admin--editor--blocks` fills and reads it. %>
    <%= render Admin::EditorScreen::MoveDialogComponent.new %>
  <% end %>
</section>
<% end %>
<% end %>

<%# A published or scheduled page's address is changed in its own dialog, drawn
    here: outside the live region (a refresh of the settings does not touch it
    and an open dialog is never replaced) and outside the settings form (a form
    in a form is invalid, and the write queue would read it as part of the
    autosaving one). Nothing for a draft or the homepage. %>
<%= render Admin::EditorScreen::SlugDialogComponent.new(page: @page, locale: admin_locale, url_options: admin_url_options) %>
