<% content_for :tree do %>
  <%= render Admin::TreeComponent.new(root: root_page, selected: @page, locale: admin_locale, url_options: admin_url_options) %>
<% end %>

<%# Reached only by a viewer who can't open Home (`PagesController#index`
    redirects everyone else to Home's editor), so the panel is a plain
    prompt (handoff §10 C34). "Create starter pages" lives in the tree's
    "⋯" menu (`Admin::TreeComponent`), which is where it is offered while
    Home is the only kept page. "Add a page" is offered only where `pages
    .create` allows a page under the homepage -- where `Admin::PagesController
    #create` puts a page with no parent named. %>
<% offer_new_page = can?("pages.create", Page.new(parent: root_page)) %>

<div class="rounded-cs border border-line bg-surface">
<%= render Admin::Ui::EmptyStateComponent.new(title: "Choose a page from the tree", description: (offer_new_page ? "Or add a new one." : nil)) do |empty_state| %>
  <% if offer_new_page %>
    <% empty_state.with_action do %>
      <%= link_to "+ New page", new_admin_page_path(**admin_url_options), data: dialog_trigger("new-page-dialog").merge(turbo_frame: "content"), class: setup_primary_button_class %>
    <% end %>
  <% end %>
<% end %>
</div>
