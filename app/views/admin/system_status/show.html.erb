<%# System status: the setup wizard's own `Setup::SystemCheck` results,
    through the same rows, so both screens word every check identically.
    Here the rows sit in one card, divided inside it; the wizard keeps its
    ruled list (`setup/_system_check_results` takes the list's classes from
    its caller). A state is each row's chip and the summary line's words:
    there is no summary chip. "Run checks again" is a plain GET back to this
    screen, which re-runs every check -- idempotent, so a reload does the
    same. The time is the site's (`Admin::BaseController` runs every request
    in the site time zone). %>
<% content_for :title, t(".title") %>
<%# An Off row (single sign-on not set up) is neither passed nor failed: it is left out of both counts. %>
<% counted = @results.reject(&:off?) %>
<% passed = counted.count(&:ok?) %>
<%# The page frame, a wide screen (lists, tables, logs, overviews). %>
<div class="admin-page admin-page--wide">
  <div class="admin-page__head">
    <div class="min-w-0">
      <h1 class="text-h1 text-ink"><%= t(".title") %></h1>
      <p class="mt-1 text-small text-meta"><%= t(".summary", passed: passed, count: counted.size, time: I18n.l(Time.zone.now, format: :"admin.time")) %></p>
    </div>
    <%= link_to t(".run_again"), admin_system_status_path(**admin_url_options), class: Admin::Ui::ButtonComponent.classes(:secondary),
          data: { turbo_prefetch: "false" } %>
  </div>
  <div class="admin-page__body">

  <div id="system-checks" class="rounded-card bg-surface shadow-1">
    <%= render "setup/system_check_results", results: @results, copyable: true, list_class: "divide-y divide-line px-4",
          mail_settings_href: (admin_settings_path(anchor: "mail", **admin_url_options) if can?("settings.manage")),
          image_settings_href: (admin_settings_path(anchor: "images", **admin_url_options) if can?("settings.manage")),
          forms_href: (admin_forms_path(**admin_url_options) if %w[forms.manage form_submissions.view].any? { |key| can?(key) }) %>
  </div>

  <%# The Content card: what the site's content asks of someone. Not checks
      (nothing is wrong with the host), so it is neither in the summary's
      count nor in the wizard; the controller hands it over only to a viewer
      who may act on it (`pages.edit`). %>
  <% if @content_results.any? %>
    <section class="mt-6" aria-labelledby="content-heading">
      <h2 id="content-heading" class="mb-2 text-h2 text-ink"><%= t(".content.title") %></h2>
      <div id="content-checks" class="rounded-card bg-surface shadow-1">
        <ul class="divide-y divide-line px-4">
          <% @content_results.each_with_index do |result, index| %>
            <%= render Admin::Ui::SystemCheckRowComponent.new(result: result, index: index,
                  diagram_drawings_href: admin_diagram_drawings_path(**admin_url_options)) %>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <%# The Alerts card: recent errors and security findings, after Content and
      like it no part of the checks' count. The Mail settings link only for a
      holder of `settings.manage`, as in the check rows above, and the audit
      log's (narrowed to an alert's events) only for a holder of
      `audit.view`, who alone may open it. %>
  <%= render Admin::SystemStatusScreen::AlertsComponent.new(alerts: @alerts, mail_blocked_by: @mail_blocked_by,
        settings_href: (admin_settings_path(anchor: "mail", **admin_url_options) if can?("settings.manage")),
        audit_path: (->(narrowing) { admin_audit_events_path(**narrowing, **admin_url_options) } if can?("audit.view"))) %>
  </div>
</div>
