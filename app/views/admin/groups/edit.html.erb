<%# Editing a group: the form, then -- for a custom group the viewer can
    manage -- the delete zone and the confirm dialog that names the active
    tokens `Groups::Destroy` revokes, both outside the form (forms don't
    nest). A built-in group shows its note in the zone's place; a group the
    viewer can only view shows neither. %>
<% content_for :title, @group.name_was.presence || t(".title") %>
<%# The page frame, a wide screen: the permission matrix needs the width. %>
<div class="admin-page admin-page--wide">
<div class="admin-page__head">
  <h1 class="text-h1 text-ink"><%= @group.name_was.presence || @group.name %></h1>
</div>
<div class="admin-page__body">

<% if @stale_form %>
  <div class="mb-4">
    <%= render "admin/shared/stale_banner", words: "admin.groups.edit.stale", change: @stale_change, reload_path: edit_admin_group_path(@group, **admin_url_options) %>
  </div>
<% end %>

<%= render "admin/groups/form", group: @group, grants: @grants, stale: @stale, members: @members, view_only: @view_only,
      url: admin_group_path(@group, **admin_url_options), method: :patch %>

<% unless @view_only %>
  <%= render Admin::GroupsScreen::DeleteZoneComponent.new(group: @group, member_count: @member_count, tokens: @tokens, url_options: admin_url_options) %>
<% end %>
</div>
</div>
