<%# Editing a group (access-control design spec §5, round 3 Task 11): the form,
    then -- for a custom group the viewer can manage -- the delete zone and the
    confirm dialog that names the active tokens `Groups::Destroy` revokes, both
    outside the form (forms don't nest). A built-in group shows the note in the
    zone's place; a group the viewer can only view shows neither. %>
<% content_for :title, @group.name_was.presence || "Group" %>
<h1 class="mb-4 text-h1 text-ink"><%= @group.name_was.presence || @group.name %></h1>

<% if @stale_form %>
  <div class="mb-4 max-w-[1000px]">
    <%= render "admin/shared/stale_banner", message: Admin::GroupsController::STALE_MESSAGE, reload_path: edit_admin_group_path(@group, **admin_url_options) %>
  </div>
<% end %>

<%= render "admin/groups/form", group: @group, grants: @grants, stale: @stale, members: @members, view_only: @view_only,
      url: admin_group_path(@group, **admin_url_options), method: :patch %>

<% unless @view_only %>
  <%= render Admin::GroupsScreen::DeleteZoneComponent.new(group: @group, member_count: @member_count, tokens: @tokens, url_options: admin_url_options) %>
<% end %>
