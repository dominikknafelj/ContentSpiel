<%# The Groups module (access-control design spec §5): every group with its
    member count. Built-in groups (the four seeded ones) are marked -- they
    can be edited but not deleted. %>
<% content_for :title, "Groups" %>
<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-h1 text-ink">Groups</h1>
    <p class="mt-1 text-meta">A group bundles permissions. Users get them by being members; an assistant token is limited to one group.</p>
  </div>
  <%= link_to "+ New group", new_admin_group_path(**admin_url_options), data: { turbo_frame: "content" }, class: setup_primary_button_class %>
</div>

<% if flash[:notice].present? %>
  <p role="status" class="mb-4 text-ok-ink"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert].present? %>
  <p role="alert" class="mb-4 text-danger-ink"><%= flash[:alert] %></p>
<% end %>

<table class="admin-groups-table w-full border-collapse text-sm">
  <thead>
    <tr class="border-b border-line-strong text-left font-cs-mono text-label uppercase tracking-mono text-meta">
      <th class="py-2 pr-4">Name</th>
      <th class="py-2 pr-4">Members</th>
      <th class="py-2"><span class="sr-only">Actions</span></th>
    </tr>
  </thead>
  <tbody>
    <% @groups.each do |group| %>
      <tr id="<%= dom_id(group) %>" class="border-b border-line align-top">
        <td class="py-2 pr-4 text-ink">
          <%= group.name %>
          <% if group.built_in? %><span class="ml-1 rounded-cs border border-line px-1.5 font-cs-mono text-label uppercase tracking-mono text-meta">Built-in</span><% end %>
          <% if group.description.present? %><span class="block text-meta"><%= group.description %></span><% end %>
        </td>
        <td class="py-2 pr-4 text-ink"><%= pluralize(@member_counts.fetch(group.id, 0), "member") %></td>
        <td class="py-2 text-right">
          <%= link_to "Edit", edit_admin_group_path(group, **admin_url_options), data: { turbo_frame: "content" }, class: setup_secondary_link_class %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
