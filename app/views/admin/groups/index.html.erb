<%# The Groups module (access-control design spec §5, round 3 Task 10): every
    group with its member and token counts, each row one link to its editor.
    Built-in groups (the four seeded ones) are marked -- they can be edited but
    not deleted. %>
<% content_for :title, "Groups" %>
<div class="flex max-w-[1000px] flex-col gap-4">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="flex flex-col gap-1.5">
      <h1 class="text-h1 text-ink">Groups</h1>
      <p class="max-w-[600px] text-sm text-dim">A group is a set of permissions. People and AI tokens get what their groups allow; owners always have everything.</p>
    </div>
    <%= link_to "New group", new_admin_group_path(**admin_url_options), data: { turbo_frame: "content" }, class: setup_primary_button_class %>
  </div>

  <%= render Admin::GroupsScreen::ListComponent.new(groups: @groups, member_counts: @member_counts, token_counts: @token_counts) %>
</div>
