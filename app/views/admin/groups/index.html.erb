<%# The Groups screen: every group with its member and token counts, each
    row one link to its editor (`Admin::GroupsScreen::ListComponent`).
    Built-in groups (the four seeded ones) are marked: they can be edited but
    not deleted.

    The heading row is "Groups" and its intro, with "New group" (the one
    primary) at its end, wrapping under the heading below 640px. %>
<% content_for :title, t(".title") %>
<div class="flex max-w-[1000px] flex-col gap-4">
  <div class="flex flex-col items-start gap-3 sm:flex-row sm:justify-between">
    <div class="flex flex-col gap-1.5">
      <h1 class="text-h1 text-ink"><%= t(".title") %></h1>
      <p class="max-w-[600px] text-small text-dim"><%= t(".intro") %></p>
    </div>
    <%= link_to t(".new_group"), new_admin_group_path(**admin_url_options), data: { turbo_frame: "content" }, class: Admin::Ui::ButtonComponent.classes(:primary) %>
  </div>

  <%= render Admin::GroupsScreen::ListComponent.new(groups: @groups, member_counts: @member_counts, token_counts: @token_counts) %>
</div>
