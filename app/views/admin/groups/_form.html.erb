<%# The group editor (access-control design spec §5): name, description,
    members and the permission matrix. Members send a blank first value so
    an empty list still arrives as one. %>
<%= render Admin::ErrorSummaryComponent.new(errors: group.errors, field_ids: { "name" => "group_name", "description" => "group_description" }) %>

<%= form_with url: url, method: method, id: "group-form", data: save_bar_form_data(dirty: group.errors.any?, always: group.new_record?) do %>
  <div class="mb-4 max-w-md">
    <%= label_tag "group_name", "Name", class: setup_label_class %>
    <%# A built-in group's name is fixed (`AccessControl::Group#built_in_name_unchanged`). %>
    <%= text_field_tag "group[name]", group.name, id: "group_name", required: true, readonly: group.built_in?,
          aria: { invalid: (group.errors.include?(:name) ? "true" : nil) }.compact,
          class: [ setup_input_class, ("!border-danger" if group.errors.include?(:name)) ] %>
  </div>

  <div class="mb-6 max-w-md">
    <%= label_tag "group_description", "Description", class: setup_label_class %>
    <%= text_field_tag "group[description]", group.description, id: "group_description", class: setup_input_class %>
  </div>

  <fieldset class="mb-6 max-w-md">
    <legend class="<%= setup_label_class %>">Members</legend>
    <%= hidden_field_tag "group[member_ids][]", "", id: nil %>
    <div class="flex flex-col gap-1">
      <% all_users.each do |user| %>
        <label class="flex items-center gap-2 text-ink">
          <%= render Admin::CheckboxComponent.new(name: "group[member_ids][]", value: user.id, checked: selected_member_ids.include?(user.id), id: "group_member_#{user.id}") %>
          <span>
            <%= render Admin::UserNameComponent.new(user: user) %>
            <% if user.name.present? %><span class="block text-sm text-meta"><%= user.email_address %></span><% end %>
          </span>
          <% if user.owner? %><span class="text-sm text-meta">(owner: has every permission anyway)</span><% end %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <h2 class="mb-2 text-h2 text-ink">Permissions</h2>
  <div class="mb-6">
    <%= render Admin::PermissionMatrixComponent.new(grants: grants, stale: stale, locale: admin_locale) %>
  </div>

  <%= render Admin::SaveBarComponent.new(form_id: "group-form", cancel_url: admin_groups_path(**admin_url_options), save_label: "Save") %>
<% end %>
