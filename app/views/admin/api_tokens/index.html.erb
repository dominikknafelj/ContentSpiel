<%# "Connect an AI assistant" (design spec §6.1, Task 9): every token,
    active and revoked, with its owner and last use. "Create token" is a
    plain, non-Turbo POST (`data-turbo="false"`, fix round 1): the one-time
    reveal is a rendered (200) response -- a Drive form submission must
    redirect, and a frame submission leaves Turbo's snapshot cache free to
    keep the reveal for Back -- so it arrives as its own document whose
    head opts out of Turbo's cache (see admin/api_tokens/create). Revoke
    is gated behind `Admin::ConfirmDialogComponent`, like every other
    destructive action in CS Studio. %>
<% content_for :title, "AI assistant" %>
<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-h1 text-ink">Connect an AI assistant</h1>
    <p class="mt-1 text-meta">An assistant connects over MCP with a token and acts as the user who created it, limited to the token's group.</p>
  </div>
  <%# The token's group bounds what an assistant using it may do, within
      the user's own rights (access-control design spec §3.3 "Tokens"):
      only groups the user may assign are offered. %>
  <%= form_with url: admin_api_tokens_path(**admin_url_options), method: :post, data: { turbo: false }, class: "flex flex-wrap items-end gap-2" do %>
    <div>
      <%= label_tag "group_id", "Group", class: setup_label_class %>
      <%= select_tag "group_id", options_from_collection_for_select(@assignable_groups, :id, :name, default_group&.id),
            id: "group_id", required: true, class: setup_input_class %>
    </div>
    <%= render Admin::ButtonComponent.new(label: "Create token", variant: :primary, type: "submit") %>
  <% end %>
</div>

<% if flash[:notice].present? %>
  <p role="status" class="mb-4 text-ok-ink"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert].present? %>
  <p role="alert" class="mb-4 text-danger-ink"><%= flash[:alert] %></p>
<% end %>

<% if @api_tokens.empty? %>
  <%= render Admin::EmptyStateComponent.new(title: "No tokens yet", description: "Create a token to connect an assistant.") %>
<% else %>
  <table class="admin-api-tokens-table w-full border-collapse text-sm">
    <thead>
      <tr class="border-b border-line-strong text-left font-cs-mono text-label uppercase tracking-mono text-meta">
        <th class="py-2 pr-4">Created</th>
        <th class="py-2 pr-4">User</th>
        <th class="py-2 pr-4">Group</th>
        <th class="py-2 pr-4">Status</th>
        <th class="py-2 pr-4">Last used</th>
        <th class="py-2 pr-4">IP</th>
        <th class="py-2"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @api_tokens.each do |api_token| %>
        <% dialog_id = "revoke-api-token-#{api_token.id}" %>
        <tr id="<%= dom_id(api_token) %>" class="border-b border-line align-top">
          <td class="py-2 pr-4 text-ink"><%= l(api_token.created_at, format: :short) %></td>
          <td class="py-2 pr-4 text-ink"><%= api_token.user.email_address %></td>
          <td class="py-2 pr-4 text-ink"><%= api_token.group.name %></td>
          <td class="py-2 pr-4">
            <% if api_token.revoked_at %>
              <span class="text-meta">Revoked <%= l(api_token.revoked_at, format: :short) %></span>
            <% else %>
              <span class="text-ok-ink">Active</span>
            <% end %>
          </td>
          <td class="py-2 pr-4 text-ink"><%= api_token.last_used_at ? l(api_token.last_used_at, format: :short) : "Never" %></td>
          <td class="py-2 pr-4 font-cs-mono text-ink"><%= api_token.last_used_ip.presence || "—" %></td>
          <td class="py-2 text-right">
            <% unless api_token.revoked_at %>
              <%= render Admin::ButtonComponent.new(label: "Revoke", variant: :danger, type: "button",
                    onclick: "document.getElementById('#{dialog_id}').showModal()") %>

              <%= render Admin::ConfirmDialogComponent.new(id: dialog_id, title: "Revoke this token?",
                    body: "Any assistant using it stops working immediately. This can't be undone.") do |dialog| %>
                <% dialog.with_confirm_action do %>
                  <%= form_with url: admin_api_token_path(api_token, **admin_url_options), method: :delete do %>
                    <%= render Admin::ButtonComponent.new(label: "Revoke", variant: :danger, type: "submit") %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<section class="mt-8 rounded-cs border border-line bg-surface p-4">
  <h2 class="text-h2 text-ink">Connecting</h2>
  <p class="mt-1 mb-4 text-meta">Point your assistant at this URL and send the token as a bearer token. Replace <code class="font-cs-mono">YOUR_TOKEN</code> with a token you created.</p>
  <%= render "admin/api_tokens/connection", token: "YOUR_TOKEN" %>
</section>
