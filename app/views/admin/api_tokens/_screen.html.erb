<%# locals: raw_token (nil except on the one-time reveal) -- the AI assistant
    page as a numbered flow: 1 Create a token, 2 Add it to your assistant, then
    the Tokens table. `index` and `create` both render it, so the reveal is the
    same page with the raw token in step 1 and filled into step 2's
    configuration. `admin--tokens--reveal` wraps all of it, so the blanking of
    every `secret` on `pagehide` reaches both steps; each Copy is its own copy
    box's `admin--ui--clipboard`. "Create token" in step 1 is the page's one
    primary. %>
<div data-controller="admin--tokens--reveal" class="flex max-w-[880px] flex-col gap-4">
  <div class="flex flex-col gap-1.5">
    <h1 class="text-h1 text-ink"><%= t(".title") %></h1>
    <p class="max-w-[600px] text-small text-dim"><%= t(".intro") %></p>
  </div>

  <%= render Admin::TokensScreen::CreateStepComponent.new(
        groups: @assignable_groups, form_url: admin_api_tokens_path(**admin_url_options), selected_id: @selected_group_id,
        name: @name.to_s, name_errors: @name_errors, group_errors: @group_errors, raw_token: raw_token) %>

  <%= render Admin::TokensScreen::ConnectStepComponent.new(
        mcp_url: mcp_url, config: mcp_client_config(raw_token || "YOUR_TOKEN"), raw_token: raw_token) %>

  <%= render Admin::TokensScreen::TableComponent.new(tokens: @api_tokens) %>
</div>
