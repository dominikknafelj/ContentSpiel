<%# The audit log (design pass round 3, Task 15): a row of filters, then the
    events under day headers, newest first -- every event `audit.view` holders
    may see (`Admin::AuditEventsController`'s own comment: this module is never
    content-scoped), a subject linked only where the viewer can open it. %>
<h1 class="mb-4 text-h1 text-ink">Audit log</h1>

<%= render Admin::AuditScreen::ToolbarComponent.new(filter: @filter, users: @users, other_actions: @other_actions,
      url_options: admin_url_options, locale: admin_locale) %>

<% event_path = ->(event) { admin_audit_event_path(event, **@filter.to_params.symbolize_keys, **admin_url_options) } %>

<% if @entries.empty? %>
  <div class="rounded-cs border border-line bg-surface">
    <% if @filter.active? %>
      <%= render Admin::EmptyStateComponent.new(title: "No matches", description: "No events match these filters.") do |empty_state| %>
        <% empty_state.with_action do %>
          <%= link_to "Clear filters", admin_audit_events_path(**admin_url_options), class: setup_secondary_link_class, data: { turbo_frame: "content", turbo_action: "replace" } %>
        <% end %>
      <% end %>
    <% else %>
      <%= render Admin::EmptyStateComponent.new(title: "No events", description: "Nothing has been recorded yet.") %>
    <% end %>
  </div>
<% else %>
  <%= render Admin::AuditScreen::DayListComponent.new(entries: @entries, event_path: event_path) %>

  <%# Newer / Load older keep the filters (`Audit::Filter#to_params`: only valid
      values, never the raw query string) and set their own `offset`. %>
  <% if @offset.positive? || @has_next %>
    <div class="flex items-center justify-center gap-3 py-3">
      <% if @offset.positive? %>
        <%= link_to "Newer", admin_audit_events_path(**@filter.to_params.symbolize_keys, **admin_url_options, offset: [ @offset - Admin::AuditEventsController::PER_PAGE, 0 ].max),
              class: setup_secondary_link_class %>
      <% end %>
      <% if @has_next %>
        <%= link_to "Load older", admin_audit_events_path(**@filter.to_params.symbolize_keys, **admin_url_options, offset: @offset + Admin::AuditEventsController::PER_PAGE),
              class: setup_secondary_link_class %>
      <% end %>
    </div>
  <% end %>
<% end %>
