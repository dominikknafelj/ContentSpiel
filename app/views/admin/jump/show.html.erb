<%# The palette's results frame (`Admin::Shell::CommandPaletteComponent`):
    a bare fragment, no layout. Rows are links that leave the frame
    (`_top`), so following one is an ordinary Turbo visit and the page
    replacement closes the dialog. %>
<%# `data-query` echoes the (trimmed, capped) query this fragment answers:
    Turbo copies a response's children, not its attributes, into the
    palette's frame, so the marker is an inner element. `admin--command-palette`
    compares it with the input to ignore a response that arrives after the
    viewer typed something else. %>
<% query = @query.strip.first(Jump::Search::MAX_QUERY) %>
<turbo-frame id="jump-results">
<div data-query="<%= query %>">
  <%# One listbox for the whole answer -- what the combobox input's
      `aria-controls` names -- always rendered, even empty, so that reference
      never dangles. Each section is a `group` named by its heading row
      (`aria-labelledby`); the heading is a presentational `<li>`, because a
      listbox may only hold options and groups of options. Every option has
      an id, for the input's `aria-activedescendant`. %>
  <div id="jump-listbox" role="listbox" aria-label="Results">
    <% @groups.each_with_index do |group, group_index| %>
      <% heading_id = "jump-group-#{group_index}" %>
      <ul role="group" aria-labelledby="<%= heading_id %>" class="py-1">
        <li role="presentation" id="<%= heading_id %>" class="px-4 pb-1 pt-2 font-cs-mono text-label uppercase tracking-mono text-meta"><%= group[:label] %></li>
        <% group[:rows].each_with_index do |row, row_index| %>
          <li role="option" id="jump-option-<%= group_index %>-<%= row_index %>" aria-selected="false" class="group">
            <%# A row with a `dialog` (New page, New post) closes the palette and opens that
                dialog; its `href` stays for a viewer without JavaScript. %>
            <% data = row[:dialog] ? { turbo_frame: "_top", action: "admin--command-palette#close admin--dialog#open", "admin--dialog-id-param": row[:dialog] } : { turbo_frame: "_top" } %>
            <%= link_to jump_row_path(row[:route]), data: data, class: "flex items-center gap-3 px-4 py-2 text-sm text-ink hover:bg-sunken" do %>
              <span class="min-w-0 flex-1 truncate"><%= row[:title] %></span>
              <% if row[:hint] %><%= render Admin::Ui::ContentTypeDotComponent.new(content_type: row[:hint]) %><% end %>
              <%# Right-hand end: a non-Live status, then -- on the selected row
                  only (`group-aria-selected`) -- the "↵" that says Enter opens it. %>
              <% if row[:status] %><%= render Admin::Ui::StatusChipComponent.new(status: row[:status], hide_live: true) %><% end %>
              <span aria-hidden="true" class="admin-palette__enter hidden font-cs-mono text-[10px] text-meta group-aria-selected:inline">↵</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
  <% if @groups.empty? && query.present? %>
    <div class="px-4 py-4 text-sm text-dim">
      <p>No results for “<%= query %>”.</p>
      <% if can?("posts.create") %>
        <p class="pt-2"><%= link_to "New post", new_admin_post_path(**admin_url_options), data: { turbo_frame: "_top", action: "admin--command-palette#close admin--dialog#open", "admin--dialog-id-param": "new-post-dialog" }, class: "underline" %></p>
      <% end %>
    </div>
  <% end %>
</div>
</turbo-frame>
