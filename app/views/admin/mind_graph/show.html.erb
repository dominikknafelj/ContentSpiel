<%# The mind graph (design spec §6.1, Task 9): `PostGraph`'s data as a
    `<script type="application/json">` data island rather than a
    `data-*-value` attribute -- the browser never executes it, and
    `json_escape` turns every `<`, `>` and `&` into a `\u` escape, so a
    post title like `</script><script>…` can't close the element early.
    `admin--mind-graph` parses it and draws the graph (d3-force).
    Read-only: relations are edited in the post editor's related-posts
    picker. %>
<% content_for :title, "Mind graph" %>
<div class="mb-4">
  <h1 class="text-h1 text-ink">Mind graph</h1>
  <p class="mt-1 text-meta">How your posts relate to each other. Drag a node to reposition it; click a node to open that post.</p>
</div>

<% if @graph[:nodes].empty? %>
  <%# For THIS viewer: a viewer who can read no post sees this, whatever the site holds. %>
  <div class="rounded-cs border border-line bg-surface p-6 text-meta" data-mind-graph-empty="no-posts">No posts yet.</div>
<% else %>
  <%# The graph takes the whole view: the full width of the content column
      and the height left under the heading (never less than 480px). The
      legend and the filter sit in a row at the top of the SAME box (round 3),
      so the box keeps the round-1 size and the SVG takes what is left of it
      (`flex-1`); `admin--mind-graph` still clamps every node and label to the
      SVG's own box and follows its resizes, so the box itself needs no cap.
      The empty message is in the box too, over the SVG's top-left corner.
      Filter: three radios (arrow keys move between them), applied
      client-side, not remembered. %>
  <div data-controller="admin--mind-graph" class="flex h-[calc(100vh-11rem)] min-h-[480px] flex-col overflow-hidden rounded-cs border border-line bg-surface">
    <script type="application/json" id="mind-graph-data" data-admin--mind-graph-target="data"><%= json_escape(@graph.to_json).html_safe %></script>
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line px-3.5 py-2.5">
      <%= render Admin::MindGraphLegendComponent.new(content_types: @graph[:nodes].map { |node| node[:type] }) %>
      <fieldset class="m-0 min-w-0 border-0 p-0">
        <legend class="sr-only">Show connections</legend>
        <div class="inline-flex overflow-hidden rounded-cs border border-line-strong bg-surface">
          <% [ [ "all", "All" ], [ "related", "Related" ], [ "tag", "Tags" ] ].each do |value, label| %>
            <label for="mind-graph-filter-<%= value %>" class="flex cursor-pointer items-center border-r border-line px-3 py-1.5 text-sm text-dim last:border-r-0 hover:bg-sunken has-[:checked]:bg-accent-tint has-[:checked]:font-semibold has-[:checked]:text-ink has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:-outline-offset-2 has-[:focus-visible]:outline-accent">
              <%= radio_button_tag "mind_graph_filter", value, value == "all", id: "mind-graph-filter-#{value}", class: "sr-only", data: { action: "change->admin--mind-graph#filter" } %>
              <span><%= label %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
    </div>
    <div class="relative min-h-0 flex-1">
      <svg data-admin--mind-graph-target="svg" class="block h-full w-full text-ink" role="group" aria-label="Post relationship graph: <%= pluralize(@graph[:nodes].size, "post") %>, <%= pluralize(@graph[:edges].size, "connection") %>. Each post is a link to its editor."></svg>
      <p data-admin--mind-graph-target="empty" data-mind-graph-empty="no-connections" class="absolute left-3.5 top-3 m-0 max-w-md rounded-cs bg-surface px-1 text-meta<%= " hidden" if @graph[:edges].any? %>">Link posts with Related posts, or give them shared tags, to see connections.</p>
    </div>
  </div>
<% end %>
