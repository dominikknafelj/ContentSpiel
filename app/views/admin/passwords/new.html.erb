<%# The reset flow's request page, in three of its four states (the fourth,
    the new-password form, is edit.html.erb): "request" (the default), "sent"
    (?sent=1, after a request) and "expired" (?expired=1, a bad or used
    link). The sent state is the same words for a known and an unknown
    address -- the controller redirects both identically. %>
<%# Handoff "Studio Password Reset": directly on the page, no card; the site
    name above the heading (`admin/shared/_auth_heading`); links in the accent
    colour, underlined on hover only. %>
<div class="flex flex-col gap-[18px]">
  <% back_link = link_to "← Back to sign in", admin_sign_in_path, class: "text-[13px] text-accent hover:text-accent-hover hover:underline" %>
  <% if params[:sent] == "1" %>
    <%= render "admin/shared/auth_heading", title: "Check your email" %>
    <p class="text-sm leading-relaxed text-dim">If that address belongs to an account, we've sent a link. It expires in 15 minutes.</p>
    <p><%= back_link %></p>
  <% elsif params[:expired] == "1" %>
    <%= render "admin/shared/auth_heading", title: "This link has expired" %>
    <p class="rounded-cs bg-danger-tint px-3 py-2.5 text-[13px] leading-normal text-danger-ink" role="alert">Reset links work for 15 minutes and only once.</p>
    <%= link_to "Send a new link", new_admin_password_path, class: "#{setup_primary_button_class} w-full text-center" %>
    <p><%= back_link %></p>
  <% else %>
    <%= render "admin/shared/auth_heading", title: "Reset password" %>
    <p class="text-sm leading-relaxed text-dim">Enter the email you sign in with. We'll send a link to set a new password.</p>

    <% if flash[:alert] %>
      <p class="rounded-cs bg-danger-tint px-3 py-2.5 text-[13px] leading-normal text-danger-ink" role="alert" id="alert"><%= flash[:alert] %></p>
    <% end %>

    <%= form_with url: admin_password_path, class: "flex flex-col gap-[18px]" do |form| %>
      <div>
        <%= form.label :email_address, "Email", class: setup_label_class %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: setup_input_class %>
      </div>
      <%= render Admin::ButtonComponent.new(label: "Send reset link", type: "submit", class: "w-full") %>
    <% end %>

    <%# No console command is named here on purpose: this repo ships no rake
        task for resetting a password, and a hint must not invent one. %>
    <p class="text-xs leading-normal text-meta">No outgoing mail on this site? Ask an owner to set a new password for you.</p>
    <p><%= back_link %></p>
  <% end %>
</div>
