<%# Edit a user: the heading is the user's name (as stored: a refused save's
    typed name isn't the title), "Last signed in …" under it (from
    `session.created` audit events), the form, then -- for an editable user --
    the owner zone (owners only) and the delete zone, both AFTER the form
    (forms don't nest) and both instant actions that wait for pending changes.
    A user the viewer can't manage (`Users::Manageability`) is read-only, and
    a neutral notice says why: a note, read where it stands and never a Tab
    stop. Up to 880px. %>
<% state = manageability(@user) %>
<% heading = @user.name_in_database.presence || @user.email_address_in_database %>
<% content_for :title, heading %>
<div class="max-w-[880px]">
  <p class="mb-1 text-label text-meta"><%= link_to t(".breadcrumb"), admin_users_path(**admin_url_options), class: "text-meta" %> /</p>
  <div class="mb-1 flex items-center justify-between gap-3">
    <h1 class="text-h1 text-ink"><%= heading %></h1>
    <%# Opens the audit log filtered to this user, with `audit.view` only.
        `_top`, not the content frame it sits in. %>
    <% if can?("audit.view") %>
      <%= link_to t(".activity"), admin_audit_events_path(subject_type: "User", subject_id: @user.id, **admin_url_options), data: { turbo_frame: "_top" }, class: Admin::Ui::ButtonComponent.classes(:secondary, size: :small) %><%# i18n-ok: "User" is the audit log's subject_type, a class name %>
    <% end %>
  </div>
  <p class="mb-4 text-small text-dim" data-last-sign-in>
    <% if @last_sign_in %><%= t(".last_signed_in_html", time: render(Admin::Ui::TimeAgoComponent.new(time: @last_sign_in))) %><% else %><%= t(".never_signed_in") %><% end %>
  </p>

  <% if @stale_form %>
    <div class="mb-4">
      <%= render "admin/shared/stale_banner", words: "admin.users.edit.stale", change: @stale_change, reload_path: edit_admin_user_path(@user, **admin_url_options) %>
    </div>
  <% end %>

  <%= render Admin::Ui::ErrorSummaryComponent.new(errors: @user.errors, field_ids: { "name" => "user_name", "email_address" => "user_email_address", "password" => "user_password", "password_confirmation" => "user_password_confirmation" }) %>

  <% reason = { owner_protected: t(".owner_protected"), outranked: t(".outranked") }[state] %>
  <% if reason %>
    <%= render Admin::Ui::NoticeComponent.new(tone: :neutral, class: "admin-view-only-notice mb-4") do %><%= reason %><% end %>
  <% end %>

  <%= render "admin/users/form", user: @user, url: admin_user_path(@user, **admin_url_options), method: :patch, state: state %>

  <% if state == :editable %>
    <% if Current.user&.owner? %>
      <%= render Admin::UsersScreen::OwnerZoneComponent.new(user: @user, last_owner: last_owner?(@user), url_options: admin_url_options) %>
    <% end %>
    <%= render Admin::UsersScreen::DeleteZoneComponent.new(user: @user, own: @user == Current.user, last_owner: last_owner?(@user), url_options: admin_url_options) %>
  <% end %>
</div>
