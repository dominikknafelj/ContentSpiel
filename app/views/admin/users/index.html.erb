<%# The Users screen: every user as a row that opens their editor, with their
    groups and last sign-in (`Users::LastSignIn`, one grouped query), and the
    open invitations among them (`Admin::UsersScreen::ListComponent`). Delete
    lives in the editor.

    The heading row is "Users" with "Invite person…" (secondary) and "New
    user" (the one primary) at its end, the actions wrapping under the
    heading below 640px. "Invite person…" is offered while mail works
    (`invites_offered?`), opening the invite dialog; otherwise an owner reads
    "Invites need mail. Set up mail →" under the heading (only an owner: mail
    is set up in Settings). Also drawn by `Admin::InvitesController#create`
    for a refused invite, with the dialog open: `@invite` and its companions
    are set only there. %>
<% content_for :title, t(".title") %>
<div class="mb-4">
  <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h1 class="text-h1 text-ink"><%= t(".title") %></h1>
    <div class="flex flex-wrap items-center gap-2">
      <% if invites_offered? %>
        <%= render Admin::Ui::ButtonComponent.new(label: t(".invite"), variant: :secondary, data: dialog_trigger(Admin::UsersScreen::InviteDialogComponent::DIALOG_ID)) %>
      <% end %>
      <%= link_to t(".new_user"), new_admin_user_path(**admin_url_options), data: { turbo_frame: "content" }, class: Admin::Ui::ButtonComponent.classes(:primary) %>
    </div>
  </div>
  <% if !invites_offered? && Current.user&.owner? %>
    <p class="mt-1 text-small text-meta" data-invites-need-mail>
      <%= t(".invites_need_mail") %>
      <%= link_to t(".set_up_mail"), admin_settings_path(anchor: "mail", **admin_url_options), data: { turbo_frame: "_top" } %>
    </p>
  <% end %>
</div>

<% if invites_offered? || @invite %>
  <%= render Admin::UsersScreen::InviteDialogComponent.new(groups: all_groups, assignable_ids: assignable_group_ids, invite: @invite,
        group_ids: @invite_group_ids || [], errors: @invite_errors || [],
        resend_invitation: @invite_resend, url_options: admin_url_options) %>
<% end %>

<%= render Admin::UsersScreen::ListComponent.new(users: @users, invitations: @invitations, last_sign_ins: @last_sign_ins, current_user: Current.user) %>
