<%# The Users module (cs-studio spec §6.1, Task 8): every user, new/edit and
    a delete gated behind `Admin::ConfirmDialogComponent` -- refused for the
    last user (`User#ensure_not_last_owner`, surfaced as a flash alert since
    this list has no per-row error slot of its own the way an autosaving
    form does). %>
<% content_for :title, "Users" %>
<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <h1 class="text-h1 text-ink">Users</h1>
  <%= link_to "+ New user", new_admin_user_path(**admin_url_options), data: { turbo_frame: "content" }, class: setup_primary_button_class %>
</div>

<% if flash[:notice].present? %>
  <p role="status" class="mb-4 text-ok-ink"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert].present? %>
  <p role="alert" class="mb-4 text-danger-ink"><%= flash[:alert] %></p>
<% end %>

<table class="admin-users-table w-full border-collapse text-sm">
  <thead>
    <tr class="border-b border-line-strong text-left font-cs-mono text-label uppercase tracking-mono text-meta">
      <th class="py-2 pr-4">Email</th>
      <th class="py-2 pr-4">Groups</th>
      <th class="py-2"><span class="sr-only">Actions</span></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <% dialog_id = "delete-user-#{user.id}" %>
      <tr id="<%= dom_id(user) %>" class="border-b border-line align-top">
        <td class="py-2 pr-4 text-ink">
          <%= user.email_address %>
          <% if user == Current.user %><span class="text-meta">(you)</span><% end %>
          <% if user.owner? %><span class="ml-1 rounded-cs border border-line px-1.5 font-cs-mono text-label uppercase tracking-mono text-meta">Owner</span><% end %>
        </td>
        <td class="py-2 pr-4 text-ink"><%= user.groups.map(&:name).sort.join(", ").presence || "—" %></td>
        <td class="py-2 text-right">
          <%= link_to "Edit", edit_admin_user_path(user, **admin_url_options), data: { turbo_frame: "content" }, class: setup_secondary_link_class %>

          <%= render Admin::ButtonComponent.new(label: "Delete", variant: :danger, type: "button",
                onclick: "document.getElementById('#{dialog_id}').showModal()") %>

          <%= render Admin::ConfirmDialogComponent.new(id: dialog_id, title: "Delete this user?",
                body: (user == Current.user ? "This is your own account — deleting it signs you out." : "This can't be undone.")) do |dialog| %>
            <% dialog.with_confirm_action do %>
              <%= form_with url: admin_user_path(user, **admin_url_options), method: :delete, data: { turbo_frame: "_top" } do %>
                <%= render Admin::ButtonComponent.new(label: "Delete", variant: :danger, type: "submit") %>
              <% end %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
