<%# "New user" (cs-studio spec §6.1) -- email + password up front
    (`has_secure_password` requires a password on create). Mirrors
    `admin/posts/new.html.erb`'s own shape. %>
<div class="mx-auto max-w-md">
  <h1 class="mb-4 font-cs-mono text-label uppercase tracking-mono text-meta">New user</h1>

  <%= render Admin::ErrorSummaryComponent.new(errors: @user.errors, field_ids: { "name" => "user_name", "email_address" => "user_email_address", "password" => "user_password", "password_confirmation" => "user_password_confirmation" }) %>

  <%= form_with url: admin_users_path(**admin_url_options), method: :post, id: "user-form", data: save_bar_form_data(dirty: @user.errors.any?, always: true) do %>
    <div class="mb-4">
      <%= label_tag "user_name", "Name", class: setup_label_class %>
      <%= text_field_tag "user[name]", @user.name, id: "user_name", maxlength: 120, autocomplete: "name",
            aria: { describedby: "user_name_help", invalid: (@user.errors.include?(:name) ? "true" : nil) }.compact,
            class: [ setup_input_class, ("!border-danger" if @user.errors.include?(:name)) ] %>
      <p id="user_name_help" class="mt-1 text-sm text-meta">Optional. Shown instead of the email.</p>
    </div>

    <div class="mb-4">
      <%= label_tag "user_email_address", "Email address", class: setup_label_class %>
      <%= email_field_tag "user[email_address]", @user.email_address, id: "user_email_address", autofocus: true,
            autocomplete: "username", aria: { invalid: (@user.errors.include?(:email_address) ? "true" : nil) }.compact,
            class: [ setup_input_class, ("!border-danger" if @user.errors.include?(:email_address)) ] %>
    </div>

    <div class="mb-4">
      <%= render Admin::PasswordFieldComponent.new(name: "user[password]", id: "user_password", label: "Password", meter: true) %>
    </div>

    <div class="mb-4">
      <%= render Admin::PasswordFieldComponent.new(name: "user[password_confirmation]", id: "user_password_confirmation", label: "Confirm password") %>
    </div>

    <%= render "admin/users/access_fields", user: @user %>

    <%# The Save button carries `data-password-submit`: the strength meter
        holds it back until the password is long enough (`admin--password-field`
        finds it inside the form, and the bar is inside the form). %>
    <%= render Admin::SaveBarComponent.new(form_id: "user-form", cancel_url: admin_users_path(**admin_url_options), save_label: "Create user", save_data: { password_submit: true }) %>
  <% end %>
</div>
