<%# "Change my password" (access-control design spec §5): every signed-in
    user's own password, behind their current one. A deliberate submit,
    never autosave, like the Users module's own forms. %>
<% content_for :title, "Change password" %>
<div class="mx-auto max-w-md">
  <h1 class="mb-1 text-h1 text-ink">Change password</h1>
  <p class="mb-4 text-meta">Signed in as <%= Current.user.display_name %>. Changing your password signs you out everywhere else.</p>

  <% if flash[:notice].present? %>
    <p role="status" class="mb-4 text-ok-ink"><%= flash[:notice] %></p>
  <% end %>
  <% if flash[:alert].present? %>
    <p role="alert" class="mb-4 text-danger-ink"><%= flash[:alert] %></p>
  <% end %>
  <% if @errors.present? %>
    <p role="alert" class="mb-4 text-danger-ink"><%= @errors.to_sentence %></p>
  <% end %>

  <% if @profile_errors.present? %>
    <p role="alert" class="mb-4 text-danger-ink"><%= @profile_errors.to_sentence %></p>
  <% end %>

  <%= form_with url: admin_account_profile_path(**admin_url_options), method: :patch, class: "mb-8" do %>
    <div class="mb-4">
      <%= label_tag "name", "Your name", class: setup_label_class %>
      <%= text_field_tag "name", Current.user.name, id: "name", maxlength: 120, autocomplete: "name", class: setup_input_class %>
    </div>

    <%= render Admin::ButtonComponent.new(label: "Save name", variant: :primary, type: "submit") %>
  <% end %>

  <%= form_with url: admin_account_password_path(**admin_url_options), method: :patch do %>
    <div class="mb-4">
      <%= label_tag "current_password", "Current password", class: setup_label_class %>
      <%= password_field_tag "current_password", nil, id: "current_password", required: true, autofocus: true,
            autocomplete: "current-password", class: setup_input_class %>
    </div>

    <div class="mb-4">
      <%= label_tag "password", "New password", class: setup_label_class %>
      <%= password_field_tag "password", nil, id: "password", required: true, maxlength: 72,
            autocomplete: "new-password", class: setup_input_class %>
    </div>

    <div class="mb-4">
      <%= label_tag "password_confirmation", "Confirm new password", class: setup_label_class %>
      <%= password_field_tag "password_confirmation", nil, id: "password_confirmation", required: true, maxlength: 72,
            autocomplete: "new-password", class: setup_input_class %>
    </div>

    <%= render Admin::ButtonComponent.new(label: "Change password", variant: :primary, type: "submit") %>
  <% end %>
</div>
