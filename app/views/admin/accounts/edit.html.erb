<%# "Change my password" (access-control design spec §5): every signed-in
    user's own password, behind their current one. A deliberate submit,
    never autosave, like the Users module's own forms. %>
<% content_for :title, "Change password" %>
<div class="mx-auto max-w-md">
  <h1 class="mb-1 text-h1 text-ink">Change password</h1>
  <p class="mb-4 text-meta">Signed in as <%= Current.user.display_name %>. Changing your password signs you out everywhere else.</p>

  <%# The service layer's `result.errors` are whole sentences with no field to
      link to (the summary prints them as they are). One summary at a time:
      only one of the two forms was submitted. %>
  <%= render Admin::ErrorSummaryComponent.new(errors: Array(@errors)) %>
  <%= render Admin::ErrorSummaryComponent.new(errors: Array(@profile_errors)) %>

  <%= form_with url: admin_account_profile_path(**admin_url_options), method: :patch, class: "mb-8" do %>
    <div class="mb-4">
      <%= label_tag "name", "Your name", class: setup_label_class %>
      <%= text_field_tag "name", Current.user.name, id: "name", maxlength: 120, autocomplete: "name", class: setup_input_class %>
    </div>

    <%= render Admin::ButtonComponent.new(label: "Save name", variant: :primary, type: "submit") %>
  <% end %>

  <%= form_with url: admin_account_password_path(**admin_url_options), method: :patch do %>
    <div class="mb-4">
      <%= render Admin::PasswordFieldComponent.new(name: "current_password", id: "current_password", label: "Current password",
            autocomplete: "current-password", autofocus: true) %>
    </div>

    <div class="mb-4">
      <%= render Admin::PasswordFieldComponent.new(name: "password", id: "password", label: "New password", meter: true) %>
    </div>

    <div class="mb-4">
      <%= render Admin::PasswordFieldComponent.new(name: "password_confirmation", id: "password_confirmation", label: "Confirm new password") %>
    </div>

    <%= render Admin::ButtonComponent.new(label: "Change password", variant: :primary, type: "submit", data: { password_submit: true }) %>
  <% end %>
</div>
