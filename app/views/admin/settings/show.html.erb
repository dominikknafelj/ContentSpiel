<%# The Settings screen (cs-studio spec §6.1; round 3, Task 5, handoff §4.5): a
    nav of anchors at the left (`Admin::SettingsScreen::NavComponent`) and one
    card per section in a column up to 1100px wide altogether. ONE form
    (`#settings-form`) wraps the whole column and carries the ONE save footer
    (`Admin::Ui::SaveBarComponent`, at its bottom): the Site and Publishing cards,
    the Languages card's order and fallbacks and the AI card's provider and
    model are its fields. What can't be a field of it -- the AI key (its own
    save, instantly, never rendered back), Test connection, and the Languages
    card's Default, Turn off and Add -- is associated with forms of its own
    that sit AFTER this one in `#settings-ai-key-forms` and
    `#settings-language-forms` (forms can't nest, and the dialog forms can't be
    inside it either), through the `form=` attribute or a dialog trigger.
    Each card shows only for the right that owns it (decision D9): a viewer with
    only `languages.manage` gets this same form with just the Languages card
    and the footer.

    After a refused save the same screen comes back (422), or after a stale one
    (409): `@submitted` holds what was typed, so every field shows that and
    nothing is lost (`Admin::SettingsScreen::Values`). %>
<% content_for :title, "Settings" %>
<% tab = @tab_locale || admin_locale %>
<% manage_settings = can?("settings.manage") %>
<% manage_languages = can?("languages.manage") %>
<% values = Admin::SettingsScreen::Values.new(site: @site_setting, submitted: @submitted) %>
<% base = params[:base_updated_at].presence || @site_setting.updated_at.iso8601(6) %>
<% error_ids = { "title" => "settings-#{Locales.default}-title", "tagline" => "settings-#{Locales.default}-tagline", "time_zone" => "settings-time_zone",
     "trash_retention_days" => "settings-trash_retention_days", "ai_provider" => "settings-ai_provider", "ai_model" => "settings-ai_model",
     "social_links" => "settings-social-0-name" } %>

<div class="grid max-w-[1100px] grid-cols-1 items-start gap-x-7 gap-y-4 lg:grid-cols-[170px_minmax(0,1fr)]">
  <div class="lg:sticky lg:top-[calc(var(--admin-top-offset)+1.75rem)]">
    <h1 class="mb-3.5 text-h1 text-ink">Settings</h1>
    <%= render Admin::SettingsScreen::NavComponent.new(sections: Admin::SettingsScreen::NavComponent.sections_for { |permission| can?(permission) }) %>
  </div>

  <div class="flex min-w-0 flex-col gap-5">
    <% if @stale_form %>
      <%= render "admin/shared/stale_banner", message: Admin::SettingsController::STALE_MESSAGE, lead: Admin::SettingsController::STALE_LEAD, change: @stale_change, reload_path: admin_settings_path(**admin_url_options) %>
    <% end %>
    <%# Full messages, so "AI provider isn't an available provider" keeps the name
    the model gives its attribute instead of the humanized key ("Ai provider"). %>
    <% summary = @errors.respond_to?(:group_by_attribute) ? @errors.group_by_attribute.transform_values { |errors| errors.map(&:full_message) } : (@errors || []) %>
    <%= render Admin::Ui::ErrorSummaryComponent.new(errors: summary, field_ids: error_ids.merge("logo" => "settings-logo")) %>

    <% if manage_settings || manage_languages %>
      <%= form_with url: admin_settings_path, method: :patch, id: "settings-form", multipart: true, class: "flex flex-col gap-5",
            data: save_bar_form_data(dirty: @stale_form || @errors.present?) do %>
        <%= render partial: "admin/shared/base_updated_at_field", locals: { id: "settings-base-updated-at", value: base } %>

        <% if manage_settings %>
          <%= render Admin::SettingsScreen::SiteCardComponent.new(site_setting: @site_setting, values: values, locale: tab,
                errors: (@errors if @errors.respond_to?(:full_messages_for))) %>
        <% end %>
        <% if manage_languages %><%= render Admin::SettingsScreen::LanguagesCardComponent.new(site_setting: @site_setting, values: values) %><% end %>
        <% if manage_settings %>
          <%= render Admin::SettingsScreen::PublishingCardComponent.new(values: values,
                errors: (@errors.full_messages_for(:trash_retention_days) if @errors.respond_to?(:full_messages_for)).to_a) %>
          <% field_errors = ->(name) { @errors.respond_to?(:full_messages_for) ? @errors.full_messages_for(name) : [] } %>
          <%= render Admin::SettingsScreen::AiCardComponent.new(site_setting: @site_setting, values: values,
                provider_errors: field_errors.call(:ai_provider), model_errors: field_errors.call(:ai_model)) %>
        <% end %>

        <%= render Admin::Ui::SaveBarComponent.new(form_id: "settings-form", cancel_url: admin_settings_path(**admin_url_options), save_label: "Save") %>
      <% end %>

      <%# Forms of their own, outside the one above (see the comment at the top). %>
      <% if manage_settings %>
        <%= render "admin/settings/ai_key_forms", site_setting: @site_setting, main_base: base %>
      <% end %>
      <% if manage_languages %>
        <div id="settings-language-forms"><%= render Admin::SettingsScreen::LanguageDialogsComponent.new(site_setting: @site_setting) %></div>
      <% end %>
    <% end %>
  </div>
</div>
