<%# locals: site_setting -- the AI API key's section of the Settings
    module (translation helpers spec §6.2), wrapped in one element whose id
    a Turbo Stream `replace` targets after any save that touched the key
    (`Admin::SettingsController#ai_key_field_stream`), so it's rendered from
    this one partial on the GET and in that stream alike.

    The key itself is never rendered (global constraints), and never even
    decrypted here: only whether one is stored (`SiteSetting#ai_api_key_
    set?`, the raw column), so an unreadable key still shows and can still
    be removed or replaced. The password field is always empty; typing into
    it and saving replaces the key, saving it blank keeps the stored one,
    and Remove key (behind the shared confirm dialog) clears it.

    Its own form, not part of the autosaving settings form (see
    `Admin::SettingsFormComponent`'s template), PATCHing the same endpoint. %>
<% key_set = site_setting.ai_api_key_set? %>
<div id="settings-ai-key-section" class="mb-4">
  <%= form_with url: admin_settings_path, method: :patch, class: "admin-column" do %>
    <%= label_tag "settings-ai_api_key", key_set ? "Replace API key" : "API key", class: setup_label_class %>
    <p class="mt-1 text-sm text-ink" data-ai-key-state="<%= key_set ? "set" : "unset" %>">
      <%= key_set ? "API key: set" : "No API key" %>
    </p>
    <div class="flex flex-wrap items-center gap-2">
      <%= password_field_tag "site_setting[ai_api_key]", nil, id: "settings-ai_api_key",
            autocomplete: "off", spellcheck: false, placeholder: key_set ? "Paste a new key to replace it" : "Paste the provider's API key",
            class: "#{setup_input_class} max-w-md" %>
      <%= button_tag "Save key", type: "submit", class: "#{setup_primary_button_class} mt-1" %>
      <% if key_set %>
        <%= render Admin::ButtonComponent.new(label: "Remove key", variant: :secondary, type: "button",
              onclick: "document.getElementById('settings-ai-remove-key-dialog').showModal()") %>
      <% end %>
    </div>
    <div id="<%= Admin::FieldComponent.error_id("settings", "ai_api_key") %>" class="mt-1 text-sm text-danger-ink"></div>
  <% end %>

  <% if key_set %>
    <%# Outside the key's form: the dialog carries a form of its own. %>
    <%= render Admin::ConfirmDialogComponent.new(id: "settings-ai-remove-key-dialog", title: "Remove the API key?",
          body: "AI translation stops working until a new key is saved.") do |dialog| %>
      <% dialog.with_confirm_action do %>
        <%= form_with url: admin_settings_path, method: :patch do %>
          <%= hidden_field_tag "site_setting[remove_ai_key]", "1", id: nil %>
          <%= render Admin::ButtonComponent.new(label: "Remove key", variant: :danger, type: "submit") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
