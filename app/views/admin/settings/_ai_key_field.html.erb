<%# locals: site_setting -- the API key's part of the AI card (translation
    helpers spec §6.2), wrapped in one element whose id a Turbo Stream
    `replace` targets after a key save (`Admin::SettingsController#ai_key`).

    The key itself is never rendered, and never even decrypted here: only
    whether one is stored (`SiteSetting#ai_api_key_set?`, the raw column), so an
    unreadable key still shows and can still be removed or replaced. The
    password field is always empty; saving it with a new key replaces the key,
    saving it blank keeps the stored one, and Remove key (behind the shared
    confirm dialog, which lives in `_ai_key_forms`) clears it.

    The field and its button belong to the key's own form (`form=`), not to the
    Settings form this markup sits inside: the key is saved at once, on its own,
    and must never count as a pending change of the main form. %>
<% key_set = site_setting.ai_api_key_set? %>
<div id="settings-ai-key-section" class="admin-column">
  <%= label_tag "settings-ai_api_key", key_set ? "Replace API key" : "API key", class: setup_label_class %>
  <p class="mt-1 text-sm text-ink" data-ai-key-state="<%= key_set ? "set" : "unset" %>">
    <%= key_set ? "API key: set" : "No API key" %>
  </p>
  <div class="flex flex-wrap items-center gap-2">
    <%= password_field_tag "site_setting[ai_api_key]", nil, id: "settings-ai_api_key", form: "settings-ai-key-form",
          autocomplete: "off", spellcheck: false, placeholder: key_set ? "Paste a new key to replace it" : "Paste the provider's API key",
          class: "#{setup_input_class} max-w-md" %>
    <%= button_tag "Save key", type: "submit", form: "settings-ai-key-form", class: "#{setup_primary_button_class} mt-1" %>
    <% if key_set %>
      <%= render Admin::ButtonComponent.new(label: "Remove key", variant: :secondary, type: "button", data: dialog_trigger("settings-ai-remove-key-dialog")) %>
    <% end %>
  </div>
  <div id="<%= Admin::FieldComponent.error_id("settings", "ai_api_key") %>" class="mt-1 text-sm text-danger-ink"></div>
</div>
