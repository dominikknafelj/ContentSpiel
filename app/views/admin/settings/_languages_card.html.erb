<%# The Languages card, as far as round 3's Task 5 goes: the languages still
    have their own screen, and this card points at it. Task 6 moves them in
    (the order and fallbacks as fields of the Settings form; Add, Turn off and
    the default as instant actions) and replaces this. %>
<section class="admin-settings-card rounded-cs border border-line bg-surface" aria-labelledby="languages">
  <div class="border-b border-line px-4 py-3.5">
    <h2 id="languages" class="text-h2 text-ink">Languages</h2>
  </div>
  <div class="p-4">
    <%= link_to "Open languages", admin_settings_languages_path(**admin_url_options), class: setup_secondary_link_class %>
  </div>
</section>
