<%# The editors' two head tags (`admin/pages/show`): Back never restores a panel form
    with a stale `base_updated_at` (or a stale NO ALT chip or segment count) from
    Turbo's page cache, and a hover-prefetched tile answer older than a save is
    never used for a click. %>
<%# The tab's title names the chosen image (the panel is a URL of its own). %>
<% content_for :title, [ @selected&.title.presence, t(".title"), t("admin.layout.title") ].compact.join(" · ") %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
  <meta name="turbo-prefetch" content="false">
<% end %>
<%# THE FOLDERS COLUMN: the shell's tree column, subject `media` (its words:
    "Hide folders", the strip's, the divider's and the top bar's "Folders"),
    outside `#content`, so a frame navigation keeps it. Like the Pages tree it
    is drawn for a full answer only: a frame answer keeps only `#content`, and
    a column drawn into one would be read and sent for nothing. It holds the
    head (the heading and the column's hide button), the find field over the
    folders and the tree of places (`Admin::MediaLibrary::FolderTreeComponent`,
    whose part every folder or move answer replaces). Its selection follows the
    place this view names (`admin--media--folders`, from `data-media-place`
    below), and its rows' links the search it names (`data-media-query`).
    Below 1024px the column is the tree drawer, opened by the top bar's
    "Folders". %>
<% unless turbo_frame_request? %>
  <% content_for :tree_label, "media" %>
  <% content_for :tree do %>
    <div class="mb-2 flex items-center gap-2 px-1">
      <h2 class="flex-1 text-sm font-semibold text-ink"><%= t("admin.components.media_library.folder_tree.heading") %></h2>
      <%# "+ New folder" creates at the top (the folder dialog drawn below);
          before the hide button, so it is the drawer's first stop. %>
      <% if can?("media.manage") %>
        <%= render Admin::Ui::ButtonComponent.new(label: t("admin.components.media_library.folder_tree.new_folder"), variant: :secondary, size: :small,
              data: Admin::MediaLibrary::FolderTreeComponent.add_params(nil, nil)) %>
      <% end %>
      <%= render Admin::Ui::TreeHideComponent.new(subject: "media") %>
    </div>
    <%= render Admin::Ui::TreeFindComponent.new(controls: Admin::MediaLibrary::FolderTreeComponent::ID, noun: :folders) %>
    <%= render Admin::MediaLibrary::FolderTreeComponent.new(tree: @folder_tree, counts: @folder_counts, place: @place, query: @place_query,
          open_set: @media_open, manage: can?("media.manage")) %>
  <% end %>
<% end %>
<%# The Media module: the header with "Upload images", the drop zone, the
    toolbar (search and segments with counts) and the grid, with the chosen
    image's rail beside it. Choosing a tile is a link into the `content` frame
    that keeps the search, the segment, the place, the page and the language,
    so Back returns to the previous choice.

    `#media-library` is a container (`admin-media`), so the rail is laid out by
    the room the library has, never the window's
    (content-spiel.tailwind.css, "THE MEDIA RAIL"). It names the place and the
    search it lists (`data-media-place`, `data-media-query`: a JSON object of
    `q` and `filter`) for the Folders column's script.

    In selection mode (`select=1`) it carries `admin--media--selection`,
    which holds the selection of this page's tiles and the bar's state: the
    bar stands between the head and the grid, a child of the library so it
    stays stuck over the whole grid.

    It always carries `admin--media--drag`: a tile (or, in selection mode,
    the selection, from a ticked tile) dragged onto a row of the Folders
    column, and a folder by its row's handle, which the controller reaches
    by the tree's id (the column stands outside the content frame). The
    ghost that follows the pointer is the `<template>` below, the drop's
    words its `data-messages`, and what it says goes into the screen's
    polite status, the upload's line.

    And `admin--media--live`: when another tab changed the library, the
    Folders column's part is fetched again and replaced silently, and when
    the place shown changed (`data-media-place-digest`, `Media::Place#digest`)
    the notice drawn from the `<template>` below stands above the grid
    (`data-admin--media--live-target="slot"`). Its subscription is a live
    part of the page (`data-live-part`). %>
<% selection = (@selecting ? { action: "keydown.esc@document->admin--media--selection#escape" } : {}) %>
<% drag_messages = messages_data("components.media_library.drag.count", "components.media_library.drag.moved", "components.media_library.drag.refused", "components.media_library.drag.too_deep", "components.media_library.drag.this_folder", "components.media_library.drag.name_taken") %>
<%= tag.div id: "media-library", class: "admin-page admin-page--wide admin-media-library",
      data: { media_place: @place.to_param, media_place_digest: @place.digest(@folder_tree), media_query: @place_query.to_json,
              controller: [ "admin--media--drag", "admin--media--live", ("admin--media--selection" if @selecting) ].compact.join(" "),
              live_part: "waiting",
              "admin--media--live-url-value": admin_media_folder_tree_path(**admin_url_options),
              "admin--media--drag-move-url-value": admin_media_move_path(**admin_url_options),
              "admin--media--drag-folder-url-value": admin_media_folder_path("FOLDER_ID", **admin_url_options),
              "admin--media--drag-drop-class": Admin::Ui::TreeItemComponent::CLASSES[:drop_into],
              messages: drag_messages,
              action: [ selection[:action], "turbo:before-cache@document->admin--media--live#reset",
                        "turbo:before-stream-render@document->admin--media--live#answeredWrite",
                        "admin--media--upload:uploaded->admin--media--live#uploaded" ].compact.join(" ") } do %>
<%= render "admin/media/live_notice" %>
<%# The drag's ghost: a pill at elevation 4 with the dragged tile's
    thumbnail, the title or "%{count} images", and the count when it is more
    than one. Never heard: the polite status says what a drop did. %>
<template data-admin--media--drag-target="ghost">
  <div class="admin-media-drag-ghost" aria-hidden="true">
    <img alt="" class="admin-media-drag-ghost__thumb" data-media-drag-thumb>
    <span class="admin-media-drag-ghost__label" data-media-drag-label></span>
    <span class="admin-media-drag-ghost__count" data-media-drag-count hidden></span>
  </div>
</template>
<div class="admin-media-library__head">
<%# Uploading: the wrapper carries `admin--media--drop` (a file drag
    anywhere on the screen shows the overlay below and a drop hands its files to
    `admin--media--upload`) and `admin--media--upload` itself (the queue: a progress
    tile per file at the start of the grid, one at a time, nothing reloads). The
    Ui::FileDropComponent inside is the visible zone and the labelled file input; it
    stops its own drops from reaching the document-level handler twice
    (file_drop_controller.js). The heading's button opens the same input. A
    progress tile takes the finished tile's box (`tile-class`), and its words are
    the `data-messages` here. %>
<div class="mb-4 flex flex-col gap-4"
     data-controller="admin--media--drop admin--media--upload"
     data-admin--media--upload-url-value="<%= admin_media_path(**admin_url_options) %>"
     data-admin--media--upload-tile-class-value="<%= Admin::MediaLibrary::TileComponent::CARD %>"
     data-admin--media--upload-button-class-value="<%= Admin::Ui::ButtonComponent.classes(:secondary, size: :small) %>"
     data-messages="<%= messages_data(*Admin::MediaLibrary::TileComponent::UPLOAD_MESSAGES) %>"
     data-action="admin--media--drop:dropped->admin--media--upload#dropped">
  <%# The place heading: the breadcrumb, the place's name as the `h1`, its count
      and Upload images (`Admin::MediaLibrary::PlaceHeadingComponent`), inside
      the upload wrapper because its button is the upload controller's. %>
  <%= render Admin::MediaLibrary::PlaceHeadingComponent.new(place: @place, tree: @folder_tree, count: @counts.fetch(:all), query: @place_query, manage: can?("media.manage"),
        select_url: admin_media_path(**@link_params, select: "1", **admin_url_options), selecting: @selecting) %>
  <%# The zone is the empty library's invitation: once the library holds a kept
      image (whatever the search shows) the wrapper is hidden. The file input
      stays in the document, the header button's and the full-window drop's
      target (`admin--media--upload-target="input"`). The status line is
      outside it, for a screen reader. %>
  <%= tag.div hidden: @library_has_images, data: { media_drop_zone: "" } do %>
    <%= render Admin::Ui::FileDropComponent.new(name: "media-upload-input", id: "media-upload-input", multiple: true, label: t(".upload"),
          hint: t(".hint", mb: ImageSettings.current.max_upload_mb),
          data: { "admin--media--upload-target": "input", action: "change->admin--media--upload#filesSelected" }) %>
  <% end %>
  <%# What each file's tile says, for a screen reader: uploaded, or not and
      why; and what a drag's drop did (`admin--media--drag`): the screen's
      polite status. %>
  <p class="sr-only" role="status" aria-live="polite" data-admin--media--upload-target="status" data-admin--media--drag-target="status"></p>
  <%# Centred by flex over the whole window, translucent (the page stays
      visible behind it, as in the mock), and never in the way of the drop
      itself (`pointer-events-none`: the drag keeps its real target). %>
  <div hidden data-admin--media--drop-target="overlay" aria-hidden="true"
       class="pointer-events-none fixed inset-0 z-(--cs-z-drop) flex items-center justify-center border-2 border-dashed border-accent bg-accent-tint/85">
    <p class="rounded-card bg-popover px-6 py-4 text-h2 text-ink shadow-3"><%= t(".drop") %></p>
  </div>
</div>

<%= render Admin::MediaLibrary::ToolbarComponent.new(counts: @counts, filter: @search.filter, q: params[:q], selected_id: @selected&.id, url_options: admin_url_options, place: (@place.to_param unless @place.all?), place_name: (@folder_tree.find(@place.folder).name if @place.folder)) %>
</div>

<% if @selecting %>
  <%= render Admin::MediaLibrary::SelectionBarComponent.new(count_on_page: @assets.size, done_url: admin_media_path(**@link_params.except(:select), **admin_url_options)) %>
<% end %>

<% page_url = ->(page) { admin_media_path(list_params(:q, :filter, :selected, :folder).merge("page" => page)) } %>
<%# DOM order is visual order at every width (grid, then rail; the rail stacks
    under the grid in a narrow library): no `order-*` swap, so tab order never
    contradicts what is drawn. `admin--media--panel` moves focus into the
    panel when a tile was chosen, and back to the tile when the rail is closed. %>
<div class="admin-page__body admin-media-library__grid" data-controller="admin--media--panel">
  <div class="admin-media-library__main">
    <div data-admin--media--live-target="slot"></div>
    <% if @pagination.out_of_range? %>
      <%= render "admin/shared/out_of_range_page", url: page_url.call(1) %>
    <% else %>
      <%= render Admin::MediaLibrary::GridComponent.new(assets: @assets, url_options: admin_url_options, selected_id: @selected&.id, link_params: @link_params,
            place: @place, tree: @folder_tree, subfolders: (@place.folder ? @folder_tree.children(@place.folder) : []), select: @selecting) %>
      <% if @pagination.total_pages > 1 %>
        <div class="mt-4 rounded-card bg-surface shadow-1">
          <%= render Admin::Ui::PaginationComponent.new(pagination: @pagination, url: page_url) %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @selected %>
    <%# The chosen image's rail: the editors' rail parts and script
        (`admin--ui--rail`), its tabs Image and what is registered at
        `media.rail.tabs` (`Admin::Slots`), which this view draws without
        knowing. Where the library docks the rail the tabs choose the panel;
        below that there are no tabs and every panel stands in the page, one
        under the other. Each panel is drawn once and never moved or cloned.

        It is a plain box: the Image panel inside is the one landmark (a
        `section` named by the image's title, and the focus target).

        Close is the rail's last child, over its top-right corner: a link, so
        it advances the address and works without script, back to the grid
        as the editor left it, with the focus on the tile
        (`admin--media--panel#close`). Escape inside the rail does the same
        unless something inside takes it (`#escape`). A choice of another
        tile keeps the tab that was current (`admin--media--panel`, through
        `admin--ui--rail:reveal`). %>
    <% rail_id = "media-rail" %>
    <% rail_slot = Admin::Ui::RailSlotComponent.new(slot: "media.rail.tabs", rail_id: rail_id, record: @selected, viewer: Current.actor, reserved: %w[image],
                                                    locale: admin_locale, url_options: admin_url_options, query: request.query_parameters) %>
    <% current = rail_slot.current_key || "image" %>
    <% tooltip = Admin::Ui::TooltipComponent.host_data %>
    <%= tag.div id: rail_id, class: "admin-media-rail", data: { controller: "admin--ui--rail", action: "keydown.esc->admin--media--panel#escape admin--ui--rail:reveal->admin--ui--rail#reveal" } do %>
      <%= render Admin::Ui::RailTabsComponent.new(rail_id: rail_id, tabs: [ Admin::Ui::RailTabsComponent::Tab.new(key: "image", label: t(".image_tab")) ],
            slot_tabs: rail_slot.tabs, current: current, label: t(".rail_label")) %>
      <%= render Admin::Ui::RailPanelComponent.new(rail_id: rail_id, key: "image", current: current == "image") do %>
        <%= render Admin::MediaLibrary::PanelComponent.new(asset: @selected, locale: admin_locale, url_options: admin_url_options, link_params: @link_params, tree: @folder_tree) %>
      <% end %>
      <%= render rail_slot %>
      <%= link_to admin_media_path(**@link_params, **admin_url_options),
            class: "admin-media-rail__close #{Admin::Ui::TooltipComponent::HOST} #{Admin::Ui::ButtonComponent.classes(:tertiary, size: :small)}",
            aria: { label: t(".close") },
            data: { controller: tooltip[:controller], action: "#{tooltip[:action]} click->admin--media--panel#close",
                    turbo_frame: "content", turbo_action: "advance",
                    "admin--media--panel-target": "close", "admin--media--panel-tile-id-param": @selected.id } do %>
        <%= render "admin/shared/icon", name: :x, size: "size-4" %><%= render Admin::Ui::TooltipComponent.new(text: t(".close")) %>
      <% end %>
    <% end %>
  <% end %>
</div>
<% end %>

<%# THE FOLDER DIALOGS, for `media.manage`: once each, after the library and
    outside every form, but inside the content frame (this view is the
    frame's answer), so a frame navigation draws them again with the place
    it opens. The folder dialog is opened by every create and rename trigger
    (the Folders column's, outside the frame, find it by its id, as every
    dialog is found); the delete confirm exists only in a folder, worded for
    that folder (`Media::DeleteFolder.preview`). %>
<%# The Move to… dialog, for everyone on the screen (an uploader moves their
    own images): its list is loaded for the trigger pressed. %>
<%= render Admin::MediaLibrary::MoveDialogComponent.new(url_options: admin_url_options) %>
<% if can?("media.manage") %>
  <%= render Admin::MediaLibrary::FolderDialogComponent.new(tree: @folder_tree, place: @place.to_param, query: @place_query) %>
  <% if @delete_preview %>
    <%= render Admin::MediaLibrary::DeleteFolderDialogComponent.new(folder: @shown_folder, preview: @delete_preview, tree: @folder_tree, query: @place_query) %>
  <% end %>
<% end %>
