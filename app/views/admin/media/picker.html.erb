<%# `Media::PickerComponent`'s Library tab (media library design spec §6,
    Task 8): `Admin::MediaController#index` with `picker=1`, rendered
    without a layout into the picker's own `<turbo-frame>` -- the search
    form and the Previous/Next links below stay inside that frame (Turbo
    scopes a frame's own forms and links to it), so searching and paging
    never navigate the editor underneath the modal. `picker` rides along in
    the form (hidden field) and in the pagination links
    (`request.query_parameters`), so every later request comes back here,
    not to the full Media module page. %>
<turbo-frame id="media-picker-library">
  <%= form_with url: admin_media_path(**admin_url_options), method: :get, class: "mb-4 flex flex-wrap items-end gap-3" do %>
    <%= hidden_field_tag :picker, "1", id: nil %>
    <% if admin_locale != Locales.default %>
      <%= hidden_field_tag :locale, admin_locale, id: nil %>
    <% end %>

    <div>
      <%= label_tag "media-picker-q", "Search images", class: setup_label_class %>
      <%= search_field_tag :q, params[:q], id: "media-picker-q", placeholder: "Title, alt text or filename", class: setup_input_class %>
    </div>

    <div>
      <%= label_tag "media-picker-filter", "Show", class: setup_label_class %>
      <%= select_tag :filter, options_for_select([ [ "All", "" ], [ "Unused", "unused" ], [ "Mine", "mine" ] ], params[:filter]),
            id: "media-picker-filter", class: setup_input_class %>
    </div>

    <%= render Admin::ButtonComponent.new(label: "Search", variant: :secondary, type: "submit") %>
  <% end %>

  <%= render Admin::MediaLibrary::GridComponent.new(assets: @assets, url_options: admin_url_options, pick: true, locale: admin_locale) %>

  <% if @has_next || @offset.positive? %>
    <div class="mt-4 flex items-center gap-3">
      <% if @offset.positive? %>
        <%= link_to "Previous", admin_media_path(request.query_parameters.merge("offset" => [ @offset - Admin::MediaController::PER_PAGE, 0 ].max)),
              class: setup_secondary_link_class %>
      <% end %>
      <% if @has_next %>
        <%= link_to "Next", admin_media_path(request.query_parameters.merge("offset" => @offset + Admin::MediaController::PER_PAGE)),
              class: setup_secondary_link_class %>
      <% end %>
    </div>
  <% end %>
</turbo-frame>
