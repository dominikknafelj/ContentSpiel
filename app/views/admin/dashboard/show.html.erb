<%# CS Studio's start page (design pass round 2, Task 16): one-row quick
    create, the cards in an auto-fit grid (each at most 5 rows and a "→"
    to the fuller list), then "Recent activity". Every list comes from
    `Dashboard::Feed` / `Dashboard::Activity` / `Dashboard::TranslationNeeds`,
    already read-scoped and loaded in a constant number of queries; the
    components only render what they return. A user who can read nothing
    simply gets empty cards.

    No `content_for :tree` here: the dashboard isn't a Pages screen, so the
    layout's grid collapses to its two-column form, same as every other
    module but Pages. %>
<h1 class="mb-4 text-h1 text-ink">Dashboard</h1>

<% quick_create = Admin::DashboardScreen::QuickCreateComponent.new(**(@draft || {})) %>
<%# The empty-state copy points at the quick-create row ("start one above"),
    so it only says so when that row is there for this viewer. %>
<%= render quick_create %>

<%# The "→" goes to the posts list, filtered by status -- the only filtered
    list there is. It shows every readable post in that state, not only mine
    and not pages; it's the fuller list, not the same list longer. Only for
    someone who can open the posts list. %>
<% posts_list = ->(status, label) { [ admin_posts_path(scope: status, **admin_url_options), label ] if can?("posts.read") } %>
<% going_live = @feed.going_live_next %>

<div class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-4">
  <%# Notes (notes spec §5): what was addressed to the viewer, and where
      threads are open. Each is a frame of its own that its own GET answers
      again (`Admin::NoteInboxController`). The unread number is the
      sidebar's (`notes_badge_count`): asked once for both. %>
  <%= render "admin/note_inbox/card", rows: Dashboard::NotesForYou.new(actor: Current.actor, locale: admin_locale).rows, unread: notes_badge_count %>
  <%= render "admin/note_inbox/open_threads", open_threads: Dashboard::OpenThreads.new(actor: Current.actor) %>

  <%= render Admin::DashboardScreen::CardComponent.new(title: "Your drafts", id: "dashboard-drafts", empty: (quick_create.render? ? "No drafts — start one above." : "No drafts."),
        link: posts_list.call("drafts", "All drafts")) do |card| %>
    <% @feed.drafts.each do |record| %>
      <% card.with_row { render Admin::DashboardScreen::RowComponent.new(record:, variant: :draft) } %>
    <% end %>
  <% end %>

  <%= render Admin::DashboardScreen::CardComponent.new(title: "Going live next", id: "dashboard-going-live-next", empty: "Nothing scheduled on the site.",
        link: posts_list.call("scheduled", "All scheduled posts"), hint: ("Schedule a draft to see it here." if going_live.size < 3 && quick_create.render?)) do |card| %>
    <% going_live.each do |record| %>
      <% card.with_row { render Admin::DashboardScreen::RowComponent.new(record:, variant: :going_live, mine: @feed.mine?(record)) } %>
    <% end %>
  <% end %>

  <%= render Admin::DashboardScreen::TranslationCardComponent.new(entries: @translation_needs.entries) %>
</div>

<div class="mt-8 flex flex-col gap-2">
  <%= render Admin::DashboardScreen::CardComponent.new(title: "Recent activity", id: "dashboard-activity", empty: "No recent activity.", limit: nil) do |card| %>
    <% @activity.rows.each do |row| %>
      <% card.with_row { render Admin::DashboardScreen::ActivityRowComponent.new(row:) } %>
    <% end %>
  <% end %>
  <% if can?("audit.view") %>
    <%= link_to "Full audit log →", admin_audit_events_path(**admin_url_options), class: "self-end text-sm text-ink hover:underline", data: { turbo_frame: "_top" } %>
  <% end %>
</div>
