<%# CS Studio's start page: one-row quick create, the panels in a grid of
    at most three columns (`.admin-dashboard-cards`), each at most 5 rows,
    then "What changed recently". Each panel is an
    `Admin::DashboardScreen::PanelComponent` headed by its job, with one line
    under the heading, its head tinted by its kind: action (something waits
    on the viewer), shortcuts (a way back into work) or information. Every
    list comes from a `Dashboard::` query, already read-scoped and loaded in
    a constant number of queries; the components only render what they
    return. A user who can read nothing simply gets empty panels.

    No `content_for :tree` here: the dashboard isn't a Pages screen, so the
    layout's grid collapses to its two-column form, same as every other
    module but Pages. %>
<div class="admin-dashboard">
<h1 class="mb-4 text-h1 text-ink"><%= t(".title") %></h1>

<%# Mail's last send failed: drawn for settings.manage only
    (`@mail_settings` is nil for anyone else) and only while it failed. %>
<% if @mail_settings %>
  <%= render Admin::Ui::MailFailedNoticeComponent.new(mail_settings: @mail_settings,
        href: admin_settings_path(anchor: "mail", **admin_url_options), class: "mb-4") %>
<% end %>

<% quick_create = Admin::DashboardScreen::QuickCreateComponent.new(**(@draft || {})) %>
<%= render quick_create %>

<%# The "→" goes to the posts list, filtered by status -- the only filtered
    list there is. It shows every readable post in that state, not only mine
    and not pages; it's the fuller list, not the same list longer. Only for
    someone who can open the posts list. %>
<% posts_list = ->(status, label) { [ admin_posts_path(scope: status, **admin_url_options), label ] if can?("posts.read") } %>
<% going_live = @feed.going_live_next %>
<% arrow = tag.span("→", aria: { hidden: true }) %>

<div class="admin-dashboard-cards">
  <%# Two frames, each answered again by its own GET when a live note
      arrives: Notes for you, what was addressed to the viewer
      (`Admin::NoteInboxController#card`; its unread number is the sidebar's,
      `notes_badge_count`, asked once for both), and Waiting for you, the
      records with open threads or unpublished changes
      (`Admin::DashboardController#waiting`). %>
  <%= render "admin/note_inbox/card", rows: Dashboard::NotesForYou.new(actor: Current.actor, locale: admin_locale).rows, unread: notes_badge_count %>
  <%= render "admin/dashboard/waiting", waiting: Dashboard::WaitingForYou.new(actor: Current.actor) %>

  <%= render Admin::DashboardScreen::PanelComponent.new(kind: :shortcuts, title: t(".drafts.title"), line: t(".drafts.line"), id: "dashboard-drafts",
        empty: t(".drafts.empty"), link: posts_list.call("drafts", t(".drafts.all"))) do |card| %>
    <%# "Start a draft" is there whenever the quick-create row is: it takes the focus to its title. %>
    <% if quick_create.render? %>
      <% card.with_empty_action do %>
        <%= link_to t(".drafts.start"), "#dashboard_draft_title", class: "text-ink underline",
              data: { controller: "admin--dashboard--start-draft", action: "admin--dashboard--start-draft#start", "admin--dashboard--start-draft-field-value": "dashboard_draft_title" } %>
      <% end %>
    <% end %>
    <% @feed.drafts.each do |record| %>
      <% card.with_row { render Admin::DashboardScreen::RowComponent.new(record:, variant: :draft) } %>
    <% end %>
  <% end %>

  <%= render Admin::DashboardScreen::PanelComponent.new(kind: :information, title: t(".going_live.title"), line: t(".going_live.line"),
        id: "dashboard-going-live-next", empty: t(".going_live.empty"), link: posts_list.call("scheduled", t(".going_live.all"))) do |card| %>
    <% if can?("posts.read") %>
      <% card.with_empty_action do %>
        <%= link_to t(".going_live.drafts_html", arrow:), admin_posts_path(scope: "drafts", **admin_url_options), class: "text-ink underline", data: { turbo_frame: "_top" } %>
      <% end %>
    <% end %>
    <% going_live.each do |record| %>
      <% card.with_row { render Admin::DashboardScreen::RowComponent.new(record:, variant: :going_live, mine: @feed.mine?(record)) } %>
    <% end %>
  <% end %>

  <%= render Admin::DashboardScreen::TranslationPanelComponent.new(entries: @translation_needs.entries) %>
</div>

<div class="mt-8 flex flex-col gap-2">
  <%= render Admin::DashboardScreen::PanelComponent.new(kind: :information, title: t(".activity.title"), line: t(".activity.line"), id: "dashboard-activity",
        empty: t(".activity.empty"), limit: nil) do |card| %>
    <% @activity.rows.each do |row| %>
      <% card.with_row { render Admin::DashboardScreen::ActivityRowComponent.new(row:) } %>
    <% end %>
  <% end %>
  <% if can?("audit.view") %>
    <%= link_to t(".activity.audit_log_html", arrow:), admin_audit_events_path(**admin_url_options), class: "self-end text-sm text-ink hover:underline", data: { turbo_frame: "_top" } %>
  <% end %>
</div>
</div>
