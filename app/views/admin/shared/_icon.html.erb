<%# Small inline icon set for the modules column (cs-studio spec §4.2). A
    partial rather than a new helper or view component, so Task 3's admin UI
    kit is free to absorb or replace it outright without this shell needing
    to change again. `aria-hidden` on every icon and `focusable="false"` for
    old Edge/IE: the accessible name for a nav item always comes from its own
    text label (kept in the DOM, just visually hidden below `md` -- see
    layouts/admin.html.erb), never from the icon. %>
<% case name
when :pages %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M8 3h5l5 5v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13 3v5h5" /></svg>
<% when :posts %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h12a1 1 0 0 1 1 1v12.5a1.5 1.5 0 0 1-1.5 1.5H6a2 2 0 0 1-2-2V5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17 8.5h2.5a.5.5 0 0 1 .5.5v9a2 2 0 0 1-2 2h-1.5" /><path stroke-linecap="round" stroke-linejoin="round" d="M7 9h6M7 12h6M7 15h3" /></svg>
<% when :tags %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4h6.17a1 1 0 0 1 .71.29l8.83 8.83a1 1 0 0 1 0 1.42l-6.17 6.17a1 1 0 0 1-1.42 0L3.29 11.88A1 1 0 0 1 3 11.17V5a1 1 0 0 1 1-1Z" /><circle cx="8" cy="8" r="1.25" fill="currentColor" stroke="none" /></svg>
<% when :external %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M11 16l4-4-4-4" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12H3" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4" /></svg>
<% when :settings %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" /></svg>
<% when :users %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19" /><circle cx="9" cy="8" r="3.25" /><path stroke-linecap="round" stroke-linejoin="round" d="M17 14.5a3.5 3.5 0 0 1 3 3.46V19" /><path stroke-linecap="round" stroke-linejoin="round" d="M14.5 5.1a3.25 3.25 0 0 1 0 6.3" /></svg>
<% when :assistant %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><rect x="5" y="8" width="14" height="11" rx="2" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 8V5M10 4h4" /><circle cx="9.5" cy="13" r="1" fill="currentColor" stroke="none" /><circle cx="14.5" cy="13" r="1" fill="currentColor" stroke="none" /><path stroke-linecap="round" d="M10 16.5h4M3 12v3M21 12v3" /></svg>
<% when :groups %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" /></svg>
<% when :key %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><circle cx="8" cy="15" r="4" /><path stroke-linecap="round" stroke-linejoin="round" d="M11 12l8-8M16 7l2 2M14 9l2 2" /></svg>
<% when :graph %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="2.25" /><circle cx="18" cy="8" r="2.25" /><circle cx="9" cy="18" r="2.25" /><path stroke-linecap="round" d="M8.2 6.4l7.6 1.2M7 8l1.4 7.8M16.4 9.8l-5.6 6.6" /></svg>
<% when :status %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h4l2.5-6 5 12 2.5-6h4" /></svg>
<% when :audit %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3.5 2" /></svg>
<% else
  raise ArgumentError, "unknown admin icon #{name.inspect}"
end %>
