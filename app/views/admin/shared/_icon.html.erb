<%# Small inline icon set for the modules column (cs-studio spec §4.2). A
    partial rather than a new helper or view component, so Task 3's admin UI
    kit is free to absorb or replace it outright without this shell needing
    to change again. `aria-hidden` on every icon and `focusable="false"` for
    old Edge/IE: the accessible name for a nav item always comes from its own
    text label (kept in the DOM, just visually hidden below `md` -- see
    layouts/admin.html.erb), never from the icon. %>
<% case name
when :pages %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M8 3h5l5 5v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13 3v5h5" /></svg>
<% when :posts %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h12a1 1 0 0 1 1 1v12.5a1.5 1.5 0 0 1-1.5 1.5H6a2 2 0 0 1-2-2V5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17 8.5h2.5a.5.5 0 0 1 .5.5v9a2 2 0 0 1-2 2h-1.5" /><path stroke-linecap="round" stroke-linejoin="round" d="M7 9h6M7 12h6M7 15h3" /></svg>
<% when :tags %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4h6.17a1 1 0 0 1 .71.29l8.83 8.83a1 1 0 0 1 0 1.42l-6.17 6.17a1 1 0 0 1-1.42 0L3.29 11.88A1 1 0 0 1 3 11.17V5a1 1 0 0 1 1-1Z" /><circle cx="8" cy="8" r="1.25" fill="currentColor" stroke="none" /></svg>
<% when :external %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 shrink-0" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M11 16l4-4-4-4" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12H3" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4" /></svg>
<% else
  raise ArgumentError, "unknown admin icon #{name.inspect}"
end %>
