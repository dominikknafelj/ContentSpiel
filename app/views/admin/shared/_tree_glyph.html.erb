<%# A tree row's own glyphs (`Admin::Ui::TreeItemComponent`): the 12px
    chevron of its disclosure and the 12px "+" (stroke 1.6), and the 14px
    page and home marks
    (stroke 1.3), and the Folders column's: `:folder`, `:folder_open` (the
    place shown), `:folder_none` (Not in a folder: the folder drawn dashed)
    and `:media` (All media). Each carries `data-tree-glyph="<name>"`, which
    the tree's stylesheet reads. They are the tree's sizes and strokes, not the modules
    column's icon set (`_icon.html.erb`). Hidden from a screen reader: the
    disclosure and the "+" are named by their words and the mark says
    nothing the title does not. %>
<% case name
when :chevron %>
  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.5 2.75 7.75 6 4.5 9.25" /></svg>
<% when :plus %>
  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 2.5v7 M2.5 6h7" /></svg>
<% when :page %>
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.75 1.75h5.5l3 3v9.5h-8.5z M9.25 1.75v3h3" /></svg>
<% when :home %>
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.25 7.25 8 2.5l5.75 4.75 M3.75 6v7.75h8.5V6 M6.5 13.75v-4h3v4" /></svg>
<% when :folder %>
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" data-tree-glyph="folder" aria-hidden="true" focusable="false"><path d="M13.33 13.33 a1.33 1.33 0 0 0 1.33 -1.33 V5.33 a1.33 1.33 0 0 0 -1.33 -1.33 h-5.27 a1.33 1.33 0 0 1 -1.13 -0.6 L6.4 2.6 A1.33 1.33 0 0 0 5.29 2 H2.67 a1.33 1.33 0 0 0 -1.33 1.33 v8.67 a1.33 1.33 0 0 0 1.33 1.33 Z" /></svg>
<% when :folder_open %>
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" data-tree-glyph="folder_open" aria-hidden="true" focusable="false"><path d="m4 9.33 1 -1.93 A1.33 1.33 0 0 1 6.16 6.67 H13.33 a1.33 1.33 0 0 1 1.29 1.67 l-1.03 4 a1.33 1.33 0 0 1 -1.3 1 H2.67 a1.33 1.33 0 0 1 -1.33 -1.33 V3.33 a1.33 1.33 0 0 1 1.33 -1.33 h2.6 a1.33 1.33 0 0 1 1.13 0.6 l0.54 0.8 a1.33 1.33 0 0 0 1.11 0.6 H12 a1.33 1.33 0 0 1 1.33 1.33 v1.33" /></svg>
<% when :folder_none %>
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2.2 2.2" data-tree-glyph="folder_none" aria-hidden="true" focusable="false"><path d="M13.33 13.33 a1.33 1.33 0 0 0 1.33 -1.33 V5.33 a1.33 1.33 0 0 0 -1.33 -1.33 h-5.27 a1.33 1.33 0 0 1 -1.13 -0.6 L6.4 2.6 A1.33 1.33 0 0 0 5.29 2 H2.67 a1.33 1.33 0 0 0 -1.33 1.33 v8.67 a1.33 1.33 0 0 0 1.33 1.33 Z" /></svg>
<% when :media %>
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" data-tree-glyph="media" aria-hidden="true" focusable="false"><rect x="2" y="3.33" width="12" height="9.33" rx="1.33" /><circle cx="5.67" cy="7" r="1" /><path d="M2 10.67 l3.33 -2.67 2.67 2.33 2 -1.67 4 3.33" /></svg>
<% else
  raise ArgumentError, "unknown tree glyph #{name.inspect}"
end %>
