<%# A tree row's own glyphs (`Admin::Ui::TreeItemComponent`): the 12px
    chevron of its disclosure and the 12px "+" (stroke 1.6), and the 14px
    page and home marks
    (stroke 1.3), and the Folders column's: `:folder`, `:folder_open` (the
    place shown), `:folder_none` (Not in a folder: the folder drawn dashed)
    and `:media` (All media). Each carries `data-tree-glyph="<name>"`, which
    the tree's stylesheet reads. They are the tree's sizes and strokes, not the modules
    column's icon set (`_icon.html.erb`). Hidden from a screen reader: the
    disclosure and the "+" are named by their words and the mark says
    nothing the title does not. %>
<% case name
when :chevron %>
  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.5 2.75 7.75 6 4.5 9.25" /></svg>
<% when :plus %>
  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 2.5v7 M2.5 6h7" /></svg>
<% when :page %>
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.75 1.75h5.5l3 3v9.5h-8.5z M9.25 1.75v3h3" /></svg>
<% when :home %>
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.25 7.25 8 2.5l5.75 4.75 M3.75 6v7.75h8.5V6 M6.5 13.75v-4h3v4" /></svg>
<% when :folder %>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" data-tree-glyph="folder" aria-hidden="true" focusable="false"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></svg>
<% when :folder_open %>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" data-tree-glyph="folder_open" aria-hidden="true" focusable="false"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2" /></svg>
<% when :folder_none %>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2.2 2.2" data-tree-glyph="folder_none" aria-hidden="true" focusable="false"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></svg>
<% when :media %>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" data-tree-glyph="media" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="14" rx="2" /><circle cx="8.5" cy="9.5" r="1.5" /><path d="M3 15l5-4 4 3.5 3-2.5 6 5" /></svg>
<% else
  raise ArgumentError, "unknown tree glyph #{name.inspect}"
end %>
