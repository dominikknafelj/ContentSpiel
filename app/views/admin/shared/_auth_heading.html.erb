<%# locals: title -- the heading block of the sign-in, reset and invitation
    pages: the site's name in the default language above the page's heading.
    Both break inside a word, so a long German name wraps in the panel. %>
<div class="flex flex-col gap-1.5">
  <p class="admin-site-name break-words text-small text-dim"><%= site_name %></p>
  <h1 class="break-words text-h1 font-semibold text-ink"><%= title %></h1>
</div>
