<%# The 403 page: rendered by `Admin::BaseController#forbidden!` inside the
    admin layout, so the modules column -- already narrowed to what this
    user can open -- is right there as the way on. Only for an *area* the
    user lacks, or an action a service refused; a record outside their read
    scope is a plain 404 instead (`errors/not_found`), so its existence isn't
    disclosed. A message on the canvas, centred and with no card, as the 404
    is: the two are the only centred things inside the shell
    (`test/lib/admin_design_rules_test.rb`). `message` is the refusal's own
    sentence and stays English (docs/reference/i18n.md). %>
<% content_for :title, t(".title") %>

<section class="admin-forbidden mx-auto flex max-w-md flex-col items-center gap-3 py-16 text-center">
  <%= render Admin::Ui::IconChipComponent.new(icon: :circle_alert, family: :neutral) %>
  <p class="text-label text-meta"><%= t(".code") %></p>
  <h1 class="text-h1 text-ink"><%= t(".heading") %></h1>
  <p role="alert" class="text-ink"><%= message %></p>
  <p class="text-small text-meta"><%= t(".advice") %></p>
  <%= link_to t(".back"), admin_root_path(**admin_url_options), class: Admin::Ui::ButtonComponent.classes(:secondary) %>
</section>
