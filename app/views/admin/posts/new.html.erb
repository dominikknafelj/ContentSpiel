<%# The no-JS fallback of the New post dialog: the dialog's own form, as a
    page, in the dialog's own words (`new_post_dialog`); see `admin/pages/new`.
    The form's `_top` target makes the redirect to the new post's editor a
    full visit. %>
<% content_for :standalone_new_record, "post" %>
<% words = "admin.components.editor_screen.new_post_dialog" %>

<% form = @form || Admin::EditorScreen::NewPostFormComponent.new(url_options: admin_url_options, locale: admin_locale,
      content_type: @post.content_type.presence || new_post_params[:content_type], title: new_post_params[:title], errors: @post.errors) %>
<div class="max-w-md">
  <h1 class="mb-4 text-base font-semibold"><%= t("#{words}.title") %></h1>

  <%= render form %>

  <div class="mt-4 flex gap-2">
    <%= render Admin::Ui::ButtonComponent.new(label: t("#{words}.create"), variant: :primary, type: "submit", form: form.form_id) %>
    <%= link_to t("#{words}.cancel"), admin_posts_path(**admin_url_options), data: { turbo_frame: "content" }, class: setup_tertiary_link_class %>
  </div>
</div>
