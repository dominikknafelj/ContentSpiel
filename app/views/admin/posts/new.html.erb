<%# The no-JS fallback of the New post dialog (design pass round 2, Task 15):
    the dialog's own form, as a page; see `admin/pages/new`. The form's
    `_top` target makes the redirect to the new post's editor a full visit. %>
<% content_for :standalone_new_record, "post" %>

<% form = @form || Admin::EditorScreen::NewPostFormComponent.new(url_options: admin_url_options, locale: admin_locale,
      content_type: @post.content_type.presence || params.dig(:post, :content_type), title: params.dig(:post, :title), errors: @post.errors) %>
<div class="mx-auto max-w-md">
  <h1 class="mb-4 text-base font-semibold">New post</h1>

  <%= render form %>

  <div class="mt-4 flex gap-2">
    <%= render Admin::ButtonComponent.new(label: "Create draft", variant: :primary, type: "submit", form: form.form_id) %>
    <%= link_to "Cancel", admin_posts_path(**admin_url_options), data: { turbo_frame: "content" }, class: setup_secondary_link_class %>
  </div>
</div>
