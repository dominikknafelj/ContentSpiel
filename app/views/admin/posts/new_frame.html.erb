<%# The New post dialog's form, answering the shell's turbo-frame (see
    `Admin::Ui::NewRecordDialogComponent`): no layout. `#new` built `@form`,
    preset from `type` and `title`. %>
<turbo-frame id="<%= Admin::Ui::NewRecordDialogComponent::KINDS.fetch(:post).frame_id %>">
  <%= render @form %>
</turbo-frame>
