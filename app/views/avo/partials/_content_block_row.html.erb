<%# One row of the Page form's inline content-block editor.

    Locals: `f` (a fields_for builder over one ContentBlock), `tool`, `title`,
    and `removable` (false for the blank "add" row, which has nothing to
    remove yet).

    `image`/`caption`/`body` are existing columns -- shown unconditionally on
    every row regardless of the block's type: it's routinely changed while
    drafting, and Avo 4.2.3 Community has no client-side conditional fields
    to swap them with. `settings`, by contrast, is rendered from the block's
    *own* `block_type` (open-types spec §6, `_typed_fields.html.erb`) -- so a
    freshly-added row (blank `block_type`) shows none until a type is picked
    and the row is saved once; picking a different type on an existing row
    shows the previous type's fields until that save happens too, the same
    "reflects what's in the database, not what you just typed" the rest of
    this row already lives with (Avo 4.2.3 Community has no live re-render). %>
<%= render ui.card(title: title, padded: true) do %>
  <div class="space-y-4">
    <div class="flex flex-wrap gap-4 items-end">
      <div>
        <%= f.label :block_type, "Type", class: "font-semibold" %>
        <%= f.select :block_type,
              BlockTypes.all.map { |definition| [ definition.label, definition.name ] },
              { include_blank: "—" },
              class: input_classes %>
      </div>

      <div>
        <%= f.label :position, "Position", class: "font-semibold" %>
        <%= f.number_field :position, class: input_classes %>
      </div>

      <% if removable %>
        <div class="flex items-center gap-2 pb-2">
          <%= f.check_box :_destroy %>
          <%= f.label :_destroy, "Remove", class: "font-semibold" %>
        </div>
      <% end %>
    </div>

    <div>
      <%= f.label :image, "Image (image blocks)", class: "font-semibold" %>
      <%= f.file_field :image, class: input_classes %>
    </div>

    <%# `locale: Locales.default`, not `settings_object`'s own ambient-
        `I18n.locale` default: `normalize_settings` (ContentBlock) always
        writes a translated setting under `Locales.default`, whatever
        `I18n.locale` happened to be ambient for the request that saved it
        (Avo's own controllers never touch it) -- reading this row back at
        the ambient locale instead would show every translated setting as
        blank the moment the two disagree, even though the save itself
        worked. %>
    <%= render "avo/partials/typed_fields", definition: f.object.definition,
          current_values: f.object.settings_object(locale: Locales.default), name_prefix: "#{f.object_name}[settings]" %>

    <% tool.locale_accessors(:caption).each do |locale, accessor| %>
      <div>
        <%= f.label accessor, "Caption (#{locale.to_s.upcase}) (image blocks)", class: "font-semibold" %>
        <%= f.text_field accessor, class: input_classes %>
      </div>
    <% end %>

    <%# Deliberately a plain HTML textarea rather than a rich editor: the
        block's own Avo form (reachable from the Content blocks panel on the
        page's Show view) is where `body` gets the full Trix editor with
        attachments. Mobility's action_text backend accepts an HTML string
        through these accessors, so what is typed here is the same value. %>
    <% tool.locale_accessors(:body).each do |locale, accessor| %>
      <div>
        <%= f.label accessor, "Body HTML (#{locale.to_s.upcase}) (rich text blocks)", class: "font-semibold" %>
        <%= f.text_area accessor, value: f.object.public_send(accessor)&.to_trix_html,
              rows: 4, class: input_classes("w-full") %>
      </div>
    <% end %>
  </div>
<% end %>
