<%# Generic schema-driven inputs for a type's field definition (open-types
    spec §6): one text input per scalar field, a select for `select`/
    `content_type`. A `group`/`groups` field has no input here yet -- like a
    block's `body`/`caption`/`image` (existing columns, not schema fields),
    it's "edited in the new admin" (sub-project 3). Throwaway until then --
    real per-type components are the point of that sub-project, this is just
    enough to keep the current admin working against open types.

    Locals:
    - `definition`: the record's own type (a `ContentModel::Definition`), or
      nil for an unregistered type -- nothing to render.
    - `current_values`: the type's `ContentModel::FieldSet` instance to read
      each field's current value from (`block.settings_object` /
      `post.fields`), or nil.
    - `name_prefix`: the raw param name prefix each input writes into, e.g.
      "#{f.object_name}[settings]" (a content-block row) or
      "#{form.object_name}[fields]" (the typed-fields resource tool). %>
<% if definition %>
  <div class="flex flex-wrap gap-4">
    <% definition.fields.each do |field| %>
      <% if field.group? %>
        <div class="text-sm text-gray-500">
          <%= field.name.humanize %> is edited in the new admin.
        </div>
      <% else %>
        <% input_name = "#{name_prefix}[#{field.name}]" %>
        <% current_value = current_values&.public_send(field.name) %>
        <div>
          <%= label_tag input_name, "#{field.name.humanize} (#{definition.label})", class: "font-semibold" %>

          <% if field.type == :content_type %>
            <%= select_tag input_name,
                  options_for_select([ [ "—", "" ] ] + ::ContentTypes.all.map { |d| [ d.label, d.name ] }, current_value.to_s),
                  class: input_classes, id: nil %>
          <% elsif field.type == :select %>
            <% raw_options = field.options[:options] %>
            <% choices = raw_options.is_a?(Hash) ? raw_options.to_a : Array(raw_options).map { |value| [ value.to_s.humanize, value ] } %>
            <%= select_tag input_name,
                  options_for_select([ [ "—", "" ] ] + choices, current_value.to_s),
                  class: input_classes, id: nil %>
          <% else %>
            <%= text_field_tag input_name, current_value, class: input_classes, id: nil %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
