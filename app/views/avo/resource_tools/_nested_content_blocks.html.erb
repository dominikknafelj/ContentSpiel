<%# The Page form's inline content-block editor. See
    app/avo/resource_tools/nested_content_blocks.rb for why this is a resource
    tool rather than Avo's `nested:` option.

    `form` is only present on New/Edit; the tool is registered `show_on: :forms`
    so it should never render anywhere else, but Avo hands resource tools a nil
    form on Show and a missing guard here is a 500 rather than a blank panel. %>
<% if form.present? %>
  <%# Read off the in-memory association rather than re-queried, so a submission
      that failed validation comes back with what the editor typed rather than
      with what is still in the database. %>
  <% blocks = form.object.content_blocks.to_a %>

  <%= render ui.panel(
    title: "Content blocks",
    description: "The page renders these in position order. Set a type on the empty row to add a block; tick Remove to delete one."
  ) do |panel| %>
    <% panel.with_body do %>
      <div class="space-y-4">
        <%# `child_index` is passed explicitly rather than left to Rails'
            per-name counter: the blank row below is a second `fields_for` call
            on the same builder, and it has to land on the index *after* the
            last real block instead of colliding with one of them. %>
        <% blocks.each_with_index do |block, index| %>
          <%= form.fields_for :content_blocks, block, multiple: true, child_index: index do |block_form| %>
            <%= render "avo/partials/content_block_row",
                  f: block_form, tool: tool, title: "Block #{index + 1}", removable: true %>
          <% end %>
        <% end %>

        <%# The "add" affordance. It rides along on every save, so Page's
            `accepts_nested_attributes_for` rejects it whenever no type was
            picked -- otherwise each save of the page would store one more
            empty block. %>
        <%= form.fields_for :content_blocks, ContentBlock.new(position: blocks.size), multiple: true, child_index: blocks.size do |block_form| %>
          <%= render "avo/partials/content_block_row",
                f: block_form, tool: tool, title: "Add a block", removable: false %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
