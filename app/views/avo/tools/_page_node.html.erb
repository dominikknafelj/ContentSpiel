<%# locals: page, root (default false)

    One page plus its own children <ul> -- recursive, so a page's children
    render the same way it does. Every children list (even an empty one)
    carries data-parent-id and is a SortableJS drop target, so a page can be
    dragged onto any node, not just reordered among its current siblings.

    The root has no drag handle: it is the one page nothing above it can ever
    move (there is nowhere for it to go -- Page's own validation guarantees
    exactly one parentless page), so nothing here treats it as draggable. %>
<li data-page-id="<%= page.id %>" class="pages-tree-node">
  <div class="flex items-center gap-2 py-1">
    <% unless root %>
      <span
        class="pages-tree-node__handle cursor-grab select-none text-content-secondary"
        aria-hidden="true"
      >⠿</span>
    <% end %>
    <%= link_to page.title, avo.edit_resources_page_path(page), class: "font-medium hover:underline" %>
    <span class="text-xs text-content-secondary">
      <%= page.page_type %> · <%= page.published_at.present? ? "published" : "draft" %>
    </span>
  </div>

  <ul
    class="pl-6 [&.sortable-ghost]:opacity-40"
    data-parent-id="<%= page.id %>"
    data-pages-tree-target="list"
  >
    <% page.children.order(:position).each do |child| %>
      <%= render "page_node", page: child, root: false %>
    <% end %>
  </ul>
</li>
