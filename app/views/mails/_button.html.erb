<%# The link as one button, with the whole address in plain text under it
    (a client that strips buttons, or a person who wants to copy it). %>
<p style="margin:24px 0;"><a href="<%= url %>" style="display:inline-block;padding:12px 20px;background:black;color:white;text-decoration:none;border-radius:6px;font-weight:600;"><%= label %></a></p>
<p style="margin:0 0 24px;font-size:13px;color:dimgray;word-break:break-all;"><%= url %></p>
