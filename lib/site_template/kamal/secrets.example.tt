# The secrets config/deploy.yml names, by NAME only: no value is in this
# file, and none may ever be.
#
#   cp .kamal/secrets.example .kamal/secrets
#
# .kamal/secrets is git-ignored. As it stands, each line takes its value
# from the variable of the same name in the shell `kamal` is run from, so
# export them first, or replace a line's right side with your password
# manager's command, for example:
#   SECRET_KEY_BASE=$(op read "op://<vault>/<item>/credential")
# Kamal reads this file when it runs; no value is written anywhere else.
#
# Make each value once and keep it. Never print one into a log or a chat.

# A token of your registry that may push and pull images
# (on GitHub: a classic token with write:packages).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Signs sessions and tokens. Made with: openssl rand -hex 64
SECRET_KEY_BASE=$SECRET_KEY_BASE

# The one-time code the setup wizard asks for. Made with: openssl rand -hex 16
SETUP_TOKEN=$SETUP_TOKEN

# The database password, for the site and for Postgres alike.
# Made with: openssl rand -hex 24
# Postgres keeps the value of its FIRST start: never change it afterwards.
CONTENT_SPIEL_DATABASE_PASSWORD=$CONTENT_SPIEL_DATABASE_PASSWORD

# The three encryption keys. Each made with: openssl rand -hex 32
# All three together. Once set, never change or lose them: what they
# encrypted cannot be read without them.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT

# Optional, each with its line in config/deploy.yml's `secret` list:
#   OTEL_EXPORTER_OTLP_HEADERS   the telemetry service's key, as the header
#                                it asks for (for example x-api-key=<key>)
#   MAIL_SMTP_PASSWORD           the mail server's password
